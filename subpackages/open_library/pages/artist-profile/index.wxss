/* 制谱人个人主页样式 */

page {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --bg-light: #F8F9FA;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #EEEEEE;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-light);
  position: relative;
}

/* 顶部背景 */
.header-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 0;
}

.nav-back {
  position: absolute;
  left: 20rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.icon-back {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* 主内容区 */
.main-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* 个人信息卡片 */
.profile-card {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 80rpx 32rpx 32rpx;
  margin-top: -40rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.avatar-wrap {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
}

.artist-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 8rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.avatar-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.verified-badge {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--accent-gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  border: 4rpx solid #FFFFFF;
}

.profile-info {
  text-align: center;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.artist-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.artist-title-badge {
  font-size: 22rpx;
  color: var(--accent-gold);
  background: rgba(242, 201, 76, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.artist-bio {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-light);
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.tag {
  background: rgba(49, 77, 99, 0.08);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--primary-color);
}

/* Tab导航 */
.tab-nav {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.tab-count {
  font-size: 24rpx;
  margin-left: 8rpx;
  color: var(--text-light);
}

/* 歌曲列表 */
.song-list {
  background: #FFFFFF;
  padding: 0 32rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.song-item:last-child {
  border-bottom: none;
}

.song-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-light);
  text-align: center;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.song-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.song-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.song-tags {
  display: flex;
  flex-shrink: 0;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.tag-badge.scale {
  background: rgba(49, 77, 99, 0.1);
  color: var(--primary-color);
}

.tag-badge.vip {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #FFFFFF;
}

.song-meta {
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.heart text {
  font-size: 32rpx;
}

.action-btn.more text {
  font-size: 36rpx;
  color: var(--text-light);
  font-weight: 700;
}

/* 合集列表 */
.collection-list {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
}

.collection-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.collection-item:last-child {
  border-bottom: none;
}

.collection-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.cover-text {
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.cover-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(0,0,0,0.4);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.collection-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.collection-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.collection-desc {
  font-size: 24rpx;
  color: var(--text-light);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 空状态 */
.empty-list {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-light);
  font-size: 28rpx;
}

/* 底部间距 */
.bottom-space {
  height: 60rpx;
}
