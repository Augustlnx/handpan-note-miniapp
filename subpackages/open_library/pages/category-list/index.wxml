<!--分类详情页-->
<view class="page-container" style="padding-top: {{statusBarHeight}}px;">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <image class="icon-back-img" src="/assets/icons/keyboard/左_left.svg" mode="aspectFit"/>
    </view>
    <text class="nav-title">{{pageTitle}}</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 筛选栏（仅在调式/音阶等类型时显示） -->
  <view class="filter-bar" wx:if="{{showFilter}}">
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-list">
        <view 
          class="filter-item {{currentFilter === '' ? 'active' : ''}}" 
          bindtap="onFilterChange" 
          data-value=""
        >全部</view>
        <view 
          class="filter-item {{currentFilter === item ? 'active' : ''}}" 
          wx:for="{{filterOptions}}" 
          wx:key="index"
          bindtap="onFilterChange"
          data-value="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 合集详情头部 -->
  <view class="collection-header" wx:if="{{type === 'collection' && collection}}" style="background: linear-gradient(135deg, {{collection.coverGradient[0]}} 0%, {{collection.coverGradient[1]}} 100%);">
    <view class="collection-info">
      <text class="collection-title">{{collection.title}}</text>
      <text class="collection-desc">{{collection.description}}</text>
      <view class="collection-meta">
        <text>{{collection.songCount}}首曲谱</text>
        <text class="meta-divider">·</text>
        <text>{{collection.playCount}}播放</text>
      </view>
      <!-- 收藏按钮 -->
      <view class="collection-actions">
        <view class="favorite-btn {{collection.isFavorite ? 'active' : ''}}" bindtap="toggleCollectionFavorite">
          <image wx:if="{{collection.isFavorite}}" class="favorite-icon-img" src="../../assets/icons/like.svg" mode="aspectFit"/>
          <text wx:else class="favorite-icon">🤍</text>
          <text class="favorite-text">{{collection.isFavorite ? '已收藏' : '收藏合集'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <scroll-view 
    class="list-scroll" 
    scroll-y 
    enhanced 
    show-scrollbar="{{false}}"
    bindscrolltolower="loadMore"
  >
    <!-- 歌曲列表 -->
    <view class="song-list" wx:if="{{listType === 'songs'}}">
      <view 
        class="song-item" 
        wx:for="{{songs}}" 
        wx:key="id"
        bindtap="goToSongDetail"
        data-item="{{item}}"
      >
        <text class="song-index">{{index + 1}}</text>
        <view class="song-info">
          <view class="song-title-row">
            <text class="song-title">{{item.title}}</text>
            <view class="song-tags">
              <text class="tag-badge scale">{{item.rootNote}}-{{item.scaleType}} {{item.noteCount || 10}}音</text>
              <text class="tag-badge vip" wx:if="{{item.isVip}}">VIP</text>
            </view>
          </view>
          <text class="song-meta">{{item.artistName}} | {{item.author}}</text>
        </view>
        <view class="song-actions">
          <view class="action-btn heart {{item.isFavorite ? 'active' : ''}}" catchtap="toggleFavorite" data-id="{{item.id}}">
            <image wx:if="{{item.isFavorite}}" class="fav-icon-img" src="../../assets/icons/like.svg" mode="aspectFit"/>
            <text wx:else>🤍</text>
          </view>
        </view>
      </view>
      
      <view class="empty-state" wx:if="{{!isLoading && songs.length === 0}}">
        <text class="empty-icon">🎵</text>
        <text class="empty-text">暂无曲谱</text>
      </view>
    </view>

    <!-- 合集列表 -->
    <view class="collection-list" wx:if="{{listType === 'collections'}}">
      <view 
        class="collection-item" 
        wx:for="{{collections}}" 
        wx:key="id"
        bindtap="goToCollectionDetail"
        data-item="{{item}}"
      >
        <view class="coll-cover" style="background: linear-gradient(135deg, {{item.coverGradient[0]}} 0%, {{item.coverGradient[1]}} 100%);">
          <text class="cover-text">{{item.title[0]}}{{item.title[1]}}</text>
          <text class="cover-count">{{item.songCount}}首</text>
        </view>
        <view class="coll-info">
          <text class="coll-title">{{item.title}}</text>
          <text class="coll-desc">{{item.description}}</text>
          <text class="coll-meta">{{item.artistName}} · {{item.playCount}}播放</text>
        </view>
      </view>
      
      <view class="empty-state" wx:if="{{!isLoading && collections.length === 0}}">
        <text class="empty-icon">📚</text>
        <text class="empty-text">暂无合集</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-space"></view>
  </scroll-view>
</view>
