/* 分类详情页样式 */

page {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --bg-light: #F8F9FA;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #EEEEEE;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-light);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
}

.nav-back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back-img {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.icon-back {
  font-size: 48rpx;
  color: var(--primary-color);
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-placeholder {
  width: 70rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
}

.filter-scroll {
  width: 100%;
}

.filter-list {
  display: flex;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-light);
  border-radius: 28rpx;
  transition: all 0.2s ease;
}

.filter-item.active {
  background: var(--primary-color);
  color: #FFFFFF;
}

/* 合集头部 */
.collection-header {
  padding: 40rpx 32rpx;
  color: #FFFFFF;
}

.collection-info {
  text-align: center;
}

.collection-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.collection-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.collection-meta {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 20rpx;
}

.meta-divider {
  margin: 0 12rpx;
}

/* 合集操作按钮 */
.collection-actions {
  margin-top: 16rpx;
}

.favorite-btn {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 32rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 36rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  transition: all 0.2s ease;
}

.favorite-btn.active {
  background: rgba(255,255,255,0.3);
  border-color: rgba(255,255,255,0.8);
}

.favorite-icon,
.favorite-icon-img {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.favorite-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.favorite-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 列表滚动区 */
.list-scroll {
  height: calc(100vh - 180rpx);
  background: #FFFFFF;
}

/* 歌曲列表 */
.song-list {
  padding: 0 32rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.song-item:last-child {
  border-bottom: none;
}

.song-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-light);
  text-align: center;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.song-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.song-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.song-tags {
  display: flex;
  flex-shrink: 0;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.tag-badge.scale {
  background: rgba(49, 77, 99, 0.1);
  color: var(--primary-color);
}

.tag-badge.vip {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #FFFFFF;
}

.song-meta {
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.heart text,
.action-btn.heart .fav-icon-img {
  font-size: 32rpx;
}
.action-btn.heart .fav-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

/* 合集列表 */
.collection-list {
  padding: 20rpx 32rpx;
}

.collection-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.collection-item:last-child {
  border-bottom: none;
}

.coll-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.cover-text {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.cover-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(0,0,0,0.4);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.coll-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.coll-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.coll-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.coll-meta {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}

/* 加载中 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 底部间距 */
.bottom-space {
  height: 40rpx;
}
