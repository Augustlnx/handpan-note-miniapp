/* 谱面详情预览页样式 */

page {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --accent-cyan: #56CCF2;
  --bg-dark: #1a2a3a;
  --bg-card: rgba(255, 255, 255, 0.08);
  --text-white: #FFFFFF;
  --text-light: rgba(255, 255, 255, 0.7);
  --text-muted: rgba(255, 255, 255, 0.5);
}

.page-container {
  min-height: 100vh;
  /* 基于#314D63主题的深色高级渐变 */
  background: linear-gradient(180deg, 
    #1a2a3a 0%, 
    #243447 25%, 
    #314D63 50%, 
    #2a4055 75%, 
    #1e3244 100%);
  position: relative;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;
}

.nav-back,
.nav-action {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back,
.icon-back-img {
  width: 56rpx;
  height: 56rpx;
}
.icon-back-img {
  display: block;
}
.icon-back {
  font-size: 56rpx;
  color: var(--text-white);
  font-weight: 300;
}

.icon-more {
  font-size: 40rpx;
  color: var(--text-white);
  letter-spacing: 4rpx;
}

.nav-title-wrap {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-white);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 主内容区 */
.main-content {
  height: calc(100vh - 180rpx);
  padding-bottom: 180rpx;
}

/* 曲谱信息头部 */
.song-header {
  padding: 40rpx 32rpx;
  text-align: center;
}

.song-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-white);
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.song-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-light);
  margin-bottom: 32rpx;
}

.song-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 4rpx;
}

.meta-value {
  font-size: 26rpx;
  color: var(--text-white);
  font-weight: 500;
}

.meta-value.clickable {
  color: var(--accent-cyan);
}

.meta-divider {
  margin: 0 24rpx;
  color: var(--text-muted);
}

.difficulty-stars {
  display: flex;
}

.difficulty-stars .star {
  font-size: 24rpx;
  color: var(--text-muted);
  margin: 0 2rpx;
}

.difficulty-stars .star.active {
  color: var(--accent-gold);
}

.song-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  background: var(--bg-card);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.tag.vip {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border: none;
  color: #FFFFFF;
  font-weight: 600;
}

.song-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: var(--text-muted);
}

.stat-value {
  font-size: 26rpx;
  color: var(--text-light);
}

/* 谱面预览区域 */
.sheet-preview-section {
  padding: 0 24rpx 32rpx;
}

.preview-container {
  background: var(--bg-card);
  border-radius: 32rpx;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
}

.preview-header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.preview-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-white);
}

.sheet-canvas-wrap {
  position: relative;
  width: 100%;
  min-height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.sheet-canvas {
  width: 100% !important;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* Canvas 隐藏状态（保留在DOM中但不可见） */
.sheet-canvas.hidden {
  position: absolute;
  left: -9999rpx;
  opacity: 0;
  pointer-events: none;
}

.preview-image {
  width: 100%;
  height: auto;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  background: #FFFFFF;
}

.canvas-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(26, 26, 46, 0.8);
  border-radius: 16rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: var(--accent-gold);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.introduction {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.intro-text {
  font-size: 26rpx;
  color: var(--text-light);
  line-height: 1.6;
}

/* 底部间距 */
.bottom-space {
  height: 40rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  /* 基于#314D63主题 */
  background: linear-gradient(to top, rgba(26, 42, 58, 0.98) 0%, rgba(36, 52, 71, 0.95) 100%);
  backdrop-filter: blur(20rpx);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn.secondary {
  background: var(--bg-card);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: var(--text-white);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--accent-gold) 0%, #E5B53A 100%);
  color: var(--bg-dark);
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 30rpx;
}

/* 收藏按钮 */
.favorite-btn {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--bg-card);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.favorite-btn.active {
  background: rgba(255, 107, 107, 0.2);
}

.fav-icon,
.fav-icon-img {
  font-size: 44rpx;
}
.fav-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

/* 响应式适配 */
@media screen and (min-width: 768px) {
  .related-item {
    width: calc(33.33% - 14rpx);
  }
  
  .song-title {
    font-size: 56rpx;
  }
  
  .sheet-canvas-wrap {
    min-height: 500rpx;
  }
}
