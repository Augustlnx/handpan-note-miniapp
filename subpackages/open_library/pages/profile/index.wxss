/* 个人中心页面样式 */

page {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --bg-light: #F8F9FA;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #EEEEEE;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-light);
  position: relative;
}

/* 顶部背景 */
.header-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 0;
}

.nav-back {
  position: absolute;
  left: 20rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.icon-back-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

/* 主内容区 */
.main-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* 个人信息卡片 */
.profile-card {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 80rpx 32rpx 32rpx;
  margin-top: 0rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.avatar-wrap {
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 8rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.avatar-icon {
  width: 80rpx;
  height: 80rpx;
  filter: brightness(100);
}

.profile-info {
  text-align: center;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.user-bio {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-light);
}

/* Tab导航 */
.tab-nav {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.tab-count {
  font-size: 24rpx;
  margin-left: 8rpx;
  color: var(--text-light);
}

/* 歌单部分 */
.playlist-section {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
}

/* 新建歌单按钮 */
.create-playlist-btn {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border: 2rpx dashed var(--primary-color);
  border-radius: 16rpx;
}

.create-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #5a7a92 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 80rpx;
  font-size: 48rpx;
  color: #FFFFFF;
  margin-right: 20rpx;
}

.create-text {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 歌单列表 */
.playlist-list {
  background: #FFFFFF;
}

.playlist-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.playlist-item:last-child {
  border-bottom: none;
}

.playlist-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.playlist-cover .cover-text {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.playlist-cover .cover-icon {
  width: 48rpx;
  height: 48rpx;
} 

.playlist-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.playlist-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.playlist-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.default-badge {
  font-size: 20rpx;
  color: var(--accent-gold);
  background: rgba(242, 201, 76, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.playlist-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-light);
}

.meta-count {
  color: var(--primary-color);
  font-weight: 500;
}

.meta-divider {
  margin: 0 12rpx;
  color: var(--border-color);
}

.meta-source {
  color: var(--text-light);
}

.playlist-actions {
  padding: 20rpx;
}

.more-icon {
  font-size: 36rpx;
  color: var(--text-light);
  font-weight: 700;
}

/* 歌曲列表 */
.song-list {
  background: #FFFFFF;
  padding: 0 32rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.song-item:last-child {
  border-bottom: none;
}

.song-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-light);
  text-align: center;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.song-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.song-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.song-tags {
  display: flex;
  flex-shrink: 0;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.tag-badge.scale {
  background: rgba(49, 77, 99, 0.1);
  color: var(--primary-color);
}

.song-meta {
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.heart text,
.action-btn.heart .fav-icon-img {
  font-size: 32rpx;
}
.action-btn.heart .fav-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.action-btn.more text {
  font-size: 36rpx;
  color: var(--text-light);
  font-weight: 700;
}

/* 合集列表 */
.collection-list {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
}

.collection-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.collection-item:last-child {
  border-bottom: none;
}

.collection-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.collection-cover .cover-text {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.cover-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  background: rgba(0,0,0,0.4);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
}

.collection-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.collection-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.collection-desc {
  font-size: 24rpx;
  color: var(--text-light);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.collection-actions {
  padding: 20rpx;
}

.favorite-icon {
  font-size: 32rpx;
}

.favorite-icon.active,
.favorite-icon-img.active {
  color: #FF6B6B;
}
.favorite-icon-img.active {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

/* 空状态 */
.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-light);
  font-size: 28rpx;
  background: #FFFFFF;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

/* 底部间距 */
.bottom-space {
  height: 60rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: calc(100% - 48rpx);
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.modal-input:focus {
  border-color: var(--primary-color);
  background: #FFFFFF;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary-color) 0%, #456275 100%);
  color: #FFFFFF;
}

/* 操作菜单 */
.action-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 16rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.sheet-item.danger {
  color: #FF4444;
}

.sheet-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.sheet-cancel {
  margin-top: 16rpx;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
  text-align: center;
  border-top: 8rpx solid #f5f5f5;
}
