/* 公开曲库首页样式 - 三合一 TabBar 布局 */

/* 主题色变量（使用类选择器避免 component wxss 中不允许的 tag 选择器） */
.page-container {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --accent-cyan: #56CCF2;
  --bg-light: #F8F9FA;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #EEEEEE;
  --shadow-sm: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-light);
  position: relative;
}

/* ==================== 自定义导航栏 ==================== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(135deg, var(--primary-color) 0%, #1E3A4C 100%);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back,
.icon-back-img {
  width: 48rpx;
  height: 48rpx;
}
.icon-back-img {
  display: block;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 70rpx;
}

/* ==================== Tab 0: 曲谱库样式 ==================== */

/* 主滚动区域 */
.main-scroll {
  height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* 搜索入口 */
.search-entry {
  padding: 24rpx 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(49, 77, 99, 0.08);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  transition: all 0.3s ease;
}

.search-box:active {
  background: rgba(49, 77, 99, 0.15);
}

.search-icon,
.search-icon-img {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.search-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
  flex-shrink: 0;
}

.search-placeholder {
  font-size: 30rpx;
  color: var(--text-light);
}

/* Banner轮播 */
.banner-section {
  position: relative;
  padding: 0 0 10rpx;
}

.banner-swiper {
  height: 320rpx;
}

/* 轮播指示点：白色，卡片底部水平居中 */
.banner-indicator {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 25rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.25s ease;
}

.banner-dot.active {
  background: #FFFFFF;
  transform: scale(1.15);
}

.banner-card {
  position: relative;
  margin: 0 2rpx;
  height: 320rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
  transform: scale(0.92);
  opacity: 0.7;
}

.banner-bg-img,
.banner-bg-gradient {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.banner-bg-img {
  display: block;
}

.banner-card.active {
  transform: scale(1);
  opacity: 1;
}

.banner-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 100%);
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 18rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

/* 金刚区 */
.quick-access {
  display: flex;
  flex-direction: row;
  gap: 18rpx;
  padding: 18rpx 32rpx 24rpx;
}

.quick-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.quick-item:active {
  opacity: 0.85;
}

.quick-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 通用板块样式 */
.section {
  margin-bottom: 15rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  display: flex;
  align-items: center;
  color: var(--text-light);
  font-size: 26rpx;
}

.section-more .arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
}

/* 精选/最近上新：列表形式，每页3行，左右滑动 */
.section-swiper-wrap {
  margin: 0 32rpx;
  padding-bottom: 48rpx;
}
.section-swiper {
  height: 360rpx;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.section-swiper-indicator {
  margin-top: 20rpx;
  padding: 0 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.section-indicator-track {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.section-indicator-slider {
  width: 24rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(49, 77, 99, 0.2);
  transition: all 0.25s ease;
}
.section-indicator-slider.active {
  width: 40rpx;
  background: var(--primary-color);
}
.section-song-list {
  padding: 0 24rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}
.section-song-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.section-song-item:last-child {
  border-bottom: none;
}
.section-file-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 16rpx;
  color: #fff;
  flex-shrink: 0;
}
.section-item-info {
  flex: 1;
  min-width: 0;
}
.section-song-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}
.section-item-name {
  flex-shrink: 0;
  max-width: 60%;
  font-size: 30rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}
.section-tag-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(49, 77, 99, 0.1);
  color: var(--primary-color);
}
.section-item-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.section-song-actions {
  margin-left: 16rpx;
}
.section-song-actions .action-btn.heart text,
.section-song-actions .action-btn.heart .fav-icon-img {
  font-size: 32rpx;
}
.section-song-actions .action-btn.heart .fav-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

/* 横向滚动歌曲列表 */
.song-scroll,
.artist-scroll {
  width: 100%;
}

.song-list.horizontal {
  display: flex;
  padding: 0 32rpx;
}

.song-card {
  flex-shrink: 0;
  width: 180rpx;
  margin-right: 20rpx;
}

.song-cover,
.collection-cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12rpx;
  overflow: hidden;
}

.cover-text {
  font-size: 52rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.vip-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.new-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.collection-count {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.song-info {
  padding: 0 2rpx;
}

.song-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4rpx;
}

.song-artist {
  display: block;
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 合集卡片 */
.collection-card {
  flex-shrink: 0;
  width: 180rpx;
  margin-right: 20rpx;
}

/* 制谱人列表（首页横向滚动版本） */
.artist-list {
  display: flex;
  padding: 0 32rpx;
}

.artist-card {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}

.artist-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: var(--shadow-md);
  border: 4rpx solid var(--accent-gold);
  margin-bottom: 16rpx;
}

.artist-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  object-fit: cover;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.verified-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: var(--accent-gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 700;
  border: 2rpx solid #FFFFFF;
  z-index: 10;
}

.artist-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.artist-count {
  font-size: 22rpx;
  color: var(--text-light);
}

/* 排行榜板块 */
.ranking-section {
  background: #FFFFFF;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding-top: 32rpx;
  margin-top: 8rpx;
}

.ranking-list {
  padding: 0 32rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 56rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-light);
  text-align: center;
  flex-shrink: 0;
}

.rank-number.top-rank {
  font-size: 36rpx;
  font-weight: 800;
}

.rank-number.rank-1 {
  color: #FFD700;
}

.rank-number.rank-2 {
  color: #C0C0C0;
}

.rank-number.rank-3 {
  color: #CD7F32;
}

.rank-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.rank-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.rank-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.rank-tags {
  display: flex;
  flex-shrink: 0;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.tag-badge.scale {
  background: rgba(49, 77, 99, 0.1);
  color: var(--primary-color);
  border: 1rpx solid rgba(49, 77, 99, 0.3);
}

.tag-badge.vip {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  border: none;
}

.rank-meta {
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.heart text,
.action-btn.heart .fav-icon-img {
  font-size: 32rpx;
}
.action-btn.heart .fav-icon-img,
.favorite-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.action-btn.more text {
  font-size: 36rpx;
  color: var(--text-light);
  font-weight: 700;
}

/* 底部间距 */
.bottom-space {
  height: 40rpx;
}

/* ==================== Tab 1: 制谱人列表样式 ==================== */

.artists-tab-container {
  min-height: 100vh;
  background: var(--bg-light);
}

.artists-scroll {
  height: 100vh;
  padding: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  box-sizing: border-box;
}

.artists-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 制谱人大卡片（Tab 1专用） */
.artist-card-large {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  min-height: 200rpx;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
}

.card-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.artist-avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.artist-avatar-img-large {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  object-fit: cover;
}

.avatar-text-large {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.verified-badge-large {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: var(--accent-gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 700;
  border: 2rpx solid #FFFFFF;
  z-index: 10;
}

.artist-info-large {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.artist-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.artist-name-large {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 12rpx;
}

.artist-title {
  font-size: 20rpx;
  color: var(--accent-gold);
  background: rgba(242, 201, 76, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.artist-bio {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.artist-stats {
  display: flex;
  align-items: center;
}

.stat {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.stat-divider {
  margin: 0 12rpx;
  color: rgba(255,255,255,0.4);
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #EEEEEE;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}

/* ==================== Tab 2: 我的样式 ==================== */

.profile-tab-container {
  min-height: 100vh;
  background: var(--bg-light);
  position: relative;
}

/* 顶部背景 */
.profile-header-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 0;
}

/* 主内容区 */
.profile-main-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 个人信息卡片 */
.profile-card {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 80rpx 32rpx 32rpx;
  margin-top: 0rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.avatar-wrap {
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 8rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.avatar-icon {
  width: 80rpx;
  height: 80rpx;
  filter: brightness(100);
}

.profile-info {
  text-align: center;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.user-bio {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 64rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-light);
}

/* Tab导航 */
.profile-tab-nav {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

.profile-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  position: relative;
}

.profile-tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.profile-tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.tab-count {
  font-size: 24rpx;
  margin-left: 8rpx;
  color: var(--text-light);
}

/* 歌单部分 */
.playlist-section {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
}

/* 新建歌单按钮 */
.create-playlist-btn {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border: 2rpx dashed var(--primary-color);
  border-radius: 16rpx;
}

.create-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, #5a7a92 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 80rpx;
  font-size: 48rpx;
  color: #FFFFFF;
  margin-right: 20rpx;
}

.create-text {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 歌单列表 */
.playlist-list {
  background: #FFFFFF;
}

.playlist-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.playlist-item:last-child {
  border-bottom: none;
}

.playlist-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.playlist-cover .cover-text {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.playlist-cover .cover-icon {
  width: 48rpx;
  height: 48rpx;
} 

.playlist-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.playlist-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.playlist-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.default-badge {
  font-size: 20rpx;
  color: var(--accent-gold);
  background: rgba(242, 201, 76, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.playlist-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-light);
}

.meta-count {
  color: var(--primary-color);
  font-weight: 500;
}

.meta-divider {
  margin: 0 12rpx;
  color: var(--border-color);
}

.meta-source {
  color: var(--text-light);
}

.playlist-actions {
  padding: 20rpx;
}

.more-icon {
  font-size: 36rpx;
  color: var(--text-light);
  font-weight: 700;
}

/* 歌曲列表 (Profile专用) */
.profile-song-list {
  background: #FFFFFF;
  padding: 0 32rpx;
}

.profile-song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.profile-song-item:last-child {
  border-bottom: none;
}

.song-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-light);
  text-align: center;
  flex-shrink: 0;
}

.profile-song-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.profile-song-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.profile-song-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.profile-song-tags {
  display: flex;
  flex-shrink: 0;
}

.profile-song-meta {
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-song-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

/* 合集列表 (Profile专用) */
.profile-collection-list {
  background: #FFFFFF;
  padding: 20rpx 32rpx;
}

.profile-collection-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.profile-collection-item:last-child {
  border-bottom: none;
}

.profile-collection-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.profile-collection-cover .cover-text {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.cover-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  background: rgba(0,0,0,0.4);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
}

.profile-collection-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.profile-collection-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-collection-desc {
  font-size: 24rpx;
  color: var(--text-light);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.profile-collection-actions {
  padding: 20rpx;
}

.favorite-icon {
  font-size: 32rpx;
}

.favorite-icon.active {
  color: #FF6B6B;
}

/* 空状态 */
.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-light);
  font-size: 28rpx;
  background: #FFFFFF;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

/* ==================== 固定的自定义底部TabBar ==================== */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.tabbar-icon,
.tabbar-icon-img {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}
.tabbar-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tabbar-text {
  font-size: 22rpx;
  color: var(--text-light);
}

.tabbar-item.active .tabbar-text {
  color: var(--primary-color);
  font-weight: 600;
}

/* ==================== 弹窗样式 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: calc(100% - 48rpx);
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.modal-input:focus {
  border-color: var(--primary-color);
  background: #FFFFFF;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary-color) 0%, #456275 100%);
  color: #FFFFFF;
}

/* 操作菜单 */
.action-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 16rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.sheet-item.danger {
  color: #FF4444;
}

.sheet-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.sheet-cancel {
  margin-top: 16rpx;
  padding: 28rpx 40rpx;
  font-size: 30rpx;
  color: var(--text-secondary);
  text-align: center;
  border-top: 8rpx solid #f5f5f5;
}

/* 响应式适配 */
@media screen and (min-width: 768px) {
  .song-card,
  .collection-card {
    width: 200rpx;
    margin-right: 24rpx;
  }
  
  .song-cover,
  .collection-cover {
    width: 200rpx;
    height: 200rpx;
  }
  
  .artist-avatar {
    width: 180rpx;
    height: 180rpx;
  }
  
  .banner-swiper {
    height: 360rpx;
  }
  
  .banner-card {
    height: 320rpx;
  }
}
