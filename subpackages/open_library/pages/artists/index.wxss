/* 制谱人列表页样式 */

page {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --bg-light: #F8F9FA;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-light);
}

/* 滚动区域（无顶部导航栏，留出状态栏即可） */
.artists-scroll {
  height: 100vh;
  padding: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  box-sizing: border-box;
}

/* 自定义底部 TabBar（与首页一致） */
.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.tabbar-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
  margin-bottom: 4rpx;
}

.tabbar-text {
  font-size: 22rpx;
  color: var(--text-light);
}

.tabbar-item.active .tabbar-text {
  color: var(--primary-color);
  font-weight: 600;
}

.artists-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 制谱人卡片 */
.artist-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  min-height: 200rpx;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to right, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);
}

.card-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.artist-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
  border: 4rpx solid rgba(255,255,255,0.5);
  overflow: hidden;
}

.artist-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.verified-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: var(--accent-gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 700;
  border: 2rpx solid #FFFFFF;
}

.artist-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.artist-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.artist-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 12rpx;
}

.artist-title {
  font-size: 20rpx;
  color: var(--accent-gold);
  background: rgba(242, 201, 76, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.artist-bio {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.artist-stats {
  display: flex;
  align-items: center;
}

.stat {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.stat-divider {
  margin: 0 12rpx;
  color: rgba(255,255,255,0.4);
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #EEEEEE;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: var(--text-light);
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}
