<!--制谱人列表页（与首页共用 TabBar，无顶部导航栏）-->
<view class="page-container" style="padding-top: {{statusBarHeight}}px;">
  <!-- 仅保留状态栏占位，无导航栏文字和返回键 -->

  <!-- 列表 -->
  <scroll-view class="artists-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="padding-bottom: {{tabbarBottom}}px;">
    <view class="artists-list">
      <view 
        class="artist-card" 
        wx:for="{{artists}}" 
        wx:key="id"
        bindtap="goToArtistDetail"
        data-item="{{item}}"
      >
        <!-- 背景模糊图 -->
        <view class="card-bg" style="background: linear-gradient(135deg, {{item.backgroundGradient[0]}} 0%, {{item.backgroundGradient[1]}} 100%);"></view>
        <view class="card-overlay"></view>
        
        <!-- 内容 -->
        <view class="card-content">
          <view class="artist-avatar" style="background: linear-gradient(135deg, {{item.backgroundGradient[0]}} 0%, {{item.backgroundGradient[1]}} 100%);">
            <image wx:if="{{item.avatar}}" class="artist-avatar-img" src="{{item.avatar}}" mode="aspectFill"/>
            <text wx:else class="avatar-text">{{item.name[0]}}</text>
            <view class="verified-badge" wx:if="{{item.isVerified}}">✓</view>
          </view>
          <view class="artist-info">
            <view class="artist-name-row">
              <text class="artist-name">{{item.name}}</text>
              <text class="artist-title" wx:if="{{item.title}}">{{item.title}}</text>
            </view>
            <text class="artist-bio">{{item.bio}}</text>
            <view class="artist-stats">
              <text class="stat">收录 {{item.songCount}} 首</text>
              <text class="stat-divider">·</text>
              <text class="stat">{{item.followers}} 关注</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
    
    <!-- 无更多 -->
    <view class="no-more" wx:if="{{!isLoading && artists.length > 0}}">
      <text>— 已展示全部制谱人 —</text>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!isLoading && artists.length === 0}}">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无制谱人</text>
    </view>
  </scroll-view>

  <!-- 自定义底部 TabBar（与首页一致） -->
  <view class="custom-tabbar" style="padding-bottom: {{safeAreaBottom}}px;">
    <view class="tabbar-item" bindtap="goToIndex">
      <image class="tabbar-icon-img" src="../../assets/icons/library.svg" mode="aspectFit"/>
      <text class="tabbar-text">曲谱库</text>
    </view>
    <view class="tabbar-item active">
      <image class="tabbar-icon-img" src="../../assets/icons/musician.svg" mode="aspectFit"/>
      <text class="tabbar-text">制谱人</text>
    </view>
    <view class="tabbar-item" bindtap="goToSettings">
      <image class="tabbar-icon-img" src="../../assets/icons/user.svg" mode="aspectFit"/>
      <text class="tabbar-text">我的</text>
    </view>
  </view>
</view>
