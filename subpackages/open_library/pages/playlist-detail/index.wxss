/* 歌单详情页面样式 */

page {
  --primary-color: #314D63;
  --accent-gold: #F2C94C;
  --bg-light: #F8F9FA;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #EEEEEE;
  --danger-color: #FF4444;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-light);
  position: relative;
}

/* 顶部背景 */
.header-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 0;
}

.nav-back {
  position: absolute;
  left: 20rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.icon-back-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

.nav-more {
  position: absolute;
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.nav-more .more-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 主内容区 */
.main-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

/* 歌单信息卡片 */
.playlist-card {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 80rpx 32rpx 32rpx;
  margin-top: 0rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.cover-wrap {
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
}

.playlist-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.cover-text {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
}

.playlist-info {
  text-align: center;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.playlist-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.default-badge {
  font-size: 20rpx;
  color: var(--accent-gold);
  background: rgba(242, 201, 76, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.playlist-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 0 40rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 64rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
}

.toolbar-left {
  display: flex;
  align-items: center;
}

.song-count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.toolbar-btn {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 编辑工具栏 */
.edit-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid var(--border-color);
}

.edit-left {
  display: flex;
  align-items: center;
}

.selected-count {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.edit-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-btn {
  padding: 10rpx 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

.edit-btn.danger {
  background: var(--danger-color);
  color: #FFFFFF;
  border-color: var(--danger-color);
}

/* 歌曲列表 */
.song-list {
  background: #FFFFFF;
  padding: 0 32rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.song-item:last-child {
  border-bottom: none;
}

.song-item.edit-mode {
  padding-left: 0;
}

/* 选择框 */
.checkbox-wrap {
  margin-right: 16rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
}

.checkbox.checked {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.song-index {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-light);
  text-align: center;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.song-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.song-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.song-tags {
  display: flex;
  flex-shrink: 0;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.tag-badge.scale {
  background: rgba(49, 77, 99, 0.1);
  color: var(--primary-color);
}

.song-meta {
  font-size: 24rpx;
  color: var(--text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.heart text,
.action-btn.heart .fav-icon-img {
  font-size: 32rpx;
}
.action-btn.heart .fav-icon-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.action-btn.more text {
  font-size: 36rpx;
  color: var(--text-light);
  font-weight: 700;
}

/* 空状态 */
.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--text-light);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 底部间距 */
.bottom-space {
  height: 60rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: calc(100% - 48rpx);
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.modal-input:focus {
  border-color: var(--primary-color);
  background: #FFFFFF;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary-color) 0%, #456275 100%);
  color: #FFFFFF;
}
