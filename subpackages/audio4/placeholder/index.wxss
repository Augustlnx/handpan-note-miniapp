/* subpackages/audio4/placeholder/index.wxss */
/* 音频分包加载页面样式 */

.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #304859 0%, #1a2a36 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

/* 加载动画容器 */
.loading-spinner {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

/* 旋转环 */
.spinner-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 6rpx solid rgba(255, 255, 255, 0.1);
  border-top-color: #FF9800;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 中心音符图标 */
.spinner-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 60rpx;
  color: #fff;
  animation: pulse 1s ease-in-out infinite;
}

/* 加载文字 */
.loading-text {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 16rpx;
}

.loading-range {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 动画定义 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.7; transform: translate(-50%, -50%) scale(0.9); }
}
