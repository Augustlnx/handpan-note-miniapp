<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>电子手碟布局编辑器 V2 (增强版)</title>
    <style>
        body { margin: 0; background: #1a1a1a; color: #fff; font-family: sans-serif; display: flex; height: 100vh; overflow: hidden; }
        
        /* 左侧画布区域 */
        #canvas-area {
            flex: 1;
            position: relative;
            background: radial-gradient(circle at center, #4a4a40 0%, #1a1a10 70%);
            overflow: hidden;
            user-select: none;
        }

        /* 参考线 */
        .guide-line { position: absolute; background: rgba(255,255,255,0.1); pointer-events: none; }
        .guide-v { width: 1px; height: 100%; left: 50%; }
        .guide-h { height: 1px; width: 100%; top: 50%; }

        /* 实际操作的 DOM 节点 */
        .editor-node {
            position: absolute;
            transform-origin: center center;
            cursor: move;
            display: flex;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
            border: 1px dashed rgba(255,255,255,0.3);
            border-radius: 50%; 
            background: rgba(255, 215, 0, 0.1);
            color: rgba(255,255,255,0.7);
            font-size: 12px;
        }
        .editor-node.selected {
            background: rgba(255, 215, 0, 0.3);
            border: 2px solid #ffd700;
            z-index: 100;
            color: #fff;
            font-weight: bold;
        }
        /* 选中时的十字中心点辅助 */
        .editor-node.selected::before {
            content: ''; position: absolute; width: 6px; height: 6px; background: red; border-radius: 50%;
        }
        .editor-node span {
            pointer-events: none;
        }

        /* 右侧控制面板 */
        #controls {
            width: 340px;
            background: #2b2b2b;
            padding: 20px;
            box-shadow: -5px 0 10px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            border-left: 1px solid #444;
        }
        h2 { margin-top: 0; font-size: 18px; color: #ffd700; margin-bottom: 20px;}
        .panel-group { margin-bottom: 20px; border-bottom: 1px solid #444; padding-bottom: 15px; }
        .control-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        label { font-size: 13px; color: #ccc; width: 90px; }
        input[type="range"] { flex: 1; margin: 0 10px; cursor: pointer; }
        input[type="number"] { width: 55px; background: #444; border: 1px solid #555; color: #fff; padding: 4px; border-radius: 3px; }
        input[type="text"] { background: #444; border: 1px solid #555; color: #fff; padding: 4px; border-radius: 3px; }
        
        button { background: #444; color: white; border: none; padding: 8px 12px; cursor: pointer; border-radius: 4px; margin-right: 5px; margin-bottom: 5px;}
        button:hover { background: #555; }
        button.primary { background: #ffd700; color: #000; font-weight: bold; }
        
        .hint { font-size: 12px; color: #888; margin-top: 5px; line-height: 1.4; }
        
        /* 坐标显示徽章 */
        .coord-badge {
            font-family: monospace;
            background: #000;
            padding: 2px 6px;
            border-radius: 4px;
            color: #0f0;
            font-size: 12px;
        }
    </style>
</head>
<body>

    <div id="canvas-area">
        <div class="guide-line guide-v"></div>
        <div class="guide-line guide-h"></div>
        <!-- 动态生成的节点 -->
    </div>

    <div id="controls">
        <h2>🎛️ 布局编辑器 V2</h2>
        
        <div class="panel-group">
            <button onclick="addNote()">+ 添加音符</button>
            <button onclick="removeSelected()" style="color:#ff6666">删除</button>
        </div>

        <div id="selected-controls" style="display:none;">
            <div class="panel-group">
                <h3 style="margin-top:0; display:flex; justify-content:space-between;">
                    选中: <span style="color:#ffd700" id="curr-label-display"></span>
                    <span class="coord-badge" id="curr-coord-display">X:0 Y:0</span>
                </h3>
                
                <div class="control-row">
                    <label>音名 (ID)</label>
                    <input type="text" id="inp-label" style="width: 100%;" oninput="updateProp('label', this.value)">
                </div>

                <!-- 新增：位置控制 -->
                <div class="control-row">
                    <label>位置 X</label>
                    <input type="range" min="0" max="1000" id="rng-x" oninput="updateProp('x', this.value)">
                    <input type="number" id="inp-x" onchange="updateProp('x', this.value)">
                </div>
                <div class="control-row">
                    <label>位置 Y</label>
                    <input type="range" min="0" max="1000" id="rng-y" oninput="updateProp('y', this.value)">
                    <input type="number" id="inp-y" onchange="updateProp('y', this.value)">
                </div>

                <hr style="border:0; border-top:1px dashed #444; margin: 15px 0;">

                <div class="control-row">
                    <label>宽度 (W)</label>
                    <input type="range" min="10" max="400" id="rng-width" oninput="updateProp('width', this.value)">
                    <input type="number" id="inp-width" onchange="updateProp('width', this.value)">
                </div>

                <div class="control-row">
                    <label>高度 (H)</label>
                    <input type="range" min="10" max="400" id="rng-height" oninput="updateProp('height', this.value)">
                    <input type="number" id="inp-height" onchange="updateProp('height', this.value)">
                </div>

                <div class="control-row">
                    <label>旋转 (°)</label>
                    <input type="range" min="-180" max="180" id="rng-rot" oninput="updateProp('rot', this.value)">
                    <input type="number" id="inp-rot" onchange="updateProp('rot', this.value)">
                </div>
            </div>
        </div>

        <div class="panel-group">
            <button class="primary" onclick="exportJSON()" style="width:100%">📤 导出 JSON 参数</button>
            <textarea id="output-json" rows="8" style="width:95%; margin-top:10px; background:#111; color:#0f0; font-size:11px; display:none; border:1px solid #444; padding:5px;"></textarea>
        </div>

        <div class="hint">
            <strong>快捷操作:</strong><br>
            • 点击圆圈选中<br>
            • 键盘 ↑ ↓ ← → 微调位置 (Shift 加速)<br>
            • 键盘 Q / E 旋转<br>
            • 画布尺寸默认 1000x1000
        </div>
    </div>

    <script>
        // 初始数据
        let notes = [
            { id: 0, label: "Ding", x: 500, y: 500, w: 280, h: 280, r: 0 },
            { id: 1, label: "A3", x: 650, y: 780, w: 220, h: 150, r: 65 },
            { id: 2, label: "Bb3", x: 350, y: 780, w: 220, h: 150, r: -65 },
        ];

        const canvas = document.getElementById('canvas-area');
        const CANVAS_SIZE = 1000; 
        let selectedId = null;

        function init() {
            renderAll();
            window.addEventListener('resize', renderAll);
            document.addEventListener('keydown', handleKey);
        }

        function renderAll() {
            // 清空画布但保留参考线
            canvas.innerHTML = '<div class="guide-line guide-v"></div><div class="guide-line guide-h"></div>';
            
            // 响应式缩放计算
            const rect = canvas.getBoundingClientRect();
            const scale = Math.min(rect.width / CANVAS_SIZE, rect.height / CANVAS_SIZE) * 0.9;
            const offsetX = (rect.width - CANVAS_SIZE * scale) / 2;
            const offsetY = (rect.height - CANVAS_SIZE * scale) / 2;

            notes.forEach((note, index) => {
                const el = document.createElement('div');
                el.className = `editor-node ${selectedId === index ? 'selected' : ''}`;
                el.setAttribute('data-id', index);
                
                // 坐标映射
                el.style.width = (note.w * scale) + 'px';
                el.style.height = (note.h * scale) + 'px';
                el.style.left = (offsetX + note.x * scale - (note.w * scale)/2) + 'px';
                el.style.top = (offsetY + note.y * scale - (note.h * scale)/2) + 'px';
                el.style.transform = `rotate(${note.r}deg)`;
                
                // 文字标签（反向旋转以保持直立）
                el.innerHTML = `<span style="transform: rotate(${-note.r}deg)">${note.label}</span>`;

                // 绑定拖拽
                el.onmousedown = (e) => startDrag(e, index, scale);
                
                canvas.appendChild(el);
            });
        }

        function startDrag(e, index, scale) {
            e.stopPropagation();
            selectNote(index);
            
            const startX = e.clientX;
            const startY = e.clientY;
            const noteStartX = notes[index].x;
            const noteStartY = notes[index].y;

            const moveHandler = (ev) => {
                const dx = (ev.clientX - startX) / scale;
                const dy = (ev.clientY - startY) / scale;
                
                notes[index].x = Math.round(noteStartX + dx);
                notes[index].y = Math.round(noteStartY + dy);
                
                // 边界限制 (可选)
                // notes[index].x = Math.max(0, Math.min(CANVAS_SIZE, notes[index].x));
                // notes[index].y = Math.max(0, Math.min(CANVAS_SIZE, notes[index].y));

                renderAll();
                updatePanelValues(); 
            };

            const upHandler = () => {
                document.removeEventListener('mousemove', moveHandler);
                document.removeEventListener('mouseup', upHandler);
            };

            document.addEventListener('mousemove', moveHandler);
            document.addEventListener('mouseup', upHandler);
        }

        function selectNote(index) {
            selectedId = index;
            document.getElementById('selected-controls').style.display = 'block';
            updatePanelValues();
            renderAll();
        }

        function updatePanelValues() {
            if (selectedId === null) return;
            const n = notes[selectedId];
            
            // 标题栏更新
            document.getElementById('curr-label-display').innerText = n.label;
            document.getElementById('curr-coord-display').innerText = `X:${n.x} Y:${n.y}`;

            // 输入框填充
            document.getElementById('inp-label').value = n.label;
            
            // X / Y
            syncInput('x', n.x);
            syncInput('y', n.y);
            
            // W / H
            syncInput('width', n.w);
            syncInput('height', n.h);
            
            // Rotate
            syncInput('rot', n.r);
        }

        // 辅助函数：同步 Range 和 Number 输入框
        function syncInput(prop, value) {
            document.getElementById(`rng-${prop}`).value = value;
            document.getElementById(`inp-${prop}`).value = value;
        }

        // 全局更新函数
        window.updateProp = function(prop, val) {
            if (selectedId === null) return;
            const n = notes[selectedId];
            
            if (prop === 'label') n.label = val;
            else if (prop === 'x') n.x = parseInt(val);
            else if (prop === 'y') n.y = parseInt(val);
            else if (prop === 'width') n.w = parseInt(val);
            else if (prop === 'height') n.h = parseInt(val);
            else if (prop === 'rot') n.r = parseInt(val);
            
            renderAll();
            updatePanelValues(); // 保持两个输入框同步
        };

        window.addNote = function() {
            notes.push({ id: notes.length, label: "New", x: 500, y: 500, w: 100, h: 80, r: 0 });
            selectNote(notes.length - 1);
        };

        window.removeSelected = function() {
            if (selectedId === null) return;
            if(confirm('确定要删除这个音符吗？')) {
                notes.splice(selectedId, 1);
                selectedId = null;
                document.getElementById('selected-controls').style.display = 'none';
                renderAll();
            }
        };

        window.exportJSON = function() {
            // 导出适合之前 Demo 的数据结构
            const exportData = notes.map((n, i) => ({
                id: i,
                note: n.label,
                cx: n.x,
                cy: n.y,
                rx: Math.round(n.w / 2),
                ry: Math.round(n.h / 2),
                angle: n.r - 90 // 修正角度：编辑器里0是水平，SVG里0是水平，但因为我们之前demo为了长轴指向圆心做了特殊处理
                                // 这里简化逻辑，直接导出编辑器看到的角度，demo 那边不做 +90 处理，或者这里适配一下
                                // 这里我们保持原始数据，让 demo 决定怎么旋转
            }));
            
            // 为了让上面的 Demo 能直接用，我们这里做一点特殊处理
            // 上面的 Demo 是基于 "长轴指向圆心" 计算的，
            // 但既然我们用了自由编辑器，就直接使用编辑器里的绝对旋转角度即可。
            // 
            // **** 重要调整 ****
            // 之前的 Demo 使用了 polar 坐标 (dist, angle)，但现在我们有了 xy 坐标。
            // 之前的 Demo 渲染逻辑需要改为直接使用 cx, cy, rotation。

            const finalJson = JSON.stringify(exportData, null, 2);
            
            const out = document.getElementById('output-json');
            out.value = finalJson;
            out.style.display = 'block';
            out.select();
            document.execCommand('copy');
            alert('✅ 数据已复制！\n请将这段 JSON 替换 Demo 中的 handpanData，并微调渲染逻辑。');
        };

        function handleKey(e) {
            if (selectedId === null) return;
            if (e.target.tagName === 'INPUT') return;

            const n = notes[selectedId];
            const step = e.shiftKey ? 10 : 1;
            let changed = false;
            
            switch(e.key) {
                case 'ArrowUp': n.y -= step; changed = true; break;
                case 'ArrowDown': n.y += step; changed = true; break;
                case 'ArrowLeft': n.x -= step; changed = true; break;
                case 'ArrowRight': n.x += step; changed = true; break;
                case 'q': n.r -= 1; changed = true; break;
                case 'e': n.r += 1; changed = true; break;
            }
            if(changed) {
                e.preventDefault();
                updatePanelValues();
                renderAll();
            }
        }

        init();
    </script>
</body>
</html>
