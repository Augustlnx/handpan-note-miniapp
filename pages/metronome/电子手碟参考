<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SVG 电子手碟 Demo</title>
    <style>
        body {
            margin: 0;
            background-color: #050a10; /* 深空蓝背景 */
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            font-family: 'Times New Roman', serif;
        }

        /* 手碟容器：模拟球体立体感 */
        #handpan-container {
            width: 95vw;
            height: 95vw;
            max-width: 600px;
            max-height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #4a4a40 0%, #2b2b20 40%, #1a1a10 80%);
            box-shadow: 0 0 50px rgba(0,0,0,0.8), inset 0 0 100px rgba(0,0,0,0.5);
            position: relative;
        }

        svg {
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        /* 音符基础样式 */
        .note-group {
            cursor: pointer;
            transition: transform 0.1s;
            /* 这一点很重要：让触摸事件只在形状上触发，而不是在透明矩形框上 */
            pointer-events: all; 
        }

        /* 触摸反馈动画：缩小一点点模拟按压 */
        .note-group:active {
            transform: scale(0.95);
        }

        /* 音符的外框（Tone Field） */
        .tone-field {
            fill: rgba(60, 60, 50, 0.6);
            stroke: #111;
            stroke-width: 2;
            transition: fill 0.1s, filter 0.1s;
        }

        /* 音符的内陷（Dimple） */
        .dimple {
            fill: rgba(30, 30, 25, 0.5);
            stroke: rgba(0,0,0,0.3);
            stroke-width: 1;
        }

        /* 文字样式 */
        text {
            fill: #d4c5a3; /* 香槟金色文字 */
            text-anchor: middle;
            dominant-baseline: middle;
            pointer-events: none; /* 防止文字阻挡点击 */
            font-weight: bold;
        }
        .note-num { font-size: 14px; opacity: 0.8; }
        .note-name { font-size: 24px; }

        /* --- 激活/发光状态 --- */
        .note-group.active .tone-field {
            fill: #ffd700; /* 金色高亮 */
            filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.8)); /* 发光滤镜 */
            fill-opacity: 0.8;
        }
        .note-group.active .dimple {
            fill: rgba(0,0,0,0.1); /* 内陷变亮 */
        }
        .note-group.active text {
            fill: #fff;
            text-shadow: 0 0 5px black;
        }

    </style>
</head>
<body>

    <div id="handpan-container">
        <!-- viewbox 定义画布坐标系 0-1000 -->
        <svg viewBox="0 0 1000 1000" id="handpan-svg">
            <!-- 内容由 JS 生成 -->
        </svg>
    </div>

    <script>
        // 定义手碟的音符数据结构
        // 坐标系：中心为 500, 500
        // angle: 旋转角度 (度)
        // dist: 距离中心的距离
        // rx, ry: 椭圆的长短半轴
        const handpanData = [
            // 中心音 (Ding)
            { id: 0, note: "D3", num: "0", type: "center", cx: 500, cy: 500, rx: 140, ry: 140 },
            
            // 外圈下半部分 (大音符)
            { id: 1, note: "A3", num: "1", type: "outer", angle: 65, dist: 330, rx: 110, ry: 75 },
            { id: 2, note: "Bb3", num: "2", type: "outer", angle: 115, dist: 330, rx: 110, ry: 75 },
            
            // 外圈两侧 (中音符)
            { id: 3, note: "C4", num: "3", type: "outer", angle: 25, dist: 340, rx: 90, ry: 65 },
            { id: 4, note: "D4", num: "4", type: "outer", angle: 155, dist: 340, rx: 90, ry: 65 },
            
            // 外圈上侧 (高音符)
            { id: 5, note: "E4", num: "5", type: "outer", angle: -20, dist: 340, rx: 80, ry: 55 },
            { id: 6, note: "F4", num: "6", type: "outer", angle: 200, dist: 340, rx: 80, ry: 55 },
            
            // 顶部小音符
            { id: 7, note: "G4", num: "7", type: "outer", angle: -55, dist: 320, rx: 70, ry: 50 },
            { id: 8, note: "A4", num: "8", type: "outer", angle: 235, dist: 320, rx: 70, ry: 50 },

            // 内圈 (Mutant notes / 高高音)
            { id: 9, note: "C5", num: "9", type: "inner", angle: 270, dist: 320, rx: 60, ry: 45 }, // 顶部正中
            { id: 10, note: "D5", num: "10", type: "inner", angle: 215, dist: 200, rx: 55, ry: 40 },
            { id: 11, note: "E5", num: "11", type: "inner", angle: 325, dist: 200, rx: 55, ry: 40 },
        ];

        const svg = document.getElementById('handpan-svg');

        // 初始化绘制函数
        function renderHandpan() {
            handpanData.forEach(item => {
                // 创建组 <g>
                const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
                g.setAttribute("class", "note-group");
                g.dataset.note = item.note; // 存储音名供后续调用

                // 计算位置
                let x = item.cx;
                let y = item.cy;
                let rotation = 0;

                if (item.type !== 'center') {
                    // 极坐标转笛卡尔坐标
                    const rad = (item.angle * Math.PI) / 180;
                    x = 500 + item.dist * Math.cos(rad);
                    y = 500 + item.dist * Math.sin(rad);
                    // 旋转角度：让椭圆长轴指向圆心 (angle + 90度)
                    rotation = item.angle + 90;
                }

                // 设置组的位置和旋转
                // transform-origin 设为自身中心，方便旋转
                g.setAttribute("transform", `translate(${x}, ${y}) rotate(${rotation})`);

                // 1. 绘制音区主体 (椭圆)
                // 注意：因为已经 translate 到了 x,y，所以这里的 cx, cy 都是 0
                const ellipse = document.createElementNS("http://www.w3.org/2000/svg", "ellipse");
                ellipse.setAttribute("cx", 0);
                ellipse.setAttribute("cy", 0);
                ellipse.setAttribute("rx", item.rx);
                ellipse.setAttribute("ry", item.ry);
                ellipse.setAttribute("class", "tone-field");
                g.appendChild(ellipse);

                // 2. 绘制中心凹陷 (Dimple)
                const dimple = document.createElementNS("http://www.w3.org/2000/svg", "ellipse");
                dimple.setAttribute("cx", 0);
                dimple.setAttribute("cy", 0);
                // 凹陷大概是主体的 40% 大小，如果是中心圆则大一点
                const scale = item.type === 'center' ? 0.5 : 0.4;
                dimple.setAttribute("rx", item.rx * scale); 
                dimple.setAttribute("ry", item.type === 'center' ? item.ry * scale : item.ry * 0.6); // 椭圆的凹陷稍微扁一点
                dimple.setAttribute("class", "dimple");
                g.appendChild(dimple);

                // 3. 绘制文字 (需要反向旋转以保持直立，或者跟随旋转)
                // 参考图中文字是跟随音符方向的 (底部朝向圆心)，所以直接写即可
                // 但为了阅读方便，我们把数字放上面，音名放中间
                
                const textNum = document.createElementNS("http://www.w3.org/2000/svg", "text");
                textNum.setAttribute("y", -item.ry * 0.5); // 稍微靠上
                textNum.setAttribute("class", "note-num");
                textNum.textContent = item.num;
                // 中心音的文字不需要旋转
                if(item.type !== 'center') textNum.setAttribute("transform", `rotate(-90)`); 
                else textNum.setAttribute("y", -40);
                g.appendChild(textNum);

                const textName = document.createElementNS("http://www.w3.org/2000/svg", "text");
                textName.setAttribute("y", item.type === 'center' ? 10 : 5);
                textName.setAttribute("class", "note-name");
                textName.textContent = item.note;
                // 让文字横过来读（参考图示，侧面的音符文字是横向排列的）
                if(item.type !== 'center') textName.setAttribute("transform", `rotate(-90)`); 
                g.appendChild(textName);

                // 绑定事件
                // 支持触摸和鼠标点击
                const handleTap = (e) => {
                    e.preventDefault(); // 防止双击缩放等
                    triggerNote(g, item.note);
                };
                
                g.addEventListener('touchstart', handleTap, {passive: false});
                g.addEventListener('mousedown', handleTap);

                svg.appendChild(g);
            });
        }

        // 触发音符效果
        function triggerNote(element, noteName) {
            // 1. 视觉效果：添加 class
            // 移除现有的动画以便重新触发
            element.classList.remove('active');
            // 强制重绘 (Reflow) 以便立即重新添加 class 产生动画
            void element.offsetWidth;
            element.classList.add('active');

            // 150ms 后自动移除发光状态
            setTimeout(() => {
                element.classList.remove('active');
            }, 200);

            // 2. 逻辑效果：这里可以连接 WebAudioContext
            console.log(`Play Sound: ${noteName}`);
            // playAudio(noteName); 
        }

        // 启动
        renderHandpan();

    </script>
</body>
</html>
