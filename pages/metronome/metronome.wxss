/* 背景图片装饰 */
.background-image {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 66.66%;
  height: auto;
  opacity: 0.3;
  z-index: -1;
  pointer-events: none;
}

.metronome-container {
  height: auto;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0rpx;
  background-color: #ffffffcf;
  position: relative;
  /* 使用全局自定义导航栏样式 */
  padding-top: 500rpx; /* 为自定义导航栏和悬浮谱面区域留出空间 */
  padding-bottom: 60rpx;
}

/* 谱面模式下增加顶部距离避免遮挡 */
.metronome-container.notation-mode-active {
  padding-top: 530rpx;
}

/* ========== 顶部悬浮谱面区域 ========== */
.floating-score-header {
  position: fixed;
  top: 158rpx; /* 导航栏下方 */
  left: 0;
  right: 0;
  z-index: 500;
  background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 100%);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 4rpx 20rpx rgba(49, 77, 99, 0.1);
  border-radius: 0 0 24rpx 24rpx;
}

/* 悬浮区域内的进度条样式 */
.floating-score-header .rhythm-progress-bar {
  margin: 0;
  border-radius: 0;
}

/* 悬浮区域内的谱面区域 */
.floating-score-header .rhythm-score-area {
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  min-height: auto;
  max-height: 340rpx;
  padding: 16rpx 24rpx;
}

/* 模块标题 */
.module-header {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  padding: 20rpx 32rpx;
  border-radius: 28rpx 28rpx 0 0;
  margin-bottom: 0;
  position: relative;
  overflow: hidden;
}

.module-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.module-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  position: relative;
  z-index: 1;
}

.module-title-center {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  position: relative;
  z-index: 1;
  text-align: center;
}

.module-subtitle {
  display: none;
}

/* 主内容区域 */
.main-content {
  background: white;
  border: none;
  border-radius: 0 0 28rpx 28rpx;
  padding: 32rpx 24rpx;
  position: relative;
  z-index: 1;
}

/* ========== 节拍器模块 ========== */
.metronome-module {
  margin-bottom: 40rpx;
  background: white;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(49, 77, 99, 0.15);
}

.simple-metronome {
  background: white;
  border-radius: 0;
  padding: 32rpx 24rpx;
  box-shadow: none;
}

.beat-display {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 10rpx;
  min-height: 120rpx;
}

.beat-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.15s;
}

.beat-dot.active {
  background: #314D63;
  transform: scale(1.5);
  box-shadow: 0 0 40rpx rgba(49, 77, 99, 0.5);
}

.beat-dot.strong {
  width: 56rpx;
  height: 56rpx;
}

/* 速度显示区域 */
.metronome-speed-display {
  display: flex;
  gap: 24rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 拍号选择按钮 + 播放按钮 横向排列 */
.metronome-bottom-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.time-sig-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  background: white;
  border: none;
  border-radius: 16rpx;
  color: #314D63;
  font-weight: 600;
  -webkit-tap-highlight-color: transparent;
}

.time-sig-trigger:active {
  background: #f0f4f7;
}

.time-sig-value {
  font-size: 42rpx;
}

.time-sig-arrow {
  width: 66rpx;
  height: 66rpx;
  opacity: 1;
}

/* 拍号选择弹窗 */
.time-sig-modal {
  max-width: 600rpx;
}

.time-sig-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.time-sig-option {
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  border: 3rpx solid #e0e0e0;
  background: #f8f9fa;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
  transition: all 0.2s;
  -webkit-tap-highlight-color: transparent;
}

.time-sig-option.active {
  background: #314D63;
  color: white;
  border-color: #314D63;
}

.time-sig-option:active {
  transform: scale(0.95);
}

/* 旧的拍号选择样式保留但隐藏 */
.time-signature-select {
  display: none;
}

.time-sig-btn {
  display: none;
}

.metronome-controls {
  display: none;
}

.metronome-speed {
  display: none;
}

.bpm-display {
  font-size: 56rpx;
  font-weight: bold;
  color: #314D63;
  min-width: 160rpx;
  text-align: center;
}

.metronome-play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.3);
  line-height: 1;
  text-align: center;
  padding: 0;
  border: none;
  -webkit-tap-highlight-color: transparent;
  outline: none;
}

.metronome-play-btn.playing {
  background: linear-gradient(135deg, #B34540 0%, #8D3A36 100%);
  box-shadow: 0 8rpx 24rpx rgba(179, 69, 64, 0.3);
}

/* ========== 节奏练习器模块 ========== */
.rhythm-module {
  margin-bottom: 60rpx;
}

/* 进度条 */
.progress-bar {
  height: 10rpx;
  background: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.progress-fill {
  height: 100%;
  background: #314D63;
  transition: width 0.1s linear;
}

/* 谱面显示区域 */
.score-area {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.1);
  min-height: 400rpx;
  position: relative;
}

.repeat-indicator {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #314D63;
  color: white;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 预热提示 */
.warmup-indicator {
  position: absolute;
  top: 0rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0rpx 16rpx;
  pointer-events: none;
  z-index: 10;
}

.warmup-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.warmup-beats {
  display: flex;
  gap: 14rpx;
}

.warmup-beat {
  font-size: 28rpx;
  color: #ccc;
  transition: all 0.15s;
}

.warmup-beat.active {
  color: #F4D096;
  transform: scale(1.2);
}

.score-content {
  display: grid;
  margin-top: 40rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  justify-items: center;
  align-items: start;
}

.rhythm-segment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  border: 3rpx solid transparent;
  transition: all 0.2s;
  width: 100%;
  box-sizing: border-box;
}

.rhythm-segment.playing {
  border-color: #314D63;
  background: #e8eef2;
  box-shadow: 0 0 30rpx rgba(49, 77, 99, 0.2);
}

.rhythm-segment.no-animation {
  border-color: transparent;
  background: #f8f9fa;
  box-shadow: none;
}

.segment-letter {
  font-size: 32rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 16rpx;
}

.segment-pattern {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

/* 谱面区域五音/拍样式 */
.segment-pattern .quintuplet-note-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.segment-pattern .quintuplet-note-wrapper .underline {
  position: absolute;
  bottom: -8rpx;
  left: -4rpx;
  width: calc(200% + 8rpx);
  height: 4rpx;
  background: #314D63;
  border-radius: 2rpx;
}

.segment-pattern .quintuplet-note-wrapper.linked {
  margin-right: 0;
}

.note {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #314D63;
  transition: all 0.15s;
}

.note.active {
  background: #F4D096;
  transform: scale(1.5);
  box-shadow: 0 0 30rpx rgba(244, 208, 150, 0.6);
}

.note.no-animation {
  background: #314D63;
  transform: scale(1);
  box-shadow: none;
}

.rest {
  width: 28rpx;
  height: 6rpx;
  background: #314D63;
  transition: all 0.15s;
}

.rest.active {
  background: #F4D096;
  box-shadow: 0 0 16rpx rgba(244, 208, 150, 0.6);
}

.rest.no-animation {
  background: #314D63;
  box-shadow: none;
}

.empty-score {
  text-align: center;
  color: #999;
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 112rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 控制面板 */
.control-panel {
  background: white;
  border-radius: 20rpx;
  padding: 50rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.1);
}

.play-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #314D63;
  color: white;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(49, 77, 99, 0.3);
  margin: 0 auto 40rpx;
  line-height: 1;
  text-align: center;
  padding: 0;
  border: none;
}

.play-button.playing {
  background-color: #e74c3c;
}

/* 速度控制 */
.speed-control {
  margin-bottom: 40rpx;
}

.speed-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.speed-buttons {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: nowrap;
}

.speed-btn {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  border: 3rpx solid #314D63;
  background: white;
  color: #314D63;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bpm-display-rhythm {
  font-size: 48rpx;
  font-weight: bold;
  color: #314D63;
  min-width: 140rpx;
  text-align: center;
}

.tap-tempo-btn {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 3rpx solid #314D63;
  background: white;
  color: #314D63;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
}

/* 功能开关 */
.switches {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: 2rpx solid #e0e0e0;
  min-height: 64rpx;
  box-sizing: border-box;
}

/* 缩小 switch 开关尺寸 */
.switch-item switch {
  transform: scale(0.7);
  transform-origin: right center;
}

.switch-label-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.help-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #314D63;
  color: white;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 编辑按钮 - 优化布局 */
.edit-buttons-row1,
.edit-buttons-row2,
.edit-buttons-row3 {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.edit-buttons-row3 {
  margin-bottom: 0;
}

.edit-btn {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.edit-btn.primary {
  background: #314D63;
  color: white;
}

.edit-btn.secondary {
  background: white;
  color: #314D63;
  border: 4rpx solid #314D63;
}

.edit-btn.random-active {
  background: #e74c3c;
  color: white;
  border: none;
}

/* 弹窗样式 */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 20000; /* 确保显示在编辑器之上 */
  padding: 40rpx;
  
}

.modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: white;
  border-radius: 30rpx;
  padding: 50rpx;
  max-width: 1200rpx;
  width: 100%;
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.3);
}

.save-modal-content {
  max-width: 800rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 4rpx solid #f0f0f0;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #314D63;
}

.modal-title-with-help {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.close-modal {
  font-size: 56rpx;
  color: #999;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

/* 弹窗底部按钮组 - 水平布局 */
.modal-buttons {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 30rpx;
  justify-content: center;
  padding: 0;
}

.modal-buttons .edit-btn {
  flex: 1;
  min-width: 160rpx;
  padding: 20rpx 40rpx;
}

/* 编辑器样式 */
.editor-section {
  margin-bottom: 30rpx;
}

.editor-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.editor-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rhythm-type-tabs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.rhythm-type-tab {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  border: 4rpx solid #314D63;
  background: white;
  color: #314D63;
  font-size: 22rpx;
}

.rhythm-type-tab.active {
  background: #314D63;
  color: white;
}

.letter-keyboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.letter-key {
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  border: 4rpx solid #314D63;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.letter-char {
  font-size: 36rpx;
  font-weight: bold;
  color: #314D63;
}

.letter-pattern {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.letter-pattern .note {
  width: 16rpx;
  height: 16rpx;
}

.letter-pattern .rest {
  width: 16rpx;
  height: 4rpx;
}

.editor-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}
.editor-actions .edit-btn.danger {
  background: #B34540;
  color: white;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(179, 69, 64, 0.25);
}

/* 手动编辑区域 */
.editor-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 15rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f0f4f7;
  border-radius: 12rpx;
  border-left: 6rpx solid #314D63;
}

/* 五音/拍提示 */
.quintuplet-hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffffff27, #ffffff);
  border-radius: 16rpx;

  margin-bottom: 20rpx;
}

.quintuplet-hint .hint-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.quintuplet-hint .hint-text {
  font-size: 28rpx;
  color: #000000;
  line-height: 1.5;
}

/* 五音/拍节奏显示样式 */
.quintuplet-pattern {
  display: flex;
  gap: 4rpx;
}

.quintuplet-note-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.quintuplet-note-wrapper .note,
.quintuplet-note-wrapper .rest {
  width: 16rpx;
  height: 16rpx;
}

.quintuplet-note-wrapper .note {
  border-radius: 50%;
  background: #314D63;
}

.quintuplet-note-wrapper .rest {
  height: 4rpx;
  background: #314D63;
  align-self: center;
  margin-top: 6rpx;
}

.quintuplet-note-wrapper .underline {
  position: absolute;
  bottom: -8rpx;
  left: -2rpx;
  width: calc(200% + 4rpx);
  height: 4rpx;
  background: #314D63;
  border-radius: 2rpx;
}

.quintuplet-note-wrapper.linked {
  margin-right: 0;
}

.manual-pattern {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
  min-height: 120rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  border: 4rpx dashed #ccc;
}

.empty-pattern {
  color: #999;
  text-align: center;
  width: 100%;
  padding: 20rpx;
  font-size: 26rpx;
}

.manual-segment {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: white;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
}

.manual-segment-letter {
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 12rpx;
}

.manual-segment-pattern {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.manual-note {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #314D63;
}

.manual-rest {
  width: 24rpx;
  height: 6rpx;
  background: #314D63;
  align-self: center;
}

.delete-segment-btn {
  font-size: 22rpx;
  color: white;
  background: #B34540;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
}

.delete-segment-icon {
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
}

.add-segment-btn {
  padding: 26rpx;
  border-radius: 20rpx;
  border: 4rpx solid #314D63;
  background: linear-gradient(135deg, #ffffff 0%, #f5f7fa 100%);
  color: #314D63;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(49, 77, 99, 0.12);
