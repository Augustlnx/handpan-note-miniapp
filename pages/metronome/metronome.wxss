  opacity: 0.7;
}

.notation-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

.notation-btn-text {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  color: #314D63;
}

/* 中间切换显示模式按钮 */
.e-pan-display-mode-btn {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: -120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: transparent;
  border-radius: 16rpx;
  z-index: 10;
  transition: all 0.2s;
}

.e-pan-display-mode-btn:active {
  transform: translateX(-50%) scale(0.95);
  opacity: 0.7;
}

.display-mode-icon {
  width: 48rpx;
  height: 48rpx;
}

.display-mode-text {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  color: #314D63;
}

/* 右上角节拍器按钮 - 无背景 */
.e-pan-metronome-btn-large {
  position: absolute;
  right: 5%;
  top: -120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  padding: 16rpx;
  background: transparent;
  border-radius: 50%;
  z-index: 10;
  transition: all 0.2s;
}

.e-pan-metronome-btn-large.active {
  background: transparent;
}

.e-pan-metronome-btn-large:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.metronome-btn-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 右上角加载音频按钮 - 非谱面模式 */
.e-pan-reload-audio-btn-large {
  position: absolute;
  right: 5%;
  top: -120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: transparent;
  border-radius: 16rpx;
  z-index: 10;
  transition: all 0.2s;
}

.e-pan-reload-audio-btn-large.loading {
  opacity: 0.5;
}

.e-pan-reload-audio-btn-large:active {
  transform: scale(0.95);
  opacity: 0.7;
}

.reload-audio-icon {
  width: 48rpx;
  height: 48rpx;
}

.reload-audio-icon.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.reload-audio-text {
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  color: #314D63;
}

/* 谱面Canvas区域 */
.notation-swiper {
  width: 100%;
  height: 340rpx;
}

.notation-canvas-area {
  background: white;
  border-radius: 0;
  box-shadow: none;
  min-height: 200rpx;
  height: 340rpx;
  padding: 16rpx 24rpx;
  overflow: hidden;
}

.notation-canvas {
  display: block;
  width: 100%;
}

/* 谱面分页提示 */
.notation-page-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 8rpx;
  gap: 8rpx;
}

.notation-page-hint .page-hint-text {
  font-size: 24rpx;
  color: #888;
}

.notation-page-hint .page-indicator {
  font-size: 22rpx;
  color: #314D63;
  font-weight: 600;
  background: rgba(49, 77, 99, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

/* 谱面模式下的节拍器控制条 - 在电子手碟上方 */
.notation-metronome-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  margin: 0 24rpx 4rpx;
  background: linear-gradient(135deg, rgba(49, 77, 99, 0.1) 0%, rgba(73, 106, 129, 0.1) 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(49, 77, 99, 0.2);
}

.notation-bar-beats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.notation-bar-beats .beat-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.15s;
}

.notation-bar-beats .beat-dot.active {
  background: #314D63;
  transform: scale(1.3);
  box-shadow: 0 0 20rpx rgba(49, 77, 99, 0.5);
}

.notation-bar-beats .beat-dot.strong {
  width: 42rpx;
  height: 42rpx;
}

.notation-bar-time-sig {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
}

.notation-bar-time-sig .time-sig-arrow {
  width: 28rpx;
  height: 28rpx;
}

.notation-bar-time-sig .time-sig-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #314D63;
}

.notation-bar-speed {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.speed-btn-mini {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #314D63;
  color: white;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 600;
}

.speed-btn-mini:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.speed-input-mini {
  width: 80rpx;
  height: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #314D63;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 8rpx;
  border: none;
}

/* 无谱面提示 */
.notation-empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  gap: 12rpx;
}

.notation-empty-hint .empty-icon {
  font-size: 48rpx;
}

.notation-empty-hint .empty-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 600;
}

.notation-empty-hint .empty-hint {
  font-size: 24rpx;
  color: #999;
}

/* 谱面模式控制区域 */
.notation-mode-controls {
  padding: 24rpx;
}

.notation-metronome {
  margin-bottom: 24rpx;
}

.notation-speed-control {
  margin-bottom: 24rpx;
}

.notation-play-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.notation-play-hint {
  font-size: 24rpx;
  color: #888;
}

/* ========== 开始演奏按钮区域 ========== */
.start-play-section {
  padding: 32rpx 24rpx 48rpx;
  margin-top: 16rpx;
}

.start-play-btn {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #FDEEC1 0%, #E6D5AC 50%, #D6BC9C 100%);
  border-radius: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(180, 150, 100, 0.35),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.4),
    inset 0 -2rpx 0 rgba(160, 130, 80, 0.3);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(200, 170, 120, 0.5);
}

.start-play-btn:active {
  transform: scale(0.98);
  box-shadow: 
    0 4rpx 16rpx rgba(180, 150, 100, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.start-play-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #403C36 0%, #131311 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 
    0 4rpx 12rpx rgba(49, 77, 99, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.15);
}

.start-play-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.start-play-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.start-play-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d3224;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.start-play-desc {
  font-size: 24rpx;
  color: #5a4a35;
}

.start-play-arrow {
  font-size: 48rpx;
  color: #8b7355;
  margin-left: 16rpx;
}