}

.help-tooltip-close {
  margin-top: 30rpx;
  padding: 20rpx 40rpx;
  background: #314D63;
  color: white;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 500;
}

/* ========== 节奏练习器 V2 - 标签页布局 ========== */

/* 模块容器 - 去掉边距和边框 */
.rhythm-module-v2 {
  margin-bottom: 0;
  background: transparent;
  border-radius: 0;
  overflow: visible;
  box-shadow: none;
}

/* 头部 - 隐藏 */
.rhythm-header {
  display: none;
}

.rhythm-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.rhythm-header::after {
  display: none;
}

.rhythm-header-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.rhythm-header-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  letter-spacing: 1rpx;
}

.rhythm-header-subtitle {
  display: none;
}

/* 进度条 */
.rhythm-progress-bar {
  height: 12rpx;
  background: #e0e0e0;
}

.rhythm-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #314D63, #496A81);
  transition: width 0.1s linear;
}

/* 谱面显示区域 - 固定1/3屏幕高度 */
.rhythm-score-area {
  background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
  padding: 20rpx 24rpx;
  height: 22vh;
  min-height: 200rpx;
  max-height: 28vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 24rpx;
  margin: 0 auto 0rpx auto;

  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.rhythm-score-area .score-content {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  justify-items: center;
  align-items: start;
  width: 100%;
}

.rhythm-score-area .rhythm-segment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 10rpx;
  border-radius: 14rpx;
  background: #f2f5f7ff;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  justify-content: center;
}

.rhythm-score-area .rhythm-segment.playing {
  border-color: #314D63;
  background: #e8eef2;
  box-shadow: 0 0 24rpx rgba(49, 77, 99, 0.2);
}

.rhythm-score-area .segment-letter {
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 12rpx;
}

.rhythm-score-area .segment-pattern {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.rhythm-score-area .note {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #314D63;
  transition: all 0.15s;
}

.rhythm-score-area .note.active {
  background: #F4D096;
  transform: scale(1.4);
  box-shadow: 0 0 24rpx rgba(244, 208, 150, 0.6);
}

.rhythm-score-area .rest {
  width: 24rpx;
  height: 5rpx;
  background: #314D63;
  transition: all 0.15s;
}

.rhythm-score-area .rest.active {
  background: #F4D096;
  box-shadow: 0 0 12rpx rgba(244, 208, 150, 0.6);
}

.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

/* 标签页导航 */
.rhythm-tabs {
  display: flex;
  background: #f8f9fa;
  border-bottom: 2rpx solid #e9ecef;
  border-top: 2rpx solid #e9ecef;
  
}

.rhythm-tab {
  flex: 1;
  padding: 24rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  border-bottom: 4rpx solid transparent;
}

.rhythm-tab .tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
  transition: all 0.3s ease;
}

.rhythm-tab.active {
  color: #314D63;
  background: white;
  border-bottom-color: #314D63;
}

.rhythm-tab.active .tab-icon {
  opacity: 1;
}

/* 标签页内容 */
.rhythm-tab-content {
  display: none;
  animation: fadeInUp 0.3s ease;
}

.rhythm-tab-content.active {
  display: block;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 播放标签页 */
.play-tab {
  padding: 24rpx;
}

/* 播放控制区域 */
.play-control-area {
  margin-bottom: 24rpx;
}

/* 播放按钮 + 开关网格布局 */
.play-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-template-rows: auto auto;
  gap: 16rpx;
  align-items: center;
  justify-items: center;
}

/* 播放按钮占据中间两行 */
.play-button-container {
  grid-column: 2;
  grid-row: 1 / 3;
  position: relative;
}

.play-button-wrapper {
  position: relative;
  display: inline-block;
}

.play-button-v2 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border: none;
  color: white;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(49, 77, 99, 0.35);
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
  outline: none;
}

.play-icon {
  width: 72rpx;
  height: 72rpx;
}

.play-button-v2::after {
  display: none;
}

.play-button-v2.playing {
  background: linear-gradient(135deg, #B34540 0%, #8D3A36 100%);
  box-shadow: 0 12rpx 40rpx rgba(179, 69, 64, 0.35);
}

.play-button-v2:active {
  transform: scale(0.95);
}

/* 开关按钮 V2 - 网格布局版本 */
.switch-btn-v2 {
  width: 100%;
  max-width: 200rpx;
  background: white;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  -webkit-tap-highlight-color: transparent;
}

.switch-btn-v2:active {
  border-color: #314D63;
  background: #f8f9fa;
}

.switch-btn-v2.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.switch-btn-label {
  font-size: 22rpx;
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

/* 开关网格定位 */
.play-grid .switch-btn-v2:nth-child(1) {
  grid-column: 1;
  grid-row: 1;
  justify-self: end;
}

.play-grid .switch-btn-v2:nth-child(3) {
  grid-column: 3;
  grid-row: 1;
  justify-self: start;
}

.play-grid .switch-btn-v2:nth-child(4) {
  grid-column: 1;
  grid-row: 2;
  justify-self: end;
}

.play-grid .switch-btn-v2:nth-child(5) {
  grid-column: 3;
  grid-row: 2;
  justify-self: start;
}

.switch-v2 {
  width: 72rpx;
  height: 40rpx;
  background: #ddd;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.3s ease;
}

.switch-v2.active {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
}

.switch-v2::after {
  content: '';
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  background: white;
  border-radius: 50%;
  top: 3rpx;
  left: 3rpx;
  transition: all 0.3s ease;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.2);
}

.switch-v2.active::after {
  left: 35rpx;
}

/* 速度控制组 V2 */
.control-group-v2 {
  background: transparent;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.control-group-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.control-group-title .title-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.speed-control-v2 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.speed-btn-v2 {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  padding: 0;
  border-radius: 16rpx;
  background: white;
  border: 3rpx solid #e9ecef;
  color: #314D63;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.speed-btn-v2:active {
  background: #314D63;
  color: white;
  border-color: #314D63;
  transform: scale(1.05);
}

.speed-display-v2 {
  font-size: 72rpx;
  font-weight: 800;
  color: #314D63;
  min-width: 180rpx;
  text-align: center;
  letter-spacing: -2rpx;
}

/* 速度输入框 */
.speed-input-v2 {
  font-size: 48rpx;
  font-weight: 800;
  color: #314D63;
  width: 140rpx;
  text-align: center;
  letter-spacing: -1rpx;
  background: transparent;
  border: none;
  border-bottom: 3rpx solid #e9ecef;
  padding: 6rpx 0;
  -webkit-tap-highlight-color: transparent;
}

.speed-input-v2:focus {
  border-bottom-color: #314D63;
}

.tap-tempo-btn-v2 {
  width: auto;
  max-width: 100%;
  align-self: center;
  background: white;
  border: 3rpx solid #314D63;
  color: #314D63;
  padding: 18rpx 28rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 12rpx rgba(49, 77, 99, 0.1);
  -webkit-tap-highlight-color: transparent;
}

.met-play-icon {
  width: 76rpx;
  height: 76rpx;
}

.tap-tempo-btn-v2:active {
  background: #314D63;
  color: white;
}

.tap-tempo-btn-v2 .tap-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 编辑标签页 */
.edit-tab {
  padding: 32rpx 24rpx;
}

.edit-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.edit-btn-v2 {
  padding: 28rpx 20rpx;
  background: white;
  border: 3rpx solid #e9ecef;
  border-radius: 20rpx;
  color: #314D63;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.edit-btn-v2:active {
  background: #314D63;
  color: white;
