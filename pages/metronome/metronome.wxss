}

.help-tooltip.active {
  display: block;
}

.help-tooltip-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 20rpx;
}

.help-tooltip-content {
  font-size: 28rpx;
