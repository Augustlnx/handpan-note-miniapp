}

.help-overlay.active {
  display: block;
}

.help-tooltip {
  display: none;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.3);
