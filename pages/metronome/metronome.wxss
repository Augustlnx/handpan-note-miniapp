/* ========== 全屏电子手碟编辑器样式 - iOS风格 ========== */
.he-fullscreen-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #f2f4f8 0%, #e8ecf2 100%);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.he-fullscreen-modal.active {
  opacity: 1;
  pointer-events: auto;
}

/* 全屏编辑画布区域 */
.he-canvas-area-fullscreen {
  flex: 1;
  padding: 60rpx 24rpx 24rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top, 0));
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.he-canvas-bg-fullscreen {
  width: 90vw;
  height: 90vw;
  max-width: 600rpx;
  max-height: 600rpx;
  position: relative;
  /* 俯视图顶光散射 - 从中心向外扩散，与生成手碟一致 */
  background: 
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.15) 0%, transparent 25%),
    radial-gradient(circle at 50% 50%, rgba(200, 230, 255, 0.2) 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, rgba(150, 190, 220, 0.15) 0%, transparent 55%),
    radial-gradient(circle at 50% 50%, #4a6a7e 0%, #3B576C 30%, #2a4055 65%, #1e3040 100%);
  border-radius: 50%;
  box-shadow: 
    0 8rpx 60rpx rgba(0,0,0,0.5),
    inset 0 -4rpx 30rpx rgba(0,0,0,0.3),
    inset 0 4rpx 30rpx rgba(255, 255, 255, 0.05);
}

/* 全屏编辑器音符节点 */
.he-note-node-fullscreen {
  position: absolute;
  transform-origin: center center;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  transition: border 0.2s, background 0.2s;
}

/* 外椭圆 - 与最终渲染一致 #3B576C + 黑色轮廓 */
.he-note-node-fullscreen::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #3B576C;
  border: 3rpx solid #1a2a35;
  box-sizing: border-box;
}

/* 内椭圆 - 与最终渲染一致，更深的蓝 + 内阴影 */
.he-note-node-fullscreen::after {
  content: '';
  position: absolute;
  width: 50%;
  height: 50%;
  border-radius: 50%;
  background: #1e3444;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

/* 中央Ding（id=0）的内椭圆 - 凸起效果 */
.he-note-node-fullscreen.ding::after {
  background: linear-gradient(145deg, #3a5a6e 0%, #1a2a35 100%);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.5),
    -2rpx -2rpx 6rpx rgba(80, 120, 150, 0.3),
    0 0 12rpx rgba(60, 100, 130, 0.2);
}

.he-note-node-fullscreen.selected::before {
  background: #4a6a80;
  border: 3rpx solid #DBCC97;
  box-shadow: 
    0 0 20rpx rgba(219, 204, 151, 0.5),
    0 0 40rpx rgba(219, 204, 151, 0.3);
}

.he-note-node-fullscreen.selected::after {
  background: #2a4a5a;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* 选中状态的Ding音凸起效果 */
.he-note-node-fullscreen.selected.ding::after {
  background: linear-gradient(145deg, #4a7a9e 0%, #2a4a5a 100%);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.4),
    -2rpx -2rpx 6rpx rgba(120, 180, 220, 0.4),
    0 0 20rpx rgba(90, 150, 200, 0.3);
}

.he-note-label-fullscreen {
  font-size: 26rpx;
  color: #fffaf0;
  font-weight: bold;
  pointer-events: none;
  z-index: 5;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}

