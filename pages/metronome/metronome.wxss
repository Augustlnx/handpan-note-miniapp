/* 背景图片装饰 */
.background-image {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 66.66%;
  height: auto;
  opacity: 0.3;
  z-index: -1;
  pointer-events: none;
}

.metronome-container {
  height: 100vh;
  box-sizing: border-box;
  padding: 0rpx;
  background-color: #ffffffcf;
  position: relative;
  overflow: hidden;
  /* 使用全局自定义导航栏样式 */
  padding-top: 168rpx; /* 为自定义导航栏留出空间 (88rpx + 40rpx) */
  padding-bottom: 350rpx; /* 适当减少空间，确保不溢出且不遮挡按钮 */
}

/* 模块标题 */
.module-header {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  padding: 20rpx 32rpx;
  border-radius: 28rpx 28rpx 0 0;
  margin-bottom: 0;
  position: relative;
  overflow: hidden;
}

.module-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.module-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  position: relative;
  z-index: 1;
}

.module-title-center {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  position: relative;
  z-index: 1;
  text-align: center;
}

.module-subtitle {
  display: none;
}

/* 主内容区域 */
.main-content {
  background: white;
  border: none;
  border-radius: 0 0 28rpx 28rpx;
  padding: 32rpx 24rpx;
  position: relative;
  z-index: 1;
}

/* ========== 节拍器模块 ========== */
.metronome-module {
  margin-bottom: 40rpx;
  background: white;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(49, 77, 99, 0.15);
}

.simple-metronome {
  background: white;
  border-radius: 0;
  padding: 32rpx 24rpx;
  box-shadow: none;
}

.beat-display {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 10rpx;
  min-height: 120rpx;
}

.beat-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.15s;
}

.beat-dot.active {
  background: #314D63;
  transform: scale(1.5);
  box-shadow: 0 0 40rpx rgba(49, 77, 99, 0.5);
}

.beat-dot.strong {
  width: 56rpx;
  height: 56rpx;
}

/* 速度显示区域 */
.metronome-speed-display {
  display: flex;
  gap: 24rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 拍号选择按钮 + 播放按钮 横向排列 */
.metronome-bottom-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.time-sig-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  background: white;
  border: none;
  border-radius: 16rpx;
  color: #314D63;
  font-weight: 600;
  -webkit-tap-highlight-color: transparent;
}

.time-sig-trigger:active {
  background: #f0f4f7;
}

.time-sig-value {
  font-size: 42rpx;
}

.time-sig-arrow {
  width: 66rpx;
  height: 66rpx;
  opacity: 1;
}

/* 拍号选择弹窗 */
.time-sig-modal {
  max-width: 600rpx;
}

.time-sig-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.time-sig-option {
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  border: 3rpx solid #e0e0e0;
  background: #f8f9fa;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
  transition: all 0.2s;
  -webkit-tap-highlight-color: transparent;
}

.time-sig-option.active {
  background: #314D63;
  color: white;
  border-color: #314D63;
}

.time-sig-option:active {
  transform: scale(0.95);
}

/* 旧的拍号选择样式保留但隐藏 */
.time-signature-select {
  display: none;
}

.time-sig-btn {
  display: none;
}

.metronome-controls {
  display: none;
}

.metronome-speed {
  display: none;
}

.bpm-display {
  font-size: 56rpx;
  font-weight: bold;
  color: #314D63;
  min-width: 160rpx;
  text-align: center;
}

.metronome-play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.3);
  line-height: 1;
  text-align: center;
  padding: 0;
  border: none;
  -webkit-tap-highlight-color: transparent;
  outline: none;
}

.metronome-play-btn.playing {
  background: linear-gradient(135deg, #B34540 0%, #8D3A36 100%);
  box-shadow: 0 8rpx 24rpx rgba(179, 69, 64, 0.3);
}

/* ========== 节奏练习器模块 ========== */
.rhythm-module {
  margin-bottom: 60rpx;
}

/* 进度条 */
.progress-bar {
  height: 10rpx;
  background: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.progress-fill {
  height: 100%;
  background: #314D63;
  transition: width 0.1s linear;
}

/* 谱面显示区域 */
.score-area {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.1);
  min-height: 400rpx;
  position: relative;
}

.repeat-indicator {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #314D63;
  color: white;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
}

/* 预热提示 */
.warmup-indicator {
  position: absolute;
  top: 0rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0rpx 16rpx;
  pointer-events: none;
  z-index: 10;
}

.warmup-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.warmup-beats {
  display: flex;
  gap: 14rpx;
}

.warmup-beat {
  font-size: 28rpx;
  color: #ccc;
  transition: all 0.15s;
}

.warmup-beat.active {
  color: #F4D096;
  transform: scale(1.2);
}

.score-content {
  display: grid;
  margin-top: 40rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  justify-items: center;
  align-items: start;
}

.rhythm-segment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  border: 3rpx solid transparent;
  transition: all 0.2s;
  width: 100%;
  box-sizing: border-box;
}

.rhythm-segment.playing {
  border-color: #314D63;
  background: #e8eef2;
  box-shadow: 0 0 30rpx rgba(49, 77, 99, 0.2);
}

.rhythm-segment.no-animation {
  border-color: transparent;
  background: #f8f9fa;
  box-shadow: none;
}

.segment-letter {
  font-size: 32rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 16rpx;
}

.segment-pattern {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

/* 谱面区域五音/拍样式 */
.segment-pattern .quintuplet-note-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.segment-pattern .quintuplet-note-wrapper .underline {
  position: absolute;
  bottom: -8rpx;
  left: -4rpx;
  width: calc(200% + 8rpx);
  height: 4rpx;
  background: #314D63;
  border-radius: 2rpx;
}

.segment-pattern .quintuplet-note-wrapper.linked {
  margin-right: 0;
}

.note {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #314D63;
  transition: all 0.15s;
}

.note.active {
  background: #F4D096;
  transform: scale(1.5);
  box-shadow: 0 0 30rpx rgba(244, 208, 150, 0.6);
}

.note.no-animation {
  background: #314D63;
  transform: scale(1);
  box-shadow: none;
}

.rest {
  width: 28rpx;
  height: 6rpx;
  background: #314D63;
  transition: all 0.15s;
}

.rest.active {
  background: #F4D096;
  box-shadow: 0 0 16rpx rgba(244, 208, 150, 0.6);
}

.rest.no-animation {
  background: #314D63;
  box-shadow: none;
}

.empty-score {
  text-align: center;
  color: #999;
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 112rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 控制面板 */
.control-panel {
  background: white;
  border-radius: 20rpx;
  padding: 50rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.1);
}

.play-button {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #314D63;
  color: white;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(49, 77, 99, 0.3);
  margin: 0 auto 40rpx;
  line-height: 1;
  text-align: center;
  padding: 0;
  border: none;
}

.play-button.playing {
  background-color: #e74c3c;
}

/* 速度控制 */
.speed-control {
  margin-bottom: 40rpx;
}

.speed-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.speed-buttons {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: nowrap;
}

.speed-btn {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  border: 3rpx solid #314D63;
  background: white;
  color: #314D63;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bpm-display-rhythm {
  font-size: 48rpx;
  font-weight: bold;
  color: #314D63;
  min-width: 140rpx;
  text-align: center;
}

.tap-tempo-btn {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 3rpx solid #314D63;
  background: white;
  color: #314D63;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
}

/* 功能开关 */
.switches {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: 2rpx solid #e0e0e0;
  min-height: 64rpx;
  box-sizing: border-box;
}

/* 缩小 switch 开关尺寸 */
.switch-item switch {
  transform: scale(0.7);
  transform-origin: right center;
}

.switch-label-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.help-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #314D63;
  color: white;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 编辑按钮 - 优化布局 */
.edit-buttons-row1,
.edit-buttons-row2,
.edit-buttons-row3 {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.edit-buttons-row3 {
  margin-bottom: 0;
}

.edit-btn {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}

.edit-btn.primary {
  background: #314D63;
  color: white;
}

.edit-btn.secondary {
  background: white;
  color: #314D63;
  border: 4rpx solid #314D63;
}

.edit-btn.random-active {
  background: #e74c3c;
  color: white;
  border: none;
}

/* 弹窗样式 */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  padding: 40rpx;
  
}

.modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: white;
  border-radius: 30rpx;
  padding: 50rpx;
  max-width: 1200rpx;
  width: 100%;
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.3);
}

.save-modal-content {
  max-width: 800rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 4rpx solid #f0f0f0;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #314D63;
}

.modal-title-with-help {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.close-modal {
  font-size: 56rpx;
  color: #999;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

/* 编辑器样式 */
.editor-section {
  margin-bottom: 30rpx;
}

.editor-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.editor-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rhythm-type-tabs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.rhythm-type-tab {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  border: 4rpx solid #314D63;
  background: white;
  color: #314D63;
  font-size: 22rpx;
}

.rhythm-type-tab.active {
  background: #314D63;
  color: white;
}

.letter-keyboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.letter-key {
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  border: 4rpx solid #314D63;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.letter-char {
  font-size: 36rpx;
  font-weight: bold;
  color: #314D63;
}

.letter-pattern {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.letter-pattern .note {
  width: 16rpx;
  height: 16rpx;
}

.letter-pattern .rest {
  width: 16rpx;
  height: 4rpx;
}

.editor-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}
.editor-actions .edit-btn.danger {
  background: #B34540;
  color: white;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(179, 69, 64, 0.25);
}

/* 手动编辑区域 */
.editor-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 15rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f0f4f7;
  border-radius: 12rpx;
  border-left: 6rpx solid #314D63;
}

/* 五音/拍提示 */
.quintuplet-hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffffff27, #ffffff);
  border-radius: 16rpx;

  margin-bottom: 20rpx;
}

.quintuplet-hint .hint-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.quintuplet-hint .hint-text {
  font-size: 28rpx;
  color: #000000;
  line-height: 1.5;
}

/* 五音/拍节奏显示样式 */
.quintuplet-pattern {
  display: flex;
  gap: 4rpx;
}

.quintuplet-note-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.quintuplet-note-wrapper .note,
.quintuplet-note-wrapper .rest {
  width: 16rpx;
  height: 16rpx;
}

.quintuplet-note-wrapper .note {
  border-radius: 50%;
  background: #314D63;
}

.quintuplet-note-wrapper .rest {
  height: 4rpx;
  background: #314D63;
  align-self: center;
  margin-top: 6rpx;
}

.quintuplet-note-wrapper .underline {
  position: absolute;
  bottom: -8rpx;
  left: -2rpx;
  width: calc(200% + 4rpx);
  height: 4rpx;
  background: #314D63;
  border-radius: 2rpx;
}

.quintuplet-note-wrapper.linked {
  margin-right: 0;
}

.manual-pattern {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
  min-height: 120rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  border: 4rpx dashed #ccc;
}

.empty-pattern {
  color: #999;
  text-align: center;
  width: 100%;
  padding: 20rpx;
  font-size: 26rpx;
}

.manual-segment {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: white;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
}

.manual-segment-letter {
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 12rpx;
}

.manual-segment-pattern {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.manual-note {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #314D63;
}

.manual-rest {
  width: 24rpx;
  height: 6rpx;
  background: #314D63;
  align-self: center;
}

.delete-segment-btn {
  font-size: 22rpx;
  color: white;
  background: #B34540;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
}

.delete-segment-icon {
  width: 30rpx;
  height: 30rpx;
  margin-top: 4rpx;
}

.add-segment-btn {
  padding: 26rpx;
  border-radius: 20rpx;
  border: 4rpx solid #314D63;
  background: linear-gradient(135deg, #ffffff 0%, #f5f7fa 100%);
  color: #314D63;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(49, 77, 99, 0.12);
  box-sizing: border-box;
}

.clear-manual-btn {
  padding: 26rpx;
  border-radius: 20rpx;
  border: none;
  background: #B34540;
  color: white;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(179, 69, 64, 0.25);
  box-sizing: border-box;
}
/* 编辑器底部操作按钮加强 */
.editor-actions .edit-btn {
  padding: 26rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(49, 77, 99, 0.12);
}

.editor-actions .edit-btn.secondary {
  background: white;
  color: #314D63;
  border: 4rpx solid #314D63;
}

.editor-actions .edit-btn.primary {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  border: none;
}

/* 节奏库样式 */
.library-items {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

/* 分类节奏库样式 */
.library-items-categorized {
  max-height: 800rpx;
  overflow-y: auto;
}

.library-category {
  margin-bottom: 24rpx;
}

.library-category:last-child {
  margin-bottom: 0;
}

.category-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.category-items {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.library-item {
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  border: 3rpx solid #e0e0e0;
  background: #f8f9fa;
  text-align: center;
  font-weight: bold;
  font-size: 28rpx;
  color: #314D63;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.library-item.selected {
  border-color: #F4D096;
  background: #fef9f0;
  color: #314D63;
  box-shadow: 0 0 20rpx rgba(244, 208, 150, 0.5);
}

/* 节奏图形显示 */
.library-item-pattern {
  display: flex;
  gap: 4rpx;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.library-item-pattern .pattern-group {
  display: flex;
  gap: 3rpx;
  align-items: center;
  margin-right: 6rpx;
}

.library-item-pattern .pattern-note {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #314D63;
}

.library-item-pattern .pattern-rest {
  width: 12rpx;
  height: 4rpx;
  background: #999;
}

/* 个人节奏库 */
.personal-library-list {
  max-height: 800rpx;
  overflow-y: auto;
}

.personal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid transparent;
}

.personal-item-info {
  flex: 1;
}

.personal-item-name {
  font-weight: bold;
  color: #314D63;
  margin-bottom: 8rpx;
  font-size: 30rpx;
}

.personal-item-pattern {
  font-size: 24rpx;
  color: #666;
}

.personal-item-delete {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #e74c3c;
  color: white;
  font-size: 24rpx;
}

.empty-library {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 随机练习配置 */
.random-hint {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  display: block;
}

.random-config {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 4rpx solid #e0e0e0;
}

.random-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.repeat-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  background: white;
}

.start-random-btn {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #314D63;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 30rpx;
  box-sizing: border-box;
}

/* 保存对话框 */
.save-dialog {
  padding: 30rpx;
  background: #f0f4f7;
  border-radius: 20rpx;
}

.save-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  margin-bottom: 20rpx;
  background: white;
  box-sizing: border-box;
}

.save-btn {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #314D63;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
}

/* 帮助提示弹窗 */
.help-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1999;
}

.help-overlay.active {
  display: block;
}

.help-tooltip {
  display: none;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.3);
  max-width: 800rpx;
  width: 90%;
  z-index: 2000;
}

.help-tooltip.active {
  display: block;
}

.help-tooltip-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 20rpx;
}

.help-tooltip-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
}

.help-tooltip-close {
  margin-top: 30rpx;
  padding: 20rpx 40rpx;
  background: #314D63;
  color: white;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 500;
}

/* ========== 节奏练习器 V2 - 标签页布局 ========== */

/* 模块容器 - 去掉边距和边框 */
.rhythm-module-v2 {
  margin-bottom: 0;
  background: transparent;
  border-radius: 0;
  overflow: visible;
  box-shadow: none;
}

/* 头部 - 隐藏 */
.rhythm-header {
  display: none;
}

.rhythm-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.rhythm-header::after {
  display: none;
}

.rhythm-header-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.rhythm-header-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 0;
  letter-spacing: 1rpx;
}

.rhythm-header-subtitle {
  display: none;
}

/* 进度条 */
.rhythm-progress-bar {
  height: 12rpx;
  background: #e0e0e0;
}

.rhythm-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #314D63, #496A81);
  transition: width 0.1s linear;
}

/* 谱面显示区域 - 固定1/3屏幕高度 */
.rhythm-score-area {
  background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
  padding: 20rpx 24rpx;
  height: 22vh;
  min-height: 200rpx;
  max-height: 28vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 24rpx;
  margin: 0 auto 0rpx auto;

  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.rhythm-score-area .score-content {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  justify-items: center;
  align-items: start;
  width: 100%;
}

.rhythm-score-area .rhythm-segment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 10rpx;
  border-radius: 14rpx;
  background: #f2f5f7ff;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  justify-content: center;
}

.rhythm-score-area .rhythm-segment.playing {
  border-color: #314D63;
  background: #e8eef2;
  box-shadow: 0 0 24rpx rgba(49, 77, 99, 0.2);
}

.rhythm-score-area .segment-letter {
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 12rpx;
}

.rhythm-score-area .segment-pattern {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.rhythm-score-area .note {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #314D63;
  transition: all 0.15s;
}

.rhythm-score-area .note.active {
  background: #F4D096;
  transform: scale(1.4);
  box-shadow: 0 0 24rpx rgba(244, 208, 150, 0.6);
}

.rhythm-score-area .rest {
  width: 24rpx;
  height: 5rpx;
  background: #314D63;
  transition: all 0.15s;
}

.rhythm-score-area .rest.active {
  background: #F4D096;
  box-shadow: 0 0 12rpx rgba(244, 208, 150, 0.6);
}

.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

/* 标签页导航 */
.rhythm-tabs {
  display: flex;
  background: #f8f9fa;
  border-bottom: 2rpx solid #e9ecef;
  border-top: 2rpx solid #e9ecef;
  
}

.rhythm-tab {
  flex: 1;
  padding: 24rpx 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  border-bottom: 4rpx solid transparent;
}

.rhythm-tab .tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
  transition: all 0.3s ease;
}

.rhythm-tab.active {
  color: #314D63;
  background: white;
  border-bottom-color: #314D63;
}

.rhythm-tab.active .tab-icon {
  opacity: 1;
}

/* 标签页内容 */
.rhythm-tab-content {
  display: none;
  animation: fadeInUp 0.3s ease;
}

.rhythm-tab-content.active {
  display: block;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 播放标签页 */
.play-tab {
  padding: 24rpx;
}

/* 播放控制区域 */
.play-control-area {
  margin-bottom: 24rpx;
}

/* 播放按钮 + 开关网格布局 */
.play-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-template-rows: auto auto;
  gap: 16rpx;
  align-items: center;
  justify-items: center;
}

/* 播放按钮占据中间两行 */
.play-button-container {
  grid-column: 2;
  grid-row: 1 / 3;
  position: relative;
}

.play-button-wrapper {
  position: relative;
  display: inline-block;
}

.play-button-v2 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border: none;
  color: white;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(49, 77, 99, 0.35);
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
  outline: none;
}

.play-icon {
  width: 72rpx;
  height: 72rpx;
}

.play-button-v2::after {
  display: none;
}

.play-button-v2.playing {
  background: linear-gradient(135deg, #B34540 0%, #8D3A36 100%);
  box-shadow: 0 12rpx 40rpx rgba(179, 69, 64, 0.35);
}

.play-button-v2:active {
  transform: scale(0.95);
}

/* 开关按钮 V2 - 网格布局版本 */
.switch-btn-v2 {
  width: 100%;
  max-width: 200rpx;
  background: white;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  -webkit-tap-highlight-color: transparent;
}

.switch-btn-v2:active {
  border-color: #314D63;
  background: #f8f9fa;
}

.switch-btn-v2.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.switch-btn-label {
  font-size: 22rpx;
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

/* 开关网格定位 */
.play-grid .switch-btn-v2:nth-child(1) {
  grid-column: 1;
  grid-row: 1;
  justify-self: end;
}

.play-grid .switch-btn-v2:nth-child(3) {
  grid-column: 3;
  grid-row: 1;
  justify-self: start;
}

.play-grid .switch-btn-v2:nth-child(4) {
  grid-column: 1;
  grid-row: 2;
  justify-self: end;
}

.play-grid .switch-btn-v2:nth-child(5) {
  grid-column: 3;
  grid-row: 2;
  justify-self: start;
}

.switch-v2 {
  width: 72rpx;
  height: 40rpx;
  background: #ddd;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.3s ease;
}

.switch-v2.active {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
}

.switch-v2::after {
  content: '';
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  background: white;
  border-radius: 50%;
  top: 3rpx;
  left: 3rpx;
  transition: all 0.3s ease;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.2);
}

.switch-v2.active::after {
  left: 35rpx;
}

/* 速度控制组 V2 */
.control-group-v2 {
  background: transparent;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.control-group-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.control-group-title .title-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.7;
}

.speed-control-v2 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.speed-btn-v2 {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: white;
  border: 3rpx solid #e9ecef;
  color: #314D63;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.speed-btn-v2:active {
  background: #314D63;
  color: white;
  border-color: #314D63;
  transform: scale(1.05);
}

.speed-display-v2 {
  font-size: 72rpx;
  font-weight: 800;
  color: #314D63;
  min-width: 180rpx;
  text-align: center;
  letter-spacing: -2rpx;
}

/* 速度输入框 */
.speed-input-v2 {
  font-size: 48rpx;
  font-weight: 800;
  color: #314D63;
  width: 140rpx;
  text-align: center;
  letter-spacing: -1rpx;
  background: transparent;
  border: none;
  border-bottom: 3rpx solid #e9ecef;
  padding: 6rpx 0;
  -webkit-tap-highlight-color: transparent;
}

.speed-input-v2:focus {
  border-bottom-color: #314D63;
}

.tap-tempo-btn-v2 {
  width: auto;
  max-width: 100%;
  align-self: center;
  background: white;
  border: 3rpx solid #314D63;
  color: #314D63;
  padding: 18rpx 28rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 12rpx rgba(49, 77, 99, 0.1);
  -webkit-tap-highlight-color: transparent;
}

.met-play-icon {
  width: 76rpx;
  height: 76rpx;
}

.tap-tempo-btn-v2:active {
  background: #314D63;
  color: white;
}

.tap-tempo-btn-v2 .tap-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 编辑标签页 */
.edit-tab {
  padding: 32rpx 24rpx;
}

.edit-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.edit-btn-v2 {
  padding: 28rpx 20rpx;
  background: white;
  border: 3rpx solid #e9ecef;
  border-radius: 20rpx;
  color: #314D63;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.edit-btn-v2:active {
  background: #314D63;
  color: white;
  border-color: #314D63;
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.25);
}

.edit-btn-v2 .edit-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

.edit-btn-v2.primary {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(49, 77, 99, 0.3);
}

/* 空规则已移除：.edit-btn-v2.primary .edit-btn-icon */

.edit-btn-v2.full-width {
  grid-column: 1 / -1;
  padding: 32rpx;
}

/* 库标签页 */
.library-tab {
  padding: 32rpx 24rpx;
}

.library-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.library-btn-v2 {
  padding: 28rpx 24rpx;
  background: white;
  border: 3rpx solid #e9ecef;
  border-radius: 20rpx;
  color: #314D63;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.library-btn-v2:active {
  background: #f8f9fa;
  border-color: #314D63;
  transform: translateX(8rpx);
}

.library-btn-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.library-btn-icon {
  width: 40rpx;
  height: 40rpx;
}

.library-btn-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
  transition: all 0.3s ease;
}

.library-btn-v2:active .library-btn-arrow {
  opacity: 1;
  transform: translateX(4rpx);
}

.random-btn-v2 {
  padding: 32rpx;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border: none;
  border-radius: 20rpx;
  color: white;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 32rpx rgba(49, 77, 99, 0.35);
  transition: all 0.3s ease;
  margin-top: 8rpx;
}

.random-btn-v2.active {
  background: linear-gradient(135deg, #B34540 0%, #8D3A36 100%);
  box-shadow: 0 8rpx 32rpx rgba(179, 69, 64, 0.35);
}

.random-btn-v2:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(49, 77, 99, 0.45);
}

.random-btn-v2 .random-icon {
  width: 36rpx;
  height: 36rpx;

}

.help-icon.light {
  background: rgba(255, 255, 255, 0.3);
  color: white;
}

/* ========== 节拍器模式显示（合并到谱面区域） ========== */
.metronome-mode-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 10rpx 0;
}

.metronome-mode-display .beat-display {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 24rpx;
  min-height: 100rpx;
}

.metronome-mode-display .beat-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.15s;
}

.metronome-mode-display .beat-dot.active {
  background: #314D63;
  transform: scale(1.5);
  box-shadow: 0 0 40rpx rgba(49, 77, 99, 0.5);
}

.metronome-mode-display .beat-dot.strong {
  width: 56rpx;
  height: 56rpx;
}

/* 空状态提示（内联版本） */
.empty-score-inline {
  text-align: center;
  color: #999;
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-score-inline .empty-text {
  font-size: 28rpx;
  margin-bottom: 12rpx;
  color: #666;
}

.empty-score-inline .empty-hint {
  font-size: 24rpx;
  color: #999;
}

.metronome-mode-display .time-sig-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 6rpx 24rpx;
  background: white;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  color: #314D63;
  font-weight: 600;
  margin-top: 0rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.metronome-mode-display .time-sig-trigger:active {
  background: #f0f4f7;
}

.metronome-mode-display .time-sig-value {
  font-size: 36rpx;
}

.metronome-mode-display .time-sig-arrow {
  width: 48rpx;
  height: 48rpx;
  opacity: 1;
}

/* ========== 底部Pan图片区域 ========== */
.pan-container {
  position: fixed;
  bottom: 0rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0 40rpx 0;
  width: 100%;
  z-index: 100;
  pointer-events: none;
}

.pan-image {
  width: 300rpx;
  height: 300rpx;
  max-width: 400rpx;
  max-height: 400rpx;
  opacity: 0.9;
  transition: all 0.15s;
  border-radius: 50%;
  pointer-events: auto;
}

.pan-image:active {
  opacity: 1;
  transform: scale(0.95);
  box-shadow: 0 0 30rpx rgba(49, 77, 99, 0.3);
}