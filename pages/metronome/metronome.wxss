}

.repeat-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  background: white;
}

.start-random-btn {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #314D63;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 30rpx;
