  padding: 32rpx 24rpx;
}

.library-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.library-btn-v2 {
  padding: 28rpx 24rpx;
  background: white;
  border: 3rpx solid #e9ecef;
  border-radius: 20rpx;
  color: #314D63;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
