}

/* 保存对话框 */
.save-dialog {
  padding: 30rpx;
  background: #f0f4f7;
  border-radius: 20rpx;
}

.save-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  margin-bottom: 20rpx;
  background: white;
  box-sizing: border-box;
}

.save-btn {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #314D63;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
