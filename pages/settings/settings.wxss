.settings-container {
  min-height: 100vh;
  padding: 100rpx 40rpx;
  background-color: #fffffff1;
  position: relative;
  overflow: hidden;
  /* 使用全局自定义导航栏样式 */
  padding-top: 168rpx; /* 为自定义导航栏留出空间 (88rpx + 40rpx) */
}

/* 背景图片装饰 */
.background-image {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 66.66%;
  height: auto;
  opacity: 0.3;
  z-index: 0;
  pointer-events: none;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

/* 设置项 */
.setting-item {
  margin-bottom: 50rpx;
  padding-bottom: 40rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 30rpx;
}

.about-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 30rpx;
}

/* 颜色设置 */
.color-setting {
  margin-bottom: 30rpx;
}

.color-label {
  display: block;
  font-size: 28rpx;
  color: #8FB9AB;
  margin-bottom: 15rpx;
}

.color-picker-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.color-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  border: 3rpx solid #E0E0E0;
}

.color-input {
  flex: 1;
  height: 80rpx;
  background-color: #F8F8F8;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #314D63;
}

/* 预设主题 */
.preset-themes {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.preset-theme-item {
  background-color: #F8F8F8;
  border-radius: 12rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preset-name {
  font-size: 28rpx;
  color: #314D63;
  font-weight: 500;
}

.preset-colors {
  display: flex;
  gap: 10rpx;
}

.preset-color {
  width: 50rpx;
  height: 50rpx;
  border-radius: 8rpx;
  border: 2rpx solid #E0E0E0;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.action-buttons button {
  flex: 1;
}

/* 关于区域 */
.about-section {
  margin-top: 30rpx;
  text-align: center;
}

.about-text {
  display: block;
  font-size: 35rpx;
  color: #DBCC97;
  margin-top: 15rpx;
  font-family: 'Tangerine', sans-serif;
  font-weight: bold;
}

.about-links {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 30rpx;
}

.about-logo {
  width: 400rpx;
  height: 400rpx;
  margin: 30rpx auto 0; /* 上30rpx，左右自动（水平居中），下0 */
  display: block;
}

.about-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx;
  transition: opacity 0.2s;
}

.about-link:active {
  opacity: 0.7;
}

.about-icon {
  width: 68rpx;
  height: 68rpx;
}

.about-link text {
  font-size: 24rpx;
  color: #314D63;
}

/* 透明度设置 */
.opacity-setting {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.opacity-value {
  font-size: 28rpx;
  color: #314D63;
  font-weight: bold;
  min-width: 60rpx;
  text-align: right;
}

.opacity-slider {
  flex: 1;
  max-width: 500rpx;
}

/* 模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: white;
  border-radius: 16rpx;
  width: 85%;
  max-width: 650rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.manual-modal {
  max-height: 75vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #314D63;
}

.modal-close {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.modal-close:active {
  opacity: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx 10rpx;
}

/* 用户手册内容 */
.manual-content {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.manual-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 8rpx;
}

.section-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.highlight {
  color: #8FB9AB;
  font-weight: 600;
}

/* 更新日志样式 */
.changelog-item {
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.changelog-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.version-tag {
  display: inline-block;
  background-color: #8FB9AB;
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.version-tag.future {
  background-color: #F4D096;
}

.version-date {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.changelog-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.change-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #314D63;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.change-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  padding-left: 10rpx;
}
.article-text {
  font-size: 24rpx;
  color: #000000ff;
  line-height: 1.6;
  padding-left: 10rpx;
}
