/* ========== 容器与背景 ========== */
.settings-container {
  min-height: 100vh;
  padding: 40rpx 0rpx;
  background: linear-gradient(180deg, #f8fafb 0%, #ffffff 100%);
  position: relative;
  overflow: hidden;
  padding-top: 90rpx;
}

/* 顶部渐变背景层 */
.top-gradient-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 980rpx;
  background-color: #314D63;
  background-image: 
      radial-gradient(circle at 90% 10%, rgba(238, 219, 178, 0.3) 0%, transparent 45%),
      radial-gradient(circle at 10% 90%, rgba(0, 0, 0, 0.45) 0%, transparent 55%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
  z-index: 0;
}

.top-gradient-bg::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 180rpx;
  background: linear-gradient(to bottom, transparent, #f8fafb);
}

.background-image {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 60%;
  height: auto;
  opacity: 0.15;
  z-index: 0;
  pointer-events: none;
}

/* ========== 用户信息区域 ========== */
.user-profile-section {
  display: flex;
  width:90%;
  margin: 0 auto;
  align-items: center;
  padding: 40rpx 20rpx 48rpx;
  position: relative;
  z-index: 1;
}

.user-avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.3);
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.user-avatar-default {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #5d7d8f 0%, #4a6b7c 50%, #3a5a6c 100%);
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  position: relative;
  z-index: 1;
}

.user-nickname-row {
  display: flex;
  align-items: center;
}

.user-nickname {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.user-arrow {
  font-size: 50rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 16rpx;
  font-weight: 300;
}

.user-hint {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}

/* ========== VIP卡片 ========== */
.vip-card-wrapper {
  width:90%;
  margin: 0 auto 32rpx;
  position: relative;
  z-index: 2;
  border-radius: 24rpx;
  box-shadow: 
    12rpx 16rpx 24rpx rgba(0, 0, 0, 0.18), 
    0 4rpx 6rpx rgba(238, 219, 178, 0.1),
    0 0 15rpx rgba(243, 231, 200, 0.4),
    0 0 30rpx rgba(217, 196, 148, 0.2);
  overflow: visible; /* 改为 visible 以允许 Pro 标签微出位 */
  animation: cardFloat 6s ease-in-out infinite;
}

@keyframes cardFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.vip-card-image {
  width: 100%;
  display: block;
  border-radius: 24rpx;
}

.pro-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;

  /* 
     修改点 1：背景渐变 
     原图是柔和的沙色/香槟金，不是高亮黄。
     提取色值：#F3E7C8 (浅) -> #E0CC9E (深)
  */
  background: linear-gradient(135deg, #F3E7C8 0%, #E6D5AC 50%, #D9C494 100%);

  /* 
     修改点 2：文字颜色
     警告：在这个浅金色背景上，白色文字完全不可读！
     必须改成原图同款的“深褐灰色”才能显出高级感。
  */
  color: #203240; 

  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  letter-spacing: 1rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(74, 64, 54, 0.15);
  
  animation: glowPulse 4s infinite ease-in-out;
  z-index: 3;
}

@keyframes glowPulse {
  0% {
    /* 呼吸感调整：主要改变光泽度，而不是大小 */
    box-shadow: 0 4rpx 12rpx rgba(74, 64, 54, 0.15);
    filter: brightness(1);
  }
  50% {
    /* 稍微亮一点，阴影稍微扩散一点，模拟微光 */
    box-shadow: 0 6rpx 16rpx rgba(74, 64, 54, 0.25);
    filter: brightness(1.05); /* 整体微微提亮 */
  }
  100% {
    box-shadow: 0 4rpx 12rpx rgba(74, 64, 54, 0.15);
    filter: brightness(1);
  }
}

.test-period {
  position: absolute;
  top: 70rpx;
  right: 48rpx;
  color: #ffffff;
  font-size: 13rpx;
  font-weight: 400;
  opacity: 0.8;
  z-index: 3;
}


.vip-card-placeholder {
  width: 100%;
  height: 200rpx;
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.vip-placeholder-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 通用卡片 ========== */
.card {
  background: #ffffff;
  border-radius: 50rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.settings-card {
  padding: 32rpx 28rpx;
}

.about-card {
  text-align: center;
  padding: 32rpx 28rpx 40rpx;
}

.section-header {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #314D63;
  margin-bottom: 12rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f2f5;
}

/* ========== 设置项 ========== */
.setting-item-new {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.setting-item-new:last-of-type {
  border-bottom: none;
}

.opacity-item {
  flex-direction: column;
  align-items: stretch;
}

.setting-label {
  font-size: 28rpx;
  color: #314D63;
  font-weight: 500;
  flex-shrink: 0;
}

.color-picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.color-preview-new {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e8eaed;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
}

.color-input-new {
  width: 160rpx;
  height: 56rpx;
  background: #f8f9fa;
  border: 1rpx solid #e8eaed;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #314D63;
  text-align: center;
}

.opacity-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  gap: 20rpx;
}

.opacity-slider-new {
  flex: 1;
}

.opacity-value-new {
  font-size: 28rpx;
  color: #314D63;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

/* ========== 操作按钮 ========== */
.action-buttons-new {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f2f5;
}

.btn-save,
.btn-reset {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 18rpx;
  border: none;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 0;
  margin: 0;
  letter-spacing: 2rpx;
}

.btn-save {
  background: linear-gradient(135deg, #8FB9AB 0%, #7aa99b 50%, #6a9a8b 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(143, 185, 171, 0.4);
}

.btn-save:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(143, 185, 171, 0.3);
}

.btn-reset {
  background: linear-gradient(135deg, #f8f9fa 0%, #f0f1f3 100%);
  color: #555;
  border: 1rpx solid #e8eaed;
}

.btn-reset:active {
  background: linear-gradient(135deg, #f0f1f3 0%, #e8e9eb 100%);
  transform: scale(0.97);
}

/* ========== 关于区域 ========== */
.app-version {
  display: block;
  font-size: 30rpx;
  color: #DBCC97;
  font-family: 'Tangerine', sans-serif;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.about-links-new {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.about-link-new {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.about-link-new:active {
  background: #f5f6f8;
  transform: scale(0.96);
}

.about-icon-new {
  width: 56rpx;
  height: 56rpx;
}

.about-link-new text {
  font-size: 24rpx;
  color: #314D63;
  font-weight: 500;
}

.about-logo-new {
  width: 320rpx;
  height: 320rpx;
  margin: 20rpx auto 0;
  display: block;
  opacity: 0.9;
}

/* ========== 模态框样式 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: white;
  border-radius: 24rpx;
  width: 88%;
  max-width: 680rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.manual-modal {
  max-height: 75vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #314D63;
}

.modal-close {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.5;
  transition: opacity 0.2s;
}

.modal-close:active {
  opacity: 1;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 28rpx;
}

/* ========== 用户手册内容 ========== */
.manual-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.manual-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 8rpx;
}

.section-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.highlight {
  color: #8FB9AB;
  font-weight: 600;
}

/* ========== 更新日志样式 ========== */
.changelog-item {
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.changelog-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.version-tag {
  display: inline-block;
  background: linear-gradient(135deg, #8FB9AB 0%, #7aa99b 100%);
  color: white;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.version-tag.future {
  background: linear-gradient(135deg, #F4D096 0%, #e8c080 100%);
}

.version-date {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.changelog-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.change-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #314D63;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.change-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  padding-left: 12rpx;
}

.article-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  padding-left: 12rpx;
  margin-top: 12rpx;
  font-style: italic;
}

/* ========== 头像昵称编辑弹窗 ========== */
.profile-modal {
  max-height: 70vh;
}

.profile-edit-content {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.avatar-edit-section,
.nickname-edit-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.edit-label {
  font-size: 28rpx;
  color: #314D63;
  font-weight: 600;
}

.edit-hint {
  font-size: 22rpx;
  color: #999;
}

/* 头像选择按钮 */
.avatar-choose-btn {
  width: 180rpx;
  height: 180rpx;
  min-width: 180rpx;
  max-width: 180rpx;
  min-height: 180rpx;
  max-height: 180rpx;
  padding: 0 !important;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  border: 4rpx dashed #d0d0d0;
  display: block;
  position: relative;
  flex-shrink: 0;
  line-height: 1;
}

.avatar-choose-btn::after {
  border: none;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
  top: 0;
  left: 0;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #f5f7f9 0%, #e8ecef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0;
  left: 0;
}

.avatar-placeholder-text {
  font-size: 80rpx;
  color: #8FB9AB;
  font-weight: 300;
}

/* 昵称输入框 */
.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #f5f7f9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.nickname-input:focus {
  border-color: #8FB9AB;
  background: #fff;
}

/* 操作按钮 */
.profile-edit-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.profile-edit-buttons .btn-cancel,
.profile-edit-buttons .btn-confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.profile-edit-buttons .btn-cancel {
  background: #f0f2f5;
  color: #666;
}

.profile-edit-buttons .btn-confirm {
  background: linear-gradient(135deg, #8FB9AB 0%, #7aa99b 100%);
  color: white;
}

.profile-edit-buttons .btn-cancel::after,
.profile-edit-buttons .btn-confirm::after {
  border: none;
}

.profile-edit-buttons .btn-cancel:active {
  background: #e5e7ea;
}

.profile-edit-buttons .btn-confirm:active {
  background: linear-gradient(135deg, #7aa99b 0%, #6a9a8b 100%);
}
