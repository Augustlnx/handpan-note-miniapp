/* 曲库页面样式 - 优化版 */
/* 主题色: #314D63 */

.library-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
  /* 使用全局自定义导航栏样式 */
  padding-top: 168rpx; /* 为自定义导航栏留出空间 (88rpx + 40rpx) */
}

/* ========== 顶部标签方框 ========== */
.tab-header {
  display: flex;
  gap: 35rpx;
  padding: 18rpx 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #e0e0e0;
}

.tab-box {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-box.active {
  background-color: #314D63;
  border-color: #314D63;
  color: #fff;
  font-weight: bold;
}

/* ========== 内容区域 ========== */
.library-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* ========== 最近打开（在顶部） ========== */
.recent-section {
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1px solid #e0e0e0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.recent-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 0;
}

.recent-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.recent-icon {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  margin: 0 auto 10rpx;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 20rpx;
  color: #fff;
  font-size: 56rpx;
}

.recent-icon-img {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
}

.recent-name {
  display: block;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 工具栏 ========== */
.toolbar {
  background-color: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1px solid #e0e0e0;
}

.breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.breadcrumb-item {
  color: #314D63;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breadcrumb-separator {
  margin: 0 10rpx;
  color: #999;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #e0e0e0;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  border: 2rpx solid #e0e0e0;
  font-size: 28rpx;
}

.search-cancel {
  margin-left: 20rpx;
  color: #314D63;
  font-size: 28rpx;
}

/* ========== 排序菜单 ========== */
.sort-menu {
  background-color: #fff;
  border-bottom: 1px solid #e0e0e0;
}

.sort-item {
  padding: 30rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1px solid #f0f0f0;
}

.sort-item.active {
  color: #314D63;
  font-weight: bold;
}

/* ========== 文件列表 ========== */
.file-list {
  flex: 1;
  height: 0; /* 配合flex:1使用，使scroll-view能够正确计算高度 */
  background-color: #fff;
  padding-bottom: 120rpx; /* 为批量操作栏预留空间 */
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid #f0f0f0;
  position: relative;
}

.item-checkbox {
  margin-right: 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ccc;
  border-radius: 50%;
  position: relative;
}

.checkbox.checked {
  background-color: #314D63;
  border-color: #314D63;
}

.checkbox.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}
/* emoji图标占位 - 后续替换为图片 */
.item-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 16rpx;
  color: #fff;
}
.item-icon-img,
.file-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.item-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-star {
  margin-left: 20rpx;
}

.star-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.item-actions {
  margin-left: 20rpx;
  padding: 10rpx;
}

.more-icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 60rpx;
  color: #999;
}

.empty-icon {
  width: 600rpx;
  height: 600rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
}

/* ========== 右下角悬浮按钮 ========== */
.fab-container {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  z-index: 100;
}

.fab-button {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.4);
  transition: all 0.3s;
}

.fab-button-icon {
  width: 50%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 64rpx;
  line-height: 1;
}

.fab-button.active {
  transform: rotate(45deg);
}

/* 悬浮菜单 */
.fab-menu {
  position: absolute;
  bottom: 140rpx;
  right: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fab-menu-item {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
}

.fab-menu-label {
  padding: 16rpx 32rpx;
  background-color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  white-space: nowrap;
}

.fab-menu-icon { display: none; }

.fab-menu-icon-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.15);
  padding: 16rpx;
}

/* ========== 批量操作栏 ========== */
.batch-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background-color: #fff;
  border-top: 1px solid #e0e0e0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.selected-count {
  font-size: 28rpx;
  color: #333;
}

.batch-actions {
  display: flex;
  gap: 20rpx;
}

.batch-btn-one {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 32rpx;
  background-color: #B34540;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.batch-btn-two {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 32rpx;
  background-color: #314D63;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.batch-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ========== 公开曲库开发中 ========== */
.public-library {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev-notice {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding: 200rpx 60rpx;
}

.dev-icon {
  width: 360rpx;
  height: 360rpx;
  opacity: 0.6;
}

.dev-text {
  font-size: 32rpx;
  color: #666;
}

.dev-subtitle {
  font-size: 28rpx;
  color: #999;
}

/* ========== 弹窗遮罩 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

/* ========== 操作菜单 ========== */
.action-menu {
  width: 100%;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 40rpx;
  gap: 30rpx;
}

.menu-icon { display: none; }

.menu-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

/* ========== 输入弹窗 ========== */
.input-modal {
  width: 640rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.modal-input {
  width: calc(100% - 15rpx);
  height: 88rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
  font-size: 30rpx;
  margin-bottom: 48rpx;
  box-sizing: border-box;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-btn {
  background-color: #f0f0f0;
  color: #666;
}

.confirm-btn {
  background-color: #314D63;
  color: #fff;
}

/* ========== 文件夹选择器 ========== */
.folder-picker {
  width: 600rpx;
  max-height: 800rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
}

.folder-list {
  flex: 1;
  max-height: 600rpx;
  margin-bottom: 30rpx;
}

.folder-option {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}

.folder-icon { display: none; }

.folder-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.folder-name {
  font-size: 28rpx;
  color: #333;
}

/* ========== 导入弹窗样式 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.import-modal {
  width: 640rpx;
  max-height: 85vh;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
}

.import-description {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
  text-align: center;
}

.save-path-bar {
  padding: 20rpx 0 12rpx 0;
}

.save-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 26rpx;
}

.save-breadcrumb-item {
  color: #314D63;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 4rpx 0;
}

.save-breadcrumb-separator {
  margin: 0 10rpx;
  color: #999;
}

.save-action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 0 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 20rpx;
}

.save-back-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  transition: all 0.2s;
}

.save-back-btn:active {
  background-color: #e0e0e0;
}

.save-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.save-folder-list {
  max-height: 500rpx;
  margin-bottom: 30rpx;
  background-color: #fff;
}

.save-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f5f5f5;
  transition: background-color 0.2s;
}

.save-folder-item:active {
  background-color: #f8f8f8;
}

.save-file-item {
  opacity: 0.6;
  pointer-events: none;
}

.save-item-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.save-file-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 14rpx;
  color: #fff;
}

.save-item-info {
  flex: 1;
  min-width: 0;
}

.save-item-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.save-item-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.save-empty-text {
  font-size: 26rpx;
  text-align: center;
}

.modal-header-with-help {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}

.modal-header-with-help .modal-title {
  flex: 1;
  text-align: center;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
  color: #666;
  padding: 0;
}

.btn-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #314D63;
  color: #fff;
  padding: 0;
}

/* ========== 新建文件弹窗样式 ========== */
.new-file-modal {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.new-file-scroll {
  flex: 1;
  max-height: calc(85vh - 180rpx);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: calc(100% - 48rpx);
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.form-col {
  flex: 1;
}

.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: calc(100% - 48rpx);
  height: 160rpx;
  padding: 20rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 难度星星选择 */
.difficulty-stars-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.difficulty-star-item {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  transition: all 0.2s;
}

.difficulty-star-item.active {
  background-color: #fff3e0;
}

.star-icon-small {
  width: 32rpx;
  height: 32rpx;
}

.star-icon-small.star-inactive {
  opacity: 0.3;
  filter: grayscale(100%);
}
