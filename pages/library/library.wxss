/* 曲库页面样式 - 优化版 */
/* 主题色: #314D63 */

.library-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
  /* 使用全局自定义导航栏样式 */
  padding-top: 168rpx; /* 为自定义导航栏留出空间 (88rpx + 40rpx) */
}

/* ========== 顶部标签方框 ========== */
.tab-header {
  display: flex;
  gap: 35rpx;
  padding: 18rpx 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #e0e0e0;
}

.tab-box {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-box.active {
  background-color: #314D63;
  border-color: #314D63;
  color: #fff;
  font-weight: bold;
}

/* ========== 内容区域 ========== */
.library-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

/* ========== 最近打开（在顶部） ========== */
.recent-section {
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1px solid #e0e0e0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.recent-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 0;
}

.recent-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.recent-icon {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  margin: 0 auto 10rpx;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 20rpx;
  color: #fff;
  font-size: 56rpx;
}

.recent-icon-img {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
}

.recent-name {
  display: block;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 工具栏 ========== */
.toolbar {
  background-color: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1px solid #e0e0e0;
}

.breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.breadcrumb-item {
  color: #314D63;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breadcrumb-separator {
  margin: 0 10rpx;
  color: #999;
}

.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1px solid #e0e0e0;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 30rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  border: 2rpx solid #e0e0e0;
  font-size: 28rpx;
}

.search-cancel {
  margin-left: 20rpx;
  color: #314D63;
  font-size: 28rpx;
}

/* ========== 排序菜单 ========== */
.sort-menu {
  background-color: #fff;
  border-bottom: 1px solid #e0e0e0;
}

.sort-item {
  padding: 30rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1px solid #f0f0f0;
}

.sort-item.active {
  color: #314D63;
  font-weight: bold;
}

/* ========== 文件列表 ========== */
.file-list {
  flex: 1;
  height: 0; /* 配合flex:1使用，使scroll-view能够正确计算高度 */
  background-color: #fff;
  padding-bottom: 120rpx; /* 为批量操作栏预留空间 */
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid #f0f0f0;
  position: relative;
}

.item-checkbox {
  margin-right: 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ccc;
  border-radius: 50%;
  position: relative;
}

.checkbox.checked {
  background-color: #314D63;
  border-color: #314D63;
}

.checkbox.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}
/* emoji图标占位 - 后续替换为图片 */
.item-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 16rpx;
  color: #fff;
}
.item-icon-img,
.file-icon-img {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.item-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-star {
  margin-left: 20rpx;
}

.star-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.item-actions {
  margin-left: 20rpx;
  padding: 10rpx;
}

.more-icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 60rpx;
  color: #999;
}

.empty-icon {
  width: 600rpx;
  height: 600rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  text-align: center;
}

/* ========== 右下角悬浮按钮 ========== */
.fab-container {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  z-index: 100;
}

.fab-button {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.4);
  transition: all 0.3s;
}

.fab-button-icon {
  width: 50%;
  height: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 64rpx;
  line-height: 1;
}

.fab-button.active {
  transform: rotate(45deg);
}

/* 悬浮菜单 */
.fab-menu {
  position: absolute;
  bottom: 140rpx;
  right: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fab-menu-item {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
}

.fab-menu-label {
  padding: 16rpx 32rpx;
  background-color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  white-space: nowrap;
}

.fab-menu-icon { display: none; }

.fab-menu-icon-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.15);
  padding: 16rpx;
}

/* ========== 批量操作栏 ========== */
.batch-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background-color: #fff;
  border-top: 1px solid #e0e0e0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.selected-count {
  font-size: 28rpx;
  color: #333;
}

.batch-actions {
  display: flex;
  gap: 20rpx;
}

.batch-btn-one {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 32rpx;
  background-color: #B34540;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.batch-btn-two {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 32rpx;
  background-color: #314D63;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.batch-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ========== 公开曲库开发中 ========== */
.public-library {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev-notice {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding: 200rpx 60rpx;
}

.dev-icon {
  width: 360rpx;
  height: 360rpx;
  opacity: 0.6;
}

.dev-text {
  font-size: 32rpx;
  color: #666;
}

.dev-subtitle {
  font-size: 28rpx;
  color: #999;
}

/* ========== 弹窗遮罩 - 高级样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4rpx);
}

/* ========== 操作菜单 - 高级样式 ========== */
.action-menu {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 0 48rpx;
  animation: slideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 44rpx;
  gap: 32rpx;
  transition: background 0.2s ease;
}

.menu-item:active {
  background: #f5f5f5;
}

.menu-icon { display: none; }

.menu-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.menu-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* ========== 输入弹窗 - 高级样式 ========== */
.input-modal {
  width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25), 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  animation: modalFadeIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: translate(-50%, -45%) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

/* 弹窗标题 - 高级样式 */
.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #314D63;
  margin-bottom: 36rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

/* 弹窗输入框 - 高级样式 */
.modal-input {
  width: calc(100% - 15rpx);
  height: 92rpx;
  padding: 0 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 40rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.modal-input:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

.modal-input::placeholder {
  color: #bbb;
}

/* 弹窗按钮区 - 高级样式 */
.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.2s ease;
}

.cancel-btn {
  background: #f0f0f0;
  color: #666;
}

.cancel-btn:active {
  background: #e0e0e0;
}

.confirm-btn {
  background: linear-gradient(135deg, #314D63 0%, #456275 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.3);
}

.confirm-btn:active {
  background: linear-gradient(135deg, #28404f 0%, #3a5363 100%);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.3);
}


/* ========== 文件夹选择器 - 高级样式 ========== */
.folder-picker {
  width: 600rpx;
  max-height: 800rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: modalFadeIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.folder-list {
  flex: 1;
  max-height: 600rpx;
  margin-bottom: 30rpx;
}

.folder-option {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  gap: 20rpx;
  border-bottom: 1px solid #f0f0f0;
  transition: background 0.2s ease;
}

.folder-option:active {
  background: #f5f5f5;
}

.folder-icon { display: none; }

.folder-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.folder-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* ========== 导入弹窗样式 - 高级设计 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(4rpx);
}

.import-modal {
  width: 640rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: modalFadeIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.import-description {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.save-path-bar {
  padding: 20rpx 0 12rpx 0;
}

.save-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 26rpx;
}

.save-breadcrumb-item {
  color: #314D63;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 4rpx 0;
}

.save-breadcrumb-separator {
  margin: 0 10rpx;
  color: #999;
}

.save-action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 0 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 20rpx;
}

.save-back-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  transition: all 0.2s;
}

.save-back-btn:active {
  background-color: #e0e0e0;
}

.save-back-icon {
  width: 40rpx;
  height: 40rpx;
}

.save-folder-list {
  max-height: 500rpx;
  margin-bottom: 30rpx;
  background-color: #fff;
}

.save-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f5f5f5;
  transition: background-color 0.2s;
}

.save-folder-item:active {
  background-color: #f8f8f8;
}

.save-file-item {
  opacity: 0.6;
  pointer-events: none;
}

.save-item-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.save-file-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #5a7a92 100%);
  border-radius: 14rpx;
  color: #fff;
}

.save-item-info {
  flex: 1;
  min-width: 0;
}

.save-item-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.save-item-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.save-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.save-empty-text {
  font-size: 26rpx;
  text-align: center;
}

.modal-header-with-help {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  margin-bottom: 24rpx;
}

.modal-header-with-help .modal-title {
  flex: 1;
  text-align: center;
  margin-bottom: 0;
}

/* 通用次级按钮 - 高级样式 */
.btn-secondary {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  color: #666;
  padding: 0;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #e0e0e0;
}

/* 通用主按钮 - 高级样式 */
.btn-primary {
  flex: 1;
  height: 92rpx;
  border-radius: 22rpx;
  font-size: 32rpx;
  border: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #456275 100%);
  color: #fff;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.3);
  transition: all 0.2s ease;
}

.btn-primary:active {
  background: linear-gradient(135deg, #28404f 0%, #3a5363 100%);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.3);
}

/* ========== 新建文件弹窗样式 - 高级设计 ========== */
.new-file-modal {
  width: 88%;
  max-width: 640rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  margin-top: 60rpx;
}

.new-file-scroll {
  flex: 1;
  max-height: calc(80vh - 180rpx);
  padding-right: 10rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.form-input {
  width: calc(100% - 48rpx);
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 14rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-col {
  flex: 1;
}

/* iOS风格选择器触发按钮 */
.picker-value {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafb 100%);
  border-radius: 14rpx;
  border: 2rpx solid rgba(143, 185, 171, 0.3);
  font-size: 26rpx;
  color: #314D63;
  font-weight: 500;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value:active {
  background: linear-gradient(135deg, #f0f2f5 0%, #e8eaed 100%);
  transform: scale(0.98);
}

.picker-arrow {
  font-size: 20rpx;
  color: #314D63;
  margin-left: 8rpx;
  transition: transform 0.2s ease;
}

.picker-value:active .picker-arrow {
  transform: rotate(180deg);
}

/* iOS风格选择器弹窗 */
.ios-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10001;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.ios-picker-container {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  animation: slideUpPicker 0.3s ease-out;
}

@keyframes slideUpPicker {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.ios-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: linear-gradient(180deg, #f8f9fa 0%, #fff 100%);
}

.ios-picker-cancel {
  font-size: 30rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.ios-picker-cancel:active {
  color: #666;
}

.ios-picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
}

.ios-picker-confirm {
  font-size: 30rpx;
  color: #314D63;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.ios-picker-confirm:active {
  color: #456275;
}

.ios-picker-view {
  width: 100%;
  height: 440rpx;
  background: linear-gradient(180deg, 
    rgba(248, 249, 250, 0.8) 0%, 
    rgba(255, 255, 255, 0) 30%, 
    rgba(255, 255, 255, 0) 70%, 
    rgba(248, 249, 250, 0.8) 100%
  );
}

.ios-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: 34rpx;
  color: #314D63;
  font-weight: 500;
}

/* 选中项指示器 */
.ios-picker-view::before {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 88rpx;
  background: rgba(49, 77, 99, 0.06);
  border-radius: 16rpx;
  border: 2rpx solid rgba(143, 185, 171, 0.3);
  pointer-events: none;
}

.form-textarea {
  width: calc(100% - 48rpx);
  height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 14rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.form-textarea:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

/* 难度星星选择 - 高级样式 */
.difficulty-stars-row {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.difficulty-star-item {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
  transition: all 0.2s ease;
}

.difficulty-star-item.active {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 193, 7, 0.3);
}

.difficulty-star-item:active {
  transform: scale(1.1);
}

.star-icon-small {
  width: 36rpx;
  height: 36rpx;
}

.star-icon-small.star-inactive {
  opacity: 0.3;
  filter: grayscale(100%);
}

/* ========== 导入JSON入口按钮 ========== */
.import-json-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  margin-right: 39rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(49, 77, 99, 0.9);
  transition: all 0.25s ease;
}

.import-json-entry:active {
  background: linear-gradient(135deg, #e0efff 0%, #d8eaee 100%);
  transform: scale(0.98);
  border-color: rgba(49, 77, 99, 0.5);
}

.import-json-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #4a6b82 100%);
  border-radius: 14rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.25);
}

.import-json-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(100);
}

.import-json-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.import-json-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #314D63;
}

.import-json-desc {
  font-size: 22rpx;
  color: #7a8a9a;
}

.import-json-arrow {
  font-size: 36rpx;
  color: #8FB9AB;
  font-weight: 300;
}

/* 分隔线 */
.form-divider-line {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 10rpx;
}

.form-divider-line::before,
.form-divider-line::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e0e0e0, transparent);
}

.divider-text {
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #999;
}

/* ========== 导入JSON弹窗样式 ========== */
.import-json-modal {
  width: 90%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.import-json-header {
  padding: 40rpx 36rpx 30rpx;
  background: linear-gradient(180deg, #f8fafb 0%, #fff 100%);
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.import-json-header-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #4a6b82 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(49, 77, 99, 0.25);
}

.import-json-header-icon image {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(100);
}

.import-json-modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #314D63;
  margin-bottom: 8rpx;
}

.import-json-modal-desc {
  display: block;
  font-size: 24rpx;
  color: #8a9aa8;
  line-height: 1.5;
}

.import-json-content {
  padding: 28rpx 32rpx;
}

.import-json-textarea {
  width: calc(100% - 40rpx);
  min-height: 200rpx;
  max-height: 320rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 24rpx;
  font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
  color: #333;
  line-height: 1.6;
  transition: all 0.2s ease;
}

.import-json-textarea:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

.import-json-error {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffebee 100%);
  border-radius: 12rpx;
  border: 1rpx solid rgba(244, 67, 54, 0.2);
}

.import-json-error .error-icon {
  width: 28rpx;
  height: 28rpx;
  filter: hue-rotate(320deg) saturate(2);
  flex-shrink: 0;
  margin-top: 2rpx;
}

.import-json-error text {
  font-size: 24rpx;
  color: #d32f2f;
  line-height: 1.5;
}

.import-json-preview {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #f0fff4 0%, #e8f5e9 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(76, 175, 80, 0.2);
}

.preview-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(76, 175, 80, 0.15);
}

.preview-check {
  width: 32rpx;
  height: 32rpx;
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2e7d32;
}

.preview-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.preview-row {
  display: flex;
  align-items: center;
}

.preview-label {
  width: 100rpx;
  font-size: 24rpx;
  color: #666;
}

.preview-value {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.import-json-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #fff 0%, #f8f9fa 100%);
}

.import-json-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.import-json-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.import-json-btn.cancel:active {
  background: #e8e8e8;
}

.import-json-btn.confirm {
  background: linear-gradient(135deg, #314D63 0%, #4a6b82 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(49, 77, 99, 0.3);
}

.import-json-btn.confirm:active {
  background: linear-gradient(135deg, #243a4d 0%, #314D63 100%);
  transform: scale(0.98);
}

.import-json-btn.confirm.disabled {
  background: #ccc;
  color: #999;
  box-shadow: none;
}

.import-json-btn.confirm.disabled:active {
  transform: none;
}

/* ========== 公开曲库入口样式 ========== */
.public-library-entry {
  padding: 32rpx;
}

.entry-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  height: 200rpx;
  box-shadow: 0 8rpx 32rpx rgba(49, 77, 99, 0.2);
}

.entry-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.entry-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 40rpx;
  height: 100%;
  box-sizing: border-box;
}

.entry-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.entry-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.entry-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.entry-arrow {
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

/* 特色介绍网格 */
.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  margin-top: 40rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.feature-icon text {
  font-size: 36rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.entry-hint {
  text-align: center;
  margin-top: 40rpx;
  padding: 20rpx;
}

.entry-hint text {
  font-size: 24rpx;
  color: #999;
}
