/* 手碟设置页面样式 - 复用metronome电子手碟编辑器风格 */
.setup-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f2f4f8 0%, #e8ecf2 100%);
  display: flex;
  flex-direction: column;
}


/* 导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 158rpx;
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  display: flex;
  align-items: flex-end;
  padding-bottom: 20rpx;
  z-index: 1000;
}

.nav-bar-left {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 0rpx;
  box-sizing: border-box;
}

.nav-bar-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-right: 16rpx;
}

.nav-back-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(10);
}

.nav-bar-content {
  flex: 1;
  text-align: center;
}

.nav-bar-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
}

/* 顶部悬浮控制按钮 */
.setup-floating-controls {
  position: absolute;
  top: 230rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
  pointer-events: none;
  z-index: 100;
}

.floating-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
  min-width: 100rpx;
}

.floating-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.2));
}

.floating-text {
  font-size: 22rpx;
  color: #314D63;
  font-weight: 500;
}

/* 主内容 - 编辑器风格布局 */
.main-content {
  flex: 1;
  padding-top: 158rpx; /* 调整顶部间距以留出导航栏空间 */
  padding-bottom: 380rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* 手碟画布区域 - 复用编辑器风格 */
.handpan-canvas-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  min-height: 0;
}

.handpan-canvas-bg {
  width: 100%;
  max-width: 750rpx;
  aspect-ratio: 1;
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(49, 77, 99, 0.08),
    0 2rpx 8rpx rgba(49, 77, 99, 0.04);
  overflow: hidden;
}

/* 参考线（装饰性） */
.guide-line-v,
.guide-line-h {
  position: absolute;
  background: rgba(49, 77, 99, 0.06);
  pointer-events: none;
  z-index: 0;
}

.guide-line-v {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1rpx;
  transform: translateX(-50%);
}

.guide-line-h {
  top: 50%;
  left: 0;
  right: 0;
  height: 1rpx;
  transform: translateY(-50%);
}

.handpan-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  max-width: 640rpx;
  aspect-ratio: 1;
  z-index: 1;
}

/* 手碟主体 - 复用metronome的e-pan-page-large风格 */
.handpan-bg {
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(ellipse 60% 60% at 40% 35%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse 40% 40% at 60% 65%, rgba(255, 255, 255, 0.04) 0%, transparent 40%),
    radial-gradient(circle at center, #3d5d73 0%, #314D63 30%, #263d4f 60%, #1a2d3a 100%);
  border-radius: 50%;
  position: relative;
  border: 2rpx solid #000000;
  box-shadow: 
    0 8rpx 60rpx rgba(0,0,0,0.35),
    0 2rpx 20rpx rgba(0,0,0,0.25),
    inset 0 -4rpx 30rpx rgba(0,0,0,0.3),
    inset 0 4rpx 30rpx rgba(255, 255, 255, 0.05);
}

/* 手碟音符 - 复用metronome的e-pan-note-large风格 */
.handpan-note {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.1s ease-out;
  -webkit-tap-highlight-color: transparent;
}

.handpan-note:active,
.handpan-note.active {
  transform: rotate(var(--rotate, 0deg)) scale(0.95);
}

.note-inner {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 外椭圆 - #3B576C + 黑色轮廓 */
.note-outer {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #3B576C;
  border: 3rpx solid #1a2a35;
  box-sizing: border-box;
}

/* 内椭圆 - 深蓝 + 内阴影 */
.note-inner-ring {
  position: absolute;
  width: 50%;
  height: 50%;
  border-radius: 50%;
  background: #1e3444;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

/* 中央Ding凸起效果 */
.note-inner-ring.ding-convex {
  background: linear-gradient(145deg, #3a5a6e 0%, #1a2a35 100%);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.5),
    -2rpx -2rpx 6rpx rgba(80, 120, 150, 0.3),
    0 0 12rpx rgba(60, 100, 130, 0.2);
}

.note-display {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.note-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #fffaf0;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.6);
}

.handpan-note.ding .note-name {
  font-size: 36rpx;
  color: #fffaf0;
}

/* 激活状态 - 发光效果 */
.handpan-note.active .note-outer {
  background: #5a7a8f;
  box-shadow: 
    0 0 30rpx rgba(90, 140, 180, 0.6),
    0 0 60rpx rgba(90, 140, 180, 0.3);
}

.handpan-note.active .note-inner-ring {
  background: #2a4a5a;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.handpan-note.active .note-inner-ring.ding-convex {
  background: linear-gradient(145deg, #4a7a9e 0%, #2a4a5a 100%);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.4),
    -2rpx -2rpx 6rpx rgba(120, 180, 220, 0.4),
    0 0 20rpx rgba(90, 150, 200, 0.3);
}

.handpan-note.active .note-name {
  color: #ffffff;
}

/* 底部属性面板（iOS风格） - 复用编辑器风格 */
.props-panel-ios {
  position: fixed;
  bottom: 160rpx;
  left: 0;
  right: 0;
  padding: 0 24rpx 24rpx;
  z-index: 100;
}

.props-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 
    0 -4rpx 24rpx rgba(49, 77, 99, 0.08),
    0 2rpx 12rpx rgba(49, 77, 99, 0.04);
}

.props-section {
  margin-bottom: 20rpx;
}

.props-section:last-child {
  margin-bottom: 0;
}

.props-section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.props-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #314D63;
}

.props-section-hint {
  font-size: 22rpx;
  color: #8a9cad;
}

.resident-buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.resident-btn {
  width: 100rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #3B576C 0%, #314D63 100%);
  border: 2rpx solid #1a2a35;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.resident-btn:active,
.resident-btn.active {
  background: linear-gradient(135deg, #5a7a8f 0%, #4a6a80 100%);
  border-color: #DBCC97;
  transform: scale(0.95);
  box-shadow: 0 0 20rpx rgba(219, 204, 151, 0.4);
}

.btn-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #fffaf0;
}

/* 映射验证 */
.validation-section {
  margin-top: 4rpx;
}

.validation-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(49, 77, 99, 0.06);
}

.validation-card.valid {
  background: rgba(76, 175, 80, 0.1);
  border: 1rpx solid rgba(76, 175, 80, 0.25);
}

.validation-card.invalid {
  background: rgba(244, 67, 54, 0.08);
  border: 1rpx solid rgba(244, 67, 54, 0.2);
}

.validation-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.validation-card.valid .validation-icon {
  background: rgba(76, 175, 80, 0.2);
  color: #4CAF50;
}

.validation-card.invalid .validation-icon {
  background: rgba(244, 67, 54, 0.15);
  color: #F44336;
}

.validation-info {
  flex: 1;
}

.validation-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #314D63;
  margin-bottom: 4rpx;
}

.validation-desc {
  display: block;
  font-size: 22rpx;
  color: #8a9cad;
  line-height: 1.4;
}

/* 底部操作栏（iOS风格） - 复用编辑器风格 */
.footer-ios {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid rgba(49, 77, 99, 0.08);
  box-shadow: 0 -4rpx 20rpx rgba(49, 77, 99, 0.04);
  z-index: 200;
}

.btn-ios-footer {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-ios-footer.secondary {
  background: #f5f7fa;
  color: #314D63;
}

.btn-ios-footer.primary {
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.2);
}

.btn-ios-footer.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.btn-ios-footer:active {
  transform: scale(0.98);
  opacity: 0.9;
}


@keyframes spin {
  to { transform: rotate(360deg); }
}

.btn-ios-footer .loading-content text {
  font-size: 28rpx;
  color: #ffffff;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.button-editor-modal {
  width: 80%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(49, 77, 99, 0.1);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #314D63;
}

.modal-content {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #8a9cad;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border: 1rpx solid rgba(49, 77, 99, 0.15);
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #314D63;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid rgba(49, 77, 99, 0.1);
}

.modal-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  color: #8a9cad;
  border-right: 1rpx solid rgba(49, 77, 99, 0.1);
}

.modal-btn.confirm {
  color: #314D63;
}

/* ========== 电子手碟编辑器弹窗 ========== */
.he-fullscreen-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #f2f4f8 0%, #e8ecf2 100%);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.he-fullscreen-modal.active {
  opacity: 1;
  pointer-events: auto;
}

/* 全屏编辑画布区域 */
.he-canvas-area-fullscreen {
  flex: 1;
  padding: 60rpx 24rpx 24rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top, 0));
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.he-canvas-bg-fullscreen {
  width: 90vw;
  height: 90vw;
  max-width: 600rpx;
  max-height: 600rpx;
  position: relative;
  background: 
    radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.15) 0%, transparent 25%),
    radial-gradient(circle at 50% 50%, rgba(200, 230, 255, 0.2) 0%, transparent 40%),
    radial-gradient(circle at 50% 50%, rgba(150, 190, 220, 0.15) 0%, transparent 55%),
    radial-gradient(circle at 50% 50%, #4a6a7e 0%, #3B576C 30%, #2a4055 65%, #1e3040 100%);
  border-radius: 50%;
  box-shadow: 
    0 8rpx 60rpx rgba(0,0,0,0.5),
    inset 0 -4rpx 30rpx rgba(0,0,0,0.3),
    inset 0 4rpx 30rpx rgba(255, 255, 255, 0.05);
}

/* 参考线 */
.he-guide-v,
.he-guide-h {
  position: absolute;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
  z-index: 0;
}

.he-guide-v {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1rpx;
  transform: translateX(-50%);
}

.he-guide-h {
  top: 50%;
  left: 0;
  right: 0;
  height: 1rpx;
  transform: translateY(-50%);
}

/* 全屏编辑器音符节点 */
.he-note-node-fullscreen {
  position: absolute;
  transform-origin: center center;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  transition: border 0.2s, background 0.2s;
}

.he-note-node-fullscreen::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #3B576C;
  border: 3rpx solid #1a2a35;
  box-sizing: border-box;
}

.he-note-node-fullscreen::after {
  content: '';
  position: absolute;
  width: 50%;
  height: 50%;
  border-radius: 50%;
  background: #1e3444;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

.he-note-node-fullscreen.ding::after {
  background: linear-gradient(145deg, #3a5a6e 0%, #1a2a35 100%);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.5),
    -2rpx -2rpx 6rpx rgba(80, 120, 150, 0.3),
    0 0 12rpx rgba(60, 100, 130, 0.2);
}

.he-note-node-fullscreen.selected::before {
  background: #4a6a80;
  border: 3rpx solid #DBCC97;
  box-shadow: 
    0 0 20rpx rgba(219, 204, 151, 0.5),
    0 0 40rpx rgba(219, 204, 151, 0.3);
}

.he-note-node-fullscreen.selected::after {
  background: #2a4a5a;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.he-note-node-fullscreen.selected.ding::after {
  background: linear-gradient(145deg, #4a7a9e 0%, #2a4a5a 100%);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.4),
    -2rpx -2rpx 6rpx rgba(120, 180, 220, 0.4),
    0 0 20rpx rgba(90, 150, 200, 0.3);
}

.he-note-label-fullscreen {
  font-size: 26rpx;
  color: #fffaf0;
  font-weight: bold;
  pointer-events: none;
  z-index: 5;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,0.6);
}

/* 右侧工具栏 */
.he-sidebar-tools {
  position: fixed;
  right: 16rpx;
  top: 33%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 14rpx 10rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(49, 77, 99, 0.15);
  z-index: 10000;
}

.he-sidebar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.he-sidebar-btn:active {
  background: rgba(49, 77, 99, 0.1);
}

.he-sidebar-btn image {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

.he-sidebar-btn text {
  font-size: 18rpx;
  color: #314D63;
  font-weight: 500;
}

.he-sidebar-divider {
  height: 1rpx;
  background: rgba(49, 77, 99, 0.15);
  margin: 8rpx 0;
}

/* iOS风格属性面板 */
.he-props-panel-ios {
  background: transparent;
  padding: 0 20rpx 20rpx;
  flex-shrink: 0;
}

.he-props-panel-ios.placeholder {
  padding-top: 20rpx;
}

.he-props-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(49, 77, 99, 0.12);
}

.he-prop-header-ios {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(49, 77, 99, 0.1);
}

.he-prop-note-badge {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.he-prop-coord-ios {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f5f7fa;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.he-coord-label {
  font-size: 20rpx;
  color: #8a9cad;
  font-weight: 500;
}

.he-coord-val {
  font-size: 22rpx;
  color: #314D63;
  font-weight: 600;
  font-family: 'SF Mono', monospace;
  margin-right: 12rpx;
}

.he-coord-val:last-child {
  margin-right: 0;
}

.he-prop-row-ios {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.he-prop-row-ios:last-of-type {
  margin-bottom: 0;
}

.he-prop-row-ios.note-names-row {
  display: flex;
  flex-direction: row;
  gap: 22rpx;
}

.he-note-input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 9rpx;
}

.he-note-input-label {
  font-size: 25rpx;
  color: #666;
  font-weight: 800;
}

.he-note-input {
  background: #f5f7fa;
  border: 1rpx solid rgba(49, 77, 99, 0.15);
  color: #314D63;
  padding: 8rpx 10rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: center;
}

.he-note-input:focus {
  border-color: #DBCC97;
  background: #fff;
}

.he-prop-label-ios {
  width: 100rpx;
  font-size: 26rpx;
  color: #314D63;
  font-weight: 500;
  flex-shrink: 0;
}

.he-slider-ios {
  flex: 1;
  margin: 0 !important;
  height: 6rpx !important;
}

.he-prop-value-input-ios {
  width: 100rpx;
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
  font-family: 'SF Mono', monospace;
  background: rgba(49, 77, 99, 0.9);
  border-radius: 10rpx;
  padding: 8rpx 0rpx;
  border: 1rpx solid rgba(49, 77, 99, 0.3);
  transition: all 0.2s ease;
}

.he-prop-value-input-ios:focus {
  background: rgba(49, 77, 99, 0.35);
  border-color: rgba(49, 77, 99, 0.6);
}

.he-prop-value-wrapper-ios {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.he-prop-value-unit-ios {
  font-size: 22rpx;
  color: #314D63;
  font-weight: 500;
}

.he-prop-actions-ios {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(49, 77, 99, 0.1);
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.he-btn-ios {
  padding: 16rpx 36rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s;
}

.he-btn-ios.danger {
  background: rgba(179, 69, 64, 0.1);
  color: #B34540;
}

.he-btn-ios.danger:active {
  background: rgba(179, 69, 64, 0.2);
}

.he-btn-ios.secondary {
  background: #f5f7fa;
  color: #314D63;
}

.he-btn-ios.secondary:active {
  background: #e8ecf2;
}

.he-btn-ios.primary {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
}

.he-btn-ios.primary:active {
  opacity: 0.85;
}

.he-btn-ios.primary.add {
  padding: 20rpx 48rpx;
}

/* 双选对齐面板 */
.he-align-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(49, 77, 99, 0.1);
  cursor: pointer;
  transition: all 0.2s ease;
  padding: 12rpx;
  margin: -12rpx -12rpx 12rpx -12rpx;
  border-radius: 12rpx;
}

.he-align-header:active {
  background: rgba(49, 77, 99, 0.05);
  transform: scale(0.98);
}

.he-align-notes {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.he-align-note-badge {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.he-align-note-badge.primary {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
}

.he-align-note-badge.secondary {
  background: #f5f7fa;
  color: #314D63;
  border: 2rpx solid rgba(49, 77, 99, 0.2);
}

.he-align-arrow {
  font-size: 28rpx;
  color: #8a9cad;
}

.he-align-hint {
  font-size: 22rpx;
  color: #8a9cad;
}

.he-align-capsule-group {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.he-align-capsule {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf2 100%);
  border-radius: 50rpx;
  border: 2rpx solid rgba(49, 77, 99, 0.1);
  transition: all 0.2s;
}

.he-align-capsule:active {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border-color: transparent;
}

.he-align-capsule:active .he-capsule-icon,
.he-align-capsule:active .he-capsule-text {
  color: white;
}

.he-capsule-icon {
  font-size: 28rpx;
  color: #314D63;
  font-weight: bold;
}

.he-capsule-text {
  font-size: 24rpx;
  color: #314D63;
  font-weight: 500;
}

/* 占位提示 */
.he-placeholder-content {
  text-align: center;
  padding: 16rpx 0 24rpx;
}

.he-placeholder-text {
  display: block;
  font-size: 28rpx;
  color: #314D63;
  margin-bottom: 8rpx;
}

.he-placeholder-hint {
  display: block;
  font-size: 22rpx;
  color: #8a9cad;
}

/* iOS风格底部操作栏 */
.he-footer-ios {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom, 0));
  background: #ffffff;
  border-top: 1rpx solid rgba(49, 77, 99, 0.1);
  flex-shrink: 0;
  gap: 12rpx;
}

.he-btn-ios-footer {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  transition: all 0.2s;
}

.he-btn-ios-footer.secondary {
  background: #f5f7fa;
  color: #314D63;
}

.he-btn-ios-footer.primary {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
}

.he-btn-ios-footer:active {
  transform: scale(0.98);
}

/* ========== 参数库弹窗 ========== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal.active {
  opacity: 1;
  visibility: visible;
}

.modal .modal-content {
  width: 85%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(49, 77, 99, 0.1);
}

.modal .modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
}

.close-modal {
  font-size: 48rpx;
  color: #8a9cad;
  line-height: 1;
}

.he-params-library-modal {
  max-height: 70vh;
}

.he-params-list {
  max-height: 400rpx;
  padding: 16rpx 24rpx;
}

.he-params-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.he-params-item.active {
  background: rgba(49, 77, 99, 0.1);
  border-color: #314D63;
}

.he-params-item-info {
  flex: 1;
}

.he-params-item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #314D63;
  margin-bottom: 4rpx;
}

.he-params-item-desc {
  display: block;
  font-size: 22rpx;
  color: #8a9cad;
}

.he-params-item-delete {
  padding: 12rpx 20rpx;
  background: rgba(179, 69, 64, 0.1);
  color: #B34540;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.he-params-item-preset-tag {
  padding: 8rpx 16rpx;
  background: rgba(49, 77, 99, 0.1);
  color: #314D63;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.modal-buttons {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid rgba(49, 77, 99, 0.1);
}

.edit-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s;
}

.edit-btn.secondary {
  background: #f5f7fa;
  color: #314D63;
}

.edit-btn.primary {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
}

/* 保存弹窗 */
.save-modal-content {
  width: 80%;
}

.save-dialog {
  padding: 24rpx;
}

.save-input {
  width: 100%;
  padding: 20rpx;
  background: #f5f7fa;
  border: 1rpx solid rgba(49, 77, 99, 0.15);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #314D63;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

/* 导入弹窗 */
.he-import-content {
  padding: 24rpx;
}

.he-import-hint {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.he-import-textarea {
  width: 100%;
  height: 240rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border: 1rpx solid rgba(49, 77, 99, 0.15);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #314D63;
  font-family: 'SF Mono', monospace;
  box-sizing: border-box;
}

.he-import-error {
  display: block;
  color: #B34540;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 帮助提示弹窗 */
.help-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 10002;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.help-overlay.active {
  opacity: 1;
  visibility: visible;
}

.help-tooltip {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 10003;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
}

.help-tooltip.active {
  opacity: 1;
  visibility: visible;
}

.help-tooltip-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
  margin-bottom: 16rpx;
}

.help-tooltip-content {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.help-tooltip-close {
  display: block;
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  color: white;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
