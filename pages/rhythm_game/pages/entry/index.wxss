/* 音游入口页面样式 */
.entry-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
  position: relative;
}

/* 自定义导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 158rpx;
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  display: flex;
  align-items: flex-end;
  padding-bottom: 20rpx;
  z-index: 1000;
}

.nav-bar-left {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 0rpx;
  box-sizing: border-box;
}

.nav-back-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(10);
}

.nav-bar-content {
  flex: 1;
  text-align: center;
}

.nav-bar-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
}

.nav-bar-right {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 15rpx;
  box-sizing: border-box;
}

/* 来源选择区域（直接显示在页面上） */
.source-section {
  padding-top: 220rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 28rpx;
  min-height: calc(100vh - 158rpx);
  display: flex;
  flex-direction: column;
}

.source-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.source-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #314D63;
  margin-bottom: 16rpx;
}

.source-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8a9aa8;
}

.source-options {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.source-option {
  display: flex;
  align-items: center;
  padding: 0rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(49, 77, 99, 0.12);
  transition: all 0.2s ease;
  flex: 1;
  max-height: 200rpx;
}

.source-option:active {
  background: #f5f8fa;
  transform: scale(0.98);
}

.source-option.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.option-icon-wrap {
  width: 100rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.option-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(10);
}

.option-info {
  flex: 1;
}

.option-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #314D63;
  margin-bottom: 12rpx;
}

.option-desc {
  display: block;
  font-size: 28rpx;
  color: #8a9aa8;
}

.option-arrow {
  font-size: 48rpx;
  color: #c0c8d0;
  margin-left: 16rpx;
}

.source-footer {
  padding-top: 40rpx;
  display: flex;
  justify-content: center;
}

.source-footer {
  padding-top: 40rpx;
  display: flex;
  justify-content: center;
}

.source-btn {
  padding: 24rpx 80rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.source-btn.cancel {
  background: #e8eef3;
  color: #5c7a8c;
}

.source-btn.cancel:active {
  background: #d0dbe5;
}

/* 弹窗遮罩 - 保留以兼容 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

/* 来源选择弹窗 */
.source-modal {
  width: 85%;
  max-width: 650rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
}

.modal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.modal-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 以下source-option样式已移至顶部source-section区域，保留option-icon-wrap等通用样式 */

.option-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.option-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(10);
}

.option-info {
  flex: 1;
}

.option-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
  margin-bottom: 8rpx;
}

.option-desc {
  display: block;
  font-size: 26rpx;
  color: #8a9aa8;
}

.option-arrow {
  font-size: 40rpx;
  color: #c0c8d0;
  margin-left: 16rpx;
}

.modal-footer {
  padding: 24rpx 32rpx 40rpx;
  display: flex;
  justify-content: center;
}

.modal-btn {
  padding: 24rpx 64rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.modal-btn.cancel {
  background: #e8eef3;
  color: #5c7a8c;
}

.modal-btn.cancel:active {
  background: #d0dbe5;
}

/* 曲库浏览界面 */
.library-browser {
  position: fixed;
  top: 178rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
  z-index: 100;
}

.library-browser.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* 工具栏 */
.browser-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #e8eef3;
}

.breadcrumb {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.breadcrumb-item {
  font-size: 28rpx;
  color: #314D63;
  font-weight: 500;
}

.breadcrumb-separator {
  font-size: 28rpx;
  color: #c0c8d0;
  margin: 0 4rpx;
}

.toolbar-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.08);
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 文件列表 */
.file-list {
  flex: 1;
  padding: 16rpx;
  padding-bottom: 160rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #8a9aa8;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.06);
  transition: all 0.2s ease;
}

.list-item:active {
  background: #f5f8fa;
  transform: scale(0.98);
}

.list-item.selected {
  background: linear-gradient(135deg, rgba(49, 77, 99, 0.08) 0%, rgba(69, 103, 129, 0.08) 100%);
  border: 2rpx solid #314D63;
}

.item-icon-img {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
}

.file-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #F4D096 0%, #e6c080 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  overflow: hidden;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #314D63;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-detail {
  display: block;
  font-size: 24rpx;
  color: #8a9aa8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-arrow {
  font-size: 36rpx;
  color: #c0c8d0;
  margin-left: 16rpx;
}

.item-star {
  margin-left: 12rpx;
}

.star-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.select-indicator {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.check-icon {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 底部操作栏 */
.browser-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e8eef3;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 200;
}

.footer-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
}

.footer-btn.cancel {
  background: #e8eef3;
  color: #5c7a8c;
}

.footer-btn.confirm {
  background: linear-gradient(135deg, #314D63 0%, #456781 100%);
  color: #ffffff;
}

.footer-btn.confirm.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.footer-btn:active {
  transform: scale(0.98);
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e8eef3;
  border-top-color: #314D63;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #5c7a8c;
}
