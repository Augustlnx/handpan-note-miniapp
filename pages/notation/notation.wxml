    <view class="modal-content notation-type-modal" catchtap="stopPropagation">
      <!-- 标题行：居中标题 + 右侧转换表库按钮 -->
      <view class="conversion-modal-header">
        <text class="conversion-modal-title">谱式转换</text>
        <view class="conversion-header-right" bindtap="openConversionLibrary">
          <image class="conversion-header-icon" src="/assets/icons/folder-rename.png" mode="aspectFit"></image>
          <text class="conversion-header-text">转换表库</text>
        </view>
      </view>
      
      <!-- 转换模式切换按钮 -->
      <view class="conversion-mode-switch">
        <view class="conversion-mode-btn {{conversionMode === 'mapping' ? 'active' : ''}}" bindtap="setConversionMode" data-mode="mapping">
          <text>映射转换</text>
        </view>
        <view class="conversion-mode-btn {{conversionMode === 'noMapping' ? 'active' : ''}}" bindtap="setConversionMode" data-mode="noMapping">
          <text>无映射转换</text>
        </view>
      </view>
      
      <!-- 当前谱式提示 + SPN计法（同一行左右顶格） -->
      <view class="conversion-info-row">
        <view class="conversion-type-hint">
          <text>当前谱式：</text>
          <text class="notation-type-current">{{notationType === 'simplified' ? '简谱' : '数字谱'}}</text>
          <text> → </text>
          <text class="notation-type-target">{{notationType === 'simplified' ? '数字谱' : '简谱'}}</text>
        </view>
        <view class="conversion-root-note-bar" bindtap="showConversionRootPicker">
          <text class="conversion-root-label">首调</text>
          <view class="conversion-root-box">
            <text class="conversion-root-text">{{conversionRootNote}}=1</text>
          </view>
        </view>
      </view>

      <!-- 转换表（三列） - 仅在映射转换模式下显示 -->
      <view class="conversion-table-container" wx:if="{{conversionMode === 'mapping'}}">
        <scroll-view class="conversion-table-scroll" scroll-y>
          <view class="conversion-table-header conversion-header-3col">
            <text class="conversion-col-header">数字谱</text>
            <text class="conversion-col-header">简谱</text>
            <text class="conversion-col-header">SPN</text>
          </view>
          <view wx:for="{{conversionMappings}}" wx:key="key" class="conversion-row conversion-row-3col">
            <!-- 数字谱列 -->
            <view class="conversion-col-fixed conversion-col-3">{{item.key}}</view>
            <!-- 简谱列（可编辑） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{conversionEditingKey === item.key && conversionEditingField === 'simplified' ? 'conversion-cell-active' : ''}}" 
                  bindtap="onConversionCellTap" 
                  data-key="{{item.key}}" 
                  data-field="simplified">
              <block wx:if="{{conversionUseNativeInput && conversionEditingKey === item.key && conversionEditingField === 'simplified'}}">
                <input class="conversion-native-input" 
                       value="{{item.simplified}}" 
                       focus="{{true}}"
                       bindinput="onConversionNativeInput"
                       bindblur="onConversionNativeBlur"
                       data-key="{{item.key}}"
                       data-field="simplified" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.simplified ? '' : 'placeholder'}}">{{item.simplified || '点击输入'}}</text>
              </block>
            </view>
            <!-- SPN列（自动计算，可编辑） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{conversionEditingKey === item.key && conversionEditingField === 'spn' ? 'conversion-cell-active' : ''}}"
                  bindtap="onConversionCellTap" 
                  data-key="{{item.key}}" 
                  data-field="spn">
              <block wx:if="{{conversionUseNativeInput && conversionEditingKey === item.key && conversionEditingField === 'spn'}}">
                <input class="conversion-native-input" 
                       value="{{item.spn}}" 
                       focus="{{true}}"
                       bindinput="onConversionNativeInput"
                       bindblur="onConversionNativeBlur"
                       data-key="{{item.key}}"
                       data-field="spn" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.spn ? '' : 'placeholder'}}">{{item.spn || '-'}}</text>
              </block>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 转换表提示 -->
      <view class="conversion-hint">
        <text wx:if="{{conversionMappingError && conversionMode === 'mapping'}}" class="conversion-error">{{conversionMappingError}}</text>
        <text wx:elif="{{conversionMode === 'noMapping'}}" class="conversion-tip">无映射转换：仅切换谱式，不转换音符内容</text>
        <text wx:else class="conversion-tip">点击单元格使用虚拟键盘编辑</text>
      </view>

      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeNotationTypeModal">取消</button>
        <button class="btn-primary" bindtap="confirmConversion" disabled="{{conversionMode === 'mapping' && (!!conversionMappingError || hasEmptyConversionMapping)}}">确认转换</button>
      </view>
    </view>
  </view>

  <!-- 转换表库弹窗 -->
