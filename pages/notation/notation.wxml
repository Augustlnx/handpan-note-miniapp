                <text 
                  wx:if="{{visualSeparators[index].type === 'beat'}}" 
                  class="separator-beat"
                >|</text>
                <text 
                  wx:elif="{{visualSeparators[index].type === 'measure'}}" 
                  class="separator-measure"
                >][</text>
              </view>
            </block>
            <text class="bracket-text">]</text>
          </view>
        </scroll-view>

        <!-- 生成的模板预览 -->
        <view class="template-preview">
          <text class="preview-label">模板预览：</text>
          <text class="preview-text">{{customTimeSignatureTemplate || '[----|----|----|----]'}}</text>
        </view>

        <!-- 小节信息列表 -->
