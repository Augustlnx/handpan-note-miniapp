  <!-- 节拍器帮助提示窗口 -->
  <view wx:if="{{showMetronomeHelpModal}}" class="modal-overlay" bindtap="closeMetronomeHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">节拍器说明</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>点击节拍器按钮会弹出一个悬浮节拍器</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>节奏速度使用当前谱面的「速度」设定</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>拍数使用当前谱面的「拍号」设定</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>悬浮节拍器会显示当前拍点，便于练习</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>点击关闭图标可关闭悬浮节拍器</text>
        </view>
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="closeMetronomeHelp">知道了</button>
      </view>
    </view>
  </view>

  <!-- 排版视角帮助窗口 -->
  <view wx:if="{{showRotationHelpModal}}" class="modal-overlay" bindtap="closeRotationHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">排版视角</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">竖屏模式：</text>默认手机端排版模式</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">横屏/平板模式：</text>一行排版更多小节，可容纳更多内容，页面元素均缩小</text>
        </view>
      
      </view>
    </view>
  </view>

  <!-- 拍号选择帮助窗口 -->
  <view wx:if="{{showTimeSignatureHelpModal}}" class="modal-overlay" bindtap="closeTimeSignatureHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">拍号设置</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot"></text>
          <text><text class="md-strong">独立数据：</text>每个拍号都有独立数据空间，互不影响</text>
        </view>
        <view class="md-line">
          <text class="md-dot"></text>
          <text><text class="md-strong">自动切换：</text>更换拍号会自动切换到对应数据</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">4/4：</text>每小节 4 拍，标准节拍</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">3/4：</text>每小节 3 拍，常见于圆舞曲</text>
        </view>
        <view class="md-quote">首次进入某拍号会初始化默认谱面，可在该拍号下自由编辑，不影响其他拍号。</view>
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="closeTimeSignatureHelp">知道了</button>
      </view>
    </view>
  </view>

  <!-- 模块标签编辑弹窗（名称+备注） -->
  <view wx:if="{{showLabelEditModal}}" class="modal-overlay" bindtap="closeLabelEditModal">
    <view class="modal-content label-edit-modal" catchtap="stopPropagation">
      <view class="modal-title">编辑模块信息</view>
      <view class="modal-body">
        <view class="label-edit-row">
          <text class="label-edit-label">名称</text>
          <input class="modal-input" type="text" value="{{labelEditName}}" placeholder="例如: A-1" bindinput="onLabelEditNameInput" />
        </view>
        <view class="label-edit-row">
          <text class="label-edit-label">备注</text>
          <input class="modal-input" type="text" value="{{labelEditRemark}}" placeholder="例如: ♪速度 (可选)" bindinput="onLabelEditRemarkInput" />
        </view>
      </view>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeLabelEditModal">取消</button>
        <button class="btn-primary" bindtap="confirmLabelEdit">确定</button>
      </view>
    </view>
  </view>

  <!-- 通用编辑弹窗（用于标题/副标题/速度等） -->
  <view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">{{editModalTitle}}</view>
      <view class="modal-body">
        <input class="modal-input" type="{{editInputType}}" value="{{editValue}}" focus="true" placeholder="{{editPlaceholder}}" bindinput="onEditInput" confirm-type="done" bindconfirm="confirmEdit" />
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="confirmEdit">确定</button>
      </view>
    </view>
  </view>

  <!-- 自由设定拍号模态框 -->
  <view wx:if="{{showCustomTimeSignatureModal}}" class="modal-overlay" bindtap="closeCustomTimeSignatureModal">
    <view class="modal-content custom-time-signature-modal" catchtap="stopPropagation">
      <view class="modal-title">自由设定拍号</view>
      
      <view class="custom-signature-help">
        <view class="help-section">
          <text class="help-label">使用说明：</text>
          <text class="help-text">1. 设置总音符数，圆点将自动显示</text>
          <text class="help-text">2. 点击圆点之间的间隙插入分隔线</text>
          <text class="help-text">3. 单击循环：无 → 拍线 | → 小节线 ][ → 无</text>
        </view>
        <view class="help-section">
          <text class="help-label">限制：</text>
          <text class="help-text">• 音符数 1~35 个，单拍音符 1~10 个</text>
        </view>
      </view>

      <view class="modal-body">
        <!-- 音符数输入 -->
        <view class="note-count-row">
          <text class="note-count-label">总音符数：</text>
          <input 
            class="note-count-input"
            type="number"
            value="{{visualNoteCount}}" 
            bindinput="onVisualNoteCountInput"
            bindblur="onVisualNoteCountBlur"
          />
          <text class="note-count-hint">（1~35）</text>
        </view>

        <!-- 可视化圆点区域 -->
        <scroll-view scroll-x class="visual-dots-scroll">
          <view class="visual-dots-container">
            <text class="bracket-text">[</text>
            <block wx:for="{{visualDots}}" wx:key="index">
              <!-- 圆点 -->
              <view class="visual-dot"></view>
              <!-- 间隙（除最后一个外） -->
              <view 
                wx:if="{{index < visualDots.length - 1}}"
                class="dot-gap {{visualSeparators[index].type !== 'none' ? 'has-separator' : ''}}"
                data-index="{{index}}"
                bindtap="onDotGapTap"
              >
                <text 
                  wx:if="{{visualSeparators[index].type === 'beat'}}" 
                  class="separator-beat"
                >|</text>
                <text 
                  wx:elif="{{visualSeparators[index].type === 'measure'}}" 
                  class="separator-measure"
                >][</text>
              </view>
            </block>
            <text class="bracket-text">]</text>
          </view>
        </scroll-view>

        <!-- 生成的模板预览 -->
        <view class="template-preview">
          <text class="preview-label">模板预览：</text>
          <text class="preview-text">{{customTimeSignatureTemplate || '[----|----|----|----]'}}</text>
        </view>

        <!-- 小节信息列表 -->
        <view wx:if="{{measureInfoList.length > 0}}" class="measure-info-list">
          <view class="measure-info-header">结构详情</view>
          <view class="measure-info-grid">
            <view 
              wx:for="{{measureInfoList}}" 
              wx:key="measureIndex" 
              class="measure-info-card"
            >
              <view class="measure-card-title">第{{item.measureIndex + 1}}小节</view>
              <view class="beat-info-list">
                <view 
                  wx:for="{{item.beats}}" 
                  wx:for-item="beat"
                  wx:for-index="beatIdx"
                  wx:key="beatIdx"
                  class="beat-info-row"
                >
                  <text class="beat-label">第{{beatIdx + 1}}拍：</text>
                  <input 
                    class="beat-note-input"
                    type="number"
                    value="{{beat.noteCount}}"
                    data-measure-index="{{item.measureIndex}}"
                    data-beat-index="{{beatIdx}}"
                    bindinput="onBeatNoteCountInput"
                    bindblur="onBeatNoteCountBlur"
                  />
                  <text class="beat-unit">音符</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{customTimeSignatureError}}" class="error-message">{{customTimeSignatureError}}</view>
      </view>

      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeCustomTimeSignatureModal">取消</button>
        <button class="btn-primary" bindtap="confirmCustomTimeSignature" disabled="{{!!customTimeSignatureError || !customTimeSignatureValid}}">确定</button>
      </view>
    </view>
  </view>

  <!-- 模块设置模态框 -->
  <view wx:if="{{showModuleSettingsModal}}" class="modal-overlay" bindtap="closeModuleSettingsModal">
    <view class="modal-content module-settings-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">模块设置</view>
        <image class="modal-close-icon" src="/assets/icons/delete.png" bindtap="closeModuleSettingsModal"></image>
      </view>
      
      <view class="module-settings-scrollable">
      <view class="settings-item">
        <view class="settings-item-header">
          <image class="settings-icon" src="/assets/icons/paragraph.png"></image>
          <text class="settings-label">样式设置</text>
        </view>
        <view class="settings-item-content style-settings-content">
          <!-- 单行高度设置 -->
          <view class="style-setting-row">
            <text class="style-label">单行高度</text>
            <view class="style-input-area">
              <text class="style-default-hint">默认{{orientation === 'landscape' ? 103 : 160}}</text>
              <input 
                class="style-input"
                type="number"
                value="{{moduleMeasureHeight}}" 
                placeholder="{{orientation === 'landscape' ? '51-193' : '80-300'}}"
                bindinput="onModuleMeasureHeightInput"
                bindconfirm="confirmModuleMeasureHeight"
                bindblur="confirmModuleMeasureHeight"
              />
              <text class="style-unit">rpx</text>
            </view>
          </view>
          <view wx:if="{{moduleMeasureHeightError}}" class="error-message">{{moduleMeasureHeightError}}</view>
          
          <!-- 音符字体大小设置 -->
          <view class="style-setting-row">
            <text class="style-label">音符字号</text>
            <view class="style-input-area">
              <text class="style-default-hint">默认{{orientation === 'landscape' ? 18 : 28}}</text>
              <input 
                class="style-input"
                type="number"
                value="{{moduleNoteFontSize}}" 
                placeholder="{{orientation === 'landscape' ? '9-32' : '14-50'}}"
                bindinput="onModuleNoteFontSizeInput"
                bindconfirm="confirmModuleNoteFontSize"
                bindblur="confirmModuleNoteFontSize"
              />
              <text class="style-unit">rpx</text>
            </view>
          </view>
          <view wx:if="{{moduleNoteFontSizeError}}" class="error-message">{{moduleNoteFontSizeError}}</view>
          
          <!-- 行间距设置 -->
          <view class="style-setting-row">
            <text class="style-label">行间距</text>
            <view class="style-input-area">
              <text class="style-default-hint">默认{{orientation === 'landscape' ? 42 : 65}}</text>
              <input 
                class="style-input"
                type="number"
                value="{{moduleLineSpacing}}" 
                placeholder="{{orientation === 'landscape' ? '19-96' : '30-150'}}"
                bindinput="onModuleLineSpacingInput"
                bindconfirm="confirmModuleLineSpacing"
                bindblur="confirmModuleLineSpacing"
              />
              <text class="style-unit">rpx</text>
            </view>
          </view>
          <view wx:if="{{moduleLineSpacingError}}" class="error-message">{{moduleLineSpacingError}}</view>
        </view>
      </view>

      <view class="settings-item">
        <view class="settings-item-header">
          <text class="settings-label">导入/导出</text>
        </view>
        <view class="settings-item-content">
          <view class="import-export-buttons">
            <view class="import-export-button" bindtap="openModuleImport" data-id="{{currentModuleId}}">
              <image src="/assets/icons/upload.png" class="button-icon"></image>
              <text class="button-text">导入代码</text>
            </view>
            <view class="import-export-button" bindtap="showExportCode">
              <image src="/assets/icons/output.png" class="button-icon"></image>
              <text class="button-text">导出代码</text>
            </view>
          </view>
          <view wx:if="{{exportModuleCode}}" style="display: flex; gap: 12rpx; align-items: flex-start; margin-top: 16rpx;">
            <view style="flex: 1; background: #f5f5f5; padding: 16rpx; border-radius: 8rpx; word-break: break-all; font-size: 24rpx; font-family: monospace; max-height: 150rpx; overflow-y: auto; color: #333;">{{exportModuleCode}}</view>
            <image class="copy-icon" src="/assets/icons/copy.svg" style="width: 40rpx; height: 40rpx; flex-shrink: 0; margin-top: 16rpx;" bindtap="copyModuleCode"></image>
          </view>
        </view>
      </view>
      </view>

      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="resetModuleSettings">恢复默认</button>
        <button class="btn-primary" bindtap="applyModuleSettings">完成</button>
      </view>
    </view>
  </view>

  <!-- 导入乐谱模态窗口 -->
  <view wx:if="{{showImportModal}}" class="modal-overlay" bindtap="closeImportModal">
    <view class="modal-content import-modal" catchtap="stopPropagation">
      <view class="modal-header-with-help">
        <view class="modal-title">导入乐谱</view>
        <view class="help-icon-wrap-enhanced" catchtap="showImportHelp">
          <image class="help-icon-enhanced" src="/assets/icons/help.svg"></image>
          <text class="help-hint">查看说明</text>
        </view>
      </view>
      <view class="import-description">
        <text>请输入乐谱代码（支持LaTeX风格语法）</text>
      </view>
      <textarea
        class="import-code-input"
        value="{{importCode}}"
        placeholder="示例：\begin{module}{A-1}&#10;[ (7,5)/(3,1) + (6)/(2,1) | ... ]&#10;\end{module}"
        bindinput="onImportCodeInput"
        maxlength="-1"
      />
      <view wx:if="{{importError}}" class="error-message">{{importError}}</view>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeImportModal">取消</button>
        <button class="btn-primary" bindtap="confirmImport">导入</button>
      </view>
    </view>
  </view>

  <!-- 导入帮助模态窗口 -->
  <view wx:if="{{showImportHelpModal}}" class="modal-overlay" bindtap="closeImportHelp">
    <view class="modal-content import-help-modal" catchtap="stopPropagation">
      <view class="modal-title">乐谱导入使用指南</view>
      <scroll-view class="help-scroll-view" scroll-y="true">
        <!-- 功能说明 -->
        <view class="help-section">
          <text class="help-section-title">📖 功能说明</text>
          <text class="help-section-text">通过代码批量创建或快速修改乐谱。特别适合处理循环乐谱或使用 AI 识别图片转代码辅助扒谱。支持“追加”到末尾或“覆盖”单个模块。</text>
        
        </view>

        <!-- 基础语法 -->
        <view class="help-section">
          <text class="help-section-title">📝 基础语法</text>
          <view class="help-subsection">
            <text class="help-label">1. 模块定义</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{A-1}</text>
              <text class="code-text">...乐谱内容...</text>
              <text class="code-text">\end{module}</text>
            </view>
            <text class="help-desc">支持可选备注：</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{A-1}{♪速度}</text>
              <text class="code-text">...乐谱内容...</text>
              <text class="code-text">\end{module}</text>
            </view>
            <text class="help-desc">支持排版样式（可选第三个括号）：</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{A-1}{备注}{h:180,f:32,s:70}</text>
              <text class="code-text">...乐谱内容...</text>
              <text class="code-text">\end{module}</text>
            </view>
            <text class="help-desc">样式参数说明：</text>
            <text class="help-item">• h: 小节高度 (默认160rpx)</text>
            <text class="help-item">• f: 音符字号 (默认28rpx)</text>
            <text class="help-item">• s: 行间距 (默认65rpx)</text>
          </view>
          
          <view class="help-subsection">
            <text class="help-label">2. 行内注记</text>
            <text class="help-desc">在行末用 /*"位置:文字"*/ 添加注记：</text>
            <view class="code-block">
              <text class="code-text">[(5)/(1)|(6)/(2)|...]/*"1:渐强","5:重音"*/\\</text>
            </view>
            <text class="help-desc">位置从1开始，按16分音符计数。注记显示在对应音符上方。</text>
          </view>
          
          <view class="help-subsection">
            <text class="help-label">3. 分隔符</text>
            <!-- 使用四个反斜杠以在界面上显示双反斜杠 -->
            <text class="help-item">• 换行：\  \（分隔不同视觉行）</text>
            <text class="help-item">• 小节：[ ] （“][”为共用小节线）</text>
            <text class="help-item">• 拍位：| （分隔拍）</text>
            <text class="help-item">• 细分：+（必须用于分隔音符列）</text>
            <text class="help-item">• 音符包裹：&lt;&gt; 或 {}（将特殊音符包裹为整体）</text>
            <text class="help-item">• 注释：% （行注释，会被忽略）</text>
          </view>
        </view>

        <!-- 音符格式 -->
        <view class="help-section">
          <text class="help-section-title">🎵 音符格式</text>
          <view class="help-subsection">
            <text class="help-label">标准格式：(右手)/(左手)</text>
            <text class="help-desc">四轨道系统从上到下依次为：</text>
            <text class="help-item">→ Slot 0：右手外侧（离中轴远）</text>
            <text class="help-item">→ Slot 1：右手内侧（贴近中轴）</text>
            <text class="help-item">→ Slot 2：左手内侧（贴近中轴）</text>
            <text class="help-item">→ Slot 3：左手外侧（离中轴远）</text>
          </view>

          <view class="help-subsection">
            <text class="help-label">常用格式</text>
            <text class="help-item">• (7,5)/(3,1) → 完整四音符</text>
            <text class="help-item">• (5)/(1,2) → 右手单音符自动贴中轴</text>
            <text class="help-item">• (5,3)/(2) → 左手单音符自动贴中轴</text>
            <text class="help-item">• ()/(1,2) → 仅左手演奏</text>
            <text class="help-item">• (7,5)/() → 仅右手演奏</text>
            <text class="help-item">• - 或 ()/() → 空音符（占位）</text>
          </view>

          <view class="help-subsection">
            <text class="help-label">简写规则（奇数右手，偶数左手）</text>
            <text class="help-item">• (1,2,3) 自动转为 (3,1)/(2)：括号前半（右手）按奇数降序，括号后半（左手）按偶数升序。</text>
            <text class="help-item">• 单个数字也可省略括号/斜杠：1 解析为 (1)/()，2 解析为 ()/(2)。</text>
            <text class="help-item">• 示例：[(1,2,3)+-+-+-] 将被识别为 [(3,1)/(2)+-+-+-]；[(2+1+-+-] 将被识别为 [()/(2)+(1)/()+-+-]。</text>
          </view>

          <view class="help-subsection">
            <text class="help-label">高级简写（隐含+号与手指定）</text>
            <text class="help-item">• 多位数：用&lt;&gt;或{}包裹以防混淆。例如 &lt;12&gt;-- 被识别为 &lt;12&gt;+-+-，而不是 1+2+-+-。</text>
            <text class="help-item">• 特殊音符：包含修饰符（' , _ ^{...}）的音符需用&lt;&gt;包裹，如 &lt;1'^{H}&gt;。</text>
            <text class="help-item">• 单手指定：用"数字/"和"/数字"格式手动指定左右手。例如 1/ 表示 ()/(1)，/1 表示 (1)/()。</text>
            <text class="help-item">• 完整手指定：简写为 4/1 等价于 (4)/(1)，也可用 &lt;4/1&gt; 规范为一个音符位。</text>
            <text class="help-item">• 所有手指定均支持&lt;&gt;：&lt;12/&gt; 表示 ()/(&lt;12&gt;)，/&lt;12&gt; 表示 (&lt;12&gt;)/()。</text>
          </view>
        </view>

        <!-- 示例代码 -->
        <view class="help-section">
          <text class="help-section-title">💡 示例代码</text>
          
          <view class="help-subsection">
            <text class="help-label">简单示例（3/4拍）</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{示例-1}</text>
              <text class="code-text">% 第一行</text>
              <text class="code-text">[ (7,5)/(3,1) + (6)/(2) + - |</text>
              <text class="code-text">  (8)/(4,2) + ()/(5) |</text>
              <text class="code-text">  (9,7)/(6,4) + (T)/(5) ]</text>
              <text class="code-text">\end{module}</text>
            </view>
          </view>

          <view class="help-subsection">
            <text class="help-label">完整示例（4/4拍，多行）</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{A-1}</text>
              <text class="code-text">% 第一行</text>
              <text class="code-text">[ (7,5)/(3,1) + (6)/(2) |</text>
              <text class="code-text">  (8,6)/(4,3) + (5)/(1,2) |</text>
              <text class="code-text">  (9)/(5) + - |</text>
              <text class="code-text">  (T,8)/(6,5) + (7)/(4) ] \\\</text>
              <text class="code-text">% 第二行</text>
              <text class="code-text">[ (5)/(1,2) + (6)/(2) |</text>
              <text class="code-text">  (7,5)/(3,1) + - |</text>
              <text class="code-text">  (8)/(4,2) + (9)/(5) |</text>
              <text class="code-text">  - + (T)/(6) ]</text>
              <text class="code-text">\end{module}</text>
            </view>
          </view>

          <view class="help-subsection">
            <text class="help-label">多模块导入</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{B-1}</text>
              <text class="code-text">[ (7)/(3) | (8)/(4) ]</text>
              <text class="code-text">\end{module}</text>
              <text class="code-text"></text>
              <text class="code-text">\begin{module}{B-2}</text>
              <text class="code-text">[ (9)/(5) | (T)/(6) ]</text>
              <text class="code-text">\end{module}</text>
            </view>
          </view>

          <view class="help-subsection">
            <text class="help-label">简写示例（复杂代码与简写对比）</text>
            <text class="help-item">以下复杂代码：</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{A-1}</text>
              <text class="code-text">[(6)/(D)+ -+()/(1)+ (d)/()|()/(D)+-+ (6)/(1)+-|</text>
              <text class="code-text"> (6)/(D)+ -+()/(1)+ (d)/()|()/(D)+-+ (6)/(1)+-]\\</text>
              <text class="code-text">\end{module}</text>
            </view>
            <text class="help-item">可简写为：</text>
            <view class="code-block">
              <text class="code-text">\begin{module}{A-2}</text>
              <text class="code-text">[6/D -/1{d/}|/D-6/1-|6/D -/1{d/}|/D-6/1-]\\</text>
              <text class="code-text">\end{module}</text>
            </view>
            <text class="help-item">说明：6/D 自动展开为 (6)/(D)，-/1 为 ()/(1)，{d/} 为 ()/{d}，隐含的 + 号自动插入</text>
          </view>
        </view>

        <!-- 使用技巧 -->
        <view class="help-section">
          <text class="help-section-title">💡 使用技巧</text>
     
          <text class="help-item">• 空格会被自动忽略</text>
          <text class="help-item">• 小节线支持 ][ 连写</text>
          <text class="help-item">• 可使用 % 添加注释说明</text>
          <text class="help-item">• 建议先用简单示例测试</text>
        </view>

        <!-- 简谱扩展语法 -->
        <view class="help-section">
          <text class="help-section-title">🎼 简谱扩展语法</text>
          <text class="help-desc">简谱模式下可使用以下扩展标记：</text>
          
          <view class="help-subsection">
            <text class="help-label">八度标记</text>
            <text class="help-item">• ' (单引号) → 高八度，音符上方加点</text>
            <text class="help-item">• '' → 高两个八度，音符上方加两点</text>
            <text class="help-item">• , (逗号) → 低八度，音符下方加点</text>
            <text class="help-item">• ,, → 低两个八度，音符下方加两点</text>
            <text class="help-item">• 示例：1' (高八度do), 5,, (低两个八度sol)</text>
          </view>
          
          <view class="help-subsection">
            <text class="help-label">时值标记</text>
            <text class="help-item">• _ (下划线) → 时值减半，音符添加下划线</text>
            <text class="help-item">• 示例：1_ (八分音符), 1'_ (高八度八分音符)</text>
          </view>
          
          <view class="help-subsection">
            <text class="help-label">上标标记</text>
            <text class="help-item">• ^{内容} → 在音符旁添加上标</text>
            <text class="help-item">• 左上标：^{H}1 → H显示在1的左上方</text>
            <text class="help-item">• 右上标：1^{H} → H显示在1的右上方</text>
            <text class="help-item">• 双上标：^{L}1^{R} → L左上，R右上</text>
            <text class="help-item">• 上标音高：上标内也支持'和,，如 ^{1'}</text>
          </view>
          
          <view class="help-subsection">
            <text class="help-label">复杂示例</text>
            <view class="code-block">
              <text class="code-text">^{1''}2,,_^{H}</text>
            </view>
            <text class="help-item">解析为：左上标高两个八度的1，低两个八度带下划线的2，右上标H</text>
          </view>
        </view>

        <!-- 导入模式说明 -->
        <view class="help-section">
          <text class="help-section-title">🔄 导入模式</text>
          <text class="help-item">• 菜单栏导入：添加新模块到谱面末尾</text>
          <text class="help-item">• 模块设置导入：覆盖当前模块内容</text>
          <text class="help-desc">（注：覆盖模式仅导入第一个模块的内容）</text>
        </view>

        <!-- 常见问题 -->
        <view class="help-section">
          <text class="help-section-title">❓ 常见问题</text>
          <text class="help-item">Q: 如何表示空音符？</text>
          <text class="help-answer">A: 使用 - 或 ()/() 均可</text>
          
          <text class="help-item">Q: 导入会覆盖原有数据吗？</text>
          <text class="help-answer">A: 菜单栏导入会添加，模块设置导入会覆盖当前模块</text>
          
          <text class="help-item">Q: 支持哪些拍号？</text>
          <text class="help-answer">A: 自动适配代码中设置的拍号，如特殊的[-][---][---]都是可行的</text>
        </view>
      </scroll-view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="dismissImportHelp">不再显示</button>
