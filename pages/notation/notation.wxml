                       focus="{{true}}"
                       bindinput="onNewTableNativeInput"
                       bindblur="onNewTableNativeBlur"
                       data-index="{{index}}"
                       data-field="key" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.key ? '' : 'placeholder'}}">{{item.key || '点击输入'}}</text>
              </block>
            </view>
            <!-- 简谱列（可编辑） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{newTableEditingIndex === index && newTableEditingField === 'simplified' ? 'conversion-cell-active' : ''}}" 
                  bindtap="onNewTableCellTap" 
                  data-index="{{index}}" 
                  data-field="simplified">
              <block wx:if="{{newTableUseNativeInput && newTableEditingIndex === index && newTableEditingField === 'simplified'}}">
                <input class="conversion-native-input" 
                       value="{{item.simplified}}" 
                       focus="{{true}}"
                       bindinput="onNewTableNativeInput"
                       bindblur="onNewTableNativeBlur"
                       data-index="{{index}}"
                       data-field="simplified" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.simplified ? '' : 'placeholder'}}">{{item.simplified || '点击输入'}}</text>
              </block>
            </view>
            <!-- SPN列（可编辑） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{newTableEditingIndex === index && newTableEditingField === 'spn' ? 'conversion-cell-active' : ''}}"
                  bindtap="onNewTableCellTap" 
                  data-index="{{index}}" 
                  data-field="spn">
              <block wx:if="{{newTableUseNativeInput && newTableEditingIndex === index && newTableEditingField === 'spn'}}">
                <input class="conversion-native-input" 
                       value="{{item.spn}}" 
                       focus="{{true}}"
                       bindinput="onNewTableNativeInput"
                       bindblur="onNewTableNativeBlur"
                       data-index="{{index}}"
                       data-field="spn" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.spn ? '' : 'placeholder'}}">{{item.spn || '-'}}</text>
              </block>
            </view>
          </view>
          
          <!-- 添加新行 -->
          <view class="conversion-add-row" bindtap="addNewConversionRow">
            <image class="conversion-add-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
            <text class="conversion-add-text">添加行</text>
          </view>
        </scroll-view>
      </view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeNewConversionTableModal">取消</button>
        <button class="btn-primary" bindtap="saveAndApplyNewTable">保存并应用</button>
      </view>
    </view>
