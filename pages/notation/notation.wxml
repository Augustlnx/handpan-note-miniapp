  <!-- 虚拟键盘 -->
  <view class="virtual-keyboard {{showVirtualKeyboard ? 'show' : ''}}" wx:if="{{showVirtualKeyboard}}" catchtap="stopPropagation">
    <!-- 区域A：新布局 -->
    <!-- 第一行：底层代码 + 渲染区 -->
    <view class="vk-display-area-new">
      <!-- 左侧：底层源代码框（带清空按钮） -->
      <view class="vk-display-code-new">
        <text class="vk-code-text">{{virtualKeyboardDisplay || '-'}}</text>
        <view class="vk-code-clear" bindtap="clearInput">
          <image class="vk-code-clear-icon" src="/assets/icons/file_delete.svg" mode="aspectFit"></image>
        </view>
      </view>
      <!-- 右侧：渲染区 -->
      <view class="vk-display-render-new" style="border-color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}}20;">
        <view class="vk-render-container">
          <!-- 左上标（带音高圆点） -->
          <view wx:if="{{vkParsed.leftSup || superscriptMode === 'left'}}" class="vk-sup-box vk-sup-left" style="{{superscriptMode === 'left' ? 'background: ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + '15; border: 2rpx solid ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + ';' : ''}}">
            <view class="vk-sup-note-container">
              <!-- 上标的高音点 -->
              <view wx:if="{{vkParsed.leftSupOctaveUp > 0}}" class="vk-sup-octave-dots vk-sup-octave-up">
                <view wx:for="{{vkParsed.leftSupOctaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
              <text class="vk-sup-text" style="color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};">{{vkParsed.leftSupBase || '　'}}</text>
              <!-- 上标的低音点 -->
              <view wx:if="{{vkParsed.leftSupOctaveDown > 0}}" class="vk-sup-octave-dots vk-sup-octave-down">
                <view wx:for="{{vkParsed.leftSupOctaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
            </view>
          </view>
          <!-- 主音符区域 -->
          <view class="vk-main-note-box" style="{{!superscriptMode ? 'background: ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + '15; border: 2rpx solid ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + ';' : ''}}">
            <view wx:if="{{vkParsed.octaveUp > 0}}" class="vk-octave-dots vk-octave-up">
              <view wx:for="{{vkParsed.octaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
            </view>
            <text class="vk-main-note {{vkParsed.underline ? 'vk-note-underline' : ''}}" style="color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};">{{vkParsed.baseNote || '-'}}</text>
            <view wx:if="{{vkParsed.octaveDown > 0}}" class="vk-octave-dots vk-octave-down">
              <view wx:for="{{vkParsed.octaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
            </view>
          </view>
          <!-- 右上标（带音高圆点） -->
          <view wx:if="{{vkParsed.rightSup || superscriptMode === 'right'}}" class="vk-sup-box vk-sup-right" style="{{superscriptMode === 'right' ? 'background: ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + '15; border: 2rpx solid ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + ';' : ''}}">
            <view class="vk-sup-note-container">
              <!-- 上标的高音点 -->
              <view wx:if="{{vkParsed.rightSupOctaveUp > 0}}" class="vk-sup-octave-dots vk-sup-octave-up">
                <view wx:for="{{vkParsed.rightSupOctaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
              <text class="vk-sup-text" style="color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};">{{vkParsed.rightSupBase || '　'}}</text>
              <!-- 上标的低音点 -->
              <view wx:if="{{vkParsed.rightSupOctaveDown > 0}}" class="vk-sup-octave-dots vk-sup-octave-down">
                <view wx:for="{{vkParsed.rightSupOctaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 第二行：智能工具栏 -->
    <view class="vk-icon-toolbar">
      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="switchKeyboardMode">
          <image class="vk-icon" src="{{virtualKeyboardMode === 'number' ? '/assets/icons/keyboard/keyboard_symbol.png' : '/assets/icons/keyboard/keyboard_num.png'}}" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">{{virtualKeyboardMode === 'number' ? '切换符号' : '切换数字'}}</text>
      </view>
      
      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="addGrid">
          <image class="vk-icon" src="/assets/icons/keyboard/leftadd_cell.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">左加格</text>
      </view>

      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="deleteGrid">
          <image class="vk-icon" src="/assets/icons/keyboard/delete_cell.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">删除格</text>
      </view>

      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="addUnderline">
          <image class="vk-icon" src="/assets/icons/keyboard/underline.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">下划线</text>
      </view>

      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="insertRow">
          <image class="vk-icon" src="/assets/icons/keyboard/add_row_below.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">插入行</text>
      </view>

      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="deleteRow">
          <image class="vk-icon" src="/assets/icons/keyboard/delete_row.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">删除行</text>
      </view>

      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="insertNoteAnnotation">
          <image class="vk-icon" src="/assets/icons/keyboard/insert_note.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">插入注记</text>
      </view>

      <view class="vk-icon-btn-group">
        <view class="vk-icon-btn" bindtap="toggleVirtualKeyboard">
          <image class="vk-icon" src="/assets/icons/keyboard/keyboard-fold.svg" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">切换键盘</text>
      </view>
    </view>

    <!-- 键盘主体区域：左中右三栏布局 -->
    <view class="vk-main-area">
      <!-- 区域D-左侧: 胶囊音高调节器 -->
      <view class="vk-pitch-sidebar">
        <view class="pitch-sidebar-inner">
          <view class="pitch-capsule-outer">
            <!-- 向上箭头按钮 -->
            <view class="pitch-capsule-arrow pitch-arrow-up {{pitchLevel >= 4 ? 'disabled' : ''}}" bindtap="pitchUp">
              <image src="/assets/icons/keyboard/上1_up-one.svg" class="vk-pitch-arrow-icon"></image>
            </view>
            
            <!-- 轨道区域 -->
            <view class="pitch-capsule-track"
                  bindtouchstart="onPitchTouchStart"
                  bindtouchmove="onPitchTouchMove"
                  bindtouchend="onPitchTouchEnd">
              <!-- 刻度线 -->
              <view class="pitch-track-ticks">
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
              </view>
              <!-- 填充条 -->
              <view class="pitch-fill-bar" style="height: {{pitchLevel === 0 ? 20 : pitchLevel === 1 ? 40 : pitchLevel === 2 ? 60 : pitchLevel === 3 ? 80 : 100}}%;">
                <text class="pitch-fill-icon">{{pitchLevelConfig[pitchLevel].icon}}</text>
              </view>
            </view>
            
            <!-- 向下箭头按钮 -->
            <view class="pitch-capsule-arrow pitch-arrow-down {{pitchLevel <= 0 ? 'disabled' : ''}}" bindtap="pitchDown">
              <image src="/assets/icons/keyboard/下1_down-one.svg" class="vk-pitch-arrow-icon"></image>
            </view>
            
            <!-- 档位提示Toast -->
            <view class="pitch-toast {{pitchToastVisible ? 'show' : ''}}">
              <text>{{pitchLevelConfig[pitchLevel].name}}</text>
            </view>
          </view>
          <text class="pitch-side-label" wx:if="{{showKeyboardHelp}}">音高调节器</text>
        </view>
      </view>

      <!-- 区域C: 主数字/符号键盘 -->
      <view class="vk-keypad {{showKeyboardHelp ? 'help-active' : ''}}">
        <!-- 数字键盘模式 -->
        <block wx:if="{{virtualKeyboardMode === 'number'}}">
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="1"><text>1</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="2"><text>2</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="3"><text>3</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="4"><text>4</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="5"><text>5</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="6"><text>6</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="7"><text>7</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="8"><text>8</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="9"><text>9</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key-sup-group {{superscriptMode === 'right' ? 'vk-key-disabled' : ''}}" bindtap="toggleLeftSuperscript">
              <view class="vk-key vk-key-sup {{superscriptMode === 'left' ? 'vk-key-sup-active' : ''}}">
                <image class="vk-sup-btn-icon" src="{{superscriptMode === 'left' ? '/assets/icons/keyboard/left_up_note_active.png' : '/assets/icons/keyboard/left_up_note.png'}}" mode="aspectFit"></image>
                <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'left'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">左上标</text>
                <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'left'}}">完成</text>
              </view>
            </view>
            <view class="vk-key-sup-group">
               <view class="vk-key" bindtap="onVirtualKey" data-key="0"><text>0</text></view>
            </view>
            <view class="vk-key-sup-group {{superscriptMode === 'left' ? 'vk-key-disabled' : ''}}" bindtap="toggleRightSuperscript">
              <view class="vk-key vk-key-sup {{superscriptMode === 'right' ? 'vk-key-sup-active' : ''}}">
                <image class="vk-sup-btn-icon" src="{{superscriptMode === 'right' ? '/assets/icons/keyboard/right_up_note_active.png' : '/assets/icons/keyboard/right_up_note.png'}}" mode="aspectFit"></image>
                <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'right'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">右上标</text>
                <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'right'}}">完成</text>
              </view>
            </view>
          </view>
        </block>
        <!-- 符号键盘模式 -->
        <block wx:else>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="d"><text>d</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="D"><text>D</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="P"><text>P</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="s"><text>s</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="T"><text>T</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="x"><text>x</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="F"><text>F</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="B"><text>B</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="O"><text>O</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key-sup-group {{superscriptMode === 'right' ? 'vk-key-disabled' : ''}}" bindtap="toggleLeftSuperscript">
              <view class="vk-key vk-key-sup {{superscriptMode === 'left' ? 'vk-key-sup-active' : ''}}">
                <image class="vk-sup-btn-icon" src="{{superscriptMode === 'left' ? '/assets/icons/keyboard/left_up_note_active.png' : '/assets/icons/keyboard/left_up_note.png'}}" mode="aspectFit"></image>
                <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'left'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">左上标</text>
                <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'left'}}">完成</text>
              </view>
            </view>
            <view class="vk-key-sup-group">
              <view class="vk-key" bindtap="onVirtualKey" data-key="H"><text>H</text></view>
            </view>
            <view class="vk-key-sup-group {{superscriptMode === 'left' ? 'vk-key-disabled' : ''}}" bindtap="toggleRightSuperscript">
              <view class="vk-key vk-key-sup {{superscriptMode === 'right' ? 'vk-key-sup-active' : ''}}">
                <image class="vk-sup-btn-icon" src="{{superscriptMode === 'right' ? '/assets/icons/keyboard/right_up_note_active.png' : '/assets/icons/keyboard/right_up_note.png'}}" mode="aspectFit"></image>
                <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'right'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">右上标</text>
                <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'right'}}">完成</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 右侧: 方向盘 + 删除键 -->
      <view class="vk-right-panel">
        <!-- 方向控制盘容器（包含帮助按钮） -->
        <view class="vk-direction-pad-container">
          <!-- 帮助按钮（右上角） -->
          <view class="vk-help-corner-btn {{showKeyboardHelp ? 'vk-help-corner-btn--active' : ''}}" bindtap="toggleKeyboardHelp">
            <image 
              class="vk-help-corner-icon {{showKeyboardHelp ? 'vk-help-corner-icon--active' : ''}}" 
              src="{{showKeyboardHelp ? '/assets/icons/keyboard/reduce-help.png' : '/assets/icons/keyboard/helpcenter.png'}}" 
              mode="aspectFit"></image>
          </view>
          <!-- 方向控制盘 -->
          <view class="vk-direction-pad">
            <view class="vk-dir-btn vk-dir-up" bindtap="moveCursorUp"><image src="/assets/icons/keyboard/上_up.svg" class="vk-dir-icon"></image></view>
            <view class="vk-dir-btn vk-dir-left" bindtap="moveCursorLeft"><image src="/assets/icons/keyboard/左_left.svg" class="vk-dir-icon"></image></view>
            <view class="vk-dir-btn vk-dir-center" bindtap="moveToNextLine"><text>⏎</text></view>
            <view class="vk-dir-btn vk-dir-right" bindtap="moveCursorRight"><image src="/assets/icons/keyboard/右_right.svg" class="vk-dir-icon"></image></view>
            <view class="vk-dir-btn vk-dir-down" bindtap="moveCursorDown"><image src="/assets/icons/keyboard/下_down.svg" class="vk-dir-icon"></image></view>
          </view>
        </view>
        <!-- 删除键（单独一行） -->
        <view class="vk-edit-row">
          <view class="vk-edit-btn vk-edit-backspace" bindtap="backspace">
            <image src="/assets/icons/keyboard/删除键_delete-key.svg" class="vk-dir-icon"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 虚拟键盘悬浮按钮（键盘收起时显示） -->
  <view class="vk-float-btn {{showVirtualKeyboard ? 'hide' : ''}}" wx:if="{{editing && !showVirtualKeyboard}}" bindtap="toggleVirtualKeyboard">
    <text class="vk-float-icon"> </text>
  </view>

  <!-- 难度选择弹窗 -->
  <view wx:if="{{showDifficultyModal}}" class="modal-overlay" bindtap="closeDifficultyModal">
    <view class="modal-content difficulty-modal" catchtap="stopPropagation">
      <view class="modal-title">选择难度</view>
      <view class="difficulty-stars">
        <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" 
              class="difficulty-star {{tempDifficulty >= item ? 'active' : ''}}" 
              bindtap="selectDifficulty" data-star="{{item}}">
          <image src="/assets/icons/star.svg" mode="aspectFit" class="star-icon {{tempDifficulty >= item ? 'star-active' : 'star-inactive'}}"></image>
        </view>
      </view>
      <text class="difficulty-hint">点击星星选择难度 (1-5)</text>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeDifficultyModal">取消</button>
        <button class="btn-primary" bindtap="confirmDifficulty">确定</button>
      </view>
    </view>
  </view>

  <!-- 副标题编辑弹窗 -->
  <view wx:if="{{showSubtitleEditModal}}" class="modal-overlay" bindtap="closeSubtitleEditModal">
    <view class="modal-content subtitle-edit-modal" catchtap="stopPropagation">
      <view class="modal-title">编辑曲谱信息</view>
      
      <view class="form-group">
        <text class="form-label">副标题</text>
        <input class="form-input" value="{{tempSubtitle || ''}}" bindinput="onTempSubtitleInput" placeholder="Author: Unknown" />
      </view>
      
      <view class="form-group">
        <text class="form-label">制谱人</text>
        <input class="form-input" value="{{tempComposer || ''}}" bindinput="onTempComposerInput" placeholder="Your Name" />
      </view>
      
      <view class="form-group form-row">
        <view class="form-col">
          <text class="form-label">主音</text>
          <picker mode="selector" range="{{rootNoteDisplayOptions}}" value="{{tempRootNote ? rootNoteOptions.indexOf(tempRootNote) : 2}}" bindchange="onRootNoteChange">
            <view class="picker-value">{{tempRootNote || 'D'}}</view>
          </picker>
        </view>
        <view class="form-col">
          <text class="form-label">调式</text>
          <picker mode="selector" range="{{scaleTypeOptions}}" value="{{tempScaleType ? scaleTypeOptions.indexOf(tempScaleType) : 9}}" bindchange="onScaleTypeChange">
            <view class="picker-value">{{tempScaleType && tempScaleType.indexOf(' / ') > -1 ? tempScaleType.split(' / ')[0] : (tempScaleType || 'Kurd')}}</view>
          </picker>
        </view>
      </view>
      
      <view class="form-group">
        <text class="form-label">音位数</text>
        <picker mode="selector" range="{{noteCountOptions}}" value="{{tempNoteCount ? noteCountOptions.indexOf(tempNoteCount) : 3}}" bindchange="onNoteCountChange">
          <view class="picker-value">{{tempNoteCount || 10}} 音</view>
        </picker>
      </view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeSubtitleEditModal">取消</button>
        <button class="btn-primary" bindtap="confirmSubtitleEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 简介弹窗 -->
  <view wx:if="{{showIntroModal}}" class="modal-overlay" bindtap="closeIntroModal">
    <view class="modal-content intro-modal" catchtap="stopPropagation">
      <view class="modal-title">曲谱简介</view>
      <textarea class="intro-textarea" value="{{tempIntroduction}}" bindinput="onTempIntroInput" placeholder="输入曲谱简介、背景故事、演奏提示等..." maxlength="500"></textarea>
      <text class="intro-counter">{{tempIntroduction.length || 0}}/500</text>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeIntroModal">取消</button>
        <button class="btn-primary" bindtap="confirmIntroEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 删除行确认弹窗 -->
  <view wx:if="{{showDeleteRowModal}}" class="modal-overlay" bindtap="closeDeleteRowModal">
    <view class="modal-content delete-row-modal" catchtap="stopPropagation">
      <view class="modal-title">确认删除</view>
      <view class="modal-description">确定要删除当前行吗？此操作不可撤销。</view>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeDeleteRowModal">取消</button>
        <button class="btn-danger" bindtap="confirmDeleteRow">删除</button>
      </view>
    </view>
  </view>
</view>

