                                <view wx:if="{{utils.parseSimplifiedNote(subdivision.leftHand[1]).rightSup}}" class="note-superscript-container note-sup-right">
                                  <view wx:if="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.leftHand[1]).rightSup).octaveUp > 0}}" class="sup-octave-dots-up">
                                    <view wx:for="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.leftHand[1]).rightSup).octaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="sup-octave-dot" style="width: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{leftHandColor}};"></view>
                                  </view>
                                  <text class="note-superscript" style="font-size: {{utils.getSupFontSize(utils.getFontSize(orientation, notation.style))}}rpx; color: {{leftHandColor}};">{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.leftHand[1]).rightSup).baseNote}}</text>
                                  <view wx:if="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.leftHand[1]).rightSup).octaveDown > 0}}" class="sup-octave-dots-down">
                                    <view wx:for="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.leftHand[1]).rightSup).octaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="sup-octave-dot" style="width: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{leftHandColor}};"></view>
                                  </view>
                                </view>
                              </view>
                              <text wx:else class="note-number placeholder" style="font-size: {{utils.getFontSize(orientation, notation.style)}}rpx;">　</text>
                            </block>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>

                  <!-- 拍子分隔线（右侧，跳过最后一个拍子且不与中间小节线重叠） -->
                  <view wx:if="{{beatIndex < measure.beats.length - 1 && !beat.barLineAfter}}" class="beat-line beat-line-right"></view>

                  <!-- 中间小节线（自定义拍子模式中的分组间分隔线，使用小节线样式） -->
                  <view wx:if="{{beat.barLineAfter}}" class="bar-line bar-line-middle"></view>
                </view>

                <!-- 小节线（右侧） -->
                <view class="bar-line bar-line-right"></view>
              </view>
            </view>
            
            <!-- 添加谱面图标（仅展开状态显示） -->
            <view class="add-notation-row" wx:if="{{!notations[pageModule.index].collapsed}}">
              <image class="add-icon" src="/assets/icons/add.svg" data-after-id="{{notation.id}}" bindtap="addNotationAfter"></image>
              <image class="refresh-icon" src="/assets/icons/refresh.png" data-id="{{notation.id}}" bindtap="refreshNotation"></image>
              <image class="tool-icon" src="/assets/icons/tool.png" data-id="{{notation.id}}" bindtap="openModuleSettings"></image>
              <image class="less-icon" src="/assets/icons/less.png" data-id="{{notation.id}}" bindtap="toggleNotationCollapse"></image>
            </view>
          </block>
        </view>
      </view>
      
      <!-- 手指拖动提示（仅在第一页且有多页时显示） -->
      <view class="hand-drag-hint" wx:if="{{currentPage === 0 && totalPages > 1}}">
        <image src="/assets/icons/hand_drag.png" class="hand-drag-image"></image>
        <text class="hand-drag-text">向左滑动浏览更多</text>
      </view>

      <!-- 手指拖动提示（第2页及以后） -->
      <view class="hand-drag-hint" wx:if="{{currentPage > 0 && totalPages > 1}}">
        <image src="/assets/icons/hand_move.png" class="hand-drag-image"></image>
        <text class="hand-drag-text">左右滑动浏览更多</text>
      </view>
    </view>

    <!-- 分页指示器 -->
    <view class="pagination-indicator" wx:if="{{enablePagination}}">
      <text class="pagination-text">第 {{currentPage + 1}} / {{totalPages}} 页</text>
    </view>
  </view>

  <!-- 页面切换加载遮罩 + 居中Logo + 80BPM悬浮节拍器（置于过渡容器外，避免被淡出遮挡） -->
  <view wx:if="{{showPageLoadingOverlay}}" class="page-loading-overlay">
    <image class="page-loading-logo" src="/assets/img/logo.png" mode="aspectFit"></image>
    <view class="overlay-metronome">
      <view wx:for="{{overlayMetronomeBeats}}" wx:key="index" class="metronome-dot overlay-dot"></view>
    </view>
  </view>

  <!-- 操作按钮（普通模式） -->
  <view wx:if="{{!actionCollapsed && !isPlaybackMode}}" class="action-buttons">
    <!-- 播放按钮（最左侧） -->
    <view class="action-btn" bindtap="togglePlayback">
      <image class="action-btn-icon" src="/assets/icons/play.svg"></image>
      <text class="action-btn-text">播放</text>
    </view>
    <view class="action-btn" bindtap="toggleFloatingMetronome">
      <image class="action-btn-icon" src="/assets/icons/metronome.png"></image>
      <text class="action-btn-text">节拍器</text>
      <view class="help-icon-wrap" catchtap="showMetronomeHelp">
        <image class="help-icon" src="/assets/icons/help.svg"></image>
      </view>
    </view>
    <view class="action-btn" bindtap="resetNotations">
      <image class="action-btn-icon" src="/assets/icons/reset.svg"></image>
      <text class="action-btn-text">重置</text>
    </view>
    <view class="action-btn" bindtap="undo">
      <image class="action-btn-icon" src="/assets/icons/上一步_back.png"></image>
      <text class="action-btn-text">撤销</text>
    </view>
    <view class="action-btn" bindtap="saveToLibrary">
      <image class="action-btn-icon" src="/assets/icons/save.svg"></image>
      <text class="action-btn-text">保存</text>
    </view>
    <view class="action-btn" bindtap="exportPDF">
      <image class="action-btn-icon" src="/assets/icons/download.png"></image>
      <text class="action-btn-text">导出</text>
    </view>
    <view class="action-btn" bindtap="openImportModal">
      <image class="action-btn-icon" src="/assets/icons/upload.png"></image>
      <text class="action-btn-text">导入</text>
    </view>
    <!-- 布局按钮（带二级菜单） -->
    <view class="layout-menu-container">
      <view class="action-btn {{showLayoutMenu ? 'layout-btn-active' : ''}}" bindtap="toggleLayoutMenu">
        <image class="action-btn-icon" src="/assets/icons/layout.svg"></image>
        <text class="action-btn-text">布局</text>
      </view>
      <!-- 布局二级菜单（气泡样式） -->
      <view class="layout-submenu" wx:if="{{showLayoutMenu}}" catchtap="stopPropagation">
        <view class="action-btn" bindtap="toggleReadingMode">
          <image class="action-btn-icon" src="{{readingMode ? '/assets/icons/newspaper-folding-active.png' : '/assets/icons/newspaper-folding.png'}}"></image>
          <text class="action-btn-text">{{readingMode ? '阅读' : '编辑'}}</text>
        </view>
        <view class="action-btn" bindtap="toggleOrientation">
          <image class="action-btn-icon" src="{{orientation === 'landscape' ? '/assets/icons/横屏.svg' : '/assets/icons/竖屏.svg'}}"></image>
          <text class="action-btn-text">{{orientation === 'landscape' ? '紧凑' : '宽松'}}</text>
        </view>
      </view>
    </view>
      <image class="action-collapse-icon" src="/assets/icons/internal-reduction.png" bindtap="toggleActionBar"></image>
      
  </view>

  <!-- ========== 播放模式悬浮控制图标 ========== -->
  <view wx:if="{{isPlaybackMode}}" class="player-floating-controls">
    <!-- 从头开始播放 -->
    <view class="player-floating-btn" bindtap="replayFromStart">
      <image class="player-floating-icon" 
             src="/subpackages/audio/icon/replay.svg"
             mode="aspectFit"></image>
    </view>
    <!-- 左移一格 -->
    <view class="player-floating-btn" bindtap="moveColumnLeft">
      <image class="player-floating-icon" 
             src="/subpackages/audio/icon/left.svg"
             mode="aspectFit"></image>
    </view>
    <!-- 右移一格 -->
    <view class="player-floating-btn" bindtap="moveColumnRight">
      <image class="player-floating-icon" 
             src="/subpackages/audio/icon/right.svg"
             mode="aspectFit"></image>
    </view>
  </view>
  
  <!-- ========== 播放模式菜单栏（三层结构设计） ========== -->
  <view wx:if="{{isPlaybackMode}}" class="player-control-bar">
    
    <!-- 第一层：次级功能行 -->
    <view class="player-secondary-row">
      <!-- 节拍器 -->
      <view class="player-secondary-btn {{metronomeActive ? 'active' : ''}}" bindtap="togglePlaybackMetronome">
        <image class="player-icon-sm" 
               src="{{metronomeActive ? '/subpackages/audio/icon/metronome-active.png' : '/subpackages/audio/icon/metronome.png'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- 速度显示（带内联竖向滑动杠） -->
      <view class="player-tempo-display" bindtap="toggleInlineTempoSlider">
        <image class="player-icon-sm" 
               src="/subpackages/audio/icon/speed.svg"
               mode="aspectFit"></image>
        <text class="player-tempo-value">{{playbackTempo || 80}}</text>
        
        <!-- 内联竖向速度调节杠（自定义触摸实现），范围30~150 -->
        <view wx:if="{{showInlineTempoSlider}}" class="inline-tempo-slider-wrapper" catchtap="stopPropagation">
          <!-- 主容器 -->
          <view class="inline-tempo-slider">
            <text class="inline-tempo-max">150</text>
            <view class="inline-tempo-track"
                  bindtouchstart="onTempoTrackTouchStart"
                  bindtouchmove="onTempoTrackTouchMove"
                  bindtouchend="onTempoTrackTouchEnd">
              <view class="inline-tempo-fill" style="height: {{((playbackTempo - 30) / 120) * 100}}%"></view>
              <view class="inline-tempo-thumb" style="bottom: {{((playbackTempo - 30) / 120) * 100}}%"></view>
            </view>
            <text class="inline-tempo-min">30</text>
            <!-- 底部可输入数字 -->
            <view class="inline-tempo-input-wrapper">
              <input class="inline-tempo-input" 
                     type="number" 
                     value="{{playbackTempo}}" 
                     bindinput="onTempoInputChange"
                     bindblur="onTempoInputBlur"
                     maxlength="3" />
            </view>
          </view>
        </view>
      </view>
      
      <!-- 视角跟随 -->
      <view class="player-secondary-btn {{playbackFollowCursor ? 'active' : ''}}" bindtap="toggleFollowCursorBtn">
        <image class="player-icon-sm" 
               src="{{playbackFollowCursor ? '/subpackages/audio/icon/perspective_follow-active.svg' : '/subpackages/audio/icon/perspective_follow.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- 倒计时 -->
      <view class="player-secondary-btn {{countdownEnabled ? 'active' : ''}}" bindtap="toggleCountdown">
        <image class="player-icon-sm" 
               src="{{countdownEnabled ? '/subpackages/audio/icon/countdown-active.svg' : '/subpackages/audio/icon/countdown.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- 更多设置 -->
      <view class="player-secondary-btn" bindtap="togglePlaybackSettings">
        <image class="player-icon-sm" 
               src="/subpackages/audio/icon/sliders.svg"
               mode="aspectFit"></image>
      </view>
    </view>
    
    <!-- 第二层：进度控制区 -->
    <view class="player-progress-area">
      <view class="player-progress-track" bindtap="seekPlayback" catchtouchmove="onProgressDrag">
        <view class="player-progress-fill" style="width: {{playbackProgress || 0}}%"></view>
        <view class="player-progress-thumb" style="left: {{playbackProgress || 0}}%"></view>
      </view>
      <view class="player-time-labels">
        <text class="player-time-current">{{playbackCurrentTimeStr || '0:00'}}</text>
        <text class="player-time-total">{{playbackDurationStr || '0:00'}}</text>
      </view>
    </view>
    
    <!-- 第三层：主控按钮行 -->
    <view class="player-primary-row">
      <!-- Level 3: 循环模式（最小） -->
      <view class="player-mode-btn" bindtap="togglePlaybackMode">
        <image class="player-icon-xs" 
               src="{{playbackMode === 'loop' ? '/subpackages/audio/icon/repeat.svg' : '/subpackages/audio/icon/repeat-once.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 2: 上一段（中等） -->
      <view class="player-nav-btn" bindtap="playbackPrevModule">
        <image class="player-icon-md" 
               src="/subpackages/audio/icon/skip-back.svg"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 1: 播放/暂停（最大，核心） -->
      <view class="player-play-btn {{isPlaying ? 'playing' : ''}}" bindtap="togglePlayPause">
        <image class="player-play-icon" 
               src="{{isPlaying ? '/subpackages/audio/icon/pause.svg' : '/subpackages/audio/icon/play.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 2: 下一段（中等） -->
      <view class="player-nav-btn" bindtap="playbackNextModule">
        <image class="player-icon-md" 
               src="/subpackages/audio/icon/skip-forward.svg"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 3: 终止/退出（最小） -->
      <view class="player-stop-btn" bindtap="stopAndExitPlayback">
        <image class="player-stop-icon" 
               src="/subpackages/audio/icon/logout.png"
               mode="aspectFit"></image>
      </view>
    </view>
  </view>
  
  <!-- 速度调节弹窗 -->
  <view wx:if="{{showTempoSlider}}" class="player-tempo-overlay" catchtap="hideTempoSlider">
    <view class="player-tempo-panel" catchtap="preventBubble">
      <text class="player-tempo-title">播放速度</text>
      <view class="player-tempo-slider-row">
        <text class="player-tempo-label">30</text>
        <slider class="player-tempo-slider" 
                min="30" max="200" step="1" 
                value="{{playbackTempo}}" 
                activeColor="#8FB9AB"
                backgroundColor="rgba(49, 77, 99, 0.15)"
                block-size="28"
                block-color="#314D63"
                bindchange="onTempoChange"/>
        <text class="player-tempo-label">200</text>
      </view>
      <text class="player-tempo-bpm">♩ = {{playbackTempo}} BPM</text>
    </view>
  </view>
  
  <!-- 更多设置弹窗 -->
  <view wx:if="{{showPlaybackSettings}}" class="player-settings-overlay" catchtap="hidePlaybackSettings">
    <view class="player-settings-panel" catchtap="preventBubble">
      <view class="player-settings-header">
        <text class="player-settings-title">播放设置</text>
        <view class="player-settings-close-btn" bindtap="hidePlaybackSettings">
          <text>✕</text>
        </view>
      </view>
      
      <!-- 节拍器音量 -->
      <view class="player-setting-row">
        <text class="player-setting-label">节拍器音量</text>
        <view class="player-setting-control">
          <slider class="player-setting-slider" 
                  min="0" max="100" step="5" 
                  value="{{metronomeVolume || 50}}" 
                  activeColor="#8FB9AB"
                  backgroundColor="rgba(49, 77, 99, 0.15)"
                  block-size="22"
                  block-color="#314D63"
                  bindchange="onMetronomeVolumeChange"/>
          <text class="player-setting-value">{{metronomeVolume || 50}}%</text>
        </view>
      </view>
      
      <!-- 视角跟随 -->
      <view class="player-setting-row">
        <text class="player-setting-label">视角跟随光标</text>
        <switch class="player-setting-switch" 
                checked="{{playbackFollowCursor}}" 
                color="#8FB9AB"
                bindchange="toggleFollowCursor"/>
      </view>
      
      <!-- 播放模式 -->
      <view class="player-setting-row">
        <text class="player-setting-label">播放模式</text>
        <view class="player-mode-selector">
          <view class="player-mode-opt {{playbackMode === 'single' ? 'selected' : ''}}" 
                bindtap="setPlaybackModeSingle">
            <text>单曲</text>
          </view>
          <view class="player-mode-opt {{playbackMode === 'loop' ? 'selected' : ''}}" 
                bindtap="setPlaybackModeLoop">
            <text>循环</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <image class="action-toggle" 
    src="/assets/icons/toolkit.svg" 
    bindtap="toggleActionBar"
    wx:if="{{actionCollapsed && !isPlaybackMode}}"></image>

  <!-- 播放倒计时遮罩 -->
  <view wx:if="{{showPlaybackCountdown}}" class="playback-countdown-overlay">
    <view class="countdown-content">
      <view class="countdown-circle {{countdownNumber <= 0 ? 'countdown-go' : ''}}">
        <text class="countdown-number">{{countdownNumber > 0 ? countdownNumber : '♪'}}</text>
      </view>
      <view class="countdown-pulse"></view>
    </view>
  </view>

  <!-- 播放资源加载提示 -->
  <view wx:if="{{showPlaybackLoading}}" class="playback-loading-overlay">
    <view class="playback-loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{playbackLoadingText}}</text>
    </view>
  </view>

  <!-- 悬浮节拍器 -->
  <view wx:if="{{showFloatingMetronome}}" class="floating-metronome">
    <view class="metronome-dots">
      <view wx:for="{{metronomeBeats}}" wx:key="index" class="metronome-dot {{currentMetronomeBeat === index ? (index === 0 ? 'active active-accent' : 'active') : ''}}"></view>
    </view>
    <image class="metronome-close" src="/assets/icons/delete.png" bindtap="closeFloatingMetronome"></image>
