  <!-- 虚拟键盘 -->
  <view class="virtual-keyboard {{showVirtualKeyboard ? 'show' : ''}}" wx:if="{{showVirtualKeyboard}}" catchtap="stopPropagation">
    <!-- 区域A：新布局 -->
    <!-- 第一行：底层代码 + 渲染区 -->
    <view class="vk-display-area-new">
      <!-- 左侧：底层源代码框（带清空按钮） -->
      <view class="vk-display-code-new">
        <text class="vk-code-text">{{virtualKeyboardDisplay || '-'}}</text>
        <view class="vk-code-clear" bindtap="clearInput">
          <image class="vk-code-clear-icon" src="/assets/icons/file_delete.svg" mode="aspectFit"></image>
        </view>
      </view>
      <!-- 右侧：渲染区 -->
      <view class="vk-display-render-new" style="border-color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}}20;">
        <view class="vk-render-container">
          <!-- 左上标（带音高圆点） -->
          <view wx:if="{{vkParsed.leftSup || superscriptMode === 'left'}}" class="vk-sup-box vk-sup-left" style="{{superscriptMode === 'left' ? 'background: ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + '15; border: 2rpx solid ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + ';' : ''}}">
            <view class="vk-sup-note-container">
              <!-- 上标的高音点 -->
              <view wx:if="{{vkParsed.leftSupOctaveUp > 0}}" class="vk-sup-octave-dots vk-sup-octave-up">
                <view wx:for="{{vkParsed.leftSupOctaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
              <text class="vk-sup-text" style="color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};">{{vkParsed.leftSupBase || '　'}}</text>
              <!-- 上标的低音点 -->
              <view wx:if="{{vkParsed.leftSupOctaveDown > 0}}" class="vk-sup-octave-dots vk-sup-octave-down">
                <view wx:for="{{vkParsed.leftSupOctaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
            </view>
          </view>
          <!-- 主音符区域 -->
          <view class="vk-main-note-box" style="{{!superscriptMode ? 'background: ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + '15; border: 2rpx solid ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + ';' : ''}}">
            <view wx:if="{{vkParsed.octaveUp > 0}}" class="vk-octave-dots vk-octave-up">
              <view wx:for="{{vkParsed.octaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
            </view>
            <text class="vk-main-note {{vkParsed.underline ? 'vk-note-underline' : ''}}" style="color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};">{{vkParsed.baseNote || '-'}}</text>
            <!-- 低八度圆点 - 当同时有下划线时显示在下划线下方 -->
            <view wx:if="{{vkParsed.octaveDown > 0}}" class="vk-octave-dots vk-octave-down" style="{{vkParsed.underline ? 'margin-top: 10rpx;' : ''}}">
              <view wx:for="{{vkParsed.octaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
            </view>
          </view>
          <!-- 右上标（带音高圆点） -->
          <view wx:if="{{vkParsed.rightSup || superscriptMode === 'right'}}" class="vk-sup-box vk-sup-right" style="{{superscriptMode === 'right' ? 'background: ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + '15; border: 2rpx solid ' + (editing.hand === 'right' ? rightHandColor : leftHandColor) + ';' : ''}}">
            <view class="vk-sup-note-container">
              <!-- 上标的高音点 -->
              <view wx:if="{{vkParsed.rightSupOctaveUp > 0}}" class="vk-sup-octave-dots vk-sup-octave-up">
                <view wx:for="{{vkParsed.rightSupOctaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
              <text class="vk-sup-text" style="color: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};">{{vkParsed.rightSupBase || '　'}}</text>
              <!-- 上标的低音点 -->
              <view wx:if="{{vkParsed.rightSupOctaveDown > 0}}" class="vk-sup-octave-dots vk-sup-octave-down">
                <view wx:for="{{vkParsed.rightSupOctaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="vk-sup-octave-dot" style="background: {{editing.hand === 'right' ? rightHandColor : leftHandColor}};"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 第二行：智能工具栏 -->
    <view class="vk-icon-toolbar {{isCustomizingKeyboard ? 'vk-toolbar-disabled' : ''}}">
      <view class="vk-icon-btn-group {{isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{isCustomizingKeyboard ? '' : 'switchKeyboardMode'}}">
          <image class="vk-icon" src="{{virtualKeyboardMode === 'number' ? '/assets/icons/keyboard/keyboard_symbol.png' : '/assets/icons/keyboard/keyboard_num.png'}}" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">{{virtualKeyboardMode === 'number' ? '切换符号' : '切换数字'}}</text>
      </view>
      
      <!-- 转换弹窗模式或自定义键盘模式下禁用以下功能 -->
      <view class="vk-icon-btn-group {{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? '' : 'addGrid'}}">
          <image class="vk-icon" src="/assets/icons/keyboard/leftadd_cell.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">{{insertDirection === 'left' ? '左加格' : '右加格'}}</text>
      </view>

      <view class="vk-icon-btn-group {{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? '' : 'deleteGrid'}}">
          <image class="vk-icon" src="/assets/icons/keyboard/delete_cell.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">删除格</text>
      </view>

      <view class="vk-icon-btn-group {{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? '' : 'addUnderline'}}">
          <image class="vk-icon" src="/assets/icons/keyboard/underline.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">下划线</text>
      </view>

      <view class="vk-icon-btn-group {{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? '' : 'insertRow'}}">
          <image class="vk-icon" src="/assets/icons/keyboard/add_row_below.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">插入行</text>
      </view>

      <view class="vk-icon-btn-group {{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null || isCustomizingKeyboard ? '' : 'deleteRow'}}">
          <image class="vk-icon" src="/assets/icons/keyboard/delete_row.png" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">删除行</text>
      </view>

      <view class="vk-icon-btn-group {{isCustomizingKeyboard ? 'vk-btn-disabled' : ''}}">
        <view class="vk-icon-btn" bindtap="{{isCustomizingKeyboard ? '' : 'toggleVirtualKeyboard'}}">
          <image class="vk-icon" src="/assets/icons/keyboard/keyboard-fold.svg" mode="aspectFit"></image>
        </view>
        <text class="vk-icon-desc" wx:if="{{showKeyboardHelp}}">切换键盘</text>
      </view>
    </view>

    <!-- 键盘主体区域：左中右三栏布局 -->
    <view class="vk-main-area" wx:if="{{!showKeyboardSettings}}">
      <!-- 区域D-左侧: 胶囊音高调节器 / 替代按键区域 -->
      <view class="vk-pitch-sidebar {{isCustomizingKeyboard ? 'vk-pitch-disabled' : ''}} {{!pitchBarEnabled && virtualKeyboardMode !== 'number' ? 'vk-pitch-bar-disabled' : ''}}">
        <!-- 数字键盘模式下，音高条关闭时显示替代按键区域（D, d, s, P） -->
        <view class="pitch-alt-keys" wx:if="{{!pitchBarEnabled && virtualKeyboardMode === 'number'}}">
          <view class="pitch-alt-key" bindtap="onVirtualKey" data-key="D">
            <text>D</text>
          </view>
          <view class="pitch-alt-key" bindtap="onVirtualKey" data-key="d">
            <text>d</text>
          </view>
          <view class="pitch-alt-key" bindtap="onVirtualKey" data-key="s">
            <text>s</text>
          </view>
          <view class="pitch-alt-key" bindtap="onVirtualKey" data-key="P">
            <text>P</text>
          </view>
        </view>
        <!-- 其他情况显示原有的音高调节器（符号键盘下关闭时变暗禁用） -->
        <view class="pitch-sidebar-inner" wx:else>
          <view class="pitch-capsule-outer {{!pitchBarEnabled ? 'pitch-capsule-disabled' : ''}}">
            <!-- 向上箭头按钮 -->
            <view class="pitch-capsule-arrow pitch-arrow-up {{pitchLevel >= 4 || isCustomizingKeyboard || !pitchBarEnabled ? 'disabled' : ''}}" bindtap="{{isCustomizingKeyboard || !pitchBarEnabled ? '' : 'pitchUp'}}">
              <image src="/assets/icons/keyboard/上1_up-one.svg" class="vk-pitch-arrow-icon"></image>
            </view>
            
            <!-- 轨道区域 -->
            <view class="pitch-capsule-track"
                  bindtouchstart="{{isCustomizingKeyboard || !pitchBarEnabled ? '' : 'onPitchTouchStart'}}"
                  bindtouchmove="{{isCustomizingKeyboard || !pitchBarEnabled ? '' : 'onPitchTouchMove'}}"
                  bindtouchend="{{isCustomizingKeyboard || !pitchBarEnabled ? '' : 'onPitchTouchEnd'}}">
              <!-- 刻度线 -->
              <view class="pitch-track-ticks">
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
                <view class="pitch-tick"></view>
              </view>
              <!-- 填充条：拖动时使用实时进度，否则使用档位对应高度 -->
              <view class="pitch-fill-bar {{pitchDragging ? 'dragging' : ''}}" style="height: {{pitchDragging ? pitchDragProgress : (pitchLevel === 0 ? 20 : pitchLevel === 1 ? 40 : pitchLevel === 2 ? 60 : pitchLevel === 3 ? 80 : 100)}}%;">
                <text class="pitch-fill-icon">{{pitchLevelConfig[pitchLevel].icon}}</text>
              </view>
            </view>
            
            <!-- 向下箭头按钮 -->
            <view class="pitch-capsule-arrow pitch-arrow-down {{pitchLevel <= 0 || isCustomizingKeyboard || !pitchBarEnabled ? 'disabled' : ''}}" bindtap="{{isCustomizingKeyboard || !pitchBarEnabled ? '' : 'pitchDown'}}">
              <image src="/assets/icons/keyboard/下1_down-one.svg" class="vk-pitch-arrow-icon"></image>
            </view>
            
            <!-- 档位提示Toast -->
            <view class="pitch-toast {{pitchToastVisible ? 'show' : ''}}">
              <text>{{pitchLevelConfig[pitchLevel].name}}</text>
            </view>
          </view>
          <text class="pitch-side-label" wx:if="{{showKeyboardHelp && pitchBarEnabled}}">音高调节器</text>
        </view>
      </view>

      <!-- 区域C: 主数字/符号键盘 -->
      <view class="vk-keypad {{showKeyboardHelp ? 'help-active' : ''}}">
        <!-- 数字键盘模式 -->
        <block wx:if="{{virtualKeyboardMode === 'number'}}">
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="1"><text>1</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="2"><text>2</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="3"><text>3</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="4"><text>4</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="5"><text>5</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="6"><text>6</text></view>
          </view>
          <view class="vk-row">
            <view class="vk-key" bindtap="onVirtualKey" data-key="7"><text>7</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="8"><text>8</text></view>
            <view class="vk-key" bindtap="onVirtualKey" data-key="9"><text>9</text></view>
          </view>
          <view class="vk-row-end">
            <view class="vk-key-sup-group {{superscriptMode === 'right' || conversionEditingKey !== null || newTableEditingIndex !== null ? 'vk-key-disabled' : ''}}" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null ? '' : 'toggleLeftSuperscript'}}">
              <view class="vk-key vk-key-sup {{superscriptMode === 'left' ? 'vk-key-sup-active' : ''}}">
                <image class="vk-sup-btn-icon" src="{{superscriptMode === 'left' ? '/assets/icons/keyboard/left_up_note_active.png' : '/assets/icons/keyboard/left_up_note.png'}}" mode="aspectFit"></image>
                <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'left'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">左上标</text>
                <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'left'}}">完成</text>
              </view>
            </view>
            <view class="vk-key-sup-group">
               <view class="vk-key" bindtap="onVirtualKey" data-key="0"><text>0</text></view>
            </view>
            <view class="vk-key-sup-group {{superscriptMode === 'left' || conversionEditingKey !== null || newTableEditingIndex !== null ? 'vk-key-disabled' : ''}}" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null ? '' : 'toggleRightSuperscript'}}">
              <view class="vk-key vk-key-sup {{superscriptMode === 'right' ? 'vk-key-sup-active' : ''}}">
                <image class="vk-sup-btn-icon" src="{{superscriptMode === 'right' ? '/assets/icons/keyboard/right_up_note_active.png' : '/assets/icons/keyboard/right_up_note.png'}}" mode="aspectFit"></image>
                <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'right'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">右上标</text>
                <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'right'}}">完成</text>
              </view>
            </view>
          </view>
        </block>
        <!-- 符号键盘模式 -->
        <block wx:else>
          <!-- 自定义键盘模式 -->
          <block wx:if="{{isCustomizingKeyboard}}">
            <view class="vk-row">
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key1' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key1">
                <input class="vk-custom-input" value="{{customSymbolKeys.key1}}" bindinput="onCustomKeyInput" data-key-index="key1" focus="{{customKeyEditingIndex === 'key1'}}" maxlength="2" />
              </view>
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key2' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key2">
                <input class="vk-custom-input" value="{{customSymbolKeys.key2}}" bindinput="onCustomKeyInput" data-key-index="key2" focus="{{customKeyEditingIndex === 'key2'}}" maxlength="2" />
              </view>
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key3' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key3">
                <input class="vk-custom-input" value="{{customSymbolKeys.key3}}" bindinput="onCustomKeyInput" data-key-index="key3" focus="{{customKeyEditingIndex === 'key3'}}" maxlength="2" />
              </view>
            </view>
            <view class="vk-row">
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key4' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key4">
                <input class="vk-custom-input" value="{{customSymbolKeys.key4}}" bindinput="onCustomKeyInput" data-key-index="key4" focus="{{customKeyEditingIndex === 'key4'}}" maxlength="2" />
              </view>
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key5' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key5">
                <input class="vk-custom-input" value="{{customSymbolKeys.key5}}" bindinput="onCustomKeyInput" data-key-index="key5" focus="{{customKeyEditingIndex === 'key5'}}" maxlength="2" />
              </view>
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key6' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key6">
                <input class="vk-custom-input" value="{{customSymbolKeys.key6}}" bindinput="onCustomKeyInput" data-key-index="key6" focus="{{customKeyEditingIndex === 'key6'}}" maxlength="2" />
              </view>
            </view>
            <view class="vk-row">
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key7' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key7">
                <input class="vk-custom-input" value="{{customSymbolKeys.key7}}" bindinput="onCustomKeyInput" data-key-index="key7" focus="{{customKeyEditingIndex === 'key7'}}" maxlength="2" />
              </view>
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key8' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key8">
                <input class="vk-custom-input" value="{{customSymbolKeys.key8}}" bindinput="onCustomKeyInput" data-key-index="key8" focus="{{customKeyEditingIndex === 'key8'}}" maxlength="2" />
              </view>
              <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key9' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key9">
                <input class="vk-custom-input" value="{{customSymbolKeys.key9}}" bindinput="onCustomKeyInput" data-key-index="key9" focus="{{customKeyEditingIndex === 'key9'}}" maxlength="2" />
              </view>
            </view>
            <view class="vk-row-end">
              <view class="vk-key-sup-group vk-key-disabled">
                <view class="vk-key vk-key-sup">
                  <image class="vk-sup-btn-icon" src="/assets/icons/keyboard/left_up_note.png" mode="aspectFit"></image>
                </view>
              </view>
              <view class="vk-key-sup-group">
                <view class="vk-key vk-key-customizing {{customKeyEditingIndex === 'key10' ? 'vk-key-editing' : ''}}" bindtap="startEditCustomKey" data-key-index="key10">
                  <input class="vk-custom-input" value="{{customSymbolKeys.key10}}" bindinput="onCustomKeyInput" data-key-index="key10" focus="{{customKeyEditingIndex === 'key10'}}" maxlength="2" />
                </view>
              </view>
              <view class="vk-key-sup-group vk-key-disabled">
                <view class="vk-key vk-key-sup">
                  <image class="vk-sup-btn-icon" src="/assets/icons/keyboard/right_up_note.png" mode="aspectFit"></image>
                </view>
              </view>
            </view>
          </block>
          <!-- 正常符号键盘模式 -->
          <block wx:else>
            <view class="vk-row">
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key1}}"><text>{{customSymbolKeys.key1}}</text></view>
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key2}}"><text>{{customSymbolKeys.key2}}</text></view>
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key3}}"><text>{{customSymbolKeys.key3}}</text></view>
            </view>
            <view class="vk-row">
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key4}}"><text>{{customSymbolKeys.key4}}</text></view>
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key5}}"><text>{{customSymbolKeys.key5}}</text></view>
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key6}}"><text>{{customSymbolKeys.key6}}</text></view>
            </view>
            <view class="vk-row">
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key7}}"><text>{{customSymbolKeys.key7}}</text></view>
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key8}}"><text>{{customSymbolKeys.key8}}</text></view>
              <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key9}}"><text>{{customSymbolKeys.key9}}</text></view>
            </view>
            <view class="vk-row-end">
              <view class="vk-key-sup-group {{superscriptMode === 'right' || conversionEditingKey !== null || newTableEditingIndex !== null ? 'vk-key-disabled' : ''}}" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null ? '' : 'toggleLeftSuperscript'}}">
                <view class="vk-key vk-key-sup {{superscriptMode === 'left' ? 'vk-key-sup-active' : ''}}">
                  <image class="vk-sup-btn-icon" src="{{superscriptMode === 'left' ? '/assets/icons/keyboard/left_up_note_active.png' : '/assets/icons/keyboard/left_up_note.png'}}" mode="aspectFit"></image>
                  <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'left'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">左上标</text>
                  <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'left'}}">完成</text>
                </view>
              </view>
              <view class="vk-key-sup-group">
                <view class="vk-key" bindtap="onVirtualKey" data-key="{{customSymbolKeys.key10}}"><text>{{customSymbolKeys.key10}}</text></view>
              </view>
              <view class="vk-key-sup-group {{superscriptMode === 'left' || conversionEditingKey !== null || newTableEditingIndex !== null ? 'vk-key-disabled' : ''}}" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null ? '' : 'toggleRightSuperscript'}}">
                <view class="vk-key vk-key-sup {{superscriptMode === 'right' ? 'vk-key-sup-active' : ''}}">
                  <image class="vk-sup-btn-icon" src="{{superscriptMode === 'right' ? '/assets/icons/keyboard/right_up_note_active.png' : '/assets/icons/keyboard/right_up_note.png'}}" mode="aspectFit"></image>
                  <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && superscriptMode !== 'right'}}" style="color: #314D63; margin-top: 2rpx; font-size: 14rpx; font-weight: bold;">右上标</text>
                  <text class="vk-key-sup-text" wx:if="{{superscriptMode === 'right'}}">完成</text>
                </view>
              </view>
            </view>
          </block>
        </block>
      </view>

      <!-- 右侧: 方向盘 + 删除键 -->
      <view class="vk-right-panel">
        <!-- 方向控制盘容器（包含帮助按钮和快捷移动按钮） -->
        <view class="vk-direction-pad-container {{isCustomizingKeyboard ? 'vk-direction-disabled' : ''}}">
          <!-- 帮助按钮（左上角）- 受 showHelpBtnSetting 控制显示 -->
          <view wx:if="{{showHelpBtnSetting && !isCustomizingKeyboard}}" class="vk-help-corner-btn {{showKeyboardHelp ? 'vk-help-corner-btn--active' : ''}}" bindtap="toggleKeyboardHelp">
            <image 
              class="vk-help-corner-icon {{showKeyboardHelp ? 'vk-help-corner-icon--active' : ''}}" 
              src="{{showKeyboardHelp ? '/assets/icons/keyboard/reduce-help.png' : '/assets/icons/keyboard/helpcenter.png'}}" 
              mode="aspectFit"></image>
          </view>
          <!-- 右上角快捷键：向右上移动 -->
          <view class="vk-diagonal-btn vk-diagonal-up-right {{isCustomizingKeyboard ? 'vk-btn-hidden' : ''}}" bindtap="{{isCustomizingKeyboard ? '' : 'moveCursorUpRight'}}">
            <image src="/assets/icons/keyboard/right-up.png" class="vk-diagonal-icon" mode="aspectFit"></image>
          </view>
          <!-- 右下角快捷键：向右下移动 -->
          <view class="vk-diagonal-btn vk-diagonal-down-right {{isCustomizingKeyboard ? 'vk-btn-hidden' : ''}}" bindtap="{{isCustomizingKeyboard ? '' : 'moveCursorDownRight'}}">
            <image src="/assets/icons/keyboard/right-down.png" class="vk-diagonal-icon" mode="aspectFit"></image>
          </view>
          <!-- 方向控制盘 -->
          <view class="vk-direction-pad {{isCustomizingKeyboard ? 'vk-pad-disabled' : ''}}">
            <view class="vk-dir-btn vk-dir-up" bindtap="{{isCustomizingKeyboard ? '' : 'moveCursorUp'}}"><image src="/assets/icons/keyboard/上_up.svg" class="vk-dir-icon"></image></view>
            <view class="vk-dir-btn vk-dir-left" bindtap="{{isCustomizingKeyboard ? '' : 'moveCursorLeft'}}"><image src="/assets/icons/keyboard/左_left.svg" class="vk-dir-icon"></image></view>
            <view class="vk-dir-btn vk-dir-center" bindtap="{{isCustomizingKeyboard ? '' : 'moveToNextLine'}}"><text>⏎</text></view>
            <view class="vk-dir-btn vk-dir-right" bindtap="{{isCustomizingKeyboard ? '' : 'moveCursorRight'}}"><image src="/assets/icons/keyboard/右_right.svg" class="vk-dir-icon"></image></view>
            <view class="vk-dir-btn vk-dir-down" bindtap="{{isCustomizingKeyboard ? '' : 'moveCursorDown'}}"><image src="/assets/icons/keyboard/下_down.svg" class="vk-dir-icon"></image></view>
          </view>
        </view>
        <!-- 删除键与更多设置（并排一行） -->
        <view class="vk-edit-row">
          <!-- 删除键 - 占2/3宽度 -->
          <view class="vk-edit-btn vk-edit-backspace {{isCustomizingKeyboard ? 'vk-edit-btn-text' : ''}}" bindtap="{{isCustomizingKeyboard ? 'finishCustomizeKeyboard' : 'backspace'}}">
            <block wx:if="{{isCustomizingKeyboard}}">
              <text class="vk-edit-btn-label">完成</text>
            </block>
            <block wx:else>
              <image src="/assets/icons/keyboard/backspace-bold.svg" class="vk-dir-icon"></image>
            </block>
          </view>
          <!-- 更多设置键 - 占1/3宽度 -->
          <view class="vk-edit-btn vk-edit-settings {{isCustomizingKeyboard ? 'vk-edit-btn-text' : ''}}" bindtap="{{isCustomizingKeyboard ? 'resetCustomSymbolKeys' : 'openKeyboardSettings'}}">
            <block wx:if="{{isCustomizingKeyboard}}">
              <text class="vk-edit-btn-label vk-reset-icon">↻</text>
            </block>
            <block wx:else>
              <image src="/assets/icons/keyboard/keyboard_settings.svg" class="vk-dir-icon"></image>
            </block>
            <text class="vk-icon-desc" wx:if="{{showKeyboardHelp && !isCustomizingKeyboard}}">更多设置</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 更多设置界面（覆盖键盘主体区域） -->
    <view class="vk-settings-panel" wx:if="{{showKeyboardSettings}}">
      <!-- 顶部导航栏 -->
      <view class="vk-settings-header">
        <view class="vk-settings-back-btn" bindtap="closeKeyboardSettings">
          <view class="vk-settings-back-icon">
            <image src="/assets/icons/keyboard/左_left.svg" class="vk-dir-icon"></image>
          </view>
        </view>
        <text class="vk-settings-title">更多设置</text>
        <view class="vk-settings-placeholder"></view>
      </view>
      
      <!-- 上2/3区域：功能图标 -->
      <view class="vk-settings-icons-area">
        <!-- 第一行图标 -->
        <view class="vk-settings-icon-row">
          <!-- 插入注记 -->
          <view class="vk-settings-icon-item {{conversionEditingKey !== null || newTableEditingIndex !== null ? 'vk-settings-icon-disabled' : ''}}" bindtap="{{conversionEditingKey !== null || newTableEditingIndex !== null ? '' : 'insertNoteAnnotationFromSettings'}}">
            <view class="vk-settings-icon-box">
              <image class="vk-settings-icon" src="/assets/icons/keyboard/insert_note.png" mode="aspectFit"></image>
            </view>
            <text class="vk-settings-icon-label">插入注记</text>
          </view>
          <!-- 自定义键盘 -->
          <view class="vk-settings-icon-item" bindtap="startCustomizeKeyboard">
            <view class="vk-settings-icon-box">
              <image class="vk-settings-icon" src="/assets/icons/keyboard/keyboard_set.svg" mode="aspectFit"></image>
            </view>
            <text class="vk-settings-icon-label">自定义键盘</text>
          </view>
          <!-- 音高调节开关 -->
          <view class="vk-settings-icon-item {{!pitchBarEnabled ? 'vk-settings-icon-off' : ''}}" bindtap="togglePitchBar">
            <view class="vk-settings-icon-box {{!pitchBarEnabled ? 'vk-settings-icon-box-off' : ''}}">
              <image class="vk-settings-icon {{!pitchBarEnabled ? 'vk-settings-icon-dimmed' : ''}}" src="/assets/icons/keyboard/controler.png" mode="aspectFit"></image>
            </view>
            <text class="vk-settings-icon-label">{{pitchBarEnabled ? '音高条(开)' : '音高条(关)'}}</text>
          </view>
          <!-- 加附点 -->
          <view class="vk-settings-icon-item {{addDotActive ? '' : 'vk-settings-icon-off'}}" bindtap="toggleAddDot">
            <view class="vk-settings-icon-box {{addDotActive ? '' : 'vk-settings-icon-box-off'}}">
              <image class="vk-settings-icon {{addDotActive ? '' : 'vk-settings-icon-dimmed'}}" src="/assets/icons/keyboard/add_dot.png" mode="aspectFit"></image>
            </view>
            <text class="vk-settings-icon-label">{{addDotActive ? '附点(开)' : '附点(关)'}}</text>
          </view>
        </view>
        <!-- 第二行图标 -->
        <view class="vk-settings-icon-row">
          <!-- 加琶音 -->
          <view class="vk-settings-icon-item {{addArpeggioActive ? '' : 'vk-settings-icon-off'}}" bindtap="toggleAddArpeggio">
            <view class="vk-settings-icon-box {{addArpeggioActive ? '' : 'vk-settings-icon-box-off'}}">
              <image class="vk-settings-icon {{addArpeggioActive ? '' : 'vk-settings-icon-dimmed'}}" src="/assets/icons/keyboard/add_arpeggio.png" mode="aspectFit"></image>
            </view>
            <text class="vk-settings-icon-label">{{addArpeggioActive ? '琶音(开)' : '琶音(关)'}}</text>
          </view>
          <view class="vk-settings-icon-item vk-settings-icon-empty"></view>
          <view class="vk-settings-icon-item vk-settings-icon-empty"></view>
          <view class="vk-settings-icon-item vk-settings-icon-empty"></view>
        </view>
      </view>
      
      <!-- 下1/3区域：切换设置 -->
      <view class="vk-settings-toggles-area">
        <!-- 插入方向切换 -->
        <view class="vk-settings-toggle-row">
          <text class="vk-settings-toggle-label">插入音符列位置</text>
          <view class="vk-settings-capsule-switch">
            <view class="vk-capsule-option {{insertDirection === 'right' ? 'vk-capsule-active' : ''}}" bindtap="setInsertDirection" data-direction="right">
              <text>向右插入</text>
            </view>
            <view class="vk-capsule-option {{insertDirection === 'left' ? 'vk-capsule-active' : ''}}" bindtap="setInsertDirection" data-direction="left">
              <text>向左插入</text>
            </view>
          </view>
        </view>
        <!-- 帮助按钮显示切换 -->
        <view class="vk-settings-toggle-row">
          <text class="vk-settings-toggle-label">显示帮助快捷键</text>
          <view class="vk-settings-capsule-switch">
            <view class="vk-capsule-option {{showHelpBtnSetting ? 'vk-capsule-active' : ''}}" bindtap="setShowHelpBtn" data-show="true">
              <text>是</text>
            </view>
            <view class="vk-capsule-option {{!showHelpBtnSetting ? 'vk-capsule-active' : ''}}" bindtap="setShowHelpBtn" data-show="false">
              <text>否</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 虚拟键盘悬浮按钮（键盘收起时显示） -->
  <view class="vk-float-btn {{showVirtualKeyboard ? 'hide' : ''}}" wx:if="{{editing && !showVirtualKeyboard}}" bindtap="toggleVirtualKeyboard">
    <text class="vk-float-icon"> </text>
  </view>

  <!-- 难度选择弹窗 -->
  <view wx:if="{{showDifficultyModal}}" class="modal-overlay" bindtap="closeDifficultyModal">
    <view class="modal-content difficulty-modal" catchtap="stopPropagation">
      <view class="modal-title">选择难度</view>
      <view class="difficulty-stars">
        <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" 
              class="difficulty-star {{tempDifficulty >= item ? 'active' : ''}}" 
              bindtap="selectDifficulty" data-star="{{item}}">
          <image src="/assets/icons/star.svg" mode="aspectFit" class="star-icon {{tempDifficulty >= item ? 'star-active' : 'star-inactive'}}"></image>
        </view>
      </view>
      <text class="difficulty-hint">点击星星选择难度 (1-5)</text>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeDifficultyModal">取消</button>
        <button class="btn-primary" bindtap="confirmDifficulty">确定</button>
      </view>
    </view>
  </view>

  <!-- 副标题编辑弹窗 -->
  <view wx:if="{{showSubtitleEditModal}}" class="modal-overlay" bindtap="closeSubtitleEditModal">
    <view class="modal-content subtitle-edit-modal" catchtap="stopPropagation">
      <view class="modal-title">编辑曲谱信息</view>
      
      <view class="form-group">
        <text class="form-label">副标题</text>
        <input class="form-input" value="{{tempSubtitle || ''}}" bindinput="onTempSubtitleInput" placeholder="Author: Unknown" />
      </view>
      
      <view class="form-group">
        <text class="form-label">制谱人</text>
        <input class="form-input" value="{{tempComposer || ''}}" bindinput="onTempComposerInput" placeholder="Your Name" />
      </view>
      
      <view class="form-group form-row">
        <view class="form-col">
          <text class="form-label">主音</text>
          <view class="picker-value" bindtap="showSubtitleRootNotePicker">
            <text>{{tempRootNote || 'D'}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </view>
        <view class="form-col">
          <text class="form-label">调式</text>
          <view class="picker-value" bindtap="showSubtitleScaleTypePicker">
            <text>{{tempScaleType && tempScaleType.indexOf(' / ') > -1 ? tempScaleType.split(' / ')[0] : (tempScaleType || 'Kurd')}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </view>
      </view>
      
      <view class="form-group">
        <text class="form-label">音位数</text>
        <view class="picker-value" bindtap="showSubtitleNoteCountPicker">
          <text>{{tempNoteCount || 10}} 音</text>
          <text class="picker-arrow">▼</text>
        </view>
      </view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeSubtitleEditModal">取消</button>
        <button class="btn-primary" bindtap="confirmSubtitleEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 副标题编辑-iOS风格主音选择器 -->
  <view wx:if="{{showSubtitleRootNotePicker}}" class="modal-overlay" catchtap="closeSubtitleRootNotePicker">
    <view class="ios-picker-modal" catchtap="stopPropagation">
      <view class="ios-picker-header">
        <text class="ios-picker-cancel" bindtap="closeSubtitleRootNotePicker">取消</text>
        <text class="ios-picker-title">选择主音</text>
        <text class="ios-picker-confirm" bindtap="confirmSubtitleRootNotePicker">确定</text>
      </view>
      <picker-view class="ios-picker-view" value="{{subtitleRootNotePickerValue}}" bindchange="onSubtitleRootNotePickerChange">
        <picker-view-column>
          <view wx:for="{{rootNoteDisplayOptions}}" wx:key="*this" class="ios-picker-item">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 副标题编辑-iOS风格调式选择器 -->
  <view wx:if="{{showSubtitleScaleTypePicker}}" class="modal-overlay" catchtap="closeSubtitleScaleTypePicker">
    <view class="ios-picker-modal" catchtap="stopPropagation">
      <view class="ios-picker-header">
        <text class="ios-picker-cancel" bindtap="closeSubtitleScaleTypePicker">取消</text>
        <text class="ios-picker-title">选择调式</text>
        <text class="ios-picker-confirm" bindtap="confirmSubtitleScaleTypePicker">确定</text>
      </view>
      <picker-view class="ios-picker-view" value="{{subtitleScaleTypePickerValue}}" bindchange="onSubtitleScaleTypePickerChange">
        <picker-view-column>
          <view wx:for="{{scaleTypeOptions}}" wx:key="*this" class="ios-picker-item">{{item.indexOf(' / ') > -1 ? item.split(' / ')[0] : item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 副标题编辑-iOS风格音位数选择器 -->
  <view wx:if="{{showSubtitleNoteCountPicker}}" class="modal-overlay" catchtap="closeSubtitleNoteCountPicker">
    <view class="ios-picker-modal" catchtap="stopPropagation">
      <view class="ios-picker-header">
        <text class="ios-picker-cancel" bindtap="closeSubtitleNoteCountPicker">取消</text>
        <text class="ios-picker-title">选择音位数</text>
        <text class="ios-picker-confirm" bindtap="confirmSubtitleNoteCountPicker">确定</text>
      </view>
      <picker-view class="ios-picker-view" value="{{subtitleNoteCountPickerValue}}" bindchange="onSubtitleNoteCountPickerChange">
        <picker-view-column>
          <view wx:for="{{noteCountOptions}}" wx:key="*this" class="ios-picker-item">{{item}} 音</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- 简介弹窗 -->
  <view wx:if="{{showIntroModal}}" class="modal-overlay" bindtap="closeIntroModal">
    <view class="modal-content intro-modal" catchtap="stopPropagation">
      <view class="modal-title">曲谱简介</view>
      <textarea class="intro-textarea" value="{{tempIntroduction}}" bindinput="onTempIntroInput" placeholder="输入曲谱简介、背景故事、演奏提示等..." maxlength="500"></textarea>
      <text class="intro-counter">{{tempIntroduction.length || 0}}/500</text>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeIntroModal">取消</button>
        <button class="btn-primary" bindtap="confirmIntroEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 删除行确认弹窗 -->
  <view wx:if="{{showDeleteRowModal}}" class="modal-overlay delete-row-overlay" bindtap="closeDeleteRowModal">
    <view class="modal-content delete-row-modal" catchtap="stopPropagation">
      <!-- 警告图标 -->
      <view class="delete-row-icon-wrapper">
        <view class="delete-row-icon">
          <text class="delete-row-icon-text">!</text>
        </view>
      </view>
      
      <!-- 标题 -->
      <view class="delete-row-title">确认删除此行？</view>
      
      <!-- 描述 -->
      <view class="delete-row-desc">
        <text>删除后该行所有音符数据将被清除</text>
        <text class="delete-row-hint">（可通过撤销恢复）</text>
      </view>
      
      <!-- 按钮组 -->
      <view class="delete-row-buttons">
        <button class="delete-row-btn delete-row-btn-cancel" bindtap="closeDeleteRowModal">取消</button>
        <button class="delete-row-btn delete-row-btn-confirm" bindtap="confirmDeleteRow">确认删除</button>
      </view>
    </view>
  </view>

  <!-- 【任务1】删除拍位确认弹窗 -->
  <view wx:if="{{showDeleteBeatModal}}" class="modal-overlay delete-beat-overlay" bindtap="closeDeleteBeatModal">
    <view class="modal-content delete-beat-modal" catchtap="stopPropagation">
      <!-- 警告图标 -->
      <view class="delete-beat-icon-wrapper">
        <view class="delete-beat-icon">
          <text class="delete-beat-icon-text">!</text>
        </view>
      </view>
      
      <!-- 标题 -->
      <view class="delete-beat-title">确认删除此拍？</view>
      
      <!-- 描述 -->
      <view class="delete-beat-desc">
        <text>检测到当前位置后续均为空拍</text>
        <text class="delete-beat-hint">删除后右侧内容将合并过来</text>
      </view>
      
      <!-- 功能切换胶囊 -->
      <view class="delete-beat-toggle-row">
        <text class="delete-beat-toggle-label">删除后续所有空拍</text>
        <view class="delete-beat-toggle {{deleteBeatAllEmpty ? 'active' : ''}}" bindtap="toggleDeleteBeatAllEmpty">
          <view class="delete-beat-toggle-thumb"></view>
        </view>
      </view>
      
      <!-- 按钮组 -->
      <view class="delete-beat-buttons">
        <button class="delete-beat-btn delete-beat-btn-cancel" bindtap="closeDeleteBeatModal">取消</button>
        <button class="delete-beat-btn delete-beat-btn-confirm" bindtap="confirmDeleteBeat">确认删除</button>
      </view>
    </view>
  </view>


  <!-- 【任务2】选中模式顶部提示栏（iOS风格） -->
  <view wx:if="{{isSelectingBeats}}" class="beat-selection-toolbar">
    <view class="selection-toolbar-content">
      <view class="selection-info">
        <view class="selection-icon">
          <image class = "selection-icon-text" src="/assets/icons/check.svg" mode="aspectFit"></image>
        </view>
        <text class="selection-text">选中模式</text>
      </view>
      <view class="selection-actions">
        <view class="selection-count" wx:if="{{beatSelectionStart && beatSelectionEnd}}">
          <text class="count-text">点击首尾拍确定选择范围</text>
        </view>
        <view class="selection-exit-btn" bindtap="exitSelectionMode">
          <text>退出</text>
        </view>
      </view>
    </view>
  </view>
</view>

