            <text wx:if="{{notationType === 'digital'}}" class="conversion-col-header">数字谱</text>
            <text class="conversion-col-header">简谱</text>
            <text class="conversion-col-header">SPN</text>
            <text class="conversion-col-header audio-col-header">音频</text>
          </view>
          
          <!-- 映射行 -->
          <view wx:for="{{audioMappings}}" wx:key="index" class="conversion-row {{notationType === 'simplified' ? 'conversion-row-2col' : 'conversion-row-3col'}} {{!item.hasAudio ? 'audio-row-no-audio' : ''}} {{item.isUsed ? 'audio-row-used' : ''}}">
            <!-- 数字谱列（仅数字谱模式显示，可编辑） -->
            <view wx:if="{{notationType === 'digital'}}" 
                  class="conversion-col-input-wrap conversion-col-3 {{audioMappingEditingIndex === index && audioMappingEditingField === 'key' ? 'conversion-cell-active' : ''}}"
                  bindtap="onAudioMappingCellTap" 
                  data-index="{{index}}" 
                  data-field="key">
              <block wx:if="{{audioMappingUseNativeInput && audioMappingEditingIndex === index && audioMappingEditingField === 'key'}}">
                <input class="conversion-native-input" 
                       value="{{item.key}}" 
                       focus="{{true}}"
                       bindinput="onAudioMappingNativeInput"
                       bindblur="onAudioMappingNativeBlur"
                       data-index="{{index}}"
                       data-field="key" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.key ? '' : 'placeholder'}}">{{item.key || '-'}}</text>
              </block>
            </view>
            
            <!-- 简谱列（可编辑，唤起虚拟键盘） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{audioMappingEditingIndex === index && audioMappingEditingField === 'simplified' ? 'conversion-cell-active' : ''}}" 
                  bindtap="onAudioMappingCellTap" 
                  data-index="{{index}}" 
                  data-field="simplified">
              <block wx:if="{{audioMappingUseNativeInput && audioMappingEditingIndex === index && audioMappingEditingField === 'simplified'}}">
                <input class="conversion-native-input" 
                       value="{{item.simplified}}" 
                       focus="{{true}}"
                       bindinput="onAudioMappingNativeInput"
                       bindblur="onAudioMappingNativeBlur"
                       data-index="{{index}}"
                       data-field="simplified" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.simplified ? '' : 'placeholder'}}">{{item.simplified || '点击输入'}}</text>
              </block>
            </view>
            
            <!-- SPN列（可编辑） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{audioMappingEditingIndex === index && audioMappingEditingField === 'spn' ? 'conversion-cell-active' : ''}} {{!item.hasAudio ? 'spn-no-audio' : ''}}"
                  bindtap="onAudioMappingCellTap" 
                  data-index="{{index}}" 
                  data-field="spn">
              <block wx:if="{{audioMappingUseNativeInput && audioMappingEditingIndex === index && audioMappingEditingField === 'spn'}}">
                <input class="conversion-native-input" 
                       value="{{item.spn}}" 
                       focus="{{true}}"
                       bindinput="onAudioMappingNativeInput"
                       bindblur="onAudioMappingNativeBlur"
                       data-index="{{index}}"
                       data-field="spn" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.spn ? '' : 'placeholder'}}">{{item.spn || '-'}}</text>
              </block>
            </view>
            
            <!-- 音频状态/试听列 -->
            <view class="audio-preview-col" bindtap="previewAudio" data-index="{{index}}">
              <block wx:if="{{item.hasAudio}}">
                <view class="audio-preview-btn {{audioMappingPreviewPlaying === index ? 'playing' : ''}}">
                  <image class="audio-preview-icon" src="/subpackages/audio/icon/{{audioMappingPreviewPlaying === index ? 'pause' : 'play'}}.svg" mode="aspectFit"></image>
                </view>
              </block>
              <block wx:else>
                <text class="audio-no-file">无音频</text>
              </block>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 提示文字 -->
      <view class="conversion-hint">
        <text class="conversion-tip">点击单元格编辑映射，点击右侧按钮试听音频</text>
      </view>

      <!-- 保存映射到曲谱选项 -->
      <view class="save-mapping-option">
        <view class="save-mapping-left">
          <text class="save-mapping-label">保存映射并隐藏下次弹窗</text>
          <text class="save-mapping-desc">可在播放器设置中重新调整</text>
        </view>
        <view class="save-mapping-toggle {{saveAudioMappingToScore ? 'active' : ''}}" bindtap="toggleSaveAudioMapping">
          <view class="toggle-track">
            <view class="toggle-thumb"></view>
          </view>
        </view>
      </view>

      <!-- 新音符提示 -->
      <view wx:if="{{audioMappingNewNotesHint}}" class="new-notes-hint">
        <text class="new-notes-icon">⚠</text>
        <text class="new-notes-text">{{audioMappingNewNotesHint}}</text>
      </view>

      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeAudioMappingModal">取消</button>
        <button class="btn-primary" bindtap="confirmAudioMappingAndPlay">开始播放</button>
      </view>
    </view>
  </view>

  <!-- 音频映射表库弹窗（复用转换表库样式） -->
  <view wx:if="{{showAudioMappingLibrary}}" class="modal-overlay audio-mapping-library-overlay" catchtap="closeAudioMappingLibrary" catchtouchmove="stopPropagation">
    <view class="modal-content conversion-library-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">转换表库</text>
        <image class="modal-close-icon" src="/assets/icons/delete.png" bindtap="closeAudioMappingLibrary"></image>
      </view>
      
      <scroll-view class="conversion-library-list" scroll-y>
        <!-- 默认转换表 -->
        <view class="conversion-library-item {{currentAudioMappingTableId === null ? 'active' : ''}}" bindtap="selectAudioMappingTable" data-id="{{null}}">
          <view class="library-item-info">
            <text class="library-item-name">默认转换表</text>
            <text class="library-item-desc">系统内置，不可删除</text>
          </view>
        </view>
        
        <!-- 用户保存的转换表 -->
        <view wx:for="{{conversionTableLibrary}}" wx:key="id" class="conversion-library-item {{currentAudioMappingTableId === item.id ? 'active' : ''}}">
          <view class="library-item-info" bindtap="selectAudioMappingTable" data-id="{{item.id}}">
            <text class="library-item-name">{{item.name}}</text>
            <text class="library-item-desc">{{item.createTime}}</text>
          </view>
        </view>
        
        <!-- 新建转换表按钮 -->
        <view class="conversion-library-add" bindtap="openNewAudioMappingTable">
          <image class="library-add-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
          <text class="library-add-text">新建转换表</text>
        </view>
      </scroll-view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeAudioMappingLibrary">取消</button>
        <button class="btn-primary" bindtap="openSelectedAudioMappingTable">打开</button>
      </view>
    </view>
  </view>
  
  <!-- 新建/编辑音频映射转换表弹窗 -->
  <view wx:if="{{showNewAudioMappingTableModal}}" class="modal-overlay new-audio-mapping-table-overlay" catchtap="closeNewAudioMappingTable" catchtouchmove="stopPropagation">
    <view class="modal-content new-conversion-table-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editingAudioMappingTableId ? '编辑转换表' : '新建转换表'}}</text>
        <image class="modal-close-icon" src="/assets/icons/delete.png" bindtap="closeNewAudioMappingTable"></image>
      </view>
      
      <!-- 转换表名称输入 -->
      <input class="new-table-name-input" 
             value="{{newAudioMappingTableName}}" 
             placeholder="输入转换表名称"
             bindinput="onNewAudioMappingTableNameInput" />
      
      <!-- 首调设置 -->
      <view class="conversion-info-row">
        <view class="conversion-root-note-bar" bindtap="showNewAudioTableRootPicker">
          <text class="conversion-root-label">首调</text>
          <view class="conversion-root-box">
            <text class="conversion-root-text">{{newAudioTableRootNote || 'F3'}}=1</text>
          </view>
        </view>
      </view>
      
      <!-- 转换表编辑区（四列：数字谱-简谱-SPN-音频） -->
      <view class="conversion-table-container">
        <scroll-view class="conversion-table-scroll" scroll-y>
          <!-- 表头 -->
          <view class="conversion-table-header new-audio-table-header">
            <text class="conversion-col-header">数字谱</text>
            <text class="conversion-col-header">简谱</text>
            <text class="conversion-col-header">SPN</text>
            <text class="conversion-col-header audio-col-header">音频</text>
          </view>
          
          <!-- 映射行 -->
          <view wx:for="{{newAudioMappingTableData}}" wx:key="index" class="conversion-row new-audio-table-row">
            <!-- 数字谱列（可编辑，原生键盘） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{newAudioTableEditingIndex === index && newAudioTableEditingField === 'key' ? 'conversion-cell-active' : ''}}"
                  bindtap="onNewAudioTableCellTap" 
                  data-index="{{index}}" 
                  data-field="key">
              <block wx:if="{{newAudioTableUseNativeInput && newAudioTableEditingIndex === index && newAudioTableEditingField === 'key'}}">
                <input class="conversion-native-input" 
                       value="{{item.key}}" 
                       focus="{{true}}"
                       bindinput="onNewAudioTableNativeInput"
                       bindblur="onNewAudioTableNativeBlur"
                       data-index="{{index}}"
                       data-field="key" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.key ? '' : 'placeholder'}}">{{item.key || '-'}}</text>
              </block>
            </view>
            
            <!-- 简谱列（可编辑，虚拟键盘） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{newAudioTableEditingIndex === index && newAudioTableEditingField === 'simplified' ? 'conversion-cell-active' : ''}}"
                  bindtap="onNewAudioTableCellTap" 
                  data-index="{{index}}" 
                  data-field="simplified">
              <block wx:if="{{newAudioTableUseNativeInput && newAudioTableEditingIndex === index && newAudioTableEditingField === 'simplified'}}">
                <input class="conversion-native-input" 
                       value="{{item.simplified}}" 
                       focus="{{true}}"
                       bindinput="onNewAudioTableNativeInput"
                       bindblur="onNewAudioTableNativeBlur"
                       data-index="{{index}}"
                       data-field="simplified" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.simplified ? '' : 'placeholder'}}">{{item.simplified || '-'}}</text>
              </block>
            </view>
            
            <!-- SPN列（可编辑，原生键盘） -->
            <view class="conversion-col-input-wrap conversion-col-3 {{newAudioTableEditingIndex === index && newAudioTableEditingField === 'spn' ? 'conversion-cell-active' : ''}} {{!item.hasAudio ? 'spn-no-audio' : ''}}"
                  bindtap="onNewAudioTableCellTap" 
                  data-index="{{index}}" 
                  data-field="spn">
              <block wx:if="{{newAudioTableUseNativeInput && newAudioTableEditingIndex === index && newAudioTableEditingField === 'spn'}}">
                <input class="conversion-native-input" 
                       value="{{item.spn}}" 
                       focus="{{true}}"
                       bindinput="onNewAudioTableNativeInput"
                       bindblur="onNewAudioTableNativeBlur"
                       data-index="{{index}}"
                       data-field="spn" />
              </block>
              <block wx:else>
                <text class="conversion-col-value {{item.spn ? '' : 'placeholder'}}">{{item.spn || '-'}}</text>
              </block>
            </view>
            
            <!-- 音频状态列 -->
            <view class="audio-preview-col">
              <block wx:if="{{item.hasAudio}}">
                <view class="audio-status-ok">✓</view>
              </block>
              <block wx:else>
                <text class="audio-no-file">无</text>
              </block>
            </view>
          </view>
          
          <!-- 添加行按钮 -->
          <view class="conversion-add-row" bindtap="addNewAudioTableRow">
            <image class="conversion-add-icon" src="/assets/icons/add.svg" mode="aspectFit"></image>
            <text class="conversion-add-text">添加行</text>
          </view>
        </scroll-view>
      </view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeNewAudioMappingTable">取消</button>
        <button class="btn-primary" bindtap="applyNewAudioMappingTable">应用</button>
      </view>
    </view>
  </view>

