        <view class="modal-title">保存到曲库</view>
      </view>
      <view class="import-description">
        <text>输入文件名，并选择保存位置</text>
      </view>
      <input class="modal-input" value="{{saveFileName}}" placeholder="文件名" bindinput="onSaveFileNameInput" />

      <view class="save-path-bar">
        <view class="save-breadcrumb">
          <text class="save-breadcrumb-item" bindtap="navigateSaveRoot">主目录</text>
          <block wx:for="{{saveFolderBreadcrumbs}}" wx:key="id">
            <text class="save-breadcrumb-separator">/</text>
            <text class="save-breadcrumb-item" bindtap="navigateSaveBreadcrumb" data-index="{{index}}">{{item.name}}</text>
          </block>
        </view>
      </view>
      <view class="save-action-bar" wx:if="{{saveFolderCurrentPath.length > 0}}">
        <view class="save-back-btn" bindtap="backSaveFolder">
          <image class="save-back-icon" src="/assets/icons/上一步_back.png" mode="aspectFit"></image>
        </view>
      </view>

      <scroll-view class="save-folder-list" scroll-y>
        <block wx:for="{{saveFolderItems}}" wx:key="id">
          <view class="save-list-item save-folder-item" wx:if="{{item.type === 'folder'}}" bindtap="enterSaveFolder" data-item="{{item}}">
            <image class="save-item-icon" src="/assets/icons/文件夹-开_folder-open.png" mode="aspectFit"></image>
            <view class="save-item-info">
              <text class="save-item-name">{{item.name}}</text>
              <text class="save-item-detail">{{item.fileCount || 0}} 个项目</text>
            </view>
          </view>
          <view class="save-list-item save-file-item" wx:else>
            <view class="save-file-icon">♪</view>
            <view class="save-item-info">
              <text class="save-item-name">{{item.file_name}}</text>
              <text class="save-item-detail">{{item.tempo}} BPM · {{item.timing}}</text>
            </view>
          </view>
        </block>
        <view class="save-empty-state" wx:if="{{saveFolderItems.length === 0}}">
