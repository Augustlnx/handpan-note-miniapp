<wxs module="utils">
// 横屏缩放比例：18/28
var LANDSCAPE_SCALE = 18 / 28;
// 定义常用字符常量，避免WXS中引号嵌套问题
var CHAR_QUOTE = "'";  // 单引号
var CHAR_COMMA = ",";  // 逗号
var CHAR_UNDERSCORE = "_"; // 下划线
var getFontSize = function(orientation, style) {
  var baseSize = 28;
  if (style && style.noteFontSize) {
    baseSize = parseInt(style.noteFontSize, 10);
    if (isNaN(baseSize)) {
      baseSize = 28;
    }
  }
  
  if (orientation === 'landscape') {
    return (baseSize * LANDSCAPE_SCALE);
  }
  return baseSize;
}

// 获取单行高度（根据横竖屏自动缩放）
// 存储的是竖屏基准值，横屏时按18/28缩放
var getMeasureHeight = function(orientation, style, isMultiMeasure) {
  var defaultHeight = isMultiMeasure ? 110 : 160;
  var measureHeight = (style && style.measureHeight) ? parseInt(style.measureHeight, 10) : defaultHeight;
  if (isNaN(measureHeight)) {
    measureHeight = defaultHeight;
  }
  if (orientation === 'landscape') {
    return Math.round(measureHeight * LANDSCAPE_SCALE);
  }
  return measureHeight;
}

// 获取行间距（根据横竖屏自动缩放）
// 存储的是竖屏基准值，横屏时按18/28缩放
var getLineSpacing = function(orientation, style) {
  var defaultSpacing = 65;
  var lineSpacing = (style && style.lineSpacing) ? parseInt(style.lineSpacing, 10) : defaultSpacing;
  if (isNaN(lineSpacing)) {
    lineSpacing = defaultSpacing;
  }
  if (orientation === 'landscape') {
    return Math.round(lineSpacing * LANDSCAPE_SCALE);
  }
  return lineSpacing;
}

// 计算音符槽位高度（根据单行高度按比例缩放）
// 默认: measureHeight=160rpx, slotHeight=36rpx, 比例=0.225
var getSlotHeight = function(orientation, style, isMultiMeasure) {
  var measureHeight = getMeasureHeight(orientation, style, isMultiMeasure);
  // 默认槽位高度比例: 36/160 = 0.225
  var height = Math.round(measureHeight * 0.225);
  // 限制最小和最大值
  if (height < 18) height = 18;
  if (height > 60) height = 60;
  return height;
}

// 计算音符列间距（根据单行高度按比例缩放）
// 默认: measureHeight=160rpx, gap=8rpx, 比例=0.05
var getColumnGap = function(orientation, style, isMultiMeasure) {
  var measureHeight = getMeasureHeight(orientation, style, isMultiMeasure);
  // 默认间距比例: 8/160 = 0.05
  var gap = Math.round(measureHeight * 0.05);
  // 限制最小和最大值
  if (gap < 4) gap = 4;
  if (gap > 16) gap = 16;
  return gap;
}

// 解析简谱音符，提取基础音符、八度偏移量、时值减半标记和上标



// 支持格式: 1(单引号), 1,, 1_, ^{H}1, 1^{H}, ^{L}1^{R}

// 返回: { baseNote: (单引号)1(单引号), octaveUp: 1, octaveDown: 0, underline: true, leftSup: (单引号)H(单引号), rightSup:(单引号)(单引号)}
var parseSimplifiedNote = function(note) {
  if (!note || note === '') {
    return { baseNote: '', octaveUp: 0, octaveDown: 0, underline: false, leftSup: '', rightSup: '' };
  }
  
  var octaveUp = 0;
  var octaveDown = 0;
  var underline = false;
  var baseNote = '';
  var leftSup = '';
  var rightSup = '';
  var remaining = note;
  
  // 解析左上标 ^{...}
  // var caretBrace = '^' + '\{';
  var caretBrace = '^' ;
  if (remaining.indexOf(caretBrace) === 0) {
    var endIdx = remaining.indexOf('}');
    if (endIdx > 2) {
      leftSup = remaining.substring(2, endIdx);
      remaining = remaining.substring(endIdx + 1);
    }
  }
  
  // 解析右上标 ...^{...}
  var rightSupIdx = remaining.lastIndexOf(caretBrace);
  if (rightSupIdx > 0) {
    var endBrace = remaining.indexOf('}', rightSupIdx);
    if (endBrace > rightSupIdx + 2) {
      rightSup = remaining.substring(rightSupIdx + 2, endBrace);
      remaining = remaining.substring(0, rightSupIdx);
    }
  }
  
  // 统计 上引号的数量（高八度）
  for (var i = 0; i < remaining.length; i++) {
    if (remaining[i] === "'") {
      octaveUp++;
    }
  }

  // 统计 , 的数量（降八度）
  for (var i = 0; i < remaining.length; i++) {
    if (remaining[i] === ',') {
      octaveDown++;
    }
  }
  
  // 检查是否有 _ （时值减半下划线）
  if (remaining.indexOf('_') !== -1) {
    underline = true;
  }
  
  // 提取基础音符（移除 上单引号、, 和 _）
  for (var i = 0; i < remaining.length; i++) {
    if (remaining[i] !== "'" && remaining[i] !== ',' && remaining[i] !== '_') {
      baseNote += remaining[i];
    }
  }
  
  return {
    baseNote: baseNote,
    octaveUp: octaveUp,
    octaveDown: octaveDown,
    underline: underline,
    leftSup: leftSup,
    rightSup: rightSup
  };
};

// 解析上标内容的音高信息
var parseSupContent = function(supStr) {
  var result = {
    baseNote: '',
    octaveUp: 0,
    octaveDown: 0
  };
  
  if (!supStr || supStr === '') return result;
  
  // 统计 ‘ 的数量（升八度）
  for (var i = 0; i < supStr.length; i++) {
    if (supStr[i] === "'") {
      result.octaveUp++;
    }
  }
  
  // 统计 , 的数量（降八度）
  for (var i = 0; i < supStr.length; i++) {
    if (supStr[i] === ',') {
      result.octaveDown++;
    }
  }
  
  // 提取基础音符（移除特殊符号）
  for (var i = 0; i < supStr.length; i++) {
    if (supStr[i] !== "'" && supStr[i] !== ',') {
      result.baseNote += supStr[i];
    }
  }
  
  return result;
}

// 获取上标的音高点大小（比主音符的点更小）
var getSupOctaveDotSize = function(fontSize) {
  var size = Math.round(fontSize * 0.18);
  if (size < 3) size = 3;
  if (size > 6) size = 6;
  return size;
}

// 获取上标字号（相对于主音符字号）
var getSupFontSize = function(fontSize) {
  return Math.round(fontSize * 0.55);
}

// 获取上标偏移量
var getSupOffset = function(fontSize) {
  return Math.round(fontSize * 0.4);
}

// 获取八度点的大小（根据字号缩放）
var getOctaveDotSize = function(fontSize) {
  // 默认字号28对应点大小6rpx，按比例缩放
  // 调整倍数以获得更好的视觉效果：fontSize * 0.1（更大的点）
  var size = Math.round(fontSize * 0.25);
  if (size < 5) size = 5;   // 最小5rpx
  if (size > 12) size = 12; // 最大12rpx
  return size;
}

// 获取八度点的间距
var getOctaveDotGap = function(fontSize) {
  var gap = Math.round(fontSize * 0.12);
  if (gap < 2) gap = 2;
  if (gap > 6) gap = 6;
  return gap;
}

// 获取八度点距离音符的偏移
var getOctaveOffset = function(fontSize, isUp) {
  var offset = Math.round(fontSize * 0.35);
  if (offset < 6) offset = 6;
  if (offset > 14) offset = 14;
  return offset;
}

// 获取下划线粗细（根据字号动态调整）
var getUnderlineThickness = function(fontSize) {
  // 默认字号28对应下划线粗细4rpx
  var thickness = Math.round(fontSize * 0.14);
  if (thickness < 2) thickness = 2;   // 最小2rpx
  if (thickness > 6) thickness = 6;   // 最大6rpx
  return thickness;
}

// 获取下划线偏移（距离基线的距离）
var getUnderlineOffset = function(fontSize) {
  var offset = Math.round(fontSize * 0.04);
  if (offset < 1) offset = 1;
  if (offset > 4) offset = 4;
  return offset;
}

module.exports = {
  getFontSize: getFontSize,
  getMeasureHeight: getMeasureHeight,
  getLineSpacing: getLineSpacing,
  getSlotHeight: getSlotHeight,
  getColumnGap: getColumnGap,
  parseSimplifiedNote: parseSimplifiedNote,
  parseSupContent: parseSupContent,
  getOctaveDotSize: getOctaveDotSize,
  getOctaveDotGap: getOctaveDotGap,
  getOctaveOffset: getOctaveOffset,
  getSupFontSize: getSupFontSize,
  getSupOffset: getSupOffset,
  getSupOctaveDotSize: getSupOctaveDotSize,
  getUnderlineThickness: getUnderlineThickness,
  getUnderlineOffset: getUnderlineOffset
};
</wxs>

<!-- 自定义导航栏 -->
<view class="custom-nav-bar">
  <view class="nav-bar-content">
    <text class="nav-bar-title">Orbit Note</text>
  </view>
</view>

<view class="notation-container {{rotationEnabled ? 'rotation-mode' : ''}} {{orientation === 'landscape' ? 'landscape-mode' : ''}} {{showVirtualKeyboard ? 'keyboard-active' : ''}}" catchtap="clearEditing">
  <!-- 背景图片装饰（固定右下角，半透明，层级低于菜单栏） -->
  <image class="background-image" src="/assets/img/bg2.png" mode="widthFix" style="opacity: {{backgroundOpacity}}"></image>
  
  <!-- 分页容器：处理触摸事件 -->
  <view id="notation-pages" class="notation-pages-wrapper {{pageTransitioning ? 'page-transition-out' : 'page-transition-in'}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <!-- 标题区（仅在第一页显示） -->
    <view class="header-section" wx:if="{{currentPage === 0}}">
      <!-- 右上角简介图标 -->
      <image class="intro-icon" src="/assets/icons/信息_info.svg" bindtap="openIntroModal" mode="aspectFit"></image>
      
      <!-- 主标题 -->
      <text class="main-title" bindtap="editTitle" style="color: {{mainTitleColor}}">{{mainTitle}}</text>
      
      <!-- 副标题行 -->
      <view class="sub-title-row" bindtap="editSubTitle">
        <text class="sub-title" style="color: {{subTitleColor}}">{{subTitle}}</text>
        <text class="sub-title-divider" style="color: {{subTitleColor}}">|</text>
        <text class="sub-title" style="color: {{subTitleColor}}">{{composer}}</text>
        <text class="sub-title-divider" style="color: {{subTitleColor}}">|</text>
        <text class="sub-title" style="color: {{subTitleColor}}">{{rootNote}}-{{scaleType.indexOf(' / ') > -1 ? scaleType.split(' / ')[0] : scaleType}} {{noteCount}}音</text>
      </view>
      
      <!-- 参数信息区（网格布局） -->
      <view class="params-grid">
        <!-- 第一行：速度 | 拍号 | 谱式 -->
        <view class="param-row">
          <!-- 左侧：速度 -->
          <view class="param-item-group" bindtap="editGlobalTempo">
            <image class="param-icon" src="/assets/icons/timing.png" mode="aspectFit"></image>
            <text class="param-label">速度：</text>
            <text class="param-value">{{globalTempo}}</text>
          </view>
          
          <!-- 中间：拍号 -->
          <view class="param-item-group" bindtap="openTimeSignaturePicker">
            <image class="param-icon" src="/assets/icons/tim_signature.svg" mode="aspectFit"></image>
            <text class="param-label">拍号：</text>
            <text class="param-value">{{currentTimeSignatureType === 'custom' ? '自由' : timeSignatureBeats + '/' + timeSignatureBottom}}</text>
          </view>
          
          <!-- 右侧：谱式 -->
          <view class="param-item-group" bindtap="openNotationTypeModal">
            <image class="param-icon" src="/assets/icons/note_change.png" mode="aspectFit"></image>
            <text class="param-label">谱式：</text>
            <text class="param-value">{{notationType === 'simplified' ? '简谱' : '数字谱'}}</text>
          </view>
        </view>
        
        <!-- 第二行：难度 | 存储（两端对齐） -->
        <view class="param-row param-row-spread">
          <!-- 左侧：难度 -->
          <view class="param-item-group" bindtap="openDifficultyModal">
            <image class="param-icon" src="/assets/icons/crown.svg" mode="aspectFit"></image>
            <text class="param-label">难度:</text>
            <view class="difficulty-stars-display">
              <image wx:for="{{[1,2,3,4,5]}}" wx:key="*this" 
                     src="/assets/icons/star.svg" 
                     class="difficulty-star-small {{difficulty >= item ? 'star-active-small' : 'star-inactive-small'}}" 
                     mode="aspectFit"></image>
            </view>
          </view>
          
          <!-- 右侧：存储 -->
          <view class="param-item-group">
            <image class="param-icon" src="/assets/icons/location.svg" mode="aspectFit"></image>
            <text class="param-label">存储：</text>
            <text class="param-value param-storage">{{storageDisplay}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 谱面列表（仅显示当前页的modules） -->
    <view class="notation-list">
      <view wx:for="{{currentPageModules}}" wx:key="id" class="notation-sheet {{notations[pageModule.index].collapsed ? 'collapsed' : ''}}" wx:for-item="pageModule">
        <!-- 使用 pageModule.index 访问原始 notations 数组中的数据 -->
        <view wx:if="{{notations[pageModule.index]}}">
          <!-- 定义引用以简化代码 -->
          <block wx:key="id" wx:for-item="notation" wx:for-index="notationItemIdx" wx:for="{{[notations[pageModule.index]]}}">
            <!-- 删除图标（右上角） -->
            <image class="delete-icon" src="/assets/icons/delete.png" data-id="{{notation.id}}" bindtap="deleteNotation" wx:if="{{!notations[pageModule.index].collapsed}}"></image>
            
            <!-- 收起状态时显示more.png -->
            <image class="more-icon-top-right" src="/assets/icons/more.png" data-id="{{notation.id}}" bindtap="toggleNotationCollapse" wx:if="{{notations[pageModule.index].collapsed}}"></image>
            
            <!-- 谱面信息 -->
            <view class="sheet-info">
              <view class="sheet-label" bindtap="editLabel" data-id="{{notation.id}}">
                <text>{{notation.label}}</text>
              </view>
              <text wx:if="{{notation.remark}}" class="sheet-remark">{{notation.remark}}</text>
            </view>

            <!-- 谱面内容 -->
            <view class="staff-container {{(notation.measuresPerRow || measuresPerRow) > 1 ? 'multi-measure' : 'single-measure'}}" style="row-gap: {{utils.getLineSpacing(orientation, notation.style)}}rpx;">
              <view wx:for="{{notation.measures}}" wx:key="index" wx:for-item="measure" wx:for-index="measureIndex" class="measure" style="width: {{100 / (notation.measuresPerRow || measuresPerRow)}}%; height: {{utils.getMeasureHeight(orientation, notation.style, (notation.measuresPerRow || measuresPerRow) > 1)}}rpx;">
                <!-- 小节编号（上方居中） -->
                <view class="measure-index">{{(notation.measureOffset || 0) + measureIndex + 1}}</view>
                <!-- 小节线（左侧） -->
                <view wx:if="{{measureIndex % (notation.measuresPerRow || measuresPerRow) === 0}}" class="bar-line bar-line-left"></view>

                <!-- 拍子 -->
                <view wx:for="{{measure.beats}}" wx:key="index" wx:for-item="beat" wx:for-index="beatIndex" class="beat">
                  <!-- 拍子分隔线（左侧，跳过第一个拍子避免与小节线重合） -->
                  <view wx:if="{{beatIndex > 0}}" class="beat-line beat-line-left"></view>

                  <!-- 16分音符（4个细分） -->
                  <view wx:for="{{beat.subdivisions}}" wx:key="index" wx:for-item="subdivision" wx:for-index="subdivisionIndex" class="subdivision">
                    <!-- 16分音符分隔线（左侧） -->
                    <view wx:if="{{subdivisionIndex > 0}}" class="subdivision-line subdivision-line-left"></view>

                    <!-- 备注显示（在音符列上方） -->
                    <view wx:if="{{subdivision.annotation}}" class="note-annotation" 
                          bindtap="editAnnotation" 
                          data-sheet="{{notation.id}}" 
                          data-measure="{{measureIndex}}" 
                          data-beat="{{beatIndex}}" 
                          data-subdivision="{{subdivisionIndex}}">
                      <text>{{subdivision.annotation}}</text>
                    </view>

                    <!-- 上下音符格 -->
                    <view class="note-grid">
                      <!-- 右手音符（上） -->
                      <view class="note-box note-box-top">
                        <view class="note-column" style="gap: {{utils.getColumnGap(orientation, notation.style, (notation.measuresPerRow || measuresPerRow) > 1)}}rpx;">
                          <view class="note-slot {{editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0 ? 'editing editing-right' : ''}}" style="height: {{utils.getSlotHeight(orientation, notation.style, (notation.measuresPerRow || measuresPerRow) > 1)}}rpx; min-height: {{utils.getSlotHeight(orientation, notation.style, (notation.measuresPerRow || measuresPerRow) > 1)}}rpx; line-height: {{utils.getSlotHeight(orientation, notation.style, (notation.measuresPerRow || measuresPerRow) > 1)}}rpx;">
                            <view wx:if="{{!(editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0)}}"
                              class="slot-click-overlay"
                              catchtap="onSlotTap"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="right" data-index="0"></view>
                            <block wx:if="{{editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0}}">
                              <input wx:if="{{!showVirtualKeyboard}}"
                                class="note-input note-input-right" value="{{editingValue}}" focus="true" catchtap="stopPropagation"
                                maxlength="{{notationType === 'simplified' ? 20 : 2}}"
                                data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="right" data-index="0"
                                bindinput="onSlotInput" bindconfirm="onSlotConfirm" bindblur="onSlotBlur"/>
                              <view wx:else class="note-input note-input-right virtual-editing" catchtap="stopPropagation">
                                <text>{{editingValue}}</text>
                                <view class="vk-cursor"></view>
                              </view>
                            </block>
                            <block wx:else>
                              <!-- 显示带八度点和上标的音符（简谱语法在所有模式下通用） -->
                              <view wx:if="{{subdivision.rightHand[0]}}" class="note-with-octave">
                                <!-- 左上标（带音高圆点） -->
                                <view wx:if="{{utils.parseSimplifiedNote(subdivision.rightHand[0]).leftSup}}" class="note-superscript-container note-sup-left">
                                  <view wx:if="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).leftSup).octaveUp > 0}}" class="sup-octave-dots-up">
                                    <view wx:for="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).leftSup).octaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="sup-octave-dot" style="width: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{rightHandColor}};"></view>
                                  </view>
                                  <text class="note-superscript" style="font-size: {{utils.getSupFontSize(utils.getFontSize(orientation, notation.style))}}rpx; color: {{rightHandColor}};">{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).leftSup).baseNote}}</text>
                                  <view wx:if="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).leftSup).octaveDown > 0}}" class="sup-octave-dots-down">
                                    <view wx:for="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).leftSup).octaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="sup-octave-dot" style="width: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{rightHandColor}};"></view>
                                  </view>
                                </view>
                                <!-- 主音符区域 -->
                                <view class="note-main-container">
                                  <!-- 上加点（升八度） -->
                                  <view wx:if="{{utils.parseSimplifiedNote(subdivision.rightHand[0]).octaveUp > 0}}" class="octave-dots-up">
                                    <view wx:for="{{utils.parseSimplifiedNote(subdivision.rightHand[0]).octaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="octave-dot" style="width: {{utils.getOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{rightHandColor}};"></view>
                                  </view>
                                  <text class="note-number note-right-hand {{utils.parseSimplifiedNote(subdivision.rightHand[0]).underline ? 'note-underline' : ''}}" style="color: {{rightHandColor}}; font-size: {{utils.getFontSize(orientation, notation.style)}}rpx; {{utils.parseSimplifiedNote(subdivision.rightHand[0]).underline ? 'text-decoration-thickness: ' + utils.getUnderlineThickness(utils.getFontSize(orientation, notation.style)) + 'rpx; text-underline-offset: ' + utils.getUnderlineOffset(utils.getFontSize(orientation, notation.style)) + 'rpx;' : ''}}">{{utils.parseSimplifiedNote(subdivision.rightHand[0]).baseNote}}</text>
                                  <!-- 下加点（降八度） -->
                                  <view wx:if="{{utils.parseSimplifiedNote(subdivision.rightHand[0]).octaveDown > 0}}" class="octave-dots-down">
                                    <view wx:for="{{utils.parseSimplifiedNote(subdivision.rightHand[0]).octaveDown}}" wx:for-item="dotIdx" wx:key="dotIdx" class="octave-dot" style="width: {{utils.getOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{rightHandColor}};"></view>
                                  </view>
                                </view>
                                <!-- 右上标（带音高圆点） -->
                                <view wx:if="{{utils.parseSimplifiedNote(subdivision.rightHand[0]).rightSup}}" class="note-superscript-container note-sup-right">
                                  <view wx:if="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).rightSup).octaveUp > 0}}" class="sup-octave-dots-up">
                                    <view wx:for="{{utils.parseSupContent(utils.parseSimplifiedNote(subdivision.rightHand[0]).rightSup).octaveUp}}" wx:for-item="dotIdx" wx:key="dotIdx" class="sup-octave-dot" style="width: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; height: {{utils.getSupOctaveDotSize(utils.getFontSize(orientation, notation.style))}}rpx; background: {{rightHandColor}};"></view>
                                  </view>
