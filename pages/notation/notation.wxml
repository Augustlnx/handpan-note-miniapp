
<!-- 自定义导航栏 -->
<view class="custom-nav-bar">
  <view class="nav-bar-content">
    <text class="nav-bar-title">Orbit Note</text>
  </view>
</view>

<view class="notation-container {{rotationEnabled ? 'rotation-mode' : ''}} {{orientation === 'landscape' ? 'landscape-mode' : ''}}" catchtap="clearEditing">
  <!-- 背景图片装饰（固定右下角，半透明，层级低于菜单栏） -->
  <image class="background-image" src="/assets/img/bg2.png" mode="widthFix" style="opacity: {{backgroundOpacity}}"></image>
  
  <!-- 分页容器：处理触摸事件 -->
  <view id="notation-pages" class="notation-pages-wrapper {{pageTransitioning ? 'page-transition-out' : 'page-transition-in'}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
    <!-- 标题区（仅在第一页显示） -->
    <view class="header-section" wx:if="{{currentPage === 0}}">
      <text class="main-title" bindtap="editTitle" style="color: {{mainTitleColor}}">{{mainTitle}}</text>
      <text class="sub-title" bindtap="editSubTitle" style="color: {{subTitleColor}}">{{subTitle}}</text>
      
      <!-- 速度设置 -->
      <view class="header-action-row" bindtap="editGlobalTempo">
        <image class="header-action-icon" src="/assets/icons/music.png"></image>
        <text class="header-action-label">速度：</text>
        <text class="header-action-value"> {{globalTempo}}</text>
      </view>

      <!-- 排版视角（旋转屏幕） -->
      <view class="header-action-row" bindtap="openOrientationPicker">
        <image class="header-action-icon" src="/assets/icons/rotation.png"></image>
        <text class="header-action-label">视角：</text>
        <text class="header-action-value">{{orientation === 'landscape' ? '手机横屏/平板模式' : '手机竖屏（默认）'}}</text>
        <view class="header-help-wrap" catchtap="showRotationHelp">
          <image class="header-help-icon" src="/assets/icons/help.png"></image>
        </view>
      </view>

      <!-- 拍号选择 -->
      <view class="header-action-row" bindtap="openTimeSignaturePicker">
        <image class="header-action-icon" src="/assets/icons/Tim_Signature.png"></image>
        <text class="header-action-label">拍号：</text>
        <text class="header-action-value">{{currentTimeSignatureType === 'custom' ? '自由设定' : timeSignatureBeats + '/' + timeSignatureBottom}}</text>
        <view class="header-help-wrap" catchtap="showTimeSignatureHelp">
          <image class="header-help-icon" src="/assets/icons/help.png"></image>
        </view>
      </view>

      <!-- 存储位置 -->
      <view class="header-action-row">
        <image class="header-action-icon" src="/assets/icons/location.png"></image>
        <text class="header-action-label">存储：</text>
        <text class="header-action-value">{{storageDisplay}}</text>
      </view>
    </view>

    <!-- 谱面列表（仅显示当前页的modules） -->
    <view class="notation-list">
      <view wx:for="{{currentPageModules}}" wx:key="id" class="notation-sheet {{notations[pageModule.index].collapsed ? 'collapsed' : ''}}" wx:for-item="pageModule">
        <!-- 使用 pageModule.index 访问原始 notations 数组中的数据 -->
        <view wx:if="{{notations[pageModule.index]}}">
          <!-- 定义引用以简化代码 -->
          <block wx:key="id" wx:for-item="notation" wx:for-index="notationItemIdx" wx:for="{{[notations[pageModule.index]]}}">
            <!-- 删除图标（右上角） -->
            <image class="delete-icon" src="/assets/icons/delete.png" data-id="{{notation.id}}" bindtap="deleteNotation" wx:if="{{!notations[pageModule.index].collapsed}}"></image>
            
            <!-- 收起状态时显示more.png -->
            <image class="more-icon-top-right" src="/assets/icons/more.png" data-id="{{notation.id}}" bindtap="toggleNotationCollapse" wx:if="{{notations[pageModule.index].collapsed}}"></image>
            
            <!-- 谱面信息 -->
            <view class="sheet-info">
              <view class="sheet-label" bindtap="editLabel" data-id="{{notation.id}}">
                <text>{{notation.label}}</text>
              </view>
            </view>

            <!-- 谱面内容 -->
            <view class="staff-container {{(notation.measuresPerRow || measuresPerRow) > 1 ? 'multi-measure' : 'single-measure'}}">
              <view wx:for="{{notation.measures}}" wx:key="index" wx:for-item="measure" wx:for-index="measureIndex" class="measure" style="width: {{100 / (notation.measuresPerRow || measuresPerRow)}}%;">
                <!-- 小节编号（上方居中） -->
                <view class="measure-index">{{(notation.measureOffset || 0) + measureIndex + 1}}</view>
                <!-- 小节线（左侧） -->
                <view wx:if="{{measureIndex % (notation.measuresPerRow || measuresPerRow) === 0}}" class="bar-line bar-line-left"></view>

                <!-- 拍子 -->
                <view wx:for="{{measure.beats}}" wx:key="index" wx:for-item="beat" wx:for-index="beatIndex" class="beat">
                  <!-- 拍子分隔线（左侧，跳过第一个拍子避免与小节线重合） -->
                  <view wx:if="{{beatIndex > 0}}" class="beat-line beat-line-left"></view>

                  <!-- 16分音符（4个细分） -->
                  <view wx:for="{{beat.subdivisions}}" wx:key="index" wx:for-item="subdivision" wx:for-index="subdivisionIndex" class="subdivision">
                    <!-- 16分音符分隔线（左侧） -->
                    <view wx:if="{{subdivisionIndex > 0}}" class="subdivision-line subdivision-line-left"></view>

                    <!-- 上下音符格 -->
                    <view class="note-grid">
                      <!-- 右手音符（上） -->
                      <view class="note-box note-box-top">
                        <view class="note-column">
                          <view class="note-slot {{editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0 ? 'editing editing-right' : ''}}">
                            <view wx:if="{{!(editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0)}}"
                              class="slot-click-overlay"
                              catchtap="onSlotTap"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="right" data-index="0"></view>
                            <input wx:if="{{editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0}}"
                              class="note-input note-input-right" value="{{editingValue}}" focus="true" catchtap="stopPropagation"
                              maxlength="2"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="right" data-index="0"
                              bindinput="onSlotInput" bindconfirm="onSlotConfirm" bindblur="onSlotBlur"/>
                            <block wx:else>
                              <text wx:if="{{subdivision.rightHand[0]}}" class="note-number note-right-hand" style="color: {{rightHandColor}}">{{subdivision.rightHand[0]}}</text>
                              <text wx:else class="note-number placeholder">　</text>
                            </block>
                          </view>
                          <view class="note-slot {{editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==1 ? 'editing editing-right' : ''}}">
                            <view wx:if="{{!(editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==1)}}"
                              class="slot-click-overlay"
                              catchtap="onSlotTap"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="right" data-index="1"></view>
                            <input wx:if="{{editing && editing.hand=='right' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==1}}"
                              class="note-input note-input-right" value="{{editingValue}}" focus="true" catchtap="stopPropagation"
                              maxlength="2"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="right" data-index="1"
                              bindinput="onSlotInput" bindconfirm="onSlotConfirm" bindblur="onSlotBlur"/>
                            <block wx:else>
                              <text wx:if="{{subdivision.rightHand[1]}}" class="note-number note-right-hand" style="color: {{rightHandColor}}">{{subdivision.rightHand[1]}}</text>
                              <text wx:else class="note-number placeholder">　</text>
                            </block>
                          </view>
                        </view>
                      </view>

                      <!-- 左手音符（下） -->
                      <view class="note-box note-box-bottom">
                        <view class="note-column">
                          <view class="note-slot {{editing && editing.hand=='left' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0 ? 'editing editing-left' : ''}}">
                            <view wx:if="{{!(editing && editing.hand=='left' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0)}}"
                              class="slot-click-overlay"
                              catchtap="onSlotTap"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="left" data-index="0"></view>
                            <input wx:if="{{editing && editing.hand=='left' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==0}}"
                              class="note-input note-input-left" value="{{editingValue}}" focus="true" catchtap="stopPropagation"
                              maxlength="2"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="left" data-index="0"
                              bindinput="onSlotInput" bindconfirm="onSlotConfirm" bindblur="onSlotBlur"/>
                            <block wx:else>
                              <text wx:if="{{subdivision.leftHand[0]}}" class="note-number note-left-hand" style="color: {{leftHandColor}}">{{subdivision.leftHand[0]}}</text>
                              <text wx:else class="note-number placeholder">　</text>
                            </block>
                          </view>
                          <view class="note-slot {{editing && editing.hand=='left' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==1 ? 'editing editing-left' : ''}}">
                            <view wx:if="{{!(editing && editing.hand=='left' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==1)}}"
                              class="slot-click-overlay"
                              catchtap="onSlotTap"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="left" data-index="1"></view>
                            <input wx:if="{{editing && editing.hand=='left' && editing.sheet==notation.id && editing.measure==measureIndex && editing.beat==beatIndex && editing.subdivision==subdivisionIndex && editing.index==1}}"
                              class="note-input note-input-left" value="{{editingValue}}" focus="true" catchtap="stopPropagation"
                              maxlength="2"
                              data-sheet="{{notation.id}}" data-measure="{{measureIndex}}" data-beat="{{beatIndex}}" data-subdivision="{{subdivisionIndex}}" data-hand="left" data-index="1"
                              bindinput="onSlotInput" bindconfirm="onSlotConfirm" bindblur="onSlotBlur"/>
                            <block wx:else>
                              <text wx:if="{{subdivision.leftHand[1]}}" class="note-number note-left-hand" style="color: {{leftHandColor}}">{{subdivision.leftHand[1]}}</text>
                              <text wx:else class="note-number placeholder">　</text>
                            </block>
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>

                  <!-- 拍子分隔线（右侧，跳过最后一个拍子且不与中间小节线重叠） -->
                  <view wx:if="{{beatIndex < measure.beats.length - 1 && !beat.barLineAfter}}" class="beat-line beat-line-right"></view>

                  <!-- 中间小节线（自定义拍子模式中的分组间分隔线，使用小节线样式） -->
                  <view wx:if="{{beat.barLineAfter}}" class="bar-line bar-line-middle"></view>
                </view>

                <!-- 小节线（右侧） -->
                <view class="bar-line bar-line-right"></view>
              </view>
            </view>
            
            <!-- 添加谱面图标（仅展开状态显示） -->
            <view class="add-notation-row" wx:if="{{!notations[pageModule.index].collapsed}}">
              <image class="add-icon" src="/assets/icons/add.png" data-after-id="{{notation.id}}" bindtap="addNotationAfter"></image>
              <image class="refresh-icon" src="/assets/icons/refresh.png" data-id="{{notation.id}}" bindtap="refreshNotation"></image>
              <image class="tool-icon" src="/assets/icons/tool.png" data-id="{{notation.id}}" bindtap="openModuleSettings"></image>
              <image class="less-icon" src="/assets/icons/less.png" data-id="{{notation.id}}" bindtap="toggleNotationCollapse"></image>
            </view>
          </block>
        </view>
      </view>
      
      <!-- 手指拖动提示（仅在第一页且有多页时显示） -->
      <view class="hand-drag-hint" wx:if="{{currentPage === 0 && totalPages > 1}}">
        <image src="/assets/icons/hand_drag.png" class="hand-drag-image"></image>
        <text class="hand-drag-text">向左滑动浏览更多</text>
      </view>

      <!-- 手指拖动提示（第2页及以后） -->
      <view class="hand-drag-hint" wx:if="{{currentPage > 0 && totalPages > 1}}">
        <image src="/assets/icons/hand_move.png" class="hand-drag-image"></image>
        <text class="hand-drag-text">左右滑动浏览更多</text>
      </view>
    </view>

    <!-- 分页指示器 -->
    <view class="pagination-indicator" wx:if="{{enablePagination}}">
      <text class="pagination-text">第 {{currentPage + 1}} / {{totalPages}} 页</text>
    </view>
  </view>

  <!-- 页面切换加载遮罩 + 居中Logo + 80BPM悬浮节拍器（置于过渡容器外，避免被淡出遮挡） -->
  <view wx:if="{{showPageLoadingOverlay}}" class="page-loading-overlay">
    <image class="page-loading-logo" src="/assets/img/logo.png" mode="aspectFit"></image>
    <view class="overlay-metronome">
      <view wx:for="{{overlayMetronomeBeats}}" wx:key="index" class="metronome-dot overlay-dot"></view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view wx:if="{{!actionCollapsed}}" class="action-buttons">
    
    <view class="action-btn" bindtap="toggleFloatingMetronome">
      <image class="action-btn-icon" src="/assets/icons/metronome.png"></image>
      <text class="action-btn-text">节拍器</text>
      <view class="help-icon-wrap" catchtap="showMetronomeHelp">
        <image class="help-icon" src="/assets/icons/help.png"></image>
      </view>
    </view>
    <view class="action-btn" bindtap="resetNotations">
      <image class="action-btn-icon" src="/assets/icons/reset.png"></image>
      <text class="action-btn-text">重置</text>
    </view>
    <view class="action-btn" bindtap="undo">
      <image class="action-btn-icon" src="/assets/icons/library/上一步_back.png"></image>
      <text class="action-btn-text">撤销</text>
    </view>
    <view class="action-btn" bindtap="saveToLibrary">
      <image class="action-btn-icon" src="/assets/icons/save.png"></image>
      <text class="action-btn-text">保存</text>
    </view>
    <view class="action-btn" bindtap="exportPDF">
      <image class="action-btn-icon" src="/assets/icons/download.png"></image>
      <text class="action-btn-text">导出</text>
    </view>
    <view class="action-btn" bindtap="openImportModal">
      <image class="action-btn-icon" src="/assets/icons/upload.png"></image>
      <text class="action-btn-text">导入</text>
    </view>
    <view class="action-btn" bindtap="toggleReadingMode">
      <image class="action-btn-icon" src="{{readingMode ? '/assets/icons/newspaper-folding-active.png' : '/assets/icons/newspaper-folding.png'}}"></image>
      <text class="action-btn-text">{{readingMode ? '编辑' : '阅读'}}</text>
    </view>
      <image class="action-collapse-icon" src="/assets/icons/internal-reduction.png" bindtap="toggleActionBar"></image>
      
  </view>
  <image class="action-toggle" 
    src="/assets/icons/handpan.png" 
    bindtap="toggleActionBar"
    wx:if="{{actionCollapsed}}"></image>

  <!-- 悬浮节拍器 -->
  <view wx:if="{{showFloatingMetronome}}" class="floating-metronome">
    <view class="metronome-dots">
      <view wx:for="{{metronomeBeats}}" wx:key="index" class="metronome-dot {{currentMetronomeBeat === index ? (index === 0 ? 'active active-accent' : 'active') : ''}}"></view>
    </view>
    <image class="metronome-close" src="/assets/icons/close.png" bindtap="closeFloatingMetronome"></image>
  </view>

  <!-- 节拍器帮助提示窗口 -->
  <view wx:if="{{showMetronomeHelpModal}}" class="modal-overlay" bindtap="closeMetronomeHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">节拍器说明</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>点击节拍器按钮会弹出一个悬浮节拍器</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>节奏速度和拍数按照「节拍器」页面设定的值</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>悬浮节拍器会显示当前拍点，便于练习</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>点击关闭图标可关闭悬浮节拍器</text>
        </view>
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="closeMetronomeHelp">知道了</button>
      </view>
    </view>
  </view>

  <!-- 排版视角帮助窗口 -->
  <view wx:if="{{showRotationHelpModal}}" class="modal-overlay" bindtap="closeRotationHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">排版视角</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">竖屏模式：</text>默认手机端排版模式</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">横屏/平板模式：</text>一行排版更多小节，可容纳更多内容，页面元素均缩小</text>
        </view>
      
      </view>
    </view>
  </view>

  <!-- 拍号选择帮助窗口 -->
  <view wx:if="{{showTimeSignatureHelpModal}}" class="modal-overlay" bindtap="closeTimeSignatureHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">拍号设置</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot"></text>
          <text><text class="md-strong">独立数据：</text>每个拍号都有独立数据空间，互不影响</text>
        </view>
        <view class="md-line">
          <text class="md-dot"></text>
          <text><text class="md-strong">自动切换：</text>更换拍号会自动切换到对应数据</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">4/4：</text>每小节 4 拍，标准节拍</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">3/4：</text>每小节 3 拍，常见于圆舞曲</text>
        </view>
        <view class="md-quote">首次进入某拍号会初始化默认谱面，可在该拍号下自由编辑，不影响其他拍号。</view>
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="closeTimeSignatureHelp">知道了</button>
      </view>
    </view>
  </view>

  <!-- 通用编辑弹窗（用于标题/副标题/速度等） -->
  <view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">{{editModalTitle}}</view>
      <view class="modal-body">
        <input class="modal-input" type="{{editInputType}}" value="{{editValue}}" focus="true" placeholder="{{editPlaceholder}}" bindinput="onEditInput" confirm-type="done" bindconfirm="confirmEdit" />
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="confirmEdit">确定</button>
      </view>
    </view>
  </view>

  <!-- 自由设定拍号模态框 -->
  <view wx:if="{{showCustomTimeSignatureModal}}" class="modal-overlay" bindtap="closeCustomTimeSignatureModal">
    <view class="modal-content custom-time-signature-modal" catchtap="stopPropagation">
      <view class="modal-title">自由设定拍号</view>
      
      <view class="custom-signature-help">
        <view class="help-section">
          <text class="help-label">符号说明：</text>
          <text class="help-text">[ ] = 小节线 | | = 拍号线 - = 音符位</text>
        </view>
        <view class="help-section">
          <text class="help-label">示例：</text>
          <text class="help-text">4/4 拍号：[----|----|----|----]</text>
        </view>
        <view class="help-section">
          <text class="help-label">限制：</text>
          <text class="help-text">• 音符位"-"不超过35个</text>
          <text class="help-text">• 仅包含 [ ] | - 四种符号</text>
          <text class="help-text">• 必须以"["开始，"]"结束</text>
        </view>
      </view>

      <view class="modal-body">
        <textarea 
          class="template-input"
          value="{{customTimeSignatureTemplate}}" 
          focus="true" 
          placeholder="输入单行模板，例如：[----|----|----|----]" 
          bindinput="onCustomTimeSignatureInput"
          maxlength="100"
        />
        <view wx:if="{{customTimeSignatureError}}" class="error-message">{{customTimeSignatureError}}</view>
      </view>

      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeCustomTimeSignatureModal">取消</button>
        <button class="btn-primary" bindtap="confirmCustomTimeSignature" disabled="{{!!customTimeSignatureError || !customTimeSignatureTemplate}}">确定</button>
      </view>
    </view>
  </view>

  <!-- 模块设置模态框 -->
  <view wx:if="{{showModuleSettingsModal}}" class="modal-overlay" bindtap="closeModuleSettingsModal">
    <view class="modal-content module-settings-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">模块设置</view>
        <image class="modal-close-icon" src="/assets/icons/delete.png" bindtap="closeModuleSettingsModal"></image>
      </view>
      
      <view class="module-settings-scrollable">
      <view class="settings-item">
        <view class="settings-item-header">
          <image class="settings-icon" src="/assets/icons/paragraph.png"></image>
          <text class="settings-label">行数</text>
        </view>
        <view class="settings-item-content">
          <view class="line-count-row">
            <text class="settings-default-label">默认：{{orientation === 'landscape' ? 2 : 4}} 行</text>
            <view class="module-line-input-group">
              <input 
                class="module-line-input"
                type="number"
                value="{{moduleLineCount}}" 
                placeholder="1-20"
                bindinput="onModuleLineCountInput"
