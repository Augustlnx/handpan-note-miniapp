<wxs module="utils">
// 横屏缩放比例：18/28
var LANDSCAPE_SCALE = 18 / 28;
// 定义常用字符常量，避免WXS中引号嵌套问题
var CHAR_QUOTE = "'";  // 单引号
var CHAR_COMMA = ",";  // 逗号
var CHAR_UNDERSCORE = "_"; // 下划线
var getFontSize = function(orientation, style) {
  var baseSize = 28;
  if (style && style.noteFontSize) {
    baseSize = parseInt(style.noteFontSize, 10);
    if (isNaN(baseSize)) {
      baseSize = 28;
    }
  }
  
  if (orientation === 'landscape') {
    return (baseSize * LANDSCAPE_SCALE);
  }
  return baseSize;
}

// 获取单行高度（根据横竖屏自动缩放）
// 存储的是竖屏基准值，横屏时按18/28缩放
var getMeasureHeight = function(orientation, style, isMultiMeasure) {
  var defaultHeight = isMultiMeasure ? 110 : 160;
  var measureHeight = (style && style.measureHeight) ? parseInt(style.measureHeight, 10) : defaultHeight;
  if (isNaN(measureHeight)) {
    measureHeight = defaultHeight;
  }
  if (orientation === 'landscape') {
    return Math.round(measureHeight * LANDSCAPE_SCALE);
  }
  return measureHeight;
}

// 获取行间距（根据横竖屏自动缩放）
// 存储的是竖屏基准值，横屏时按18/28缩放
var getLineSpacing = function(orientation, style) {
  var defaultSpacing = 65;
  var lineSpacing = (style && style.lineSpacing) ? parseInt(style.lineSpacing, 10) : defaultSpacing;
  if (isNaN(lineSpacing)) {
    lineSpacing = defaultSpacing;
  }
  if (orientation === 'landscape') {
    return Math.round(lineSpacing * LANDSCAPE_SCALE);
  }
  return lineSpacing;
}

// 计算音符槽位高度（根据单行高度按比例缩放）
// 默认: measureHeight=160rpx, slotHeight=36rpx, 比例=0.225
var getSlotHeight = function(orientation, style, isMultiMeasure) {
  var measureHeight = getMeasureHeight(orientation, style, isMultiMeasure);
  // 默认槽位高度比例: 36/160 = 0.225
  var height = Math.round(measureHeight * 0.225);
  // 限制最小和最大值
  if (height < 18) height = 18;
  if (height > 60) height = 60;
  return height;
}

// 计算音符列间距（根据单行高度按比例缩放）
// 默认: measureHeight=160rpx, gap=8rpx, 比例=0.05
var getColumnGap = function(orientation, style, isMultiMeasure) {
  var measureHeight = getMeasureHeight(orientation, style, isMultiMeasure);
  // 默认间距比例: 8/160 = 0.05
  var gap = Math.round(measureHeight * 0.05);
  // 限制最小和最大值
  if (gap < 4) gap = 4;
  if (gap > 16) gap = 16;
  return gap;
}

// 解析简谱音符，提取基础音符、八度偏移量、时值减半标记和上标



// 支持格式: 1(单引号), 1,, 1_, ^{H}1, 1^{H}, ^{L}1^{R}

// 返回: { baseNote: (单引号)1(单引号), octaveUp: 1, octaveDown: 0, underline: true, leftSup: (单引号)H(单引号), rightSup:(单引号)(单引号)}
var parseSimplifiedNote = function(note) {
  if (!note || note === '') {
    return { baseNote: '', octaveUp: 0, octaveDown: 0, underline: false, leftSup: '', rightSup: '' };
  }
  
  var octaveUp = 0;
  var octaveDown = 0;
  var underline = false;
  var baseNote = '';
  var leftSup = '';
  var rightSup = '';
  var remaining = note;
  
  // 解析左上标 ^{...}
  // var caretBrace = '^' + '\{';
  var caretBrace = '^' ;
  if (remaining.indexOf(caretBrace) === 0) {
    var endIdx = remaining.indexOf('}');
    if (endIdx > 2) {
      leftSup = remaining.substring(2, endIdx);
      remaining = remaining.substring(endIdx + 1);
    }
  }
  
  // 解析右上标 ...^{...}
  var rightSupIdx = remaining.lastIndexOf(caretBrace);
  if (rightSupIdx > 0) {
    var endBrace = remaining.indexOf('}', rightSupIdx);
    if (endBrace > rightSupIdx + 2) {
      rightSup = remaining.substring(rightSupIdx + 2, endBrace);
      remaining = remaining.substring(0, rightSupIdx);
    }
  }
  
  // 统计 上引号的数量（高八度）
  for (var i = 0; i < remaining.length; i++) {
    if (remaining[i] === "'") {
      octaveUp++;
    }
  }

  // 统计 , 的数量（降八度）
  for (var i = 0; i < remaining.length; i++) {
    if (remaining[i] === ',') {
      octaveDown++;
    }
  }
  
  // 检查是否有 _ （时值减半下划线）
  if (remaining.indexOf('_') !== -1) {
    underline = true;
  }
  
  // 提取基础音符（移除 上单引号、, 和 _）
  for (var i = 0; i < remaining.length; i++) {
    if (remaining[i] !== "'" && remaining[i] !== ',' && remaining[i] !== '_') {
      baseNote += remaining[i];
    }
  }
  
  return {
    baseNote: baseNote,
    octaveUp: octaveUp,
    octaveDown: octaveDown,
    underline: underline,
    leftSup: leftSup,
    rightSup: rightSup
  };
};

// 解析上标内容的音高信息
var parseSupContent = function(supStr) {
  var result = {
    baseNote: '',
    octaveUp: 0,
    octaveDown: 0
  };
  
  if (!supStr || supStr === '') return result;
  
  // 统计 ‘ 的数量（升八度）
  for (var i = 0; i < supStr.length; i++) {
    if (supStr[i] === "'") {
      result.octaveUp++;
    }
  }
  
  // 统计 , 的数量（降八度）
  for (var i = 0; i < supStr.length; i++) {
    if (supStr[i] === ',') {
      result.octaveDown++;
    }
  }
  
  // 提取基础音符（移除特殊符号）
  for (var i = 0; i < supStr.length; i++) {
    if (supStr[i] !== "'" && supStr[i] !== ',') {
      result.baseNote += supStr[i];
    }
  }
  
  return result;
}

// 获取上标的音高点大小（比主音符的点更小）
var getSupOctaveDotSize = function(fontSize) {
  var size = Math.round(fontSize * 0.18);
  if (size < 3) size = 3;
  if (size > 6) size = 6;
  return size;
}

// 获取上标字号（相对于主音符字号）
var getSupFontSize = function(fontSize) {
  return Math.round(fontSize * 0.55);
}

// 获取上标偏移量
var getSupOffset = function(fontSize) {
  return Math.round(fontSize * 0.4);
}

// 获取八度点的大小（根据字号缩放）
var getOctaveDotSize = function(fontSize) {
  // 默认字号28对应点大小6rpx，按比例缩放
  // 调整倍数以获得更好的视觉效果：fontSize * 0.1（更大的点）
  var size = Math.round(fontSize * 0.25);
  if (size < 5) size = 5;   // 最小5rpx
  if (size > 12) size = 12; // 最大12rpx
  return size;
}

// 获取八度点的间距
var getOctaveDotGap = function(fontSize) {
  var gap = Math.round(fontSize * 0.12);
  if (gap < 2) gap = 2;
  if (gap > 6) gap = 6;
  return gap;
}

// 获取八度点距离音符的偏移
var getOctaveOffset = function(fontSize, isUp) {
  var offset = Math.round(fontSize * 0.35);
  if (offset < 6) offset = 6;
  if (offset > 14) offset = 14;
  return offset;
}

// 获取下划线粗细（根据字号动态调整）
var getUnderlineThickness = function(fontSize) {
  // 默认字号28对应下划线粗细4rpx
  var thickness = Math.round(fontSize * 0.2);
  if (thickness < 2) thickness = 2;   // 最小2rpx
  if (thickness > 6) thickness = 6;   // 最大6rpx
  return thickness;
}

// 获取下划线偏移（距离基线的距离）
var getUnderlineOffset = function(fontSize) {
  var offset = Math.round(fontSize * 0.03);
  if (offset < 1) offset = 1;
  if (offset > 4) offset = 4;
  return offset;
}

// 获取下划线与低八度圆点之间的间距
// 当音符同时有下划线和低八度圆点时使用
// 缩小到原先的1/4
var getUnderlineDotGap = function(fontSize) {
  // 极小的间距，仅保证视觉分隔
  var gap = Math.round(fontSize * 0.01);
  if (gap < 1) gap = 1;   // 最小1rpx
  if (gap > 2) gap = 2;   // 最大2rpx
  return gap;
}

// 计算下划线底部到音符底部的距离（用于定位低八度圆点）
// 当同时有下划线和低八度圆点时，圆点需要显示在下划线下方
// 缩小间距到原先的1/4
var getUnderlineBottomOffset = function(fontSize) {
  // 下划线偏移 + 下划线粗细的一小部分
  var underlineOffset = getUnderlineOffset(fontSize);
  var underlineThickness = getUnderlineThickness(fontSize);
  return underlineOffset + underlineThickness * 0.15;
}

// 判断音符是否同时有下划线和低八度圆点
var hasUnderlineAndOctaveDown = function(note) {
  var parsed = parseSimplifiedNote(note);
  return parsed.underline && parsed.octaveDown > 0;
}

// 获取上标的额外向上偏移量（当有下划线+低八度圆点时使用）
// 返回负值表示向上偏移（em单位）
var getSupExtraTopOffset = function(note) {
  var parsed = parseSimplifiedNote(note);
  // 当同时有下划线和低八度圆点时，上标需要额外向上偏移
  if (parsed.underline && parsed.octaveDown > 0) {
    return -0.25; // 额外向上偏移0.25em
  }
  // 仅有下划线时，也需要轻微调整
  if (parsed.underline) {
    return -0.1;
  }
  // 仅有低八度圆点时
  if (parsed.octaveDown > 0) {
    return -0.15;
  }
  return 0;
}

module.exports = {
  getFontSize: getFontSize,
  getMeasureHeight: getMeasureHeight,
  getLineSpacing: getLineSpacing,
  getSlotHeight: getSlotHeight,
  getColumnGap: getColumnGap,
  parseSimplifiedNote: parseSimplifiedNote,
  parseSupContent: parseSupContent,
  getOctaveDotSize: getOctaveDotSize,
  getOctaveDotGap: getOctaveDotGap,
  getOctaveOffset: getOctaveOffset,
  getSupFontSize: getSupFontSize,
  getSupOffset: getSupOffset,
  getSupOctaveDotSize: getSupOctaveDotSize,
  getUnderlineThickness: getUnderlineThickness,
  getUnderlineOffset: getUnderlineOffset,
  getUnderlineDotGap: getUnderlineDotGap,
  getUnderlineBottomOffset: getUnderlineBottomOffset,
  hasUnderlineAndOctaveDown: hasUnderlineAndOctaveDown,
  getSupExtraTopOffset: getSupExtraTopOffset
};
</wxs>

<!-- 自定义导航栏 -->
<view class="custom-nav-bar">
  <view class="nav-bar-content">
    <text class="nav-bar-title">Orbit Note</text>
  </view>
</view>

<view class="notation-container {{rotationEnabled ? 'rotation-mode' : ''}} {{orientation === 'landscape' ? 'landscape-mode' : ''}} {{showVirtualKeyboard ? 'keyboard-active' : ''}} {{isPlaybackMode ? 'playback-mode' : ''}} {{pageReady ? 'page-ready' : ''}}" catchtap="clearEditing">
  <!-- 背景图片装饰（固定右下角，半透明，层级低于菜单栏） -->
  <image class="background-image" src="/assets/img/bg2.png" mode="widthFix" style="opacity: {{backgroundOpacity}}"></image>
  
  <!-- 分页容器：处理触摸事件（选中模式下禁用分页切换） -->
  <view id="notation-pages" class="notation-pages-wrapper {{pageTransitioning ? 'page-transition-out' : 'page-transition-in'}}" bindtouchstart="{{!isPlaybackMode && !isSelectingBeats ? 'onTouchStart' : ''}}" bindtouchmove="{{!isPlaybackMode && !isSelectingBeats ? 'onTouchMove' : ''}}" bindtouchend="{{!isPlaybackMode && !isSelectingBeats ? 'onTouchEnd' : ''}}">
    <!-- 标题区（仅在第一页显示，选中模式下禁用所有点击） -->
    <view class="header-section {{isSelectingBeats ? 'disabled' : ''}}" wx:if="{{currentPage === 0}}">
      <!-- 右上角简介图标 -->
      <image class="intro-icon" src="/assets/icons/信息_info.svg" bindtap="{{!isPlaybackMode && !isSelectingBeats ? 'openIntroModal' : ''}}" mode="aspectFit"></image>
      
      <!-- 主标题 -->
      <text class="main-title" bindtap="{{!isPlaybackMode && !isSelectingBeats ? 'editTitle' : ''}}" style="color: {{mainTitleColor}}">{{mainTitle}}</text>
      
      <!-- 副标题行 -->
      <view class="sub-title-row" bindtap="{{!isPlaybackMode && !isSelectingBeats ? 'editSubTitle' : ''}}">
        <text class="sub-title" style="color: {{subTitleColor}}">{{subTitle}}</text>
        <text class="sub-title-divider" style="color: {{subTitleColor}}">|</text>
        <text class="sub-title" style="color: {{subTitleColor}}">{{composer}}</text>
        <text class="sub-title-divider" style="color: {{subTitleColor}}">|</text>
        <text class="sub-title" style="color: {{subTitleColor}}">{{rootNote}}-{{scaleType.indexOf(' / ') > -1 ? scaleType.split(' / ')[0] : scaleType}} {{noteCount}}音</text>
      </view>
      
      <!-- 参数信息区（网格布局） -->
      <view class="params-grid">
        <!-- 第一行：速度 | 拍号 | 谱式 -->
        <view class="param-row">
          <!-- 左侧：速度 -->
          <view class="param-item-group" bindtap="editGlobalTempo">
            <image class="param-icon" src="/assets/icons/timing.png" mode="aspectFit"></image>
            <text class="param-label">速度：</text>
            <text class="param-value">{{globalTempo}}</text>
          </view>
          
          <!-- 中间：拍号 -->
          <view class="param-item-group" bindtap="openTimeSignaturePicker">
            <image class="param-icon" src="/assets/icons/tim_signature.svg" mode="aspectFit"></image>
            <text class="param-label">拍号：</text>
            <text class="param-value">{{currentTimeSignatureType === 'custom' ? '自由' : timeSignatureBeats + '/' + timeSignatureBottom}}</text>
          </view>
          
          <!-- 右侧：谱式 -->
          <view class="param-item-group" bindtap="openNotationTypeModal">
            <image class="param-icon" src="/assets/icons/note_change.png" mode="aspectFit"></image>
            <text class="param-label">谱式：</text>
            <text class="param-value">{{notationType === 'simplified' ? '简谱' : '数字谱'}}</text>
          </view>
        </view>
        
        <!-- 第二行：难度 | 存储（两端对齐） -->
        <view class="param-row param-row-spread">
          <!-- 左侧：难度 -->
          <view class="param-item-group" bindtap="openDifficultyModal">
            <image class="param-icon" src="/assets/icons/crown.svg" mode="aspectFit"></image>
            <text class="param-label">难度:</text>
            <view class="difficulty-stars-display">
              <image wx:for="{{[1,2,3,4,5]}}" wx:key="*this" 
                     src="/assets/icons/star.svg" 
                     class="difficulty-star-small {{difficulty >= item ? 'star-active-small' : 'star-inactive-small'}}" 
                     mode="aspectFit"></image>
            </view>
          </view>
          
          <!-- 右侧：存储 -->
          <view class="param-item-group">
            <image class="param-icon" src="/assets/icons/location.svg" mode="aspectFit"></image>
            <text class="param-label">存储：</text>
            <text class="param-value param-storage">{{storageDisplay}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 谱面列表（仅显示当前页的modules） -->
    <view class="notation-list">
      <view wx:for="{{currentPageModules}}" wx:key="id" class="notation-sheet {{notations[pageModule.index].collapsed ? 'collapsed' : ''}}" wx:for-item="pageModule">
        <!-- 使用 pageModule.index 访问原始 notations 数组中的数据 -->
        <view wx:if="{{notations[pageModule.index]}}">
          <!-- 定义引用以简化代码 -->
          <block wx:key="id" wx:for-item="notation" wx:for-index="notationItemIdx" wx:for="{{[notations[pageModule.index]]}}">
            <!-- 删除图标（右上角，选中模式下禁用） -->
            <image class="delete-icon {{isSelectingBeats ? 'disabled' : ''}}" src="/assets/icons/delete.png" data-id="{{notation.id}}" bindtap="{{!isSelectingBeats ? 'deleteNotation' : ''}}" wx:if="{{!notations[pageModule.index].collapsed}}"></image>
            
            <!-- 收起状态时显示more.png（Canvas模式展开按钮），播放模式和选中模式下禁用防止误触 -->
            <image class="more-icon-top-right" src="/assets/icons/more.png" data-id="{{notation.id}}" bindtap="{{!isSelectingBeats ? 'toggleNotationCollapse' : ''}}" wx:if="{{notations[pageModule.index].collapsed && !isPlaybackMode}}"></image>
            
            <!-- 谱面信息（选中模式下禁用点击） -->
            <view class="sheet-info">
              <view class="sheet-label" bindtap="{{!isSelectingBeats ? 'editLabel' : ''}}" data-id="{{notation.id}}">
                <text>{{notation.label}}</text>
              </view>
              <text wx:if="{{notation.remark}}" class="sheet-remark">{{notation.remark}}</text>
            </view>

            <!-- ========== Canvas2D统一渲染模式（全面替代View渲染）========== -->
            <!-- 
              Canvas模式迁移说明：
              - collapsed=true: 显示静态图片（如果有）或Canvas，隐藏操作按钮
              - collapsed=false: 直接显示Canvas（常驻编辑模式），显示操作按钮
            -->
            <view id="notation-container-{{notation.id}}"
                  class="canvas-notation-container {{notations[pageModule.index].collapsed ? 'canvas-collapsed' : 'canvas-expanded'}} {{showBeatSelectionBubble && beatSelectionEnd && beatSelectionEnd.notationId === notation.id ? 'bubble-visible' : ''}}" 
                  style="height: {{notations[pageModule.index].canvasHeight || 300}}px;">
              
              <!-- 模式1: 静态图片显示（仅collapsed状态且有缓存图片时显示） -->
              <image 
                wx:if="{{notations[pageModule.index].collapsed && notations[pageModule.index].tempImagePath && !notations[pageModule.index].isCanvasEditing}}"
                class="notation-static-image"
                src="{{notations[pageModule.index].tempImagePath}}"
                mode="widthFix"
                style="width: 100%;"
                data-id="{{notation.id}}"
                data-index="{{pageModule.index}}"
                bindtap="onCollapsedNotationTap"
                bindlongpress="{{!isPlaybackMode && !readingMode ? 'onStaticImageLongPress' : ''}}"
              />
              
              <!-- 模式2: Canvas 2D 谱面渲染
                   - collapsed=false: 常驻Canvas编辑模式
                   - collapsed=true && (无图片 || 编辑中): 显示Canvas
              -->
              <canvas 
                wx:if="{{!notations[pageModule.index].collapsed || !notations[pageModule.index].tempImagePath || notations[pageModule.index].isCanvasEditing}}"
                type="2d" 
                id="notation-canvas-{{notation.id}}" 
                class="notation-canvas {{notations[pageModule.index].isCanvasEditing || !notations[pageModule.index].collapsed ? 'editing-mode' : ''}}"
                style="width: 100%; height: 100%; position: absolute; z-index: 1;"
                data-id="{{notation.id}}"
                data-index="{{pageModule.index}}"
                bindtap="onCanvasTap"
                bindlongpress="{{!isPlaybackMode && !readingMode ? 'onCanvasLongPress' : ''}}"
              ></canvas>
              
              <!-- 播放光标覆盖层（View层，pointer-events: none）-->
              <view 
                wx:if="{{isPlaybackMode}}"
                class="playback-cursor-overlay"
                id="playback-cursor-{{notation.id}}"
              >
                <!-- 播放光标（使用CSS transform + transition实现流畅移动）
                     cursorVisible: true=显示, false=隐藏（未播放到/已播放完）
                     修复：分离可见性和播放动画，确保暂停/定位时也能显示光标 -->
                <view 
                  class="playback-cursor {{notations[pageModule.index].cursorVisible ? 'visible' : 'hidden'}} {{isPlaying && notations[pageModule.index].cursorVisible ? 'playing' : ''}}"
                  id="cursor-{{notation.id}}"
                  style="width: {{notations[pageModule.index].cursorWidth || 0}}px; height: {{notations[pageModule.index].cursorHeight || 0}}px; transform: translate({{notations[pageModule.index].cursorX || 0}}px, {{notations[pageModule.index].cursorY || 0}}px);"
                ></view>
              </view>
              
              <!-- 透明输入层已移除，使用虚拟键盘输入 -->
              <!-- 【性能优化】Canvas编辑状态下的选中框高亮（使用 transform 提升性能） -->
              <view 
                wx:if="{{canvasEditing && canvasEditing.notationId === notation.id}}"
                class="canvas-editing-highlight canvas-editing-highlight--optimized {{canvasEditing.hand === 'right' ? 'canvas-editing-highlight--right' : 'canvas-editing-highlight--left'}}"
                style="--highlight-x: {{canvasEditing.inputX}}px; --highlight-y: {{canvasEditing.inputY}}px; --highlight-w: {{canvasEditing.inputWidth}}px; --highlight-h: {{canvasEditing.inputHeight}}px; --highlight-color: {{canvasEditing.hand === 'right' ? rightHandColor : leftHandColor}};"
              ></view>
              <!-- 「切换键盘」后：在选中格上显示原生 input，唤起设备键盘并保持选中 -->
              <view 
                wx:if="{{canvasEditing && canvasEditing.notationId === notation.id && canvasUseNativeInput}}"
                class="canvas-native-input-wrap"
                style="position: absolute; left: {{canvasEditing.inputX}}px; top: {{canvasEditing.inputY}}px; width: {{canvasEditing.inputWidth}}px; height: {{canvasEditing.inputHeight}}px; z-index: 10;"
              >
                <input 
                  class="canvas-native-input"
                  type="text"
                  value="{{canvasEditingValue}}"
                  focus="{{true}}"
                  placeholder=""
                  bindinput="onCanvasNativeInput"
                  bindblur="onCanvasNativeInputBlur"
                  confirm-type="done"
                />
              </view>
              
              <!-- Canvas模式下的复制/粘贴/删除气泡弹窗（显示在选中尾拍位置） -->
              <view wx:if="{{showBeatSelectionBubble && beatSelectionEnd && beatSelectionEnd.notationId === notation.id}}" 
                    class="beat-bubble beat-bubble-canvas" 
                    style="left: {{beatBubbleCanvasPosition.x}}px; top: {{beatBubbleCanvasPosition.y}}px;"
                    catchtap="stopPropagation">
                <view class="beat-bubble-btn" bindtap="copySelectedBeats">
                  <image class="beat-bubble-icon" src="/assets/icons/copy.svg" mode="aspectFit"></image>
                  <text>复制</text>
                </view>
                <view class="beat-bubble-divider"></view>
                <view class="beat-bubble-btn {{beatClipboardBeats.length > 0 ? '' : 'disabled'}}" bindtap="{{beatClipboardBeats.length > 0 ? 'pasteBeats' : ''}}">
                  <image class="beat-bubble-icon" src="/assets/icons/paste.svg" mode="aspectFit"></image>
                  <text>粘贴</text>
                </view>
                <view class="beat-bubble-divider"></view>
                <view class="beat-bubble-btn beat-bubble-btn-delete" bindtap="deleteSelectedBeats">
                  <image class="beat-bubble-icon beat-bubble-icon-delete" src="/assets/icons/delete.png" mode="aspectFit"></image>
                  <text>删除</text>
                </view>
              </view>
            </view>

            <!-- 添加谱面图标（仅展开状态显示，选中模式下禁用所有操作） -->
            <view class="add-notation-row {{isSelectingBeats ? 'disabled' : ''}}" wx:if="{{!notations[pageModule.index].collapsed}}">
              <image class="add-icon" src="/assets/icons/add.svg" data-after-id="{{notation.id}}" bindtap="{{!isSelectingBeats ? 'addNotationAfter' : ''}}"></image>
              <image class="refresh-icon" src="/assets/icons/refresh.png" data-id="{{notation.id}}" bindtap="{{!isSelectingBeats ? 'refreshNotation' : ''}}"></image>
              <image class="tool-icon" src="/assets/icons/tool.png" data-id="{{notation.id}}" bindtap="{{!isSelectingBeats ? 'openModuleSettings' : ''}}"></image>
              <image class="less-icon" src="/assets/icons/less.png" data-id="{{notation.id}}" bindtap="{{!isSelectingBeats ? 'toggleNotationCollapse' : ''}}"></image>
            </view>
          </block>
        </view>
      </view>
      
      <!-- 手指拖动提示（仅在第一页且有多页时显示） -->
      <view class="hand-drag-hint" wx:if="{{currentPage === 0 && totalPages > 1}}">
        <image src="/assets/icons/hand_drag.png" class="hand-drag-image"></image>
        <text class="hand-drag-text">向左滑动浏览更多</text>
      </view>

      <!-- 手指拖动提示（第2页及以后） -->
      <view class="hand-drag-hint" wx:if="{{currentPage > 0 && totalPages > 1}}">
        <image src="/assets/icons/hand_move.png" class="hand-drag-image"></image>
        <text class="hand-drag-text">左右滑动浏览更多</text>
      </view>
    </view>

    <!-- 分页指示器 -->
    <view class="pagination-indicator" wx:if="{{enablePagination}}">
      <text class="pagination-text">第 {{currentPage + 1}} / {{totalPages}} 页</text>
    </view>
  </view>

  <!-- 页面切换加载遮罩 + 居中Logo + 80BPM悬浮节拍器（置于过渡容器外，避免被淡出遮挡） -->
  <view wx:if="{{showPageLoadingOverlay}}" class="page-loading-overlay">
    <image class="page-loading-logo" src="/assets/img/logo.png" mode="aspectFit"></image>
    <view class="overlay-metronome">
      <view wx:for="{{overlayMetronomeBeats}}" wx:key="index" class="metronome-dot overlay-dot"></view>
    </view>
  </view>

  <!-- 操作按钮（普通模式） -->
  <view wx:if="{{!actionCollapsed && !isPlaybackMode}}" class="action-buttons">
    <!-- 播放按钮（最左侧） -->
    <view class="action-btn" bindtap="togglePlayback">
      <image class="action-btn-icon" src="/assets/icons/play.svg"></image>
      <text class="action-btn-text">播放</text>
    </view>
    <view class="action-btn" bindtap="toggleFloatingMetronome">
      <image class="action-btn-icon" src="/assets/icons/metronome.png"></image>
      <text class="action-btn-text">节拍器</text>
      <view class="help-icon-wrap" catchtap="showMetronomeHelp">
        <image class="help-icon" src="/assets/icons/help.svg"></image>
      </view>
    </view>
    <view class="action-btn" bindtap="resetNotations">
      <image class="action-btn-icon" src="/assets/icons/reset.svg"></image>
      <text class="action-btn-text">重置</text>
    </view>
    <view class="action-btn" bindtap="undo">
      <image class="action-btn-icon" src="/assets/icons/上一步_back.png"></image>
      <text class="action-btn-text">撤销</text>
    </view>
    <view class="action-btn" bindtap="saveToLibrary">
      <image class="action-btn-icon" src="/assets/icons/save.svg"></image>
      <text class="action-btn-text">保存</text>
    </view>
    <view class="action-btn" bindtap="exportPDF">
      <image class="action-btn-icon" src="/assets/icons/download.png"></image>
      <text class="action-btn-text">导出</text>
    </view>
    <view class="action-btn" bindtap="openImportModal">
      <image class="action-btn-icon" src="/assets/icons/upload.png"></image>
      <text class="action-btn-text">导入</text>
    </view>
    <!-- 布局按钮（带二级菜单） -->
    <view class="layout-menu-container">
      <view class="action-btn {{showLayoutMenu ? 'layout-btn-active' : ''}}" bindtap="toggleLayoutMenu">
        <image class="action-btn-icon" src="/assets/icons/layout.svg"></image>
        <text class="action-btn-text">布局</text>
      </view>
      <!-- 布局二级菜单（气泡样式） -->
      <view class="layout-submenu" wx:if="{{showLayoutMenu}}" catchtap="stopPropagation">
        <view class="action-btn" bindtap="toggleReadingMode">
          <image class="action-btn-icon" src="{{readingMode ? '/assets/icons/newspaper-folding-active.png' : '/assets/icons/newspaper-folding.png'}}"></image>
          <text class="action-btn-text">{{readingMode ? '阅读' : '编辑'}}</text>
        </view>
        <view class="action-btn" bindtap="toggleOrientation">
          <image class="action-btn-icon" src="{{orientation === 'landscape' ? '/assets/icons/横屏.svg' : '/assets/icons/竖屏.svg'}}"></image>
          <text class="action-btn-text">{{orientation === 'landscape' ? '紧凑' : '宽松'}}</text>
        </view>
      </view>
    </view>
      <image class="action-collapse-icon" src="/assets/icons/internal-reduction.png" bindtap="toggleActionBar"></image>
      
  </view>

  <!-- ========== 播放模式悬浮控制图标 ========== -->
  <view wx:if="{{isPlaybackMode}}" class="player-floating-controls">
    <!-- 从头开始播放 -->
    <view class="player-floating-btn" bindtap="replayFromStart">
      <image class="player-floating-icon" 
             src="/subpackages/audio/icon/replay.svg"
             mode="aspectFit"></image>
    </view>
    <!-- 左移一格 -->
    <view class="player-floating-btn" bindtap="moveColumnLeft">
      <image class="player-floating-icon" 
             src="/subpackages/audio/icon/left.svg"
             mode="aspectFit"></image>
    </view>
    <!-- 右移一格 -->
    <view class="player-floating-btn" bindtap="moveColumnRight">
      <image class="player-floating-icon" 
             src="/subpackages/audio/icon/right.svg"
             mode="aspectFit"></image>
    </view>
  </view>
  
  <!-- ========== 播放模式菜单栏（三层结构设计） ========== -->
  <view wx:if="{{isPlaybackMode}}" class="player-control-bar">
    
    <!-- 第一层：次级功能行 -->
    <view class="player-secondary-row">
      <!-- 节拍器 -->
      <view class="player-secondary-btn {{metronomeActive ? 'active' : ''}}" bindtap="togglePlaybackMetronome">
        <image class="player-icon-sm" 
               src="{{metronomeActive ? '/subpackages/audio/icon/metronome-active.png' : '/subpackages/audio/icon/metronome.png'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- 速度显示（带内联竖向滑动杠） -->
      <view class="player-tempo-display" bindtap="toggleInlineTempoSlider">
        <image class="player-icon-sm" 
               src="/subpackages/audio/icon/speed.svg"
               mode="aspectFit"></image>
        <text class="player-tempo-value">{{playbackTempo || 80}}</text>
        
        <!-- 内联竖向速度调节杠（自定义触摸实现），范围20~180 -->
        <view wx:if="{{showInlineTempoSlider}}" class="inline-tempo-slider-wrapper" catchtap="stopPropagation">
          <!-- 主容器 -->
          <view class="inline-tempo-slider">
            <!-- 可输入数字 -->
            <view class="inline-tempo-input-wrapper">
              <input class="inline-tempo-input" 
                     type="number" 
                     value="{{playbackTempo}}" 
                     bindinput="onTempoInputChange"
                     bindblur="onTempoInputBlur"
                     maxlength="3" />
            </view>
            <!-- 触摸区域包含 180+轨道+20，便于拖到最上/最下也能取到 180/20 -->
            <view class="inline-tempo-track-area"
                  bindtouchstart="onTempoTrackTouchStart"
                  bindtouchmove="onTempoTrackTouchMove"
                  bindtouchend="onTempoTrackTouchEnd">
              <text class="inline-tempo-max">180</text>
              <view class="inline-tempo-track">
                <view class="inline-tempo-fill" style="height: {{((playbackTempo - 20) / 160) * 100}}%"></view>
                <view class="inline-tempo-thumb" style="bottom: {{((playbackTempo - 20) / 160) * 100}}%"></view>
              </view>
              <text class="inline-tempo-min">20</text>
            </view>
            
          </view>
        </view>
      </view>
      
      <!-- 视角跟随 -->
      <view class="player-secondary-btn {{playbackFollowCursor ? 'active' : ''}}" bindtap="toggleFollowCursorBtn">
        <image class="player-icon-sm" 
               src="{{playbackFollowCursor ? '/subpackages/audio/icon/perspective_follow-active.svg' : '/subpackages/audio/icon/perspective_follow.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- 倒计时 -->
      <view class="player-secondary-btn {{countdownEnabled ? 'active' : ''}}" bindtap="toggleCountdown">
        <image class="player-icon-sm" 
               src="{{countdownEnabled ? '/subpackages/audio/icon/countdown-active.svg' : '/subpackages/audio/icon/countdown.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- 更多设置 -->
      <view class="player-secondary-btn" bindtap="togglePlaybackSettings">
        <image class="player-icon-sm" 
               src="/subpackages/audio/icon/sliders.svg"
               mode="aspectFit"></image>
      </view>
    </view>
    
    <!-- 第二层：进度控制区 -->
    <view class="player-progress-area">
      <view class="player-progress-track" bindtap="seekPlayback" catchtouchmove="onProgressDrag">
        <view class="player-progress-fill" style="width: {{playbackProgress || 0}}%"></view>
        <view class="player-progress-thumb" style="left: {{playbackProgress || 0}}%"></view>
      </view>
      <view class="player-time-labels">
        <text class="player-time-current">{{playbackCurrentTimeStr || '0:00'}}</text>
        <text class="player-time-total">{{playbackDurationStr || '0:00'}}</text>
      </view>
    </view>
    
    <!-- 第三层：主控按钮行 -->
    <view class="player-primary-row">
      <!-- Level 3: 循环模式（最小） -->
      <view class="player-mode-btn" bindtap="togglePlaybackMode">
        <image class="player-icon-xs" 
               src="{{playbackMode === 'loop' ? '/subpackages/audio/icon/repeat.svg' : '/subpackages/audio/icon/repeat-once.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 2: 上一段（中等） -->
      <view class="player-nav-btn" bindtap="playbackPrevModule">
        <image class="player-icon-md" 
               src="/subpackages/audio/icon/skip-back.svg"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 1: 播放/暂停（最大，核心） -->
      <view class="player-play-btn {{isPlaying ? 'playing' : ''}}" bindtap="togglePlayPause">
        <image class="player-play-icon" 
               src="{{isPlaying ? '/subpackages/audio/icon/pause.svg' : '/subpackages/audio/icon/play.svg'}}"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 2: 下一段（中等） -->
      <view class="player-nav-btn" bindtap="playbackNextModule">
        <image class="player-icon-md" 
               src="/subpackages/audio/icon/skip-forward.svg"
               mode="aspectFit"></image>
      </view>
      
      <!-- Level 3: 终止/退出（最小） -->
      <view class="player-stop-btn" bindtap="stopAndExitPlayback">
        <image class="player-stop-icon" 
               src="/subpackages/audio/icon/logout.png"
               mode="aspectFit"></image>
      </view>
    </view>
  </view>
  
  <!-- 速度调节弹窗 -->
  <view wx:if="{{showTempoSlider}}" class="player-tempo-overlay" catchtap="hideTempoSlider">
    <view class="player-tempo-panel" catchtap="preventBubble">
      <text class="player-tempo-title">播放速度</text>
      <view class="player-tempo-slider-row">
        <text class="player-tempo-label">30</text>
        <slider class="player-tempo-slider" 
                min="30" max="200" step="1" 
                value="{{playbackTempo}}" 
                activeColor="#8FB9AB"
                backgroundColor="rgba(49, 77, 99, 0.15)"
                block-size="28"
                block-color="#314D63"
                bindchange="onTempoChange"/>
        <text class="player-tempo-label">200</text>
      </view>
      <text class="player-tempo-bpm">♩ = {{playbackTempo}} BPM</text>
    </view>
  </view>
  
  <!-- 更多设置弹窗 -->
  <view wx:if="{{showPlaybackSettings}}" class="player-settings-overlay" catchtap="hidePlaybackSettings">
    <view class="player-settings-panel" catchtap="preventBubble">
      <view class="player-settings-handle"></view>
      <view class="player-settings-header">
        <text class="player-settings-title">播放设置</text>
        <view class="player-settings-close-btn" bindtap="hidePlaybackSettings">
          <text>✕</text>
        </view>
      </view>
      
      <view class="player-settings-body">
        <!-- 播放体验 -->
        <view class="player-settings-section">
          <text class="player-settings-section-title">播放体验</text>
          <view class="player-settings-card">
            <view class="player-setting-row player-setting-row-slider">
              <text class="player-setting-label">节拍器音量</text>
              <view class="player-setting-control player-setting-control-slider">
                <slider class="player-setting-slider" 
                        min="0" max="100" step="5" 
                        value="{{metronomeVolume || 50}}" 
                        activeColor="#8FB9AB"
                        backgroundColor="rgba(49, 77, 99, 0.12)"
                        block-size="16"
                        block-color="#8FB9AB"
                        bindchange="onMetronomeVolumeChange"/>
                <view class="player-setting-value-pill player-setting-value-pill-above" style="left: {{metronomeVolumePercent || 50}}%"><text>{{metronomeVolume || 50}}%</text></view>
              </view>
            </view>
            <view class="player-setting-divider"></view>
            <view class="player-setting-row">
              <text class="player-setting-label">视角跟随光标</text>
              <switch class="player-setting-switch" 
                      checked="{{playbackFollowCursor}}" 
                      color="#8FB9AB"
                      bindchange="toggleFollowCursor"/>
            </view>
          </view>
        </view>
        
        <!-- 播放模式 -->
        <view class="player-settings-section">
          <text class="player-settings-section-title">播放模式</text>
          <view class="player-mode-selector">
            <view class="player-mode-opt {{playbackMode === 'single' ? 'selected' : ''}}" 
                  bindtap="setPlaybackModeSingle">
              <text>单曲</text>
            </view>
            <view class="player-mode-opt {{playbackMode === 'loop' ? 'selected' : ''}}" 
                  bindtap="setPlaybackModeLoop">
              <text>循环</text>
            </view>
          </view>
        </view>
        
        <!-- 音频映射 -->
        <view class="player-settings-section">
          <view class="audio-mapping-settings-btn" bindtap="openAudioMappingFromSettings">
            <image class="audio-mapping-btn-icon" src="/subpackages/audio/icon/sliders.svg" mode="aspectFit"></image>
            <text class="audio-mapping-btn-text">音频映射设置</text>
            <text class="audio-mapping-btn-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <image class="action-toggle {{isSelectingBeats ? 'disabled' : ''}}" 
    src="/assets/icons/toolkit.svg" 
    bindtap="{{!isSelectingBeats ? 'toggleActionBar' : ''}}"
    wx:if="{{actionCollapsed && !isPlaybackMode}}"></image>

  <!-- 播放倒计时遮罩 -->
  <view wx:if="{{showPlaybackCountdown}}" class="playback-countdown-overlay">
    <view class="countdown-content">
      <view class="countdown-circle {{countdownNumber <= 0 ? 'countdown-go' : ''}}">
        <text class="countdown-number">{{countdownNumber > 0 ? countdownNumber : '♪'}}</text>
      </view>
      <view class="countdown-pulse"></view>
    </view>
  </view>

  <!-- 播放资源加载提示 -->
  <view wx:if="{{showPlaybackLoading}}" class="playback-loading-overlay">
    <view class="playback-loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{playbackLoadingText}}</text>
    </view>
  </view>

  <!-- 悬浮节拍器 -->
  <view wx:if="{{showFloatingMetronome}}" class="floating-metronome">
    <view class="metronome-dots">
      <view wx:for="{{metronomeBeats}}" wx:key="index" class="metronome-dot {{currentMetronomeBeat === index ? (index === 0 ? 'active active-accent' : 'active') : ''}}"></view>
    </view>
    <image class="metronome-close" src="/assets/icons/delete.png" bindtap="closeFloatingMetronome"></image>
  </view>

  <!-- 节拍器帮助提示窗口 -->
  <view wx:if="{{showMetronomeHelpModal}}" class="modal-overlay" bindtap="closeMetronomeHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">节拍器说明</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>点击节拍器按钮会弹出一个悬浮节拍器</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>节奏速度使用当前谱面的「速度」设定</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>拍数使用当前谱面的「拍号」设定</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>悬浮节拍器会显示当前拍点，便于练习</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text>点击关闭图标可关闭悬浮节拍器</text>
        </view>
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="closeMetronomeHelp">知道了</button>
      </view>
    </view>
  </view>

  <!-- 排版视角帮助窗口 -->
  <view wx:if="{{showRotationHelpModal}}" class="modal-overlay" bindtap="closeRotationHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">排版视角</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">竖屏模式：</text>默认手机端排版模式</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">横屏/平板模式：</text>一行排版更多小节，可容纳更多内容，页面元素均缩小</text>
        </view>
      
      </view>
    </view>
  </view>

  <!-- 拍号选择帮助窗口 -->
  <view wx:if="{{showTimeSignatureHelpModal}}" class="modal-overlay" bindtap="closeTimeSignatureHelp">
    <view class="modal-content help-modal" catchtap="stopPropagation">
      <view class="modal-title">拍号设置</view>
      <view class="help-md">
        <view class="md-line">
          <text class="md-dot"></text>
          <text><text class="md-strong">独立数据：</text>每个拍号都有独立数据空间，互不影响</text>
        </view>
        <view class="md-line">
          <text class="md-dot"></text>
          <text><text class="md-strong">自动切换：</text>更换拍号会自动切换到对应数据</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">4/4：</text>每小节 4 拍，标准节拍</text>
        </view>
        <view class="md-line">
          <text class="md-dot">•</text>
          <text><text class="md-strong">3/4：</text>每小节 3 拍，常见于圆舞曲</text>
        </view>
        <view class="md-quote">首次进入某拍号会初始化默认谱面，可在该拍号下自由编辑，不影响其他拍号。</view>
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="closeTimeSignatureHelp">知道了</button>
      </view>
    </view>
  </view>

  <!-- 模块标签编辑弹窗（名称+备注） -->
  <view wx:if="{{showLabelEditModal}}" class="modal-overlay" bindtap="closeLabelEditModal">
    <view class="modal-content label-edit-modal" catchtap="stopPropagation">
      <view class="modal-title">编辑模块信息</view>
      <view class="modal-body">
        <view class="label-edit-row">
          <text class="label-edit-label">名称</text>
          <input class="modal-input" type="text" value="{{labelEditName}}" placeholder="例如: A-1" bindinput="onLabelEditNameInput" />
        </view>
        <view class="label-edit-row">
          <text class="label-edit-label">备注</text>
          <input class="modal-input" type="text" value="{{labelEditRemark}}" placeholder="例如: ♪速度 (可选)" bindinput="onLabelEditRemarkInput" />
        </view>
      </view>
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeLabelEditModal">取消</button>
        <button class="btn-primary" bindtap="confirmLabelEdit">确定</button>
      </view>
    </view>
  </view>

  <!-- 通用编辑弹窗（用于标题/副标题/速度等） -->
  <view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">{{editModalTitle}}</view>
      <view class="modal-body">
        <input class="modal-input" type="{{editInputType}}" value="{{editValue}}" focus="true" placeholder="{{editPlaceholder}}" bindinput="onEditInput" confirm-type="done" bindconfirm="confirmEdit" />
      </view>
      <view class="modal-buttons">
        <button class="btn-primary" bindtap="confirmEdit">确定</button>
      </view>
    </view>
  </view>

  <!-- 自由设定拍号模态框 -->
  <view wx:if="{{showCustomTimeSignatureModal}}" class="modal-overlay" bindtap="closeCustomTimeSignatureModal">
    <view class="modal-content custom-time-signature-modal" catchtap="stopPropagation">
      <view class="modal-title">自由设定拍号</view>
      
      <view class="custom-signature-help">
        <view class="help-section">
          <text class="help-label">使用说明：</text>
          <text class="help-text">1. 设置总音符数，圆点将自动显示</text>
          <text class="help-text">2. 点击圆点之间的间隙插入分隔线</text>
          <text class="help-text">3. 单击循环：无 → 拍线 | → 小节线 ][ → 无</text>
        </view>
        <view class="help-section">
          <text class="help-label">限制：</text>
          <text class="help-text">• 音符数 1~35 个，单拍音符 1~10 个</text>
        </view>
      </view>

      <view class="modal-body">
        <!-- 音符数输入 -->
        <view class="note-count-row">
