          <text class="library-add-text">新建转换表</text>
        </view>
      </scroll-view>
      
      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeConversionLibrary">关闭</button>
        <button class="btn-primary" bindtap="applySelectedConversionTable">应用</button>
