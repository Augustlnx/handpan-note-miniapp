      <!-- 弹窗标题 -->
      <view class="splash-header">
        <text class="splash-title">欢迎使用</text>
        <text class="splash-subtitle">Orbit Note 星轨手碟记谱</text>
      </view>

      <!-- Logo 图片 -->
      <image class="splash-logo" src="/subpackages/resources/img/logo5.png"></image>
      <!-- 弹窗描述 -->
      <view class="splash-description">
        <text class="splash-text">Orbit Note 是一个专为Handpan手碟音乐记谱设计的小程序工具。支持创建、编辑和导出乐谱，提供了灵活的记谱格式和多种导出选项。</text>
        <text class="splash-text">如遇谱面绘制空白，可尝试点击模块底部最右侧“缩小”按钮尝试切换加载谱面。导出文件若因为缓存超限失败，可在设置界面选择清除缓存（会删除所有数据，请提前导出创作内容）。欢迎分享给其他朋友使用~</text>
        <text class="splash-text"></text>
      </view>

      <!-- 隐私说明区域（可展开） -->
      <view class="splash-privacy-container {{splashPrivacyExpanded ? 'splash-privacy-expanded' : ''}}">
        <view class="splash-privacy-header" bindtap="onSplashPrivacyToggle">
          <text class="splash-privacy-title">隐私权限说明</text>
          <image wx:if="{{!splashPrivacyExpanded}}" class="splash-privacy-arrow" src="/assets/icons/keyboard/右_right.svg" mode="aspectFit"></image>
          <image wx:else class="splash-privacy-arrow" src="/assets/icons/keyboard/下_down.svg" mode="aspectFit"></image>
        </view>
        <scroll-view wx:if="{{splashPrivacyExpanded}}" class="splash-privacy-scroll" scroll-y="true">
          <view class="splash-privacy-content">
            <view class="privacy-section">
              <view class="privacy-item">
                <text class="privacy-icon">📋</text>
                <view class="privacy-text-wrapper">
                  <text class="privacy-item-title">剪切板权限</text>
                  <text class="privacy-item-desc">用于导入和导出曲谱数据。当您使用"导入曲谱"或"复制曲谱"功能时，需要访问剪切板以读取或写入曲谱数据，方便您在不同设备间分享和备份您的创作。</text>
                </view>
              </view>
            </view>

            <view class="privacy-section">
              <view class="privacy-item">
                <text class="privacy-icon">🖼️</text>
                <view class="privacy-text-wrapper">
                  <text class="privacy-item-title">相册访问权限</text>
                  <text class="privacy-item-desc">用于保存导出的曲谱PDF文件。当您使用"导出PDF"功能时，需要将生成的PDF文件保存到您的设备相册或文件系统中，方便您随时查看和分享。</text>
                </view>
              </view>
            </view>

            <view class="privacy-section">
              <view class="privacy-item">
                <text class="privacy-icon">👤</text>
                <view class="privacy-text-wrapper">
                  <text class="privacy-item-title">微信用户信息</text>
                  <text class="privacy-item-desc">用于设置用户中心界面。我们会获取您的微信头像和昵称，用于在用户中心界面显示个性化信息，提升使用体验。这些信息仅用于界面展示，不会用于其他用途。</text>
                </view>
              </view>
            </view>

            <view class="privacy-section">
              <view class="privacy-item">
                <text class="privacy-icon">💾</text>
                <view class="privacy-text-wrapper">
                  <text class="privacy-item-title">文件存储权限</text>
                  <text class="privacy-item-desc">用于保存曲谱PDF文件到本地。当您导出曲谱为PDF格式时，需要将文件保存到设备存储中，确保您的创作内容可以持久保存和随时访问。</text>
                </view>
              </view>
            </view>

            <view class="privacy-agreement">
              <text class="privacy-agreement-text">进入小程序即表示您已阅读、理解并同意上述隐私权限说明。我们承诺仅将上述权限用于提供核心功能服务，不会收集或使用您的其他个人信息。</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 操作按钮（三个横向排列） -->
      <view class="splash-actions">
        <view class="splash-action-row">
          <button class="splash-btn splash-btn-never-show" bindtap="onSplashNeverShowAgain">
            <text class="splash-btn-label">不再显示</text>
          </button>
          <button class="splash-btn splash-btn-example" bindtap="onSplashViewExample">
            <text class="splash-btn-label">查看示例</text>
          </button>
          <button class="splash-btn splash-btn-manual" bindtap="onSplashViewManual">
            <text class="splash-btn-label">新手教程</text>
          </button>
        </view>
      </view>
