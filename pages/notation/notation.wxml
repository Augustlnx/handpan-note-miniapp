        </view>

        <!-- 可视化圆点区域 -->
        <scroll-view scroll-x class="visual-dots-scroll">
          <view class="visual-dots-container">
            <text class="bracket-text">[</text>
            <block wx:for="{{visualDots}}" wx:key="index">
              <!-- 圆点 -->
              <view class="visual-dot"></view>
              <!-- 间隙（除最后一个外） -->
