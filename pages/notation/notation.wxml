      <view class="modal-buttons">
        <button class="btn-secondary" bindtap="closeSaveToLibraryModal">取消</button>
        <button class="btn-primary" bindtap="confirmSaveToLibrary">保存到当前目录</button>
      </view>
    </view>
  </view>

  <!-- 保存模式选择弹窗 -->
