.vk-dir-btn text {
  font-size: 24rpx;
  font-weight: 900;
}

.vk-dir-up {
  grid-column: 2;
  grid-row: 1;
  padding-top: 20rpx;
}

.vk-dir-left {
  grid-column: 1;
  grid-row: 2;
  padding-left: 20rpx;
}

.vk-dir-center {
  grid-column: 2;
  grid-row: 2;
  width: 85rpx;
  height: 85rpx;
  border-radius: 50%;
  border: 3rpx solid #CDCDCD; 
  background: linear-gradient(145deg, #F2F2F2, #EDEDED);
  box-shadow: 5rpx 5rpx 10rpx #b0b0b0, -5rpx -5rpx 10rpx #ffffff, inset 0 0 0 4rpx #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.vk-dir-center text {
  font-size: 28rpx;
  color: #333;
  margin-left: 4rpx;
}

.vk-dir-center:active {
  box-shadow: inset 3rpx 3rpx 6rpx #b0b0b0, inset -3rpx -3rpx 6rpx #ffffff;
}

.vk-dir-right {
  grid-column: 3;
  grid-row: 2;
  padding-right: 20rpx;
}

.vk-dir-down {
  grid-column: 2;
  grid-row: 3;
  padding-bottom: 20rpx;
}

/* 编辑功能键行（删除键独占整行） */
.vk-edit-row {
  flex: 1.2;
  display: flex;
  margin-top: 20rpx;
  flex-direction: row;
  gap: 10rpx;
}

.vk-edit-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.12);
  transition: all 0.1s ease;
}

.vk-edit-btn:active {
  opacity: 0.85;
  transform: scale(0.94);
}

/* 编辑按钮内的普通文字（排除特定类） */
.vk-edit-btn text:not(.vk-edit-btn-label):not(.vk-icon-desc) {
  font-size: 30rpx;
  color: #000000;
  font-weight: 500;
}

.vk-edit-backspace {
  flex: 2; /* 删除键占2/3宽度 */
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
}

/* 更多设置键 */
.vk-edit-settings {
  flex: 1; /* 更多设置键占1/3宽度 */
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
  justify-content: center;
}

/* 编辑按钮文字模式（自定义键盘模式） */
.vk-edit-btn-text {
  background: linear-gradient(180deg, #314D63 0%, #456275 100%) !important;
}

/* 编辑按钮标签文字（自定义键盘模式下的"完成"和"↻"） */
.vk-edit-btn-label {
  font-size: 28rpx;
  color: #fff !important;
  font-weight: 600;
  display: block;
}

.vk-reset-icon {
  font-size: 36rpx !important;
}

/* ========== 更多设置界面样式 ========== */
.vk-settings-panel {
  position: absolute;
  top: -480rpx;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #f8fafb 0%, #ffffff 100%);
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  z-index: 100;
  animation: settingsPanelFadeIn 0.25s ease-out;
}

@keyframes settingsPanelFadeIn {
  from {
    opacity: 0;
    transform: translateX(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 设置界面顶部导航 */
.vk-settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(49, 77, 99, 0.08);
}

.vk-settings-back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.15s ease;
}

.vk-settings-back-btn:active {
  transform: scale(0.92);
  background: rgba(49, 77, 99, 0.12);
}

.vk-settings-back-icon {
  width:42rpx;
  height:42rpx;
}

.vk-settings-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #314D63;
}

.vk-settings-placeholder {
  width: 56rpx;
}

/* 设置界面图标区域 */
.vk-settings-icons-area {
  flex: 2;
  display: flex;
  flex-direction: column;
  padding: 24rpx 20rpx;
  gap: 20rpx;
}

.vk-settings-icon-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex: 1;
}

.vk-settings-icon-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.15s ease;
}

.vk-settings-icon-item:active:not(.vk-settings-icon-empty):not(.vk-settings-icon-disabled) {
  transform: scale(0.95);
}

.vk-settings-icon-empty {
  opacity: 0;
  pointer-events: none;
}

.vk-settings-icon-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.vk-settings-icon-box {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f0f2f5 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.08);
  border: 1rpx solid rgba(49, 77, 99, 0.06);
}

.vk-settings-icon {
  width: 48rpx;
  height: 48rpx;
}

.vk-settings-icon-label {
  font-size: 22rpx;
  color: #314D63;
  font-weight: 500;
}

/* 音高条关闭状态的图标样式 */
.vk-settings-icon-off {
  opacity: 0.7;
}

.vk-settings-icon-box-off {
  background: linear-gradient(145deg, #f0f2f5 0%, #e0e2e5 100%);
}

.vk-settings-icon-dimmed {
  opacity: 0.4;
  filter: grayscale(30%);
}

/* 设置界面切换区域 */
.vk-settings-toggles-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: rgba(49, 77, 99, 0.02);
  border-top: 1rpx solid rgba(49, 77, 99, 0.06);
}

.vk-settings-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.vk-settings-toggle-label {
  font-size: 26rpx;
  color: #314D63;
  font-weight: 500;
}

/* 胶囊切换按钮 */
.vk-settings-capsule-switch {
  display: flex;
  background: rgba(49, 77, 99, 0.08);
  border-radius: 24rpx;
  padding: 4rpx;
  gap: 0;
}

.vk-capsule-option {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.vk-capsule-option text {
  font-size: 24rpx;
  color: rgba(49, 77, 99, 0.6);
  font-weight: 500;
  white-space: nowrap;
}

.vk-capsule-option.vk-capsule-active {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.12);
}

.vk-capsule-option.vk-capsule-active text {
  color: #314D63;
  font-weight: 600;
}

/* ========== 自定义键盘模式样式 ========== */
.vk-key-customizing {
  position: relative;
  background: #fff;
}

.vk-key-editing {
  border: 2rpx solid #314D63 !important;
  background: linear-gradient(180deg, #f8fafb 0%, #ffffff 100%) !important;
}

.vk-custom-input {
  width: 100%;
  height: 100%;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #212529;
  background: transparent;
}

/* 禁用状态样式 */
.vk-toolbar-disabled {
  opacity: 0.5;
}

.vk-pitch-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.vk-direction-disabled {
  opacity: 0.4;
}

.vk-pad-disabled {
  pointer-events: none;
}

.vk-btn-hidden {
  opacity: 0;
  pointer-events: none;
}

/* ========== 新增：标题区优化样式 ========== */

/* 右上角简介图标 */
.intro-icon {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
  transition: opacity 0.2s;
}

.intro-icon:active {
  opacity: 1;
}

/* 副标题行 */
.sub-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 0 10rpx;
}

.sub-title-divider {
  font-size: 28rpx;
  opacity: 0.6;
}

/* 参数网格布局 */
.params-grid {
  width: 100%;
  padding: 0rpx 0;
}

.param-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
  margin-bottom: 16rpx;
  width: 100%;
}

/* 单元格内对齐：首项左对齐，末项右对齐，中间项左对齐以实现垂直对齐 */
.param-row .param-item-group:nth-child(1) {
  justify-self: start;
}

.param-row .param-item-group:nth-child(2) {
  justify-self: start; /* 改为 start 以确保第一行和第二行的中间项左侧对齐线一致 */
  margin-left: 10%;    /* 稍微向右偏移，使其在布局上更接近视觉居中，同时保持对齐 */
}

.param-row .param-item-group:nth-child(3) {
  justify-self: end;
}

/* 第二行保持垂直居中 */
.param-row-spread {
}

/* 参数项组合：图标+名称+数值为整体 */
.param-item-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0rpx;
  background: #fff;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.param-item-group:active {
  background: rgba(143, 185, 171, 0.12);
  transform: scale(0.98);
}

.param-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.param-label {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.param-value {
  font-size: 26rpx;
  color: #314D63;
  font-weight: 600;
  white-space: nowrap;
}

.param-storage {
  /* 允许显示全部内容，移除了宽度限制和省略号 */
}

/* 难度星星小型显示 */
.difficulty-stars-display {
  display: flex;
  align-items: center; /* 确保星星垂直居中 */
  gap: 2rpx;
}

.difficulty-star-small {
  width: 20rpx;
  height: 20rpx;
}

.star-active-small {
  opacity: 1;
}

.star-inactive-small {
  opacity: 0.25;
  filter: grayscale(100%);
}

/* ========== 难度选择弹窗 ========== */
.difficulty-modal {
  padding: 40rpx;
}

.difficulty-stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0;
}

.difficulty-star {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
}

.difficulty-star:active {
  transform: scale(1.2);
}

.star-icon {
  width: 48rpx;
  height: 48rpx;
}

.star-inactive {
  opacity: 0.3;
  filter: grayscale(100%);
}

.star-active {
  opacity: 1;
  filter: none;
}

.difficulty-hint {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* ========== 副标题编辑弹窗 ========== */
.subtitle-edit-modal {
  padding: 30rpx;
  max-height: 80vh;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #314D63;
  margin-bottom: 12rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.form-input {
  width: calc(100% - 48rpx);
  height: 84rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafb 100%);
  border-radius: 14rpx;
  border: 2rpx solid rgba(143, 185, 171, 0.3);
  font-size: 28rpx;
  color: #314D63;
  box-sizing: border-box;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.06);
}

.form-input:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-col {
  flex: 1;
}

.picker-value {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafb 100%);
  border-radius: 14rpx;
  border: 2rpx solid rgba(143, 185, 171, 0.3);
  font-size: 28rpx;
  color: #314D63;
  font-weight: 500;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 20rpx;
  color: #314D63;
  margin-left: 8rpx;
  transition: transform 0.2s ease;
}

.picker-value:active {
  background: linear-gradient(135deg, #f0f8f5 0%, #e8f4f0 100%);
  border-color: #8FB9AB;
  box-shadow: 0 4rpx 16rpx rgba(143, 185, 171, 0.2);
  transform: scale(0.98);
}

.picker-value:active .picker-arrow {
  transform: rotate(180deg);
}

/* ========== 简介弹窗 ========== */
.intro-modal {
  padding: 30rpx;
}

.intro-textarea {
  width: 100%;
  height: 300rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 10rpx;
}

.intro-counter {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}
/* ========== 曲谱播放模式样式 - 三层结构设计 ========== */

/* 播放模式悬浮控制图标 - 位于菜单栏上方右侧 */
.player-floating-controls {
  position: fixed;
  right: 18rpx;
  bottom: calc(350rpx + env(safe-area-inset-bottom)); /* 菜单栏上方 */
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  z-index: 1001; /* 高于播放控制栏 z-index: 1000 */
  animation: floatingControlsFadeIn 0.3s ease-out;
}

@keyframes floatingControlsFadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.player-floating-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 50%;
  transition: all 0.2s ease;
  opacity: 0.7;
}

.player-floating-btn:active {
  transform: scale(0.92);
  background: rgba(255, 255, 255, 0.9);
  opacity: 1;
}

.player-floating-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.55;
}

.player-floating-btn:active .player-floating-icon {
  opacity: 1;
}

/* 播放器主容器 - 垂直线性渐变背景 */
.player-control-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  /* 从白色到浅蓝色的自然渐变 */
background: radial-gradient(
    150% 120% at 50% 100%, 
    
    /* 核心色：加深了！现在是明显的青蓝色，不再是若有若无的白 */
    rgba(49, 77, 99, 0.15) 0%,  
    
    /* 过渡色：稍微带一点灰调的蓝，连接核心和顶部 */
    rgba(225, 238, 245, 0.3) 25%,  
    
    /* 外部：保持纯白，但位置推到了 80% 以后 */
    rgba(255, 255, 255, 0.98) 80%,
    rgba(255, 255, 255, 1) 100%
  );

  backdrop-filter: blur(25px);
  /* 建议：因为背景变深了，顶部的高光线可以稍微明显一点，增加层次 */
  -webkit-backdrop-filter: blur(20px);
  padding: 4rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 1000;
  box-shadow: 0 -2rpx 20rpx rgba(49, 77, 99, 0.08);
  animation: playerSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes playerSlideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* ===== 第一层：次级功能行 ===== */
.player-secondary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
  margin-bottom: 40rpx;
}

.player-secondary-btn {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.player-secondary-btn:active {
  transform: scale(0.94);
  background: rgba(49, 77, 99, 0.12);
}

.player-secondary-btn.active {
}

.player-icon-sm {
  width: 43rpx;
  height: 43rpx;
  opacity: 0.75;
}

.player-secondary-btn.active .player-icon-sm {
  opacity: 1;
}

.player-icon-text {
  font-size: 28rpx;
  opacity: 0.6;
}

.player-secondary-btn.active .player-icon-text {
  opacity: 1;
}

/* 速度显示 */
.player-tempo-display {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.player-tempo-display:active {
  background: rgba(49, 77, 99, 0.12);
}

.player-tempo-note {
  font-size: 42rpx;
  color: #314D63;
  font-weight: 500;
  vertical-align: middle; 
}

.player-tempo-value {
  font-size: 38rpx;
  color: #314D63;
  vertical-align: middle; 
  font-weight: 800;
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
}

/* ===== 第二层：进度控制区 ===== */
.player-progress-area {
  padding: 0 8rpx;
  margin-bottom: 15rpx;
}

.player-progress-track {
  height: 6rpx;
  background: rgba(49, 77, 99, 0.12);
  border-radius: 3rpx;
  position: relative;
  margin-bottom: 8rpx;
}

.player-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3D5C6B 0%, #334E5A 100%);
  border-radius: 3rpx;
  transition: width 0.15s ease-out;
}

.player-progress-thumb {
  position: absolute;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  background: #314D63;
  border: 3rpx solid #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.25);
  transition: left 0.15s ease-out;
}

.player-time-labels {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 4rpx;
}

.player-time-current,
.player-time-total {
  font-size: 20rpx;
  color: rgba(49, 77, 99, 0.5);
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
  letter-spacing: 0.5rpx;
}

/* ===== 第三层：主控按钮行 ===== */
.player-primary-row {
  display: flex;
  align-items: center;
  justify-content: space-between; 
  gap: 0;
  padding: 0 2rpx; 
  width: 100%;
  box-sizing: border-box;
}

/* Level 3: 循环/终止按钮（最小） */
.player-mode-btn,
.player-stop-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border-radius: 50%;
  transition: all 0.15s ease;
}

.player-mode-btn:active,
.player-stop-btn:active {
  transform: scale(0.9);
  background: rgba(49, 77, 99, 0.08);
}

.player-icon-xs {
  width: 55rpx;
  height: 55rpx;
  opacity: 1;
}

.player-stop-icon {
  width: 52rpx;
  height: 52rpx;
}

/* Level 2: 导航按钮（中等） */
.player-nav-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.15s ease;
  margin: 0 8rpx;
}

.player-nav-btn:active {
  transform: scale(0.92);
  background: rgba(49, 77, 99, 0.12);
}

.player-icon-md {
  width: 55rpx;
  height: 55rpx;
  opacity: 1;
}

/* Level 1: 播放/暂停按钮（最大，核心） */
.player-play-btn {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border-radius: 50%;
  box-shadow: 0 12rpx 40rpx rgba(49, 77, 99, 0.35);
  transition: all 0.2s ease;
  margin: 0 0rpx;
  position: relative;
  z-index: 1;
}

.player-play-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx rgba(49, 77, 99, 0.3);
}

.player-play-btn.playing {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  animation: playBtnPulse 2s ease-in-out infinite;
}

@keyframes playBtnPulse {
  0%, 100% {
    box-shadow: 0 12rpx 40rpx rgba(49, 77, 99, 0.35);
  }
  50% {
    box-shadow: 0 12rpx 48rpx rgba(49, 77, 99, 0.5),
                0 0 60rpx rgba(49, 77, 99, 0.2);
  }
}

.player-play-icon {
  width: 62rpx;
  height: 62rpx;
  filter: brightness(0) invert(1);
}

/* ===== 内联竖向速度调节杠 ===== */
.player-tempo-display {
  position: relative;
}

/* 整体容器包装器 */
.inline-tempo-slider-wrapper {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 12rpx;
  z-index: 1200;
  animation: slideUpFade 0.2s ease;
}

/* 主滑杆容器 */
.inline-tempo-slider {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 54rpx;
  padding: 20rpx 8rpx;
  box-shadow: 0 10rpx 40rpx rgba(49, 77, 99, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 80rpx;
}

@keyframes slideUpFade {
  from { 
    opacity: 0; 
    transform: translateX(-50%) translateY(10rpx);
  }
  to { 
    opacity: 1; 
    transform: translateX(-50%) translateY(0);
  }
}

/* 触摸区域：包含 180+轨道+20，拖到顶端/底端也能正确取到 180/20 */
.inline-tempo-track-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.inline-tempo-max,
.inline-tempo-min {
  font-size: 20rpx;
  color: rgba(49, 77, 99, 0.6);
  font-family: 'SF Mono', 'Monaco', monospace;
  font-weight: 500;
}

/* 自定义竖向滑动条轨道 - 加大 */
.inline-tempo-track {
  width: 44rpx;
  height: 380rpx;
  background: rgba(48, 72, 89, 0.2);
  border-radius: 46rpx;
  position: relative;
  overflow: visible;
}

/* 已填充部分（从底部向上） */
.inline-tempo-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 0;
  background: #3D586B;
  border-radius: 0 0 46rpx 46rpx;
  transition: height 0.05s ease-out;
}

/* 滑块 - 加大，置于填充层之上 */
.inline-tempo-thumb {
  position: absolute;
  left: 50%;
  transform: translateX(-50%) translateY(50%);
  width: 50rpx;
  height: 50rpx;
  z-index: 1;
  background: #3D586B;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(48, 72, 89, 0.5);
  transition: bottom 0.05s ease-out;
  border: 4rpx solid #fff;
}

.inline-tempo-thumb:active {
  transform: translateX(-50%) translateY(50%) scale(1.15);
  box-shadow: 0 6rpx 20rpx rgba(48, 72, 89, 0.6);
}

/* 顶部可输入数字 - 圆形内垂直水平居中 */
.inline-tempo-input-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #314D63;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  box-sizing: border-box;
  padding: 0;
  margin-bottom: 4rpx;
}

.inline-tempo-input {
  width: 100%;
  height: 100%;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  line-height: 1;
  font-family: 'SF Mono', 'Monaco', monospace;
  background: transparent;
  padding: 0;
}

/* 常用档位按键组 - 悬浮在容器外侧 */
.inline-tempo-presets-float {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tempo-preset-btn {
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(49, 77, 99, 0.85);
  border-radius: 12rpx;
  text-align: center;
  min-width: 68rpx;
  transition: all 0.15s ease;
  font-family: 'SF Mono', 'Monaco', monospace;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.3);
}

.tempo-preset-btn:active {
  transform: scale(0.95);
  background: rgba(49, 77, 99, 0.95);
}

.tempo-preset-btn.active {
  background: #8FB9AB;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(143, 185, 171, 0.5);
}

.tempo-preset-btn.active {
  color: #fff;
  background: #8FB9AB;
  font-weight: 600;
}

.inline-tempo-current {
  font-size: 24rpx;
  font-weight: 700;
  color: #314D63;
  font-family: 'SF Mono', 'Monaco', monospace;
  background: rgba(49, 77, 99, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

/* ===== 速度调节弹窗（保留备用） ===== */
.player-tempo-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(49, 77, 99, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: overlayFadeIn 0.2s ease;
}

@keyframes overlayFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.player-tempo-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 64rpx rgba(49, 77, 99, 0.2);
}

.player-tempo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #314D63;
  text-align: center;
  margin-bottom: 40rpx;
}

.player-tempo-slider-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.player-tempo-label {
  font-size: 22rpx;
  color: rgba(49, 77, 99, 0.4);
  min-width: 48rpx;
  text-align: center;
  font-family: 'SF Mono', 'Monaco', monospace;
}

.player-tempo-slider {
  flex: 1;
}

.player-tempo-bpm {
  font-size: 56rpx;
  font-weight: 700;
  color: #314D63;
  text-align: center;
  margin-top: 32rpx;
  font-family: 'SF Mono', 'Monaco', monospace;
  letter-spacing: -1rpx;
}

/* ===== 更多设置弹窗 ===== */
.player-settings-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(49, 77, 99, 0.35);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 1100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: overlayFadeIn 0.25s ease;
}

.player-settings-panel {
  width: 100%;
  max-height: 85vh;
  background: linear-gradient(180deg, #FBFCFD 0%, #F6F8FA 100%);
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  animation: panelSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -8rpx 40rpx rgba(49, 77, 99, 0.08);
}

@keyframes panelSlideUp {
  from { transform: translateY(100%); opacity: 0.96; }
  to { transform: translateY(0); opacity: 1; }
}

.player-settings-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 20rpx auto 8rpx;
  background: rgba(49, 77, 99, 0.14);
  border-radius: 4rpx;
}

.player-settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 28rpx;
}

.player-settings-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #314D63;
  letter-spacing: 0.5rpx;
}

.player-settings-close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(49, 77, 99, 0.06);
  border-radius: 50%;
}

.player-settings-close-btn text {
  font-size: 28rpx;
  color: rgba(49, 77, 99, 0.45);
  font-weight: 300;
}

.player-settings-body {
  padding-bottom: 24rpx;
}

.player-settings-section {
  margin-bottom: 32rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.player-settings-section:last-child {
  margin-bottom: 0;
}

.player-settings-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(49, 77, 99, 0.5);
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.player-settings-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(49, 77, 99, 0.04);
  overflow: hidden;
}

.player-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.player-setting-row-slider {
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
}

.player-setting-row-slider .player-setting-label {
  margin-bottom: 0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.player-setting-control-slider {
  position: relative;
  flex: 1;
  margin-left: 0;
  padding-top: 20rpx;
  padding-bottom: 2rpx;
}

.player-setting-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(49, 77, 99, 0.06) 8%, rgba(49, 77, 99, 0.06) 92%, transparent 100%);
  margin: 0 -28rpx;
}

.player-setting-label {
  font-size: 30rpx;
  color: #314D63;
  flex-shrink: 0;
  font-weight: 500;
}

.player-setting-control {
  display: flex;
  align-items: center;
  flex: 1;
  margin-left: 24rpx;
}

.player-setting-slider {
  flex: 1;
  height: 16rpx;
}

.player-setting-value-pill {
  align-self: flex-end;
  font-size: 26rpx;
  color: #8FB9AB;
  font-weight: 600;
  font-family: 'SF Mono', 'Monaco', monospace;
  padding: 8rpx 20rpx;
  background: rgba(143, 185, 171, 0.12);
  border-radius: 20rpx;
  letter-spacing: 0.5rpx;
}

.player-setting-value-pill-above {
  position: absolute;
  top: 0rpx;
  left: 0;
  pointer-events: none;
  white-space: nowrap;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  z-index: 10;
  transform: translateX(-50%);
