  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  border: 1rpx solid #dee2e6;
  transition: all 0.1s ease;
}

.pitch-alt-key:active {
  background: #e9ecef;
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.1);
}

.pitch-alt-key text {
  font-size: 32rpx;
  color: #212529;
  font-weight: 600;
}

/* 符号键盘下音高条禁用状态 */
.vk-pitch-bar-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.pitch-capsule-disabled {
  opacity: 0.5;
  filter: grayscale(30%);
}

/* 旧的切换按钮样式保留 */
.vk-switch-btn {
  flex: 1;
