  align-items: center;
  padding: 10rpx 20rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  border-radius: 10rpx;
}

.beat-bubble-btn:active {
  opacity: 0.7;
  background: rgba(255, 255, 255, 0.1);
}

.beat-bubble-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

