}

/* 八度点容器 - 竖直排列（多个点上下叠加） */
.vk-octave-dots {
  display: flex;
  flex-direction: column; /* 竖直排列 */
  align-items: center;
  justify-content: center;
  gap: 0rpx;
}

.vk-octave-up {
  margin-bottom: -1rpx;
}

.vk-octave-down {
  margin-top: 3rpx;
}

.vk-octave-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
}

/* 上标内音符容器 */
.vk-sup-note-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative; /* 关键：开启相对定位（不脱离文档流） */
  bottom: -8rpx; 
}

/* 上标内的八度点 */
.vk-sup-octave-dots {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0rpx;
}

.vk-sup-octave-up {
  margin-bottom: -1rpx;
}

.vk-sup-octave-down {
  margin-top: 1rpx;
}

.vk-sup-octave-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
}

/* 区域B: 智能工具栏 - 高级设计 */
.vk-toolbar {
  background: transparent;
  padding: 8rpx 0;
  white-space: nowrap;
}

.vk-toolbar-inner {
  display: inline-flex;
  flex-direction: row;
  padding: 0 12rpx;
  gap: 10rpx;
}

.vk-tool-btn-light {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  min-width: 90rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  border: 1rpx solid #e9ecef;
}

.vk-tool-btn-light:active {
  background: #f1f3f4;
  transform: scale(0.96);
}

.vk-tool-text-dark {
  font-size: 24rpx;
  color: #495057;
  font-weight: 500;
}

/* 键盘主体区域 - 左中右三栏布局 */
.vk-main-area {
  display: flex;
  flex-direction: row;
  padding: 10rpx 12rpx 16rpx;
  gap: 12rpx;
  height: 360rpx;
}

/* 区域D-左侧: 胶囊音高调节器 */
.vk-pitch-sidebar {
  width: 15%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.pitch-sidebar-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
}

.pitch-side-label {
  writing-mode: vertical-lr;
  font-size: 18rpx;
  color: #314D63;
  font-weight: bold;
  margin-left: 8rpx;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* 区域C: 主数字/符号键盘 */
.vk-keypad {
  width: 56%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  transition: width 0.3s ease;
}

.vk-keypad.help-active {
  width: 52%;
}
.pitch-capsule-outer {
  position: relative;
  width: 80rpx;
  height: 100%;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  box-shadow: 0 10rpx 25rpx rgba(0,0,0,0.15);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  box-sizing: border-box;
}

/* 箭头按钮 */
.pitch-capsule-arrow {
  width: 100%;
  height: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 50;
  transition: transform 0.1s, opacity 0.2s;
}

.pitch-capsule-arrow:active {
  transform: scale(0.9);
  opacity: 0.7;
}

.pitch-capsule-arrow.disabled {
  opacity: 0.2;
  pointer-events: none;
}

.vk-pitch-arrow-icon {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

/* 轨道区域 */
.pitch-capsule-track {
  position: relative;
  width: 46rpx;
  flex: 1;
  margin: 0;
  background-color: #E5E7EB;
  border-radius: 23rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.1);
  z-index: 10;
}

/* 刻度线容器 */
.pitch-track-ticks {
  position: absolute;
  top: 23rpx;
  bottom: 23rpx;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
  opacity: 0.3;
}

.pitch-tick {
  width: 12rpx;
  height: 2rpx;
  background: #999;
}

/* 填充条 */
.pitch-fill-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60%;
  background-color: #314D63;
  border-radius: 23rpx 23rpx 0 0;
  transition: height 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
}

/* 拖动时取消过渡动画，实现丝滑跟随 */
.pitch-fill-bar.dragging {
  transition: none;
}

.pitch-fill-icon {
  color: #fff;
  font-size: 24rpx;
}

/* 档位提示Toast */
.pitch-toast {
  position: absolute;
  right: -100rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.7);
  color: white;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
  z-index: 100;
  white-space: nowrap;
}

.pitch-toast.show {
  opacity: 1;
}

/* 音高条关闭时的替代按键区域 */
.pitch-alt-keys {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  width: 100%;
  gap: 10rpx;
  padding: 4rpx 0;
