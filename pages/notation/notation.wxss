/* 简谱音符八度点容器 */
/* 简谱音符八度点容器 - 重构版本（latex风格） */
.note-with-octave {
  position: relative;
  display: inline-flex;
  flex-direction: row;
  align-items: flex-end; /* 底部对齐，上标在上方 */
  justify-content: center;
}

/* 主音符容器（包含音符、上加点、下加点） */
.note-main-container {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 八度点竖直排列（多个点上下叠加） */
.octave-dots-up {
  display: flex;
  flex-direction: column; /* 竖直排列 */
  align-items: center;
  justify-content: center;
  gap: 0rpx;
  margin-bottom: -7rpx;
}

.octave-dots-down {
  display: flex;
  flex-direction: column; /* 竖直排列 */
  align-items: center;
  justify-content: center;
  gap: 0rpx;
  margin-top: -2rpx;
}

.octave-dot {
  width: 2rpx;
  height: 2rpx;
  border-radius: 50%;
  background: currentColor;
