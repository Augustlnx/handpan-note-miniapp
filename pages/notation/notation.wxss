}

/* 自定义拍号模态框 */
.custom-time-signature-modal {
  max-width: 650rpx;
  max-height: 85vh;
  overflow-y: auto;
}

/* 导出规格设置弹窗样式 */
.export-specs-modal {
  max-width: 600rpx;
}

/* 行布局：左侧文本，右侧选项 */
.export-spec-row {
  display: flex;
  align-items: center;
  gap: 20rpx; /* 增加间距，使布局更舒展 */
  margin-bottom: 16rpx; /* 增加行间距 */
}

.spec-row-inline {
  flex-wrap: wrap;
}

.export-spec-label {
  font-size: 26rpx;
  color: #314D63;
  font-weight: 600;
  flex: 0 0 25%; /* 减少占比，使选项有更多空间 */
  min-width: 100rpx;
  text-align: left;
}

.a4-orientation-options,
.layout-mode-options {
  display: flex;
  gap: 16rpx; /* 适中间距 */
  flex: 1 1 auto;
  justify-content: space-around; /* 选项均匀分布 */
  align-items: center;
}

/* option 块：图标 + 文本 */
.spec-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 16rpx; /* 适中内边距 */
  border-radius: 12rpx;
  border: 1rpx solid #E6E6E6;
  background: #FFF;
  cursor: pointer;
  min-width: 120rpx; /* 适中宽度 */
  height: 48rpx; /* 适中高度 */
  box-sizing: border-box;
  flex: 1; /* 使选项均匀伸缩 */
}
.spec-option:active {
  opacity: 0.95;
}

.spec-option.selected {
  background: #314D63;
  color: #fff;
  border-color: #314D63;
}

/* 图形尺寸放大 */
.spec-shape {
  width: 32rpx;
  height: 36rpx;
  border-radius: 4rpx;
  border: 2rpx solid #D9D9D9;
  background: #F8F8F8;
}

/* 纵向与横向形状 */
.shape-portrait {
  width: 20rpx;
  height: 36rpx;
}
.shape-landscape {
  width: 42rpx;
  height: 18rpx;
}

/* 布局模式简化图（放大比例） */
.layout-loose {
  width: 30rpx;
  height: 26rpx;
  background: linear-gradient(90deg, #F4F4F4 0%, #E9E9E9 100%);
  border: 1rpx solid #D9D9D9;
}
.layout-compact {
  width: 38rpx;
  height: 14rpx;
  background: linear-gradient(90deg, #F4F4F4 0%, #E9E9E9 100%);
  border: 1rpx solid #D9D9D9;
}

.spec-option-label {
  font-size: 24rpx;
  color: inherit;
}

/* 提示文字占满一行，允许换行 */
.export-spec-hint {
  font-size: 22rpx;
  color: #777;
  margin-top: 12rpx;
  line-height: 1.5;
  width: 100%;
}

/* 导出设置分区标题 */
.export-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #314D63;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #E6E6E6;
}

/* 滑块行样式 */
.slider-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.slider-label {
  flex: 0 0 80rpx;
  min-width: 80rpx;
  font-size: 24rpx;
}

.export-slider {
  flex: 1;
  margin: 0;
}

.slider-unit {
  font-size: 22rpx;
  color: #888;
  min-width: 40rpx;
  text-align: right;
}

/* 颜色模式选择 */
.color-mode-options {
  display: flex;
  gap: 16rpx;
  flex: 1 1 auto;
  justify-content: space-around;
  align-items: center;
}

.color-mode-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E6E6E6;
  background: #FFF;
  cursor: pointer;
  min-width: 100rpx;
  height: 48rpx;
  box-sizing: border-box;
  flex: 1;
}

.color-mode-option.selected {
  background: #314D63;
  color: #fff;
  border-color: #314D63;
}

.color-mode-preview {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.dual-preview {
  flex-direction: row;
}

.single-preview {
  justify-content: center;
}

.color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.color-dot.large {
  width: 24rpx;
  height: 24rpx;
}

/* 颜色选择器行 */
.export-color-pickers {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
}

.color-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx;
  background: #F9F9F9;
  border-radius: 8rpx;
}

.color-picker-label {
  font-size: 24rpx;
  color: #555;
  flex-shrink: 0;
}

.color-picker-controls {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.color-input {
  width: 140rpx;
  height: 36rpx;
  font-size: 22rpx;
  text-align: center;
  border: 1rpx solid #D9D9D9;
  border-radius: 6rpx;
  background: #FFF;
  color: #333;
  padding: 0 8rpx;
}

.color-picker-trigger {
  width: 50rpx;
  height: 36rpx;
  border-radius: 6rpx;
  border: 2rpx solid #D9D9D9;
  cursor: pointer;
  flex-shrink: 0;
}

/* 小屏时的适配：标签仍占一行，选项换行且居左 */
@media (max-width: 420rpx) {
  .export-spec-label {
    flex: 0 0 100%;
    min-width: 0;
    margin-bottom: 8rpx;
  }
  .a4-orientation-options,
  .layout-mode-options {
    justify-content: flex-start;
    width: 100%;
    gap: 12rpx;
    flex-wrap: wrap;
  }
  .spec-option {
    min-width: 48%;
  }
}


