/* ==================== 分页样式 ==================== */

/* 分页容器 */
.notation-pages-wrapper {
  width: 100%;
  transition: opacity 0.25s ease-in-out, transform 0.25s ease-in-out;
  opacity: 1;
  transform: translateX(0);
  padding-top: 50rpx;
}

/* 页面切换：淡出 */
.notation-pages-wrapper.page-transition-out {
  opacity: 0;
  transform: translateX(-20rpx);
}

/* 页面切换：淡入 */
.notation-pages-wrapper.page-transition-in {
  opacity: 1;
  transform: translateX(0);
}

/* 手指拖动提示 */
.hand-drag-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  padding: 40rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  animation: hand-drag-bounce 2s ease-in-out infinite;
}

.hand-drag-image {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.7;
}

.hand-drag-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 300;
}

/* 手指拖动动画 */
@keyframes hand-drag-bounce {
  0%, 100% {
    opacity: 0.7;
    transform: translateX(0);
  }
  50% {
    opacity: 1;
    transform: translateX(-20rpx);
  }
}

/* 分页指示器 */
.pagination-indicator {
  position: fixed;
  bottom: 80rpx;
  right: 30rpx;
  background-color: rgba(49, 77, 99, 0.9);
  color: white;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 100;
}

.pagination-text {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 平滑过渡：切换时禁用交互 */
.notation-pages-wrapper.page-transition-out .notation-list {
  pointer-events: none;
}

/* 页面切换加载遮罩（Logo + 80BPM 悬浮节拍器） */
.page-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  background-color: #ffffff;
  z-index: 1200;
  will-change: opacity;
}

.page-loading-logo {
  width: 500rpx;
  height: 500rpx;
  opacity: 0.98;
}

.overlay-metronome {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 26rpx;
  background-color: rgba(49, 77, 99, 0.08);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.12);
}

.overlay-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
}

/* 让四个点按序列脉动，对应 80bpm (750ms) */
.overlay-metronome .overlay-dot:nth-child(1) {
  animation: overlayBeatAccent 0.75s ease-in-out infinite;
  animation-delay: 0s;
}
.overlay-metronome .overlay-dot:nth-child(2) {
  animation: overlayBeatLight 0.75s ease-in-out infinite;
  animation-delay: 0.75s;
}
.overlay-metronome .overlay-dot:nth-child(3) {
  animation: overlayBeatLight 0.75s ease-in-out infinite;
  animation-delay: 1.5s;
}
.overlay-metronome .overlay-dot:nth-child(4) {
  animation: overlayBeatLight 0.75s ease-in-out infinite;
  animation-delay: 2.25s;
}

@keyframes overlayBeatLight {
  0% { transform: scale(1); background-color: #E0E0E0; }
  35% { transform: scale(1.25); background-color: #5F7C92; }
  65% { transform: scale(1); background-color: #E0E0E0; }
  100% { transform: scale(1); }
}

@keyframes overlayBeatAccent {
  0% { transform: scale(1); background-color: #E0E0E0; }
  30% { transform: scale(1.5); background-color: #314D63; }
  60% { transform: scale(1); background-color: #E0E0E0; }
  100% { transform: scale(1); }
}

.notation-pages-wrapper.page-transition-in .notation-list {
  pointer-events: auto;
}

/* ========== 开屏弹窗样式 ========== */
.splash-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-out, background-color 0.3s ease-out;
}

.splash-modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
  background-color: rgba(0, 0, 0, 0.5);
}

.splash-modal-content {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  width: 100%;
  max-width: 650rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  animation: splashSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
}

@keyframes splashSlideIn {
  from {
    opacity: 0;
    transform: translateY(50rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 关闭按钮 */
.splash-close-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 36rpx;
  height: 36rpx;
  padding: 8rpx;
  cursor: pointer;
  transition: opacity 0.2s;
}

.splash-close-btn:active {
  opacity: 0.6;
}

.splash-header {
  text-align: center;
  padding-top: 20rpx;
}

.splash-title {
  display: block;
  font-size: 50rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 8rpx;
}

.splash-subtitle {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #DBCC97;
  font-family: 'Tangerine', sans-serif;
}

.splash-logo {
  width: 350rpx;
  height: 350rpx;
  margin: -30rpx auto -30rpx auto;
  display: block;
}

.splash-description {
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.splash-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: left;
  text-indent: 2em;
  display: block;
}

.splash-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.splash-action-row {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.splash-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.splash-btn::after {
  border: none;
}

.splash-btn-label {
  color: white;
  font-size: 26rpx;
  white-space: nowrap;
}

/* 不再显示按钮 - 浅灰色 */
.splash-btn-never-show {
  background-color: #D0D0D0;
}

.splash-btn-never-show:active {
  background-color: #B0B0B0;
  transform: scale(0.98);
}

/* 查看示例按钮 - 辅助色（绿色） */
.splash-btn-example {
  background-color: #8FB9AB;
}

.splash-btn-example:active {
  background-color: #4a8f84;
  transform: scale(0.98);
}

/* 用户手册按钮 - 主色调（蓝色） */
.splash-btn-manual {
  background-color: #2E5C7F;
}

.splash-btn-manual:active {
  background-color: #1f3d57;
  transform: scale(0.98);
}

.splash-btn-manual .splash-btn-label {
  color: white;
}
/* ======================== 自定义 Toast 样式 ======================== */
.custom-toast-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  pointer-events: auto;
}

.custom-toast-content {
  background-color: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 32rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
  max-width: 80%;
  word-wrap: break-word;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  animation: toastSlideIn 0.3s ease-out;
}

.custom-toast-icon {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
}

.custom-toast-icon-fail {
  color: #F44336;
}

.custom-toast-text {
  word-break: break-all;
  line-height: 1.5;
}

/* Toast 动画 */
@keyframes toastSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
