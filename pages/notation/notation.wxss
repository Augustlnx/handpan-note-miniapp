/* ======================== 自定义 Toast 样式 ======================== */
.custom-toast-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  pointer-events: auto;
}

.custom-toast-content {
  background-color: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 32rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
  max-width: 80%;
  word-wrap: break-word;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  animation: toastSlideIn 0.3s ease-out;
}

.custom-toast-icon {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
}

.custom-toast-icon-fail {
  color: #F44336;
}

.custom-toast-text {
  word-break: break-all;
  line-height: 1.5;
}

/* Toast 动画 */
@keyframes toastSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

