}

/* 弹窗按钮区 - 高级样式 */
.modal-buttons {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 0 0;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 24rpx;
  overflow: hidden;
}

.modal-buttons button {
  flex: 1;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  position: relative;
}

.modal-buttons button::after {
  display: none;
}

.modal-buttons button:last-child::after {
  display: none;
}

.modal-buttons button:active {
  transform: translateY(1rpx);
}

/* 取消按钮 - 高级样式 */
.btn-secondary {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  border: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  color: #666;
  padding: 0;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #e0e0e0 !important;
}

/* 第三级按钮（无映射转换等） */
.btn-tertiary {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 2rpx solid #8FB9AB;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #8FB9AB;
  padding: 0;
}

.btn-tertiary:active {
  background: #f0f8f5 !important;
  border-color: #7aa89a;
}

/* 确认/主要按钮 - 高级样式 */
.btn-primary {
  flex: 1;
  height: 92rpx;
  border-radius: 22rpx;
  font-size: 32rpx;
  border: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #314D63 0%, #456275 100%);
  color: #fff;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.3);
  transition: all 0.2s ease;
}

.btn-primary:active {
  background: linear-gradient(135deg, #28404f 0%, #3a5363 100%) !important;
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.3);
}

/* 独立按钮样式（非底部贴边） */
.modal-buttons--gap {
  padding: 20rpx 0 0;
  gap: 16rpx;
  border-top: none;
  margin-top: 20rpx;
}

.modal-buttons--gap button {
  border-radius: 16rpx;
  height: 88rpx;
}

.modal-buttons--gap button::after {
