.settings-item.settings-item-highlight {
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border: none;
  cursor: pointer;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(44, 62, 80, 0.25), 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 高级光泽效果 */
.settings-item.settings-item-highlight::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transition: left 0.5s ease;
}

.settings-item.settings-item-highlight:active::before {
  left: 100%;
}

.settings-item.settings-item-highlight:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(44, 62, 80, 0.3), 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

