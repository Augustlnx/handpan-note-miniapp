}

.modal-description {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 16rpx;
  line-height: 1.5;
  display: block;
}

/* 关闭按钮 - 高级样式 */
.modal-close-icon {
  width: 44rpx;
  height: 44rpx;
  position: absolute;
  right: 0;
  top: 0;
  padding: 8rpx;
  border-radius: 50%;
  background: #f5f5f5;
  cursor: pointer;
  opacity: 0.8;
  transition: all 0.2s ease;
}

.modal-close-icon:active {
  opacity: 1;
  background: #e8e8e8;
  transform: scale(0.9);
}

/* 帮助提示窗口 */
.help-modal {
  max-width: 600rpx;
}

.help-text {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: left;
}

.help-text text {
  display: block;
}

/* Markdown 风格的帮助文案 - 高级样式 */
.help-md {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: linear-gradient(135deg, #f9fafb 0%, #f5f7f9 100%);
  padding: 24rpx;
