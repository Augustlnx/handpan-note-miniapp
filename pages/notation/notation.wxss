.notation-container {
  min-height: 100vh;
  background-color: #FFFFFF; /* 与 splash 页面背景色保持一致 */
  padding: 40rpx 30rpx 200rpx;
  position: relative;
  overflow: hidden;
  /* 使用全局自定义导航栏样式 */
  padding-top: 128rpx; /* 为自定义导航栏留出空间 (88rpx + 40rpx) */
  transition: padding-bottom 0.3s ease, opacity 0.25s ease-in;
  /* 初始状态：微透明，实现从 splash 过来的无缝衔接 */
  opacity: 0.92;
}

/* 页面准备就绪后完全显示 */
.notation-container.page-ready {
  opacity: 1;
}

/* 虚拟键盘激活时增加底部边距，确保音符格可见 */
.notation-container.keyboard-active {
  padding-bottom: 520rpx; /* 虚拟键盘高度约480rpx + 额外留白 */
}

/* 背景图片装饰（固定右下角，半透明，不随滚动改变，低于菜单栏） */
.background-image {
  position: fixed;
  bottom: 0;
  right: 0;
  width: 66.66%;
  height: auto;
  opacity: 0.10;
  z-index: 50;
  pointer-events: none;
}

/* 标题区域 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 20rpx;
  margin-top: 20rpx; 
  background-color: white;
  padding: 0rpx 0rpx 5rpx 0rpx;
  border-radius: 6rpx;
  position: relative;
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

.main-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #314D63;
  margin-bottom: 16rpx;
  transition: opacity 0.2s;
}

.main-title:active {
  opacity: 0.7;
}

/* 选中模式下禁用标题区交互 */
.header-section.disabled {
  pointer-events: none;
  opacity: 0.6;
}

.header-section.disabled .main-title,
.header-section.disabled .sub-title-row,
.header-section.disabled .intro-icon {
  pointer-events: none;
  opacity: 0.6;
}

.sub-title {
  display: block;
  font-size: 28rpx;
  color: #8FB9AB;
  font-weight: 300;
  transition: opacity 0.2s;
}

.sub-title:active {
  opacity: 0.7;
}

/* 功能行帮助图标 */
.header-help-wrap {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.header-help-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.header-help-icon:active {
  opacity: 1;
}

/* 谱面内容容器 - 支持多小节并行 */
.staff-container {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  position: relative;
}

.notation-sheet {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.08);
  position: relative;
}

/* 收缩状态下减少下边距（没有底部图标了） */
.notation-sheet.collapsed {
  margin-bottom: 8rpx;
}

.measure {
  position: relative;
  display: flex;
  align-items: stretch;
  height: 160rpx;
  box-sizing: border-box;
  min-width: 0; /* 允许在横屏两栏时收缩 */
}

.measure-index {
  position: absolute;
  color: #9AA0A6;
  font-size: 22rpx;
  font-weight: 500;
}

/* 统一将小节计数显示在左侧小节线上方，水平居中对齐 */
.staff-container.single-measure .measure-index {
  left: 0rpx;
  top: -28rpx;
  transform: translateX(-50%);
  text-align: center;
  min-width: 24rpx;
}

/* 当一行超过一小节时，小节计数在左侧小节线正上方 */
.staff-container.multi-measure .measure-index {
  left: 0rpx;
  top: -25rpx;
  transform: translateX(-50%);
  text-align: center;
  min-width: 24rpx;
  font-size: 15rpx;
}

/* 横屏时可略微缩小数字，保持轨道位置不变 */



.staff-container.multi-measure {
  gap: 0;
  row-gap: 65rpx; /* 增大行间距 */
}

/* 横屏两栏高度与比例（约1:8），保证两小节同行 */
.staff-container.multi-measure .measure {
  height: 110rpx;
  margin-bottom: 0;
}

/* 横屏两栏：线条略细但保持清晰 */
.staff-container.multi-measure .bar-line {
  border-left-width: 4rpx; /* 修正：使用border-left-width而非width */
}
.staff-container.multi-measure .bar-line-left,
.staff-container.multi-measure .bar-line-right {
  display: block;
}
.staff-container.multi-measure .beat-line {
  width: 2rpx;
}

/* 横屏两栏：数字与槽位进一步压缩，保持轨道对齐 */
.staff-container.multi-measure .note-number {
  font-size: 18rpx;
}
.staff-container.multi-measure .note-slot {
  height: 24rpx;
  min-height: 24rpx;
  line-height: 24rpx;
}
.staff-container.multi-measure .note-column {
  gap: 4rpx;
}

/* 删除图标（右上角） */
.delete-icon {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  opacity: 1;
  transition: opacity 0.2s;
  z-index: 10;
}

.delete-icon:active {
  opacity: 1;
}

/* 选中模式下禁用删除图标 */
.delete-icon.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 更多图标（右上角，收起状态） */
.more-icon-top-right {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  opacity: 1;
  transition: all 0.2s;
  z-index: 10;
}

.more-icon-top-right:active {
  opacity: 1;
  transform: scale(1.1);
}

/* 添加谱面图标行 */
.add-notation-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 10rpx 0;
}

.add-icon,
.refresh-icon,
.tool-icon,
.less-icon {
  width: 43rpx;
  height: 43rpx;
  opacity: 1;
  transition: all 0.3s ease;
}

/* 选中模式下禁用功能栏 */
.add-notation-row.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.add-notation-row.disabled .add-icon,
.add-notation-row.disabled .refresh-icon,
.add-notation-row.disabled .tool-icon,
.add-notation-row.disabled .less-icon {
  opacity: 0.4;
  pointer-events: none;
}

.add-icon:active,
.refresh-icon:active,
.tool-icon:active,
.less-icon:active {
  opacity: 1;
}

.add-icon:active {
  transform: scale(1.1);
}

.refresh-icon:active {
  transform: rotate(90deg);
}

.tool-icon:active {
  transform: scale(1.08);
}

.less-icon:active {
  transform: scale(1.1);
}

/* 谱面信息 */
.sheet-info {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  margin-bottom: 40rpx;
  gap: 16rpx;
}

.sheet-label {
  border: 3rpx solid #314D63;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #314D63;
}

/* 模块备注（label框外右侧淡灰色） */
.sheet-remark {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.tempo-mark {
  font-size: 32rpx;
  color: #314D63;
  font-weight: 500;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 小节线（粗黑色，全高） */
.bar-line {
  border-left: 5rpx solid #000000;
  height: 100%;
  z-index: 3;
}

.bar-line-left {
  margin-right: 0;
}

.bar-line-right {
  margin-left: 0;
}

/* 【优化】当有占位拍时，右侧小节线使用绝对定位 */
.bar-line-right.bar-line-positioned {
  position: absolute;
  top: 0;
  bottom: 0;
  margin-left: 0;
}

/* 中间小节线（自定义拍子模式中的分组间分隔线） */
.bar-line-middle {
  position: absolute;
  right: -2rpx; /* 轻微右移，使5rpx线居中对齐边界 */
}

/* 拍子 */
.beat {
  flex: 1;
  display: flex;
  position: relative;
  align-items: stretch;
  min-width: 0; /* 防止数字挤宽拍子 */
}

/* 拍子分隔线（细灰色，全高） */
.beat-line {
  width: 2rpx;
  background-color: #CCCCCC;
  height: 100%;
  z-index: 2;
}

.beat-line-left {
  margin-right: 0;
}

.beat-line-right {
  margin-left: 0;
}

/* 16分音符 */
.subdivision {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  align-items: stretch;
  min-width: 0; /* 防止数字挤宽细分 */
}

/* 音符备注（显示在音符列上方） */
.note-annotation {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #666;
  white-space: nowrap;
  z-index: 10;
  background: rgba(255, 255, 255, 0.9);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  line-height: 1.2;
}

/* 16分音符分隔线（浅灰色，短线） */
.subdivision-line {
  width: 1rpx;
  background-color: #E8E8E8;
  height: 50%;
  position: absolute;
  top: 25%;
  left: 0;
  z-index: 1;
}

.subdivision-line-left {
  margin-right: 0;
}

.beat-line-left {
  margin-right: 0;
}

.beat-line-right {
  margin-left: 0;
}

/* 音符格子 */
.note-grid {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
}

.note-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.note-box-top {
  border-bottom: 1rpx solid #E0E0E0;
}

.note-box-bottom {
  border-top: 1rpx solid #E0E0E0;
}

/* 音符列 */
.note-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 固定上下两个音符的槽位高度，保证单/双音符位置一致 */
.note-slot {
  height: 36rpx;
  min-height: 36rpx;
  line-height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  position: relative;
  z-index: 5; /* 置于小节/拍线之上，确保可点可输入 */
}

.slot-click-overlay {
  position: absolute;
  inset: 0; /* top:0; right:0; bottom:0; left:0 */
  z-index: 6; /* 高于文字，低于输入框 */
  background: transparent;
}
/* 内嵌编辑高亮样式 */
.note-slot.editing {
  border: 2rpx solid #333;
  background: rgba(0,0,0,0.06);
  border-radius: 4rpx;
}
.note-slot.editing-right {
  border-color: #F4D096; /* 右手强调色，与 .note-right-hand 保持一致 */
  background: rgba(244,208,150,0.22);
}
.note-slot.editing-left {
  border-color: #314D63; /* 左手主色，与 .note-left-hand 保持一致 */
  background: rgba(49,77,99,0.16);
}
.note-input {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  line-height: inherit;
  color: #111;
  background: transparent;
  position: relative;
  z-index: 6;
}
.note-input-right { color: #F4D096; }
.note-input-left { color: #314D63; }

/* 音符数字 */
.note-number {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  line-height: inherit;
  padding: 0;
  margin: 0;
  transition: background-color 0.2s;
  position: relative;
  z-index: 5;
}

.note-number:active {
  background-color: rgba(244, 208, 150, 0.2);
}

/* 时值减半下划线样式 */
/* text-underline-offset 由 inline style 动态设置 */
.note-underline {
  text-decoration: underline;
  text-decoration-color: currentColor;
  font-weight: bold;
  /* text-decoration-thickness 和 text-underline-offset 由 inline style 控制 */
}

.note-right-hand {
  color: #F4D096;
}

.note-right-hand:active {
  background-color: rgba(244, 208, 150, 0.3);
}

.note-left-hand {
  color: #314D63;
}

.placeholder {
  opacity: 0; /* 透明占位，保持轨道 */
}

/* 删除按钮样式 */
.btn-small {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.btn-danger {
  background-color: #B34540;
  color: #fff;
  border: none;
}
.btn-danger:active {
  background-color: #9a3a36;
}

.note-left-hand:active {
  background-color: rgba(49, 77, 99, 0.1);
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
  align-items: center;
  z-index: 10000; /* 确保在Canvas同层渲染之上 */
  padding: 24rpx 40rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.15);
  animation: slideUp 0.3s ease-out;
  max-width: 100vw; /* 自适应页面宽度 */
  box-sizing: border-box;
}

/* 菜单栏滑上动画 */
@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx; /* 缩小图标间距：从6rpx改为4rpx */
  padding: 0rpx 12rpx; /* 略微减小左右内边距 */
  transition: all 0.3s;
  border-radius: 16rpx;
  position: relative;
}

.action-btn:active {
  background-color: rgba(49, 77, 99, 0.08);
  transform: scale(0.95);
}

.action-btn-icon {
  width: 40rpx;
  height: 40rpx;
  object-fit: contain;
}

.action-btn-text {
  font-size: 22rpx;
  color: #314D63;
  font-weight: 500;
  white-space: nowrap;
}

/* 帮助图标可点区域（放大命中范围） */
.help-icon-wrap {
  position: absolute;
  top: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 帮助图标 */
.help-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.help-icon:active {
  opacity: 1;
}

/* 底部收缩图标（在操作按钮栏内） */
.action-collapse-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
  opacity: 0.6;
  transition: all 0.3s;
}

.action-collapse-icon:active {
  opacity: 1;
  transform: rotate(180deg);
}

/* ========== 布局二级菜单 - 气泡样式 ========== */
.layout-menu-container {
  position: relative;
}

.layout-submenu {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(49, 77, 99, 0.2);
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
  z-index: 110;
  animation: layoutMenuFadeIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 气泡箭头 */
.layout-submenu::after {
  content: '';
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #fff;
  filter: drop-shadow(0 4rpx 4rpx rgba(49, 77, 99, 0.1));
}

@keyframes layoutMenuFadeIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(10rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
}

.layout-submenu .action-btn {
  padding: 8rpx 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.layout-submenu .action-btn:active {
  background: linear-gradient(135deg, #314D63 0%, #456275 100%);
}

.layout-submenu .action-btn:active .action-btn-text {
  color: #fff;
}

/* 布局按钮激活状态 */
.layout-btn-active {
  background: rgba(49, 77, 99, 0.1);
}

/* 布局菜单遮罩 */
.layout-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999; /* 在菜单栏的下方，但在Canvas之上 */
}

/* 底部折叠图标（右侧，收缩后显示） */
.action-toggle {
  position: fixed;
  right: 30rpx;
  bottom: 10rpx;
  width: 60rpx;
  height: 60rpx;
  z-index: 10000; /* 与菜单栏同级别 */
  opacity: 0.9;
  transition: all 0.3s;
  border-radius: 0%;
  
  cursor: pointer;
  animation: floating 3s ease-in-out infinite;
}

/* 浮动动画 */
@keyframes floating {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

.action-toggle:active {
  opacity: 1;
  transform: scale(1.15) !important;
}

/* 选中模式下禁用菜单栏展开按钮 */
.action-toggle.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* —— 横屏整体 UI 缩放：标题区、功能行、模块标签与图标缩小至 50% —— */
.landscape-mode .header-section {
  padding: 20rpx; /* 40 -> 20 */
}
.landscape-mode .main-title {
  font-size: 22rpx; /* 44 -> 22 */
  margin-bottom: 8rpx; /* 16 -> 8 */
}
.landscape-mode .sub-title {
  font-size: 14rpx; /* 28 -> 14 */
}
.landscape-mode .header-help-wrap {
  width: 16rpx; /* 32 -> 16 */
  height: 16rpx;
}
.landscape-mode .header-help-icon {
  width: 12rpx; /* 24 -> 12 */
  height: 12rpx;
}

/* 模块标题（如 A-1）缩小至 50%（横屏时略放大以提升可读性） */
.landscape-mode .sheet-label {
  font-size: 18rpx; /* 28 -> 18（比之前大一点） */
  padding: 8rpx 12rpx; /* 5 10 -> 8 12，增加内边距让名称更醒目 */
  border-width: 1.8rpx; /* 1.5 -> 1.8，微调边框使其更稳重 */
} 

/* 横屏模式下模块备注 */
.landscape-mode .sheet-remark {
  font-size: 12rpx; /* 24 -> 12 */
}

/* 横屏：标题区右上角详情图标缩小 */
.landscape-mode .intro-icon {
  width: 18rpx; /* 36 -> 18 */
  height: 18rpx;
  top: 5rpx; /* 10 -> 5 */
  right: 5rpx;
}

/* 横屏：副标题行缩小 */
.landscape-mode .sub-title-row {
  gap: 4rpx; /* 8 -> 4 */
  margin-bottom: 8rpx; /* 16 -> 8 */
}
.landscape-mode .sub-title-divider {
  font-size: 14rpx; /* 28 -> 14 */
}

/* 横屏：参数网格区域缩小 */
.landscape-mode .params-grid {
  padding: 0;
}
.landscape-mode .param-row {
  margin-bottom: 8rpx; /* 16 -> 8 */
}
.landscape-mode .param-item-group {
  gap: 4rpx; /* 8 -> 4 */
  padding: 6rpx 0; /* 12 -> 6 */
}
.landscape-mode .param-icon {
  width: 16rpx; /* 32 -> 16 */
  height: 16rpx;
}
.landscape-mode .param-label {
  font-size: 13rpx; /* 26 -> 13 */
}
.landscape-mode .param-value {
  font-size: 13rpx; /* 26 -> 13 */
}
.landscape-mode .param-storage {
  max-width: none;
}

/* 横屏：难度星星缩小 */
.landscape-mode .difficulty-stars-display {
  gap: 1rpx; /* 2 -> 1 */
}
.landscape-mode .difficulty-star-small {
  width: 10rpx; /* 20 -> 10 */
  height: 10rpx;
}

/* 模块图标：delete / add / refresh / tool / less 横屏下统一减半 */
.landscape-mode .delete-icon,
.landscape-mode .more-icon-top-right,
.landscape-mode .add-icon,
.landscape-mode .refresh-icon,
.landscape-mode .tool-icon,
.landscape-mode .less-icon {
  width: 24rpx; /* 48 -> 24 */
  height: 24rpx;
}

/* 横屏：整体留白与模块内外间距收紧 */
.landscape-mode .notation-container {
  padding: 20rpx 20rpx 140rpx; /* 顶/侧留白减半，底部略留出固定操作栏空间 */
}
.landscape-mode .notation-sheet {
  padding: 20rpx; /* 40 -> 20 */
  margin-bottom: 20rpx; /* 40 -> 20 */
  border-radius: 12rpx; /* 16 -> 12，微收紧圆角 */
  box-shadow: 0 3rpx 10rpx rgba(49, 77, 99, 0.08);
}
.landscape-mode .sheet-info {
  margin-bottom: 28rpx; /* 20 -> 28，增加标题与谱面间距 */
} 
.landscape-mode .staff-container.multi-measure {
  row-gap: 30rpx; /* 提升为30rpx以增加行间空间，让谱面更易读 */
}
.landscape-mode .staff-container.multi-measure .measure {
  height: 100rpx; /* 110 -> 100 再收紧垂直高度 */
}
.landscape-mode .add-notation-row {
  margin-top: 10rpx; /* 20 -> 10 */
  padding: 5rpx 0; /* 10 -> 5 */
  gap: 12rpx; /* 20 -> 12 */
}

.landscape-mode .refresh-icon {
  margin-left: 0; /* 移除左边距，使用gap统一 */
}

/* 横屏：菜单栏（底部操作按钮）缩小至 50% */
.landscape-mode .action-buttons {
  gap: 12rpx; /* 20 -> 12 */
  padding: 12rpx 20rpx; /* 24 40 -> 12 20 */
  border-radius: 30rpx; /* 60 -> 30 */
  box-shadow: 0 6rpx 16rpx rgba(49, 77, 99, 0.12);
}
.landscape-mode .action-btn {
  gap: 3rpx; /* 6 -> 3 */
  padding: 8rpx 10rpx; /* 12 16 -> 8 10 */
  border-radius: 10rpx; /* 16 -> 10 */
}
.landscape-mode .action-btn-icon {
  width: 20rpx; /* 40 -> 20 */
  height: 20rpx;
}
.landscape-mode .action-btn-text {
  font-size: 11rpx; /* 22 -> 11 */
}
/* 横屏：菜单栏中的帮助图标及其包裹层缩小 */
.landscape-mode .help-icon-wrap {
  width: 12rpx; /* 24 -> 12 */
  height: 12rpx;
}
.landscape-mode .help-icon {
  width: 14rpx; /* 28 -> 14 */
  height: 14rpx;
}
.landscape-mode .action-collapse-icon {
  width: 20rpx; /* 40 -> 20 */
  height: 20rpx;
  margin-left: 8rpx; /* 16 -> 8 */
}
.landscape-mode .action-toggle {
  width: 32rpx; /* 64 -> 32 */
  height: 32rpx;
  right: 20rpx; /* 微调位置，避免过大留白 */
  bottom: 20rpx;
  box-shadow: 0 3rpx 10rpx rgba(49, 77, 99, 0.18), 
              0 1rpx 4rpx rgba(49, 77, 99, 0.08);
  /* 继承浮动动画 */
}

/* 悬浮节拍器 */
.floating-metronome {
  position: fixed;
  top: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(49, 77, 99, 0.2);
  z-index: 10100; /* 确保在Canvas之上 */
}

.metronome-dots {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.metronome-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

.metronome-dot.active {
  background-color: #314D63;
  transform: scale(1.4);
  box-shadow: 0 0 12rpx rgba(49, 77, 99, 0.5);
}

.metronome-dot.active-accent {
  background-color: #B2E8E8;
  box-shadow: 0 0 12rpx rgba(178, 232, 232, 0.8);
}

.metronome-close {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
  transition: all 0.2s;
  margin-left: 8rpx;
}

.metronome-close:active {
  opacity: 1;
  transform: rotate(90deg);
}

/* 弹窗 - 基础样式（继承全局样式，仅保留页面特定覆盖） */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10500; /* 确保在Canvas和菜单栏之上 */
  backdrop-filter: blur(4rpx);
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 85%;
  max-width: 580rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25), 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 模块标签编辑弹窗 */
.label-edit-modal {
  max-width: 550rpx;
}

.label-edit-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.label-edit-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
}

/* 弹窗标题 - 高级样式 */
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #314D63;
  flex: 1;
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
