/* ========== 【任务2】复制/粘贴气泡弹窗样式（紧凑版） ========== */
/* 【任务2】复制/粘贴/删除气泡弹窗（相对于拍位元素定位，跟随谱面滚动） */
.beat-bubble {
  position: absolute;
  top: -80rpx; /* 显示在拍位上方 */
  left: 50%;
  transform: translateX(-50%); /* 水平居中 */
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(30, 30, 30, 0.96) 0%, rgba(45, 45, 45, 0.94) 100%);
  border-radius: 16rpx;
  padding: 10rpx 8rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.4), 0 3rpx 10rpx rgba(0, 0, 0, 0.2);
  z-index: 10001; /* 确保在拍位内容上方 */
  pointer-events: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  white-space: nowrap; /* 防止换行 */
}

/* Canvas模式下的气泡（相对于Canvas容器定位） */
.beat-bubble-canvas {
  top: auto; /* 覆盖默认的top值 */
  left: auto; /* 覆盖默认的left值 */
  transform: none; /* 覆盖默认的transform */
  z-index: 10002; /* 确保在Canvas上方 */
}

/* 【Bug修复】选中模式下允许气泡溢出显示 */
.canvas-notation-container.bubble-visible {
  overflow: visible !important;
}

.beat-bubble::before {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid rgba(45, 45, 45, 0.94);
}

.beat-bubble-btn {
  display: flex;
