  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.3);
}

.modal-buttons--gap .btn-primary:active {
  background: linear-gradient(135deg, #28404f 0%, #3a5363 100%) !important;
  transform: translateY(2rpx);
}
/* 通用弹窗输入框 - 高级样式 */
.modal-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
