/* ==================== 分页样式 ==================== */

/* 分页容器 */
.notation-pages-wrapper {
  width: 100%;
  transition: opacity 0.25s ease-in-out, transform 0.25s ease-in-out;
  opacity: 1;
  transform: translateX(0);
  padding-top: 10rpx;
}

/* 页面切换：淡出 */
.notation-pages-wrapper.page-transition-out {
  opacity: 0;
  transform: translateX(-20rpx);
}

/* 页面切换：淡入 */
.notation-pages-wrapper.page-transition-in {
  opacity: 1;
  transform: translateX(0);
}

/* 手指拖动提示 */
.hand-drag-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  padding: 40rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  animation: hand-drag-bounce 2s ease-in-out infinite;
}

.hand-drag-image {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.7;
}

.hand-drag-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 300;
}

/* 手指拖动动画 */
@keyframes hand-drag-bounce {
  0%, 100% {
    opacity: 0.7;
    transform: translateX(0);
  }
  50% {
    opacity: 1;
    transform: translateX(-20rpx);
  }
}

/* 分页指示器 */
.pagination-indicator {
  position: fixed;
  bottom: 80rpx;
  right: 30rpx;
  background-color: rgba(49, 77, 99, 0.9);
  color: white;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 100;
}

.pagination-text {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 平滑过渡：切换时禁用交互 */
.notation-pages-wrapper.page-transition-out .notation-list {
  pointer-events: none;
}

/* 页面切换加载遮罩（Logo + 80BPM 悬浮节拍器） */
.page-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  background-color: #ffffff;
  z-index: 1200;
  will-change: opacity;
}

.page-loading-logo {
  width: 500rpx;
  height: 500rpx;
  opacity: 0.98;
}

.overlay-metronome {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 26rpx;
  background-color: rgba(49, 77, 99, 0.08);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.12);
}

.overlay-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
}

/* 让四个点按序列脉动，对应 80bpm (750ms) */
.overlay-metronome .overlay-dot:nth-child(1) {
  animation: overlayBeatAccent 0.75s ease-in-out infinite;
  animation-delay: 0s;
}
.overlay-metronome .overlay-dot:nth-child(2) {
  animation: overlayBeatLight 0.75s ease-in-out infinite;
  animation-delay: 0.75s;
}
.overlay-metronome .overlay-dot:nth-child(3) {
  animation: overlayBeatLight 0.75s ease-in-out infinite;
  animation-delay: 1.5s;
}
.overlay-metronome .overlay-dot:nth-child(4) {
  animation: overlayBeatLight 0.75s ease-in-out infinite;
  animation-delay: 2.25s;
}

@keyframes overlayBeatLight {
  0% { transform: scale(1); background-color: #E0E0E0; }
  35% { transform: scale(1.25); background-color: #5F7C92; }
  65% { transform: scale(1); background-color: #E0E0E0; }
  100% { transform: scale(1); }
}

@keyframes overlayBeatAccent {
  0% { transform: scale(1); background-color: #E0E0E0; }
  30% { transform: scale(1.5); background-color: #314D63; }
  60% { transform: scale(1); background-color: #E0E0E0; }
  100% { transform: scale(1); }
}

.notation-pages-wrapper.page-transition-in .notation-list {
  pointer-events: auto;
}

/* ========== 开屏弹窗样式 - 高级设计 ========== */
.splash-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10500; /* 确保在Canvas之上 */
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-out, background 0.3s ease-out;
  backdrop-filter: blur(0rpx);
}

.splash-modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
  backdrop-filter: blur(8rpx);
}

/* 平板模式下弹窗位置下移 */
.splash-modal-overlay.tablet {
  align-items: flex-start;
  padding-top: 18vh;
}

.splash-modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 90%;
  max-width: 650rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25), 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  animation: splashSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
}

/* 平板设备适配 - 缩小弹窗 */
.splash-modal-content.tablet {
  max-width: 550rpx;
  padding: 30rpx 24rpx;
  gap: 20rpx;
}

.splash-modal-content.tablet .splash-title {
  font-size: 38rpx;
}

.splash-modal-content.tablet .splash-subtitle {
  font-size: 30rpx;
}

