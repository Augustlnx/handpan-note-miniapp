}

.player-setting-value-pill text {
  font-size: 26rpx;
  color: #8FB9AB;
  font-weight: 600;
  font-family: 'SF Mono', 'Monaco', monospace;
  letter-spacing: 0.5rpx;
}

.player-setting-value {
  font-size: 24rpx;
  color: #8FB9AB;
  min-width: 80rpx;
  text-align: right;
  font-family: 'SF Mono', 'Monaco', monospace;
  margin-left: 16rpx;
}

.player-setting-switch {
  transform: scale(0.9);
}

/* 播放模式区块（独立 section，不用 card） */
.player-settings-section .player-mode-selector {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 16rpx rgba(49, 77, 99, 0.04);
}

.player-mode-opt {
  flex: 1;
  padding: 22rpx 24rpx;
  background: transparent;
  border-radius: 18rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.player-mode-opt.selected {
  background: rgba(143, 185, 171, 0.18);
  box-shadow: 0 2rpx 8rpx rgba(143, 185, 171, 0.15);
}

.player-mode-opt text {
  font-size: 28rpx;
  color: rgba(49, 77, 99, 0.55);
  font-weight: 500;
}

.player-mode-opt.selected text {
  color: #2A3F52;
  font-weight: 700;
}

/* 音频映射入口（section 内） */
.player-settings-section .audio-mapping-settings-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #314D63 0%, #2A3F52 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(49, 77, 99, 0.2);
  overflow: hidden;
}

.player-settings-section .audio-mapping-settings-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.player-settings-section .audio-mapping-btn-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  filter: brightness(0) invert(1);
  opacity: 0.9;
}

.audio-mapping-btn-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-mapping-btn-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 旧版样式兼容保留 */
.playback-mode-bar {
  display: none;
}

/* 旧版播放模式菜单栏 - 已弃用但保留兼容 */
.playback-mode-bar {
  display: none;
}

/* 播放高亮列效果 */
.subdivision.playback-highlight {
  position: relative;
  z-index: 10;
}

.subdivision.playback-highlight::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -8rpx;
  background: linear-gradient(180deg, 
    rgba(178, 232, 232, 0.6) 0%, 
    rgba(143, 185, 171, 0.4) 50%,
    rgba(178, 232, 232, 0.6) 100%);
  border-radius: 8rpx;
  z-index: -1;
  animation: highlightPulse 0.3s ease-out;
  box-shadow: 0 0 20rpx rgba(143, 185, 171, 0.5),
              0 0 40rpx rgba(178, 232, 232, 0.3);
}

@keyframes highlightPulse {
  0% {
    opacity: 0;
    transform: scaleY(0.8);
  }
  50% {
    opacity: 1;
    transform: scaleY(1.1);
  }
  100% {
    opacity: 1;
    transform: scaleY(1);
  }
}

/* 高亮淡出残影效果（模拟手碟延音） */
.subdivision.playback-fadeout::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -8rpx;
  background: linear-gradient(180deg, 
    rgba(178, 232, 232, 0.3) 0%, 
    rgba(143, 185, 171, 0.2) 100%);
  border-radius: 8rpx;
  z-index: -1;
  animation: highlightFadeout 0.6s ease-out forwards;
}

@keyframes highlightFadeout {
  0% {
    opacity: 0.6;
    transform: scaleY(1);
  }
  100% {
    opacity: 0;
    transform: scaleY(0.9);
  }
}

/* 倒计时遮罩 */
.playback-countdown-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10600; /* 确保在所有UI之上 */
  backdrop-filter: blur(8rpx);
  animation: countdownOverlayFadeIn 0.3s ease-out;
}

@keyframes countdownOverlayFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.countdown-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.countdown-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #314D63 0%, #456275 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 40rpx rgba(49, 77, 99, 0.5),
              inset 0 -4rpx 12rpx rgba(0, 0, 0, 0.2);
  animation: countdownBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.countdown-circle.countdown-go {
  background: linear-gradient(135deg, #8FB9AB 0%, #B2E8E8 100%);
  animation: countdownGo 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes countdownBounce {
  0% {
    transform: scale(0.3);
    opacity: 0;
  }
  50% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes countdownGo {
  0% {
    transform: scale(1);
  }
  30% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.countdown-number {
  font-size: 100rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
}

.countdown-pulse {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(178, 232, 232, 0.6);
  animation: countdownPulseRing 1s ease-out infinite;
}

@keyframes countdownPulseRing {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}

/* 播放资源加载提示 */
.playback-loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10550; /* 确保在Canvas和菜单栏之上 */
  animation: loadingFadeIn 0.2s ease-out;
}

@keyframes loadingFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.playback-loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E0E0E0;
  border-top-color: #314D63;
  border-radius: 50%;
  animation: loadingSpin 0.8s linear infinite;
}

@keyframes loadingSpin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #314D63;
  font-weight: 500;
}

/* 播放模式下底部预留空间，防止播放器菜单栏遮挡谱面 */
.notation-container.playback-mode {
  padding-bottom: 520rpx;
}

.landscape-mode .notation-container.playback-mode {
  padding-bottom: 320rpx;
}

/* 播放模式下禁用编辑交互 */
.notation-container.playback-mode .note-slot,
.notation-container.playback-mode .slot-click-overlay {
  pointer-events: none;
}

.notation-container.playback-mode .add-notation-row,
.notation-container.playback-mode .delete-icon,
.notation-container.playback-mode .refresh-icon,
.notation-container.playback-mode .tool-icon,
.notation-container.playback-mode .less-icon {
  display: none !important;
}

/* 播放模式下隐藏底部导航栏的样式（通过JS控制tabBar） */

/* ========== Canvas 渲染模式样式 ========== */
/* 
 * 渲染模式说明：
 * 1. 静态图片模式（非编辑时）：Canvas转图片后销毁，解决层级和延迟问题
 * 2. Canvas编辑模式（编辑时）：使用 type="2d" Canvas 进行交互编辑
 * 3. 播放光标层：使用 View 覆盖层 + animate API，不影响性能
 */

/* Canvas 谱面容器 */
.canvas-notation-container {
  position: relative;
  width: 100%;
  min-height: 200px;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  overflow: hidden;
  /* 确保容器在文档流中 */
  display: block;
  box-sizing: border-box;
  /* 建立层叠上下文 */
  isolation: isolate;
}

/* 【Canvas模式迁移】展开模式样式 - 直接显示Canvas编辑模式 */
.canvas-notation-container.canvas-expanded {
  /* 展开模式下Canvas常驻编辑状态 */
  margin-bottom: 0;
}

/* 【Canvas模式迁移】收起模式样式 - 显示静态图片 */
.canvas-notation-container.canvas-collapsed {
  margin-top: 10rpx;
}

/* 静态图片显示（非编辑状态） */
.notation-static-image {
  display: block;
  width: 100%;
  position: relative;
  z-index: 1;
  /* 防止图片拖动 */
  -webkit-touch-callout: none;
  user-select: none;
}

/* Canvas 元素 - 编辑模式 */
.notation-canvas {
  display: block;
  width: 100%;
  height: 100%;
  /* 强制底层定位 */
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* Canvas编辑模式激活 */
.notation-canvas.editing-mode {
  z-index: 10;
}

/* ========== 播放光标覆盖层 ========== */
/* 
 * 播放光标使用 View 层覆盖在图片/Canvas 上方
 * 使用 CSS transform + transition 实现流畅移动
 * pointer-events: none 防止干扰点击事件
 * 主题色: #8FB9AB (薄荷绿)
 */
.playback-cursor-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500; /* 提高层级确保在所有内容之上 */
  pointer-events: none;
  overflow: visible; /* 改为visible确保光标不被裁剪 */
}

/* 播放光标 - 高级设计感的圆角矩形光标（低透明度避免遮挡音符） */
.playback-cursor {
  position: absolute;
  top: 0;
  left: 0;
  /* 主色调渐变 #8FB9AB - 降低透明度 */
  background: linear-gradient(
    180deg,
    rgba(143, 185, 171, 0.08) 0%,
    rgba(143, 185, 171, 0.15) 30%,
    rgba(143, 185, 171, 0.18) 70%,
    rgba(143, 185, 171, 0.08) 100%
  );
  /* 圆角设计 */
  border-radius: 12rpx;
  /* 左右两侧高亮边框 */
  border-left: 3rpx solid rgba(143, 185, 171, 0.7);
  border-right: 3rpx solid rgba(143, 185, 171, 0.7);
  border-top: none;
  border-bottom: none;
  /* 初始隐藏 */
  opacity: 0;
  /* 使用 transform 实现移动，性能更好 */
  will-change: transform, opacity;
  /* 过渡动画 - 位置变化平滑 */
  transition: transform 60ms cubic-bezier(0.25, 0.1, 0.25, 1), 
              opacity 150ms ease-out,
              box-shadow 300ms ease-out;
  /* 高级发光效果 - 边框发光为主 */
  box-shadow: 
    0 0 8rpx rgba(143, 185, 171, 0.4),
    0 0 16rpx rgba(143, 185, 171, 0.2);
}

/* 光标内部扫光装饰线 */
.playback-cursor::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.6) 50%,
    transparent 100%
  );
  border-radius: 12rpx 12rpx 0 0;
}

/* 光标底部装饰线 */
.playback-cursor::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(143, 185, 171, 0.8) 50%,
    transparent 100%
  );
  border-radius: 0 0 12rpx 12rpx;
}

/* 光标可见状态（cursorVisible为true，用于暂停/定位时显示） */
.playback-cursor.visible {
  opacity: 1;
}

/* 播放时光标有呼吸动画 */
.playback-cursor.playing {
  animation: cursor-breathe 1.5s ease-in-out infinite;
}

/* 播放模式激活时光标可见 - 带呼吸动画（兼容旧类名） */
.playback-mode .playback-cursor.active {
  opacity: 1;
  animation: cursor-breathe 1.5s ease-in-out infinite;
}

/* 光标呼吸发光动画 - 仅控制 box-shadow，不影响 transform（位置）
 * 修复：移除 transform 属性，避免覆盖 style 中设置的光标位置
 * 这是短曲谱播放时光标消失的根本原因 */
@keyframes cursor-breathe {
  0%, 100% {
    box-shadow: 
      0 0 8rpx rgba(143, 185, 171, 0.4),
      0 0 16rpx rgba(143, 185, 171, 0.2);
  }
  50% {
    box-shadow: 
      0 0 12rpx rgba(143, 185, 171, 0.6),
      0 0 24rpx rgba(143, 185, 171, 0.3),
      0 0 36rpx rgba(143, 185, 171, 0.15);
  }
}

/* 播放光标激活状态（兼容旧类名） */
.playback-cursor.active {
  opacity: 1;
}

/* 播放光标隐藏状态 */
.playback-cursor.hidden {
  opacity: 0 !important;
  pointer-events: none;
}

/* 播放光标淡出效果（用于残影） */
.playback-cursor.fadeout {
  opacity: 0.15;
  transition: opacity 300ms ease-out;
  animation: none;
  box-shadow: 
    0 0 8rpx rgba(143, 185, 171, 0.3),
    inset 0 0 4rpx rgba(255, 255, 255, 0.1);
}

/* 光标进入动画 */
@keyframes cursor-enter {
  from {
    opacity: 0;
    transform: var(--cursor-transform, translate(0, 0)) scale(0.9);
  }
  to {
    opacity: 1;
    transform: var(--cursor-transform, translate(0, 0)) scale(1);
  }
}

/* 光标离开动画 */
@keyframes cursor-leave {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

/* Canvas模式下的编辑高亮框（使用虚拟键盘输入） */
.canvas-editing-highlight {
  position: absolute;
  border-radius: 4rpx;
  z-index: 100;
  box-sizing: border-box;
  pointer-events: none;
  animation: canvasHighlightPulse 1.5s ease-in-out infinite;
}

/* 【性能优化】使用 transform 和 CSS 变量实现高性能高亮框移动 */
.canvas-editing-highlight--optimized {
  /* 使用 transform 替代 left/top，启用 GPU 加速 */
  left: 0;
  top: 0;
  width: var(--highlight-w, 0);
  height: var(--highlight-h, 0);
  transform: translate(var(--highlight-x, 0), var(--highlight-y, 0));
  /* 启用硬件加速 */
  will-change: transform;
  /* 快速过渡动画，提升切换流畅感 */
  transition: transform 30ms ease-out;
  /* 高层级确保不被遮挡 */
  z-index: 1000;
  /* 边框和背景通过 CSS 变量设置 */
  border: 4rpx solid var(--highlight-color, #F4D096);
  background: color-mix(in srgb, var(--highlight-color, #F4D096) 15%, transparent);
}

/* 右手高亮样式 */
.canvas-editing-highlight--right {
  border-color: var(--highlight-color, #F4D096);
}

/* 左手高亮样式 */
.canvas-editing-highlight--left {
  border-color: var(--highlight-color, #314D63);
}

/* 兼容不支持 color-mix 的环境 */
@supports not (background: color-mix(in srgb, red 50%, blue)) {
  .canvas-editing-highlight--optimized.canvas-editing-highlight--right {
    background: rgba(244, 208, 150, 0.2);
  }
  .canvas-editing-highlight--optimized.canvas-editing-highlight--left {
    background: rgba(49, 77, 99, 0.2);
  }
}

@keyframes canvasHighlightPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

/* 「切换键盘」后画布格上的原生输入框（唤起设备键盘，保持选中） */
.canvas-native-input-wrap {
  box-sizing: border-box;
  overflow: hidden;
}
.canvas-native-input {
  width: 100%;
  height: 100%;
  padding: 0 4rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #314D63;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

/* Canvas模式下的收起状态额外样式 */
.notation-sheet.collapsed .canvas-notation-container {
  margin-top: 10rpx;
}

/* Canvas模式下的编辑光标容器 */
.canvas-edit-cursor {
  position: absolute;
  pointer-events: none;
  border: 2rpx dashed #314D63;
  border-radius: 4rpx;
  animation: canvasCursorBlink 1s infinite;
  z-index: 99;
}

@keyframes canvasCursorBlink {
  0%, 50% {
    opacity: 1;
  }
  51%, 100% {
    opacity: 0.3;
  }
}

/* Canvas模式下的虚拟键盘适配 */
.notation-container.keyboard-active .canvas-notation-container {
  margin-bottom: 20rpx;
}

/* Canvas渲染加载占位 */
.canvas-loading-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
}

.canvas-loading-text {
  font-size: 24rpx;
  color: #999;
}

/* ========== 保存映射到曲谱选项 ========== */
.save-mapping-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
  background: rgba(49, 77, 99, 0.05);
  border-radius: 12rpx;
}

.save-mapping-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.save-mapping-label {
  font-size: 26rpx;
  color: #314D63;
  font-weight: 500;
}

.save-mapping-desc {
  font-size: 22rpx;
  color: #999;
}

.save-mapping-toggle {
  width: 88rpx;
  height: 48rpx;
  cursor: pointer;
}

.save-mapping-toggle .toggle-track {
  width: 100%;
  height: 100%;
  background: rgba(49, 77, 99, 0.2);
  border-radius: 24rpx;
  position: relative;
  transition: background 0.3s ease;
}

.save-mapping-toggle.active .toggle-track {
  background: #8FB9AB;
}

.save-mapping-toggle .toggle-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  transition: left 0.3s ease;
}

.save-mapping-toggle.active .toggle-thumb {
  left: 44rpx;
}

/* 新音符提示 */
.new-notes-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  margin: 12rpx 0;
  background: rgba(255, 193, 7, 0.15);
  border-radius: 8rpx;
  border-left: 4rpx solid #FFC107;
}

.new-notes-icon {
  font-size: 28rpx;
  color: #FFA000;
}

.new-notes-text {
  font-size: 24rpx;
  color: #6D4C00;
  flex: 1;
}

/* ========== 音频映射设置按钮 ========== */
.audio-mapping-btn-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(49, 77, 99, 0.1);
}

.audio-mapping-settings-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #314D63 0%, #496A81 100%);
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.audio-mapping-settings-btn:active {
  background: #26404F;
  transform: scale(0.98);
}

.audio-mapping-btn-icon {
  width: 32rpx;
  height: 32rpx;
  filter: brightness(0) invert(1);
}

.audio-mapping-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}