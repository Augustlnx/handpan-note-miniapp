{
  "pages": [
    "pages/notation/notation",
    "pages/library/library",
    "pages/metronome/metronome",
    "pages/settings/settings"
  ],
  "subpackages": [
    {
      "root": "subpackages/open_library",
      "name": "open_library",
      "pages": [
        "pages/index/index",
        "pages/search/index",
        "pages/category-list/index",
        "pages/artists/index",
        "pages/artist-profile/index",
        "pages/sheet-preview/index",
        "pages/profile/index",
        "pages/playlist-detail/index"
      ]
    },
    {
      "root": "subpackages/resources",
      "name": "resources",
      "pages": [
        "placeholder/index" 
      ]
    },
    {
      "root": "subpackages/packageA",
      "name": "packageA",
      "pages": [
        "page/export/export"
      ]
    },
    {
      "root": "subpackages/packageB",
      "name": "packageB",
      "pages": [
        "guide_page/guide"
      ]
    },
    {
      "root": "subpackages/openpage",
      "name": "openpage",
      "pages": [
        "page/splash/splash"
      ],
      "independent": true
    },
    {
      "root": "subpackages/audio",
      "name": "audio",
      "pages": [
        "placeholder/index"
      ]
    },
    {
      "root": "subpackages/audio2",
      "name": "audio2",
      "pages": [
        "placeholder/index"
      ]
    },
    {
      "root": "subpackages/audio3",
      "name": "audio3",
      "pages": [
        "placeholder/index"
      ]
    },
    {
      "root": "subpackages/audio4",
      "name": "audio4",
      "pages": [
        "placeholder/index"
      ]
    },
    {
      "root": "subpackages/rhythm_game",
      "name": "rhythm_game",
      "pages": [
        "pages/entry/index",
        "pages/audio_mapping/index",
        "pages/handpan_setup/index",
        "pages/gameplay/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/metronome/metronome": {
      "network": "all",
      "packages": ["resources", "rhythm_game"]
    },
    "pages/library/library": {
      "network": "all",
      "packages": ["resources", "open_library"]
    },
    "pages/settings/settings": {
      "network": "all",
      "packages": ["resources"]
    },
    "pages/notation/notation": {
      "network": "all",
      "packages": ["audio"]
    },
    "subpackages/openpage/page/splash/splash": {
      "network": "all",
      "packages": ["resources"]
    }
  },
  "entryPagePath": "subpackages/openpage/page/splash/splash",
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#304859",
    "navigationBarTitleText": "Handpan Note",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#fffffff1"
  },
  "tabBar": {
    "color": "black",
    "selectedColor": "#314D63",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/notation/notation",
        "text": "记谱",
        "iconPath": "assets/icons/notation.png",
        "selectedIconPath": "assets/icons/notation-active.png"
      },
      {
        "pagePath": "pages/library/library",
        "text": "曲库",
        "iconPath": "assets/icons/library.png",
        "selectedIconPath": "assets/icons/library-active.png"
      },
      {
        "pagePath": "pages/metronome/metronome",
        "text": "电子碟",
        "iconPath": "assets/icons/handpan.jpg",
        "selectedIconPath": "assets/icons/handpan-active.jpeg"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "设置",
        "iconPath": "assets/icons/settings.png",
        "selectedIconPath": "assets/icons/settings-active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "workers": "workers"
}
