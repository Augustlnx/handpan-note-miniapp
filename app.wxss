/* 全局样式 */
page {
  background-color: #F4F4F4;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* 自定义导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx; /* 导航栏高度 */
  background-color: #304859; /* 与 app.json 中的背景色一致 */
  z-index: 1000;
  display: flex;
  justify-content: center; /* 水平居中 */
  padding-top: 20rpx;
  padding-bottom: 10rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.nav-bar-content {
  flex: 1;
  position: relative;
  height: 100%;
}

.nav-bar-title {
  position: absolute;
  top: 70%;
  left: 50%;
  transform: translateX(-50%);
  color: white; /* 文字颜色 */
  font-size: 38rpx; /* 文字大小 */
  text-align: center;
  /*字体样式*/
  font-family: 'Tangerine', sans-serif;
}

/* 为使用自定义导航栏的页面添加顶部边距 */
.page-with-custom-nav {
  padding-top: 160rpx; /* 为自定义导航栏留出空间 (120rpx + 40rpx) */
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #314D63;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-secondary {
  background-color: #8FB9AB;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-accent {
  background-color: #F4D096;
  color: #314D63;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

/* 输入框样式 */
.input-field {
  background-color: white;
  border: 2rpx solid #B2E8E8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #314D63;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.08);
  position: relative;
  z-index: 1;
}

/* ============================================================ */
/* 全局高级弹窗样式系统 - Premium Modal System */
/* ============================================================ */

/* 弹窗遮罩层 */
.g-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.6) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
  backdrop-filter: blur(4rpx);
}

.g-modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* 弹窗容器 */
.g-modal {
  background: #fff;
  border-radius: 24rpx;
  width: 90%;
  max-width: 640rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25), 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  transform: translateY(30rpx) scale(0.95);
  opacity: 0;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
  overflow: hidden;
}

.g-modal-overlay.show .g-modal {
  transform: translateY(0) scale(1);
  opacity: 1;
}

/* 弹窗尺寸变体 */
.g-modal--sm {
  max-width: 500rpx;
}

.g-modal--lg {
  max-width: 750rpx;
}

.g-modal--xl {
  max-width: 90%;
}

/* 弹窗头部 */
.g-modal__header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 48rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(180deg, #fafbfc 0%, #fff 100%);
}

.g-modal__header--no-border {
  border-bottom: none;
}

/* 弹窗标题 */
.g-modal__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #314D63;
  text-align: center;
  flex: 1;
  letter-spacing: 1rpx;
}

/* 弹窗副标题/描述 */
.g-modal__subtitle {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 关闭按钮 */
.g-modal__close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
  transition: all 0.2s ease;
}

.g-modal__close:active {
  background: #e8e8e8;
  transform: translateY(-50%) scale(0.9);
}

.g-modal__close-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

/* 帮助按钮（与关闭按钮同位置或旁边） */
.g-modal__help {
  position: absolute;
  right: 80rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #8FB9AB 0%, #6FA696 100%);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(143, 185, 171, 0.3);
  transition: all 0.2s ease;
}

.g-modal__help:active {
  transform: translateY(-50%) scale(0.95);
  opacity: 0.9;
}

.g-modal__help-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.g-modal__help-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
}

/* 弹窗内容区 */
.g-modal__body {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.g-modal__body--centered {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.g-modal__body--no-padding {
  padding: 0;
}

/* 弹窗描述文字 */
.g-modal__desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

/* 弹窗输入框 */
.g-modal__input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.g-modal__input:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

.g-modal__input::placeholder {
  color: #bbb;
}

/* 弹窗文本域 */
.g-modal__textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 28rpx;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  transition: all 0.2s ease;
  line-height: 1.6;
}

.g-modal__textarea:focus {
  border-color: #8FB9AB;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(143, 185, 171, 0.15);
}

/* 弹窗底部按钮区 */
.g-modal__footer {
  display: flex;
  padding: 0;
  border-top: 1rpx solid #f0f0f0;
  background: #fafbfc;
}

.g-modal__footer--gap {
  padding: 20rpx 32rpx 32rpx;
  gap: 20rpx;
  background: #fff;
  border-top: none;
}

/* 按钮基础样式 */
.g-modal__btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background: transparent;
  transition: all 0.2s ease;
  position: relative;
}

.g-modal__btn::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: #f0f0f0;
}

.g-modal__btn:last-child::after {
  display: none;
}

.g-modal__btn:active {
  background: #f5f5f5;
}

/* 取消按钮 */
.g-modal__btn--cancel {
  color: #666;
}

/* 确认/主要按钮 */
.g-modal__btn--primary {
  color: #314D63;
  font-weight: 700;
}

/* 危险按钮 */
.g-modal__btn--danger {
  color: #e74c3c;
}

/* 圆角按钮版本（用于间距布局） */
.g-modal__footer--gap .g-modal__btn {
  border-radius: 16rpx;
  height: 88rpx;
}

.g-modal__footer--gap .g-modal__btn::after {
  display: none;
}

.g-modal__footer--gap .g-modal__btn--cancel {
  background: #f0f0f0;
  color: #666;
}

.g-modal__footer--gap .g-modal__btn--cancel:active {
  background: #e0e0e0;
}

.g-modal__footer--gap .g-modal__btn--primary {
  background: linear-gradient(135deg, #314D63 0%, #456275 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(49, 77, 99, 0.3);
}

.g-modal__footer--gap .g-modal__btn--primary:active {
  background: linear-gradient(135deg, #28404f 0%, #3a5363 100%);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(49, 77, 99, 0.3);
}

.g-modal__footer--gap .g-modal__btn--danger {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(231, 76, 60, 0.3);
}

/* 分隔线 */
.g-modal__divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* 帮助内容区域样式 */
.g-modal__help-content {
  background: #f9fafb;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #314D63;
}

.g-modal__help-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
  font-size: 28rpx;
  color: #555;
}

.g-modal__help-line:last-child {
  margin-bottom: 0;
}

.g-modal__help-dot {
  color: #314D63;
  font-weight: bold;
  flex-shrink: 0;
}

.g-modal__help-strong {
  font-weight: 600;
  color: #314D63;
}

.g-modal__help-quote {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #eef2f6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 代码块样式 */
.g-modal__code {
  background: #2c3e50;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 16rpx 0;
}

.g-modal__code-text {
  font-size: 24rpx;
  font-family: 'SF Mono', Monaco, monospace;
  color: #fff;
  line-height: 1.8;
  word-break: break-all;
}

/* 错误提示样式 */
.g-modal__error {
  color: #e74c3c;
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.4;
}

/* 提示信息 */
.g-modal__hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* 加载状态 */
.g-modal__loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 24rpx;
}

.g-modal__loading-icon {
  width: 80rpx;
  height: 80rpx;
  animation: g-modal-spin 1s linear infinite;
}

@keyframes g-modal-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.g-modal__loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 成功/完成状态 */
.g-modal__success {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.g-modal__success-icon {
  width: 100rpx;
  height: 100rpx;
}

.g-modal__success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.g-modal__success-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
}

/* 底部操作栏弹窗（底部滑出） */
.g-modal-overlay--bottom {
  align-items: flex-end;
}

.g-modal-overlay--bottom .g-modal {
  max-width: 100%;
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  max-height: 70vh;
}

.g-modal-overlay--bottom.show .g-modal {
  transform: translateY(0);
}

/* 表单组样式 */
.g-form-group {
  margin-bottom: 28rpx;
}

.g-form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.g-form-row {
  display: flex;
  gap: 20rpx;
}

.g-form-col {
  flex: 1;
}

/* 选择器样式 */
.g-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.g-picker-arrow {
  font-size: 24rpx;
  color: #999;
}

@font-face {
    font-family: 'Tangerine';
    src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
        url('data:font/woff;charset=utf-8;base64,') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
}



.fancy-text {
    font-family: 'Tangerine', sans-serif;
    font-size: 40rpx;
}