/* 全局样式 */
page {
  background-color: #F4F4F4;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "微软雅黑", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
}

/* 自定义导航栏 */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx; /* 导航栏高度 */
  background-color: #304859; /* 与 app.json 中的背景色一致 */
  z-index: 1000;
  display: flex;
  justify-content: center; /* 水平居中 */
  padding-top: 20rpx;
  padding-bottom: 10rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
}

.nav-bar-content {
  flex: 1;
  position: relative;
  height: 100%;
}

.nav-bar-title {
  position: absolute;
  top: 70%;
  left: 50%;
  transform: translateX(-50%);
  color: white; /* 文字颜色 */
  font-size: 38rpx; /* 文字大小 */
  text-align: center;
  /*字体样式*/
  font-family: 'Tangerine', sans-serif;
}

/* 为使用自定义导航栏的页面添加顶部边距 */
.page-with-custom-nav {
  padding-top: 160rpx; /* 为自定义导航栏留出空间 (120rpx + 40rpx) */
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #314D63;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-secondary {
  background-color: #8FB9AB;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-accent {
  background-color: #F4D096;
  color: #314D63;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

/* 输入框样式 */
.input-field {
  background-color: white;
  border: 2rpx solid #B2E8E8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #314D63;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(49, 77, 99, 0.08);
  position: relative;
  z-index: 1;
}

@font-face {
    font-family: 'Tangerine';
    src: url('data:font/woff2;charset=utf-8;base64,') format('woff2'),
        url('data:font/woff;charset=utf-8;base64,') format('woff');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
}



.fancy-text {
    font-family: 'Tangerine', sans-serif;
    font-size: 40rpx;
}